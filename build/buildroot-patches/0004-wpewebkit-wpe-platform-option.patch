Subject: wpewebkit: add the WPE Platform API (and its DRM platform) as options

WPE WebKit 2.44+ carries a second embedding API next to libwpe: WPE Platform
(libWPEPlatform). The application creates a WPEDisplay -- DRM/KMS, headless or
Wayland -- and WebKit renders through it; input, screens and system settings
(WPE_SETTING_DARK_MODE among them) come from the platform instead of a libwpe
backend. It is where upstream puts new work: the libwpe path is now WebKit's
"ViewLegacy".

In 2.50 the switch, ENABLE_WPE_PLATFORM, defaults to ENABLE_DEVELOPER_MODE, so
a release build -- Buildroot's -- leaves it off, and Buildroot has no option to
turn it on. 0001 in this series sets it OFF explicitly; this replaces that with
BR2_PACKAGE_WPEWEBKIT_WPE_PLATFORM (off by default, so nothing changes for a
config that does not ask), plus BR2_PACKAGE_WPEWEBKIT_WPE_PLATFORM_DRM for the
KMS platform, which needs libinput (>= 1.19) and udev at build time
(OptionsWPE.cmake) and GBM/libdrm to allocate and scan out buffers.

The headless platform is built with it (no dependencies). The Wayland platform
is left off: it is for running under a compositor, and would bring wayland and
wayland-protocols back, which 0001 took out.

Applies on top of 0001. A candidate to send upstream to Buildroot.

diff -ruN a/package/wpewebkit/Config.in b/package/wpewebkit/Config.in
--- a/package/wpewebkit/Config.in	2026-10-16 02:06:04
+++ b/package/wpewebkit/Config.in	2026-10-16 02:06:25
@@ -83,6 +83,36 @@
 	depends on BR2_PACKAGE_LIBSECCOMP_ARCH_SUPPORTS
 	depends on !BR2_TOOLCHAIN_HEADERS_AT_LEAST_3_12
 
+config BR2_PACKAGE_WPEWEBKIT_WPE_PLATFORM
+	bool "WPE Platform API"
+	select BR2_PACKAGE_LIBXKBCOMMON
+	help
+	  Build the WPE Platform library (libWPEPlatform), the API
+	  that replaces the libwpe backend interface: the application
+	  creates a WPEDisplay and WebKit renders through it, with
+	  input, screens and settings (dark mode and the like) handled
+	  by the platform instead of a libwpe backend. Includes the
+	  headless platform. Applications using the libwpe API keep
+	  working alongside it.
+
+if BR2_PACKAGE_WPEWEBKIT_WPE_PLATFORM
+
+config BR2_PACKAGE_WPEWEBKIT_WPE_PLATFORM_DRM
+	bool "DRM platform"
+	depends on BR2_PACKAGE_HAS_UDEV # libinput
+	depends on BR2_PACKAGE_HAS_LIBGBM
+	select BR2_PACKAGE_LIBDRM
+	select BR2_PACKAGE_LIBINPUT
+	help
+	  WPE Platform backend that drives kernel mode-setting (KMS)
+	  directly: full-screen output with no compositor, input
+	  through libinput.
+
+comment "DRM platform needs udev and GBM"
+	depends on !BR2_PACKAGE_HAS_UDEV || !BR2_PACKAGE_HAS_LIBGBM
+
+endif
+
 config BR2_PACKAGE_WPEWEBKIT_MULTIMEDIA
 	bool "multimedia support"
 	select BR2_PACKAGE_GSTREAMER1
diff -ruN a/package/wpewebkit/wpewebkit.mk b/package/wpewebkit/wpewebkit.mk
--- a/package/wpewebkit/wpewebkit.mk	2026-10-16 02:06:04
+++ b/package/wpewebkit/wpewebkit.mk	2026-10-16 02:06:25
@@ -32,7 +32,6 @@
 	-DENABLE_INTROSPECTION=OFF \
 	-DENABLE_MINIBROWSER=OFF \
 	-DENABLE_WEB_RTC=OFF \
-	-DENABLE_WPE_PLATFORM=OFF \
 	-DUSE_ATK=OFF
 
 # WPE WebKit uses a bundled copy of Skia since 2.46.0 for
@@ -113,6 +112,22 @@
 WPEWEBKIT_DEPENDENCIES += libbacktrace
 else
 WPEWEBKIT_CONF_OPTS += -DUSE_LIBBACKTRACE=OFF
+endif
+
+ifeq ($(BR2_PACKAGE_WPEWEBKIT_WPE_PLATFORM),y)
+WPEWEBKIT_CONF_OPTS += \
+	-DENABLE_WPE_PLATFORM=ON \
+	-DENABLE_WPE_PLATFORM_HEADLESS=ON \
+	-DENABLE_WPE_PLATFORM_WAYLAND=OFF
+WPEWEBKIT_DEPENDENCIES += libxkbcommon
+ifeq ($(BR2_PACKAGE_WPEWEBKIT_WPE_PLATFORM_DRM),y)
+WPEWEBKIT_CONF_OPTS += -DENABLE_WPE_PLATFORM_DRM=ON
+WPEWEBKIT_DEPENDENCIES += libinput udev
+else
+WPEWEBKIT_CONF_OPTS += -DENABLE_WPE_PLATFORM_DRM=OFF
+endif
+else
+WPEWEBKIT_CONF_OPTS += -DENABLE_WPE_PLATFORM=OFF
 endif
 
 ifeq ($(BR2_PACKAGE_LIBDRM),y)
