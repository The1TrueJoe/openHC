# Buildroot output (multi-GB, reproducible from configs)
/output/
/dl/
/br2-external/buildroot/
*.img
*.bin
# NO EXCEPTION for the vendor IO-MCU images: Control4's proprietary firmware,
# not ours to redistribute. Return to stock reads them from the box's own
# recovery archive (board/common/firmware/io-mcu/README.md).
/board/common/firmware/io-mcu/build/
# scratch
/tmp/
*.log
__pycache__/
/test/
# local python venv for the netboot/serial tools
.venv/

.DS_Store
# packages/ build artifacts (Rust target, node deps, UI bundle, staged binaries)
/packages/target/
/packages/**/node_modules/
/packages/**/dist/
# packages/build.sh stages the compiled daemons (iod/webd/sysmond/…) into this
# dir — those are build output and stay ignored. The committed fleet source
# scripts that share the dir (the ohc service dispatcher + mdns/tz) are the
# exceptions below; build.sh only adds binaries, it never cleans them out.
/board/common/rootfs-overlay/opt/ohc/bin/*
!/board/common/rootfs-overlay/opt/ohc/bin/ohc
!/board/common/rootfs-overlay/opt/ohc/bin/ohc-mdns
!/board/common/rootfs-overlay/opt/ohc/bin/ohc-tz
*.tsbuildinfo

# Device backups (eMMC dumps) — never commit these
/backups/

# docs site (site/dist is the built output; the lockfile IS committed)
/site/dist/
/site/.astro/
/site/node_modules/
c4-recon/

# local secrets (Kasa login etc.)
.env
# agent worktrees — a git repo inside this one, never ours to commit
.claude/worktrees/
