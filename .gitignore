# Buildroot output (multi-GB, reproducible from configs)
/output/
/dl/
/br2-external/buildroot/
*.img
*.bin
# NO EXCEPTION for the vendor IO-MCU images. They are Control4/Snap One
# proprietary firmware, and "the owner of the hardware already has them" is a
# reason someone may keep a copy — not a licence to redistribute one from a
# public repository. Pull them off your own unit; see
# board/hc800/firmware/io-mcu/lm3s1162/vendor/README.md for where they live and
# the checksums to confirm you have the right ones.
# scratch
/tmp/
*.log
__pycache__/
/test/
# local python venv for the netboot/serial tools
.venv/

.DS_Store
# packages/ build artifacts (Rust target, node deps, UI bundle, staged binaries)
/packages/target/
/packages/**/node_modules/
/packages/**/dist/
/board/common/rootfs-overlay/opt/ohc/bin/
*.tsbuildinfo

# Device backups (eMMC dumps) — never commit these
/backups/

# docs site (site/dist is the built output; the lockfile IS committed)
/site/dist/
/site/.astro/
/site/node_modules/
c4-recon/
