# Buildroot output (multi-GB, reproducible from configs)
/output/
/dl/
/br2-external/buildroot/
*.img
*.bin
# ...except the vendor IO-MCU images we deliberately keep. These are the ONLY
# way back to stock firmware on the microcontroller — the equivalent of the
# sda2 factory partition for the host — and they are 70 KB, pulled off a live
# unit's /control4/firmware/io/. Losing them to a blanket *.bin would mean a
# bricked MCU is unrecoverable without SWD.
!/board/*/firmware/io-mcu/*/vendor/*.bin
# scratch
/tmp/
*.log
__pycache__/
/test/
# local python venv for the netboot/serial tools
.venv/

.DS_Store
# packages/ build artifacts (Rust target, node deps, UI bundle, staged binaries)
/packages/target/
/packages/**/node_modules/
/packages/**/dist/
/board/common/rootfs-overlay/opt/ohc/bin/
*.tsbuildinfo

# Device backups (eMMC dumps) — never commit these
/backups/

# docs site (site/dist is the built output; the lockfile IS committed)
/site/dist/
/site/.astro/
/site/node_modules/
c4-recon/
