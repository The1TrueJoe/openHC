From 5917c818254fd6373c3fdf57f682b205acb39a17 Mon Sep 17 00:00:00 2001
From: Joseph Telaak <joseph@telaak.dev>
Date: Mon, 9 Nov 2026 16:59:21 -0500
Subject: [PATCH iwl-next 1/2] dt-bindings: net: add the Intel CE4100 GbE

The Gigabit Ethernet MAC of the Intel CE4100 family (CE4100, CE4200,
CE5300) is a PCI function, 8086:2e6e, driven by e1000. Boards built on
the CE5300 wire it straight to a switch port with no PHY, which the
device tree describes with phy-mode and a fixed-link node on the PCI
device's node. Document the node so those properties have a schema.

The existing falconfalls CE4100 tree names the node with the full
PCI bus binding list ("pci8086,2e6e.2", "pci8086,2e6e",
"pciclass020000", "pciclass0200"); only the vendor/device form is
documented here.
---
 .../bindings/net/intel,ce4100-gbe.yaml        | 64 +++++++++++++++++++
 1 file changed, 64 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/net/intel,ce4100-gbe.yaml

diff --git a/Documentation/devicetree/bindings/net/intel,ce4100-gbe.yaml b/Documentation/devicetree/bindings/net/intel,ce4100-gbe.yaml
new file mode 100644
index 000000000..5c9b5e431
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/intel,ce4100-gbe.yaml
@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/intel,ce4100-gbe.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Intel CE4100 family Gigabit Ethernet MAC
+
+maintainers:
+  - Joseph Telaak <joseph@telaak.dev>
+
+description:
+  The Gigabit Ethernet MAC built into the Intel CE4100 family of media SoCs
+  (CE4100, CE4200, CE5300), a PCI function on the SoC's internal bus,
+  handled by the e1000 driver. It has an external RGMII or RMII interface.
+  Most boards put a PHY on its MDIO bus, which the driver finds by itself.
+  Boards that wire the MAC straight to a switch port describe that link
+  with phy-mode and a fixed-link node.
+
+allOf:
+  - $ref: /schemas/pci/pci-device.yaml#
+  - $ref: ethernet-controller.yaml#
+
+properties:
+  compatible:
+    const: pci8086,2e6e
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  phy-mode:
+    enum:
+      - rgmii
+      - rmii
+
+required:
+  - compatible
+  - reg
+
+dependencies:
+  fixed-link: [ phy-mode ]
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    pci {
+        #address-cells = <3>;
+        #size-cells = <2>;
+
+        ethernet@c,0 {
+            compatible = "pci8086,2e6e";
+            reg = <0x6000 0 0 0 0>;
+            phy-mode = "rgmii";
+
+            fixed-link {
+                speed = <1000>;
+                full-duplex;
+            };
+        };
+    };
