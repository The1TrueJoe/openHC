From f6d91030e62fe430959ec52ba8e4801e496fee7c Mon Sep 17 00:00:00 2001
From: Joseph Telaak <joseph@telaak.dev>
Date: Mon, 9 Nov 2026 16:59:21 -0500
Subject: [PATCH 1/2] dt-bindings: net: add Intel CE4100 GbE

The GbE MAC of the Intel CE4100 and CE5300 is a PCI function, 8086:2e6e,
with an RGMII or RMII interface. Some boards connect it directly to a
switch port with no PHY. Document the PCI device node so phy-mode and
fixed-link can describe such a link.
---
 .../devicetree/bindings/net/pci8086,2e6e.yaml | 71 +++++++++++++++++++
 1 file changed, 71 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/net/pci8086,2e6e.yaml

diff --git a/Documentation/devicetree/bindings/net/pci8086,2e6e.yaml b/Documentation/devicetree/bindings/net/pci8086,2e6e.yaml
new file mode 100644
index 000000000..77c3547d8
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/pci8086,2e6e.yaml
@@ -0,0 +1,71 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/pci8086,2e6e.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Intel CE4100 family Gigabit Ethernet MAC
+
+maintainers:
+  - Joseph Telaak <joseph@telaak.dev>
+
+description:
+  The Gigabit Ethernet MAC of the Intel CE4100 and CE5300 media SoCs, a PCI
+  function on the SoC's internal bus with an RGMII or RMII interface. Some
+  boards connect it directly to a switch port with no PHY and describe that
+  link with phy-mode and a fixed-link node.
+
+allOf:
+  - $ref: /schemas/pci/pci-device.yaml
+  - $ref: ethernet-controller.yaml
+
+properties:
+  compatible:
+    oneOf:
+      - const: pci8086,2e6e
+      - items:
+          - const: pci8086,2e6e.2
+          - const: pci8086,2e6e
+          - const: pciclass020000
+          - const: pciclass0200
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  phy-mode:
+    enum:
+      - rgmii
+      - rgmii-id
+      - rgmii-rxid
+      - rgmii-txid
+      - rmii
+
+required:
+  - compatible
+  - reg
+
+dependencies:
+  fixed-link: [ phy-mode ]
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    pci {
+        #address-cells = <3>;
+        #size-cells = <2>;
+
+        ethernet@c,0 {
+            compatible = "pci8086,2e6e";
+            reg = <0x6000 0 0 0 0>;
+            phy-mode = "rgmii";
+
+            fixed-link {
+                speed = <1000>;
+                full-duplex;
+            };
+        };
+    };
-- 
