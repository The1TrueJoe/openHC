From c8cda0f8a57f7c142758a2d9858f64c9b34c1b56 Mon Sep 17 00:00:00 2001
From: Joseph Telaak <joseph@telaak.dev>
Date: Mon, 9 Nov 2026 17:45:43 -0500
Subject: [PATCH] net: dsa: b53: mirror BPDUs to CPU port 5 when port 8 is not
 a CPU port

With port 5 as the CPU port, a BCM531x5 runs in dual-IMP mode and traps
BPDUs from LAN ports to port 8. On boards where port 8 is unconnected
they are lost, so STP never sees its peers and a loop between two user
ports takes the host off the network.

Mirror frames sent to the bridge group address from the user ports to
port 5 instead. The multiport address registers cannot do this, since
reserved multicast is resolved before them, and marking the user ports
as WAN ports stops forwarding between them.

The switch has one mirror, so refuse tc mirroring while it carries BPDUs.
---
 drivers/net/dsa/b53/b53_common.c | 32 ++++++++++++++++++++++++++++++++
 drivers/net/dsa/b53/b53_priv.h   |  1 +
 2 files changed, 33 insertions(+)

diff --git a/drivers/net/dsa/b53/b53_common.c b/drivers/net/dsa/b53/b53_common.c
index a2a5754c413c..a4ba7d0ca01f 100644
--- a/drivers/net/dsa/b53/b53_common.c
+++ b/drivers/net/dsa/b53/b53_common.c
@@ -758,6 +758,29 @@ void b53_disable_port(struct dsa_switch *ds, int port)
 }
 EXPORT_SYMBOL(b53_disable_port);
 
+/* With port 5 as its CPU port, a BCM531x5 runs in dual-IMP mode, which
+ * traps the BPDUs of LAN ports to the IMP port (8), not to port 5. When
+ * port 8 is not a CPU port, mirror them to port 5 instead. The switch has
+ * one mirror, so tc mirroring is refused while this holds it.
+ */
+static void b53_bpdu_mirror(struct b53_device *dev, int port, bool enable)
+{
+	if (enable) {
+		b53_write48(dev, B53_MGMT_PAGE, B53_IG_MIR_MAC,
+			    ether_addr_to_u64(eth_stp_addr));
+		b53_write16(dev, B53_MGMT_PAGE, B53_IG_MIR_CTL,
+			    MIRROR_DA << MIRROR_FILTER_SHIFT |
+			    (dsa_user_ports(dev->ds) & MIRROR_MASK));
+		b53_write16(dev, B53_MGMT_PAGE, B53_MIR_CAP_CTL,
+			    MIRROR_EN | port);
+	} else if (dev->bpdu_mirror) {
+		b53_write16(dev, B53_MGMT_PAGE, B53_IG_MIR_CTL, 0);
+		b53_write16(dev, B53_MGMT_PAGE, B53_MIR_CAP_CTL, 0);
+	}
+
+	dev->bpdu_mirror = enable;
+}
+
 void b53_brcm_hdr_setup(struct dsa_switch *ds, int port)
 {
 	struct b53_device *dev = ds->priv;
@@ -797,6 +820,9 @@ void b53_brcm_hdr_setup(struct dsa_switch *ds, int port)
 		hdr_ctl |= GC_FRM_MGMT_PORT_M;
 	b53_write8(dev, B53_MGMT_PAGE, B53_GLOBAL_CONFIG, hdr_ctl);
 
+	b53_bpdu_mirror(dev, port, tag_en && port == 5 && is531x5(dev) &&
+			!dsa_is_cpu_port(ds, B53_CPU_PORT));
+
 	/* B53_BRCM_HDR not present on devices with legacy tags */
 	if (dev->tag_protocol == DSA_TAG_PROTO_BRCM_LEGACY ||
 	    dev->tag_protocol == DSA_TAG_PROTO_BRCM_LEGACY_FCS)
@@ -2604,6 +2630,12 @@ int b53_mirror_add(struct dsa_switch *ds, int port,
 	struct b53_device *dev = ds->priv;
 	u16 reg, loc;
 
+	if (dev->bpdu_mirror) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "The mirror carries BPDUs to CPU port 5");
+		return -EBUSY;
+	}
+
 	if (ingress)
 		loc = B53_IG_MIR_CTL;
 	else
diff --git a/drivers/net/dsa/b53/b53_priv.h b/drivers/net/dsa/b53/b53_priv.h
index c4d2a41c714f..6269c8b3c95a 100644
--- a/drivers/net/dsa/b53/b53_priv.h
+++ b/drivers/net/dsa/b53/b53_priv.h
@@ -170,6 +170,7 @@ struct b53_device {
 
 	/* run time configuration */
 	bool enable_jumbo;
+	bool bpdu_mirror;
 
 	unsigned int num_vlans;
 	struct b53_vlan *vlans;
-- 
