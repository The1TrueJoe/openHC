config BR2_PACKAGE_WEBVIEW
	bool "webview"
	depends on BR2_PACKAGE_WPEWEBKIT_WPE_PLATFORM_DRM
	help
	  Full-screen web surface for openHC.

	  Creates one WPE WebKit view on the WPE Platform DRM display,
	  loads a URL and runs a main loop. No chrome, no navigation, no
	  tabs (Buildroot builds WebKit with ENABLE_MINIBROWSER=OFF).
	  S95ohc-display runs it when the web UI turns the view on.

	  The URL comes from argv[1] or $WEBVIEW_URL, defaulting to
	  http://localhost/ -- the dashboard webd already serves on :80.

	  USB keyboards and mice drive the page through libinput. The
	  page draws the mouse cursor itself.

comment "webview needs wpewebkit with the WPE Platform DRM display"
	depends on !BR2_PACKAGE_WPEWEBKIT_WPE_PLATFORM_DRM
