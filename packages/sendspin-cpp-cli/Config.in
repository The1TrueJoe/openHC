config BR2_PACKAGE_SENDSPIN_CPP_CLI
	bool "sendspin-cpp-cli"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_10 # C++20
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_MMU # fork()
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_ALSA_LIB_PCM
	select BR2_PACKAGE_ALSA_LIB_MIXER
	help
	  A headless Sendspin player (sendspin-cli): a Sendspin server
	  (Music Assistant, for one) finds it over mDNS and plays to it,
	  in sync with its other players. audiod runs one per Sendspin
	  endpoint. mDNS needs Avahi's libdns_sd compatibility library
	  (BR2_PACKAGE_AVAHI_LIBDNSSD_COMPATIBILITY); without it the
	  player cannot be discovered.

	  Not packaged by Buildroot; this is openHC's own package.

	  https://github.com/Sendspin/sendspin-cpp-cli

comment "sendspin-cpp-cli needs a toolchain w/ C++, threads, gcc >= 10"
	depends on BR2_USE_MMU
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS || \
		!BR2_TOOLCHAIN_GCC_AT_LEAST_10
