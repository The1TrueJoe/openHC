#!/bin/sh
#
# Spotify Connect receiver. Advertises this box on the LAN; a Spotify client
# picks it as a playback device. Needs a Premium account (Spotify's API only
# permits Connect for Premium) -- with a free account the device is discovered
# and then refuses to play, which looks like a bug and is not one.
#
# --name uses the unit hostname so several controllers on one network stay
# distinguishable (openhc-<board>-<MAC>, set by S09hostname).

DAEMON=/usr/bin/librespot
# A board with named outputs (board.env OHC_AUDIO_OUTPUTS) runs its endpoints
# through ohc-audio / S95ohcaudio instead — N instances, one per mapping.
[ -r /opt/ohc/board.env ] && . /opt/ohc/board.env
[ -n "$OHC_AUDIO_OUTPUTS" ] && exit 0
PIDFILE=/var/run/librespot.pid
NAME="$(hostname)"
# The web UI's output selector (iod audio.output) writes OHC_AUDIO_DEVICE here;
# honour it when set, otherwise 'alsa' with no device follows the default PCM, so
# an asound.conf or a USB DAC change needs no edit. Picked up on (re)start, which
# is what the panel tells the user.
[ -r /etc/ohc/audio-output ] && . /etc/ohc/audio-output
DEV="${OHC_AUDIO_DEVICE:+--device $OHC_AUDIO_DEVICE}"
ARGS="--name $NAME --backend alsa $DEV --bitrate 320 --disable-audio-cache"

case "$1" in
  start)
	[ -x "$DAEMON" ] || exit 0
	printf 'Starting librespot: '
	start-stop-daemon -S -q -m -b -p "$PIDFILE" -x "$DAEMON" -- $ARGS \
		&& echo OK || echo FAIL
	;;
  stop)
	printf 'Stopping librespot: '
	start-stop-daemon -K -q -p "$PIDFILE" && echo OK || echo FAIL
	rm -f "$PIDFILE"
	;;
  restart|reload)
	"$0" stop
	sleep 1
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac
