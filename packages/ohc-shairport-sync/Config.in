config BR2_PACKAGE_OHC_SHAIRPORT_SYNC
	bool "shairport-sync (openHC, AirPlay 2, multi-instance)"
	depends on BR2_TOOLCHAIN_HAS_THREADS_NPTL
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_USE_WCHAR # libglib2
	depends on BR2_USE_MMU
	depends on BR2_PACKAGE_LIBGPG_ERROR_ARCH_SUPPORTS # libgcrypt
	depends on BR2_PACKAGE_FFMPEG_ARCH_SUPPORTS
	depends on !BR2_PACKAGE_SHAIRPORT_SYNC # same binary, same paths
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_ALSA_LIB_MIXER
	select BR2_PACKAGE_LIBCONFIG
	select BR2_PACKAGE_POPT
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_AVAHI
	select BR2_PACKAGE_AVAHI_DAEMON
	select BR2_PACKAGE_DBUS
	select BR2_PACKAGE_LIBGLIB2
	select BR2_PACKAGE_LIBPLIST
	select BR2_PACKAGE_LIBSODIUM
	select BR2_PACKAGE_LIBGCRYPT
	select BR2_PACKAGE_FFMPEG
	select BR2_PACKAGE_UTIL_LINUX
	select BR2_PACKAGE_UTIL_LINUX_LIBUUID
	select BR2_PACKAGE_OHC_NQPTP # runtime
	help
	  An AirPlay 2 receiver (it also takes classic AirPlay senders),
	  built from shairport-sync's development branch: that is where
	  several AirPlay 2 instances can share one host and one address,
	  each on its own port (shairport-sync#2277, #2273, #2278, #2287).
	  audiod runs one per AirPlay endpoint. Built with the D-Bus
	  remote control (how audiod moves a sender's volume slider)
	  and the metadata pipe (now-playing and cover art).

	  https://github.com/mikebrady/shairport-sync
