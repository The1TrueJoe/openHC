config BR2_PACKAGE_OHC_NQPTP
	bool "nqptp (openHC, multi-instance)"
	depends on BR2_USE_MMU # fork()
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  The PTP timing companion AirPlay 2 needs. One per host, shared
	  by every shairport-sync instance; this build is nqptp's
	  development branch, which serves several instances (each with
	  its own shared-memory interface) where the 1.2.x releases serve
	  one. Started by ohc-audiod (or S99shairport-sync), not by an
	  init script of its own.

	  https://github.com/mikebrady/nqptp
