From: openHC <noreply@openhc>
Subject: [PATCH] DIAG(temp): log EGL failure points in createWindowContext

Release wpewebkit emits no RELEASE_LOG, so the WPE compositor's window-context
creation fails silently. Print the exact EGL error at each step to locate it.
Remove once the LinuxFB window context is working.

--- ga/Source/WebCore/platform/graphics/egl/GLContext.cpp	2026-10-06 16:56:13
+++ gb/Source/WebCore/platform/graphics/egl/GLContext.cpp	2026-10-06 16:56:13
@@ -18,6 +18,7 @@
 
 #include "config.h"
 #include "GLContext.h"
+#include <cstdio>
 
 #include "GLDisplay.h"
 #include "GraphicsContextGL.h"
@@ -133,12 +134,14 @@
     EGLDisplay eglDisplay = display.eglDisplay();
     EGLConfig config;
     if (!getEGLConfig(eglDisplay, &config, EGL_WINDOW_BIT)) {
+        fprintf(stderr, "ohcwk: getEGLConfig(WINDOW) FAILED egl=0x%x\n", eglGetError()); fflush(stderr);
         RELEASE_LOG_INFO(Compositing, "Cannot obtain EGL window context configuration: %s\n", lastErrorString());
         return nullptr;
     }
 
     EGLContext context = createContextForEGLVersion(eglDisplay, config, sharingContext);
     if (context == EGL_NO_CONTEXT) {
+        fprintf(stderr, "ohcwk: createContextForEGLVersion FAILED egl=0x%x\n", eglGetError()); fflush(stderr);
         RELEASE_LOG_INFO(Compositing, "Cannot create EGL window context: %s\n", lastErrorString());
         return nullptr;
     }
@@ -160,6 +163,7 @@
         break;
     }
 
+    fprintf(stderr, "ohcwk: createWindowSurfaceWPE -> surface=%p egl=0x%x\n", (void*)surface, eglGetError()); fflush(stderr);
     if (surface == EGL_NO_SURFACE) {
         RELEASE_LOG_INFO(Compositing, "Cannot create EGL window surface: %s. Retrying with fallback.", lastErrorString());
         // EGLNativeWindowType changes depending on the EGL implementation, reinterpret_cast
