# The NCP image every openHC Zigbee board keeps its EM357 on. Sourced by
# install.sh; bump all four together.
#
# EmberZNet 6.7.8 (EZSP v8) is the last line Silicon Labs built for the EM35x,
# and new enough for zigbee2mqtt's `ezsp` driver and ZHA/bellows. The file is
# Silicon Labs' own build, mirrored in walthowd/husbzb-firmware (the HUSBZB-1 is
# the same EM357), pinned to a commit so the URL can never change under us.
EM357_NCP_URL=https://raw.githubusercontent.com/walthowd/husbzb-firmware/d6a512ccb2d770d4fdabdc27805ddd68fde96988/em357-v678-ncp-uart-sw.ebl
EM357_NCP_FILE=em357-v678-ncp-uart-sw.ebl
EM357_NCP_SHA256=a6e1ea568656f3da5017baffbdd3bf6940b8e5a8b11e8620b71312dd471311b9
EM357_NCP_STACK=6.7.8.0
