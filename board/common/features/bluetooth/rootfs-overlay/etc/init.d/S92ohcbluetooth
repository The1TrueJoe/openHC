#!/bin/sh
# openHC Bluetooth LE to MQTT bridge — the 'bluetooth' feature.
#
# bluetooth-bridge (github.com/pulzar-net/bluetooth-bridge, built by
# packages/build.sh from the feature's `packages`) drives the first Bluetooth
# controller (hci0) through the kernel's HCI user channel and puts what it
# hears on MQTT under <box base>/bluetooth: beacons and sensors (BTHome, Ruuvi,
# iBeacon, Eddystone), connections, GATT and pairing as requests. A dongle
# plugged in after boot is picked up within 30 s. Bonds and the bridge's own
# identity live in /data/ohc/bluetooth.
[ -r /opt/ohc/board.env ] && . /opt/ohc/board.env
BIN=/opt/ohc/bin/bluetooth-bridge
CONF=/run/ohc/bluetooth-bridge.toml
DATA=/data/ohc/bluetooth
PID=/var/run/bluetooth-bridge.pid

run() {
    echo $$ > "$PID.run"   # so `stop` ends this loop even mid-sleep
    export NO_COLOR=1      # plain text in syslog, not ANSI colour codes
    base=$(/opt/ohc/bin/ohc-mqtt-base)
    set -- $(/opt/ohc/bin/ohc-mqtt-base broker)
    mkdir -p "$DATA" "${CONF%/*}"
    cat > "$CONF" <<CONF
# Written by $0 at every start.
[adapter]
transport = "hci0"
name = "${base##*/}"

[mqtt]
host = "$1"
port = $2
client_id = "${base##*/}-bluetooth"
base_topic = "$base/bluetooth"

[homeassistant]
enabled = false

[data]
dir = "$DATA"
CONF
    # Onboard controllers come up from the device tree; a dongle's driver is
    # loaded by eudev. Either way, wait for hci0.
    modprobe -q btusb 2>/dev/null
    # ponytail: a plain restart loop, 30 s apart, no backoff.
    while [ -f "$PID" ]; do
        if [ -e /sys/class/bluetooth/hci0 ]; then
            "$BIN" --config "$CONF"
            echo "bluetooth-bridge exited ($?); restarting in 30 s"
        fi
        sleep 30
    done
}

start() {
    [ -x "$BIN" ] || return 0
    start-stop-daemon -S -q -b -m -p "$PID" --exec /bin/sh -- \
        -c "$0 run 2>&1 | logger -t bluetooth-bridge" \
        && echo "bluetooth-bridge: watching hci0"
}
stop() {
    [ -f "$PID" ] || return 0
    start-stop-daemon -K -q -p "$PID"
    [ -f "$PID.run" ] && kill "$(cat "$PID.run")" 2>/dev/null
    rm -f "$PID" "$PID.run"
    killall bluetooth-bridge 2>/dev/null
}
case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    run) run ;;
    *) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
