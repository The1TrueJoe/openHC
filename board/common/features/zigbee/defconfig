# openHC feature: zigbee — the shared userspace to run an EM35x Zigbee NCP and
# bridge it into the rest of the world over MQTT. Enabled on every board that has
# a radio (ca1, the EA family, hc800); NOT on the IO Extender, which has none.
#
# This is the TRANSPORT-AGNOSTIC half. WHICH port the NCP is on is the board's
# udev rule (60-openhc-board.rules -> /dev/zigbee): a CP2104 USB bridge on the
# EA, a native UART on the ca1 (ttymxc4) and hc800 (ttyS4). The kernel side of
# the USB bridge is this feature's linux.fragment.
#
# Everything the feature runs is a static Rust binary built by packages/build.sh
# from features/zigbee/packages, not a Buildroot package:
#   * zigbee         NCP bring-up: out of the bootloader, onto the bundled
#                    EmberZNet 6.7.8, then holds the port (S91ohczigbee);
#   * zigbee-bridge  github.com/pulzar-net/zigbee-bridge, the Zigbee to MQTT
#                    bridge on that port (S92ohczigbee-bridge, this feature's
#                    overlay). It replaced zigbee2mqtt, and with it Node.js.
# The broker is the box's mosquitto (common_defconfig).

# Kept from the Node.js days: dropping them changes the toolchain, and Buildroot
# quietly drops any other package that needs libstdc++. Remove them once nothing
# on these boards does.
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_INSTALL_LIBSTDCPP=y
