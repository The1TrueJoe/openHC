# openHC busybox additions. The initramfs /init (board/common/rootfs-overlay/init)
# pivots to p1 with switch_root, so that applet must exist — do not rely on the
# upstream default having it on. mount --move and mkdir are also load-bearing there.
CONFIG_SWITCH_ROOT=y
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_FEATURE_MOUNT_LABEL=y
CONFIG_MKDIR=y
CONFIG_UMOUNT=y
CONFIG_SLEEP=y
CONFIG_SEQ=y

# etc/init.d/S02watchdog kicks /dev/watchdog through this applet, and -F (run in
# the foreground) is what lets start-stop-daemon own the pidfile.
CONFIG_WATCHDOG=y

# etc/init.d/S44ntpd keeps the clock right. Without it a box whose RTC has lost
# its time (the HC-800 came up in 2002, a dead CMOS cell) fails every TLS
# handshake — npm, any https fetch — on "certificate not yet valid".
CONFIG_NTPD=y
CONFIG_HWCLOCK=y
