# openHC — settings shared by EVERY board (EA1/EA3 variants, CA1, HC800, IOXv1).
#
# NOT a standalone defconfig. build/build.sh prepends this to the family base
# (ea-common for the EA boards) and the board's own <board>_defconfig, then feeds
# the concatenation to Buildroot. Kconfig takes the LAST assignment of a symbol,
# so a family or board file overrides anything here just by appearing after it.
#
# Put something here only if it is TRUE FOR EVERY openHC board — arch-independent
# userspace, services, the kernel version, the credential. Arch/toolchain-tuning,
# radios, storage, reachability and image type are per-family or per-board.

# --- toolchain: musl everywhere (small, static-friendly) ---
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_OPTIMIZE_S=y

# --- kernel: one mainline stable across the fleet (image type is per-board) ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.1.8"

# --- init / login ---
# Password login on serial + ssh. root's password is "openhc"; board/common/
# post-build.sh adds an `openhc` uid-0 alias so `openhc`/`openhc` is also root.
BR2_TARGET_GENERIC_ROOT_PASSWD="openhc"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y

# --- reachability + identity: SSH and mDNS on every board ---
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y

# --- on-target debugging + GPIO userspace ---
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y


# --- /etc/motd is a FILE, not a build step ---
# It used to be a source-less Buildroot package that shelled out to the host's
# figlet during the build. That put a banner in the build graph and a host tool
# in the dependency list to produce a few hundred static bytes. It is now just
# board/common/rootfs-overlay/etc/motd — a base firmware feature, shipped the
# way every other base firmware feature is shipped.
#
# figlet itself stays in the image, because splash renders the banner ON THE
# DEVICE at boot (S01splash), which is what lets the splash text change without
# rebuilding anything.

# --- common post-build: the openhc uid-0 alias. A board that needs its own
# post-build (ca1's DTB lift) must include this path in its own list, since
# kconfig takes the last assignment, not the union. ---
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_OPENHC_PATH)/common/post-build.sh"

# Ensure switch_root (and the mount/mkdir applets the initramfs /init uses) are
# built into busybox — the pivot to the persistent p1 rootfs depends on them.
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_OPENHC_PATH)/common/busybox-openhc.fragment"
