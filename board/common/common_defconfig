# openHC — settings shared by EVERY board (EA1/EA3 variants, CA1, HC800, IOXv1).
#
# NOT a standalone defconfig. build/build.sh prepends this to the family base
# (ea/common for the EA boards) and the board's own <board>_defconfig, then feeds
# the concatenation to Buildroot. Kconfig takes the LAST assignment of a symbol,
# so a family or board file overrides anything here just by appearing after it.
#
# Put something here only if it is TRUE FOR EVERY openHC board — arch-independent
# userspace, services, the kernel version, the credential. Arch/toolchain-tuning,
# radios, storage, reachability and image type are per-family or per-board.

# --- toolchain: musl everywhere (small, static-friendly) ---
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_OPTIMIZE_S=y

# --- kernel: one mainline stable across the fleet (image type is per-board) ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.1.8"
# The toolchain is built against this kernel's own headers, and Buildroot checks
# the series it was told to expect. 2026.02's newest choice is 6.19; for the
# newest choice the check is "at least" (loose), so 6.19 accepts 7.1. Left
# unset it defaults to "really old" (2.6), which the strict check rejects:
#   Incorrect selection of kernel headers: expected 2.6.x, got 7.1.x
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_19=y

# --- init / login ---
# Password login on serial + ssh. root's password is "openhc"; board/common/
# post-build.sh adds an `openhc` uid-0 alias so `openhc`/`openhc` is also root.
BR2_TARGET_GENERIC_ROOT_PASSWD="openhc"
# eudev, not mdev: udev rules are ADDITIVE files, while busybox mdev has no
# include mechanism and would mean forking Buildroot's /etc/mdev.conf. It also
# fires on hotplug rather than only at boot. See /shared/io-naming/ and
# /etc/udev/rules.d/70-openhc-io.rules.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

# --- reachability + identity: SSH and mDNS on every board ---
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
# The MQTT broker on every board. Each openHC daemon (iod, sysmond, ohc-audiod)
# is a client of it and publishes its own topics under <prefix>/<host>/; Home
# Assistant / Control4 drivers connect to it on 1883, and the web UI over a
# WebSocket listener (libwebsockets) that webd exposes as /mqtt. A real broker
# rather than iod serving MQTT itself: one topic tree from several daemons, and
# bridging to a house broker is mosquitto's own bridge feature. Config:
# board/common/rootfs-overlay/etc/mosquitto/mosquitto.conf.
BR2_PACKAGE_MOSQUITTO=y
BR2_PACKAGE_MOSQUITTO_BROKER=y
BR2_PACKAGE_LIBWEBSOCKETS=y

# D-Bus on every board, so avahi is built one way everywhere and its config can
# simply say enable-dbus=yes. Without it, a D-Bus-less avahi rejects the key
# outright and will not start, while the audio images need D-Bus for
# shairport-sync's avahi-client to register AirPlay — one build, no per-image
# special cases. dbus-daemon is ~1 MB; the tightest image (ioxv1, ~17 MB in a
# 32 MiB NAND slot) has room.
BR2_PACKAGE_DBUS=y

# --- on-target debugging + GPIO userspace ---
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y


# The openhc uid-0 alias. A board needing its own post-build (ca1's DTB lift)
# must include this path in ITS list — kconfig takes the last assignment, not
# the union.
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_OPENHC_PATH)/common/post-build.sh"

# Ensure switch_root (and the mount/mkdir applets the initramfs /init uses) are
# built into busybox — the pivot to the persistent p1 rootfs depends on them.
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_OPENHC_PATH)/common/busybox-openhc.fragment"
