#!/bin/sh
# The on-screen web surface — SHARED across boards (board/common).
#
# The screen shows the splash (S01splash) and nothing else UNLESS an on-screen
# URL is configured. Set one (web UI Settings, or PUT /api/display on webd) and
# this shows that page full screen, restarting it if it exits; clear it and the
# splash comes back. With no URL this does nothing at all, on every board.
#
# The URL lives in /data/ohc/webview.url (one line; webd writes it). $WEBVIEW_URL
# from board.env, if a board sets one, is used when that file is absent.
#
# The display program is per board, picked by what the image has:
#   ea*    webview   (board/ea/common/packages/webview) through the PowerVR
#                    backend, wpebackend-pvr
#   hc800  cog       on its DRM platform, through Mesa i915 (board/hc800/
#                    features/wpe) — straight to KMS, no compositor
# Both take the URL as their one argument.
[ -r /opt/ohc/board.env ] && . /opt/ohc/board.env

URLFILE=/data/ohc/webview.url
RUN=/run/ohc/webview
PIDFILE=/var/run/webview.pid

url() {
	if [ -s "$URLFILE" ]; then
		head -1 "$URLFILE"
	else
		echo "${WEBVIEW_URL:-}"
	fi
}

program() {
	if [ -x /usr/bin/webview ]; then
		echo "/usr/bin/webview"
	elif [ -x /usr/bin/cog ]; then
		echo "/usr/bin/cog --platform=drm"
	fi
}

case "${1:-start}" in
	start)
		U=$(url)
		[ -n "$U" ] || exit 0                     # no URL: the splash stays
		P=$(program)
		[ -n "$P" ] || { echo "webview: an on-screen URL is set but this image has no display program"; exit 0; }
		mkdir -p "$RUN"
		chmod 0700 "$RUN"
		# WebKit wants a HOME for its caches and wpebackend-fdo an
		# XDG_RUNTIME_DIR for its private Wayland socket. The loop restarts the
		# page if the program exits (a crashed web process, a lost modeset).
		start-stop-daemon -S -q -b -m -p "$PIDFILE" -x /bin/sh -- -c "
			export HOME=$RUN XDG_RUNTIME_DIR=$RUN
			while :; do
				$P '$U' 2>&1 | logger -t webview
				sleep 3
			done" && echo "webview: $U"
		;;
	stop)
		[ -f "$PIDFILE" ] && start-stop-daemon -K -q -p "$PIDFILE"
		rm -f "$PIDFILE"
		killall webview cog WPEWebProcess WPENetworkProcess 2>/dev/null
		# Give the screen back to the splash.
		[ -x /etc/init.d/S01splash ] && /etc/init.d/S01splash start >/dev/null 2>&1
		;;
	restart|reload)
		"$0" stop
		sleep 1
		"$0" start
		;;
	*)
		echo "usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
