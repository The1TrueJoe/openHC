#!/bin/sh
# The universal openHC identity layer — mDNS + timezone — on every board. Runs
# after networking (S40net / S40wifi both sit at S40) and after any per-family
# hardware init (e.g. the EA's S49ohc-ea-hw).
case "$1" in
  start) /opt/ohc/bin/ohc boot ;;
  stop)  /opt/ohc/bin/ohc stop ;;
  restart) /opt/ohc/bin/ohc stop; /opt/ohc/bin/ohc boot ;;
  status) /opt/ohc/bin/ohc status ;;
  *) echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
