#!/bin/sh
# Wi-Fi setup-AP + captive portal — SHARED driver logic (board/common).
#
# When the wired uplink has no carrier (unplugged but powered) and the board has
# a Wi-Fi radio, this either:
#   (a) joins a previously-saved home network in station mode, or
#   (b) if none is saved (or the join fails), brings wlan up as an OPEN AP named
#       for the hostname (openhc-<model>-<mac>) and raises a captive portal —
#       ohc-webd redirects :80 to it — so a phone can pick a network
#       and hand us its credentials. Submitting them writes the station config
#       and restarts this script, which then takes path (a).
#
# Boards with no Wi-Fi (OHC_WIFI_IFACE empty, e.g. ea3) skip it entirely. Runs
# after S40net so the uplink's carrier has settled. The per-board CONFIG — the
# hostapd/dnsmasq templates and the iface/addressing — lives in each board's
# overlay; only this driver is shared.
[ -r /opt/ohc/board.env ] && . /opt/ohc/board.env
UPLINK="${OHC_UPLINK_IFACE:-eth0}"
WIFI="${OHC_WIFI_IFACE:-}"
# Three knobs that were hardcoded until the HC-800 turned up and broke all
# three. Defaults reproduce the previous behaviour exactly, so the EA and CA-1
# boards are unaffected by their existence.
#
#   OHC_WIFI_DRIVER      wpa_supplicant backend. nl80211 for a cfg80211 radio;
#                        the HC-800's RTL8192SU is on staging r8712u, which sets
#                        netdev->wireless_handlers and registers NO wiphy, so
#                        nl80211 finds nothing and only -Dwext drives it.
#   OHC_WIFI_MODULE      module to modprobe before the interface can exist.
#                        EMPTY means the driver is builtin and there is nothing
#                        to load — which is the HC-800 case, and asking modprobe
#                        for a builtin returns failure, so this cannot just be
#                        left pointing at ath9k.
#   OHC_WIFI_AP_CAPABLE  0 for a radio that cannot run hostapd. r8712u is a
#                        station-only WEXT driver: no AP mode, and no nl80211
#                        for hostapd to drive even if it had one.
OHC_WIFI_DRIVER="${OHC_WIFI_DRIVER:-nl80211}"
OHC_WIFI_MODULE="${OHC_WIFI_MODULE-ath9k}"
OHC_WIFI_AP_CAPABLE="${OHC_WIFI_AP_CAPABLE:-1}"
AP_ADDR="10.42.0.1"
AP_PORT="8080"                     # the setup portal's own port (webd keeps :80)
STA_CONF="/etc/wpa_supplicant/wpa_supplicant-${WIFI}.conf"
SCAN_CACHE="/tmp/ohc-wifi-scan"    # SSIDs the portal offers, captured at AP start
PORTAL=/opt/ohc/bin/ohc-portal     # the captive-portal web app, run only with the AP
PORTAL_FLAG="/tmp/ohc-ap-portal"   # holds the portal URL; ohc-webd redirects :80 probes here while it exists

have_link() { [ "$(cat /sys/class/net/$1/carrier 2>/dev/null)" = 1 ]; }

# Is ANY wired interface actually on a network?
#
# This replaces a plain carrier test on $UPLINK, which is wrong twice over on a
# board with the BCM53125 switch:
#
#   * the DSA MASTER (eth0) is wired back-to-back to the switch, so its carrier
#     reads 1 whether or not a cable is in either jack. Testing it alone means
#     the AP never comes up on an unplugged unit -- exactly the case the AP
#     exists for.
#   * the real jacks are the DSA slaves (lan1/lan2), which appear only when the
#     switch attaches, so they cannot be hardcoded either.
#
# Carrier on its own is also not connectivity: a cable into a dead switch gives
# carrier and no address. Requiring an IPv4 address as well makes this "we are
# reachable", which is the actual question -- and it is a safe test here because
# S40net has already run and done DHCP by the time S41 starts.
#
# Everything that is not loopback and not the radio counts, so lan1/lan2, eth0
# and eth1 are all covered without naming any of them.
wired_online() {
    for d in /sys/class/net/*; do
        i="${d##*/}"
        case "$i" in
            lo|"$WIFI"|wlan*) continue ;;
        esac
        [ "$(cat "$d/carrier" 2>/dev/null)" = 1 ] || continue
        if ip -4 -o addr show dev "$i" 2>/dev/null | grep -q "inet "; then
            echo "$i"
            return 0
        fi
    done
    return 1
}

# Join a saved home network in station mode. Returns 0 once DHCP grants a lease.
sta_join() {
    [ -s "$STA_CONF" ] || return 1
    ip link set "$WIFI" up
    wpa_supplicant -B -i "$WIFI" -D "$OHC_WIFI_DRIVER" -c "$STA_CONF" >/dev/null 2>&1 || return 1
    i=0
    while [ $i -lt 15 ]; do
        udhcpc -i "$WIFI" -t 3 -T 2 -n >/dev/null 2>&1 && return 0
        sleep 1; i=$((i + 1))
    done
    return 1
}

# Capture nearby SSIDs for the portal (station-mode scan via wpa_cli — the image
# has no `iw`). Best-effort: an empty cache just means the portal shows only the
# manual-entry field.
scan_networks() {
    ip link set "$WIFI" up
    printf 'ctrl_interface=/var/run/wpa_supplicant\n' > /tmp/wpa-scan.conf
    wpa_supplicant -B -i "$WIFI" -D "$OHC_WIFI_DRIVER" -c /tmp/wpa-scan.conf >/dev/null 2>&1 || return 1
    wpa_cli -i "$WIFI" scan >/dev/null 2>&1
    sleep 3
    wpa_cli -i "$WIFI" scan_results 2>/dev/null \
        | awk -F'\t' 'NR>1 && $5 != "" {print $5}' | sort -u > "$SCAN_CACHE"
    wpa_cli -i "$WIFI" terminate >/dev/null 2>&1
    killall wpa_supplicant 2>/dev/null
}

start_ap() {
    # the hostname already carries the per-unit MAC suffix (S09hostname), so it
    # IS the setup-AP SSID — e.g. openhc-ca1-000FFF528265.
    SSID="$(hostname)"
    ip link set "$WIFI" up
    ip addr add "$AP_ADDR/24" dev "$WIFI" 2>/dev/null

    sed -e "s/@IFACE@/$WIFI/" -e "s/@SSID@/$SSID/" \
        /etc/hostapd/hostapd.conf.tmpl > /etc/hostapd/hostapd.conf
    sed -e "s/@IFACE@/$WIFI/" -e "s/@ADDR@/$AP_ADDR/" -e "s/@PORT@/$AP_PORT/" \
        /etc/dnsmasq-ap.conf.tmpl > /etc/dnsmasq-ap.conf

    printf 'Wi-Fi AP: %s ' "$SSID"
    if start-stop-daemon -S -q -b --exec /usr/sbin/hostapd -- -B /etc/hostapd/hostapd.conf \
       && start-stop-daemon -S -q -b --exec /usr/sbin/dnsmasq -- --conf-file=/etc/dnsmasq-ap.conf; then
        # the captive portal is its own app (ohc-portal) on its own port — the
        # dashboard stays put on :80 and just redirects probes here (PORTAL_FLAG).
        [ -x "$PORTAL" ] && start-stop-daemon -S -q -b --exec "$PORTAL" -- "0.0.0.0:$AP_PORT"
        echo "http://$AP_ADDR:$AP_PORT/" > "$PORTAL_FLAG"
        echo "up (open) on $WIFI ($AP_ADDR) — setup portal on :$AP_PORT"
    else
        echo "FAIL"
    fi
}

# Load the radio driver, then wait for its interface to appear.
#
# ath9k/mac80211/cfg80211 are MODULES (see ea-common/linux/wifi.fragment: built
# in, they overrun CEFDK's 7,417,856-byte kernel window and the box does not
# boot). Nothing loads them automatically here -- there is no udev, and mdev
# does not autoload from a PCI modalias -- so the interface simply would not
# exist and this script would report "no radio on this board" on a board that
# has one.
#
# The wait matters: modprobe returns once the module is loaded, but the PCI
# probe and netdev registration finish a moment later, so testing for the
# interface immediately loses the race.
load_radio() {
    [ -d "/sys/class/net/$WIFI" ] && return 0
    # No module named means the driver is builtin; if the interface is still
    # absent at this point it is genuinely absent, and modprobe would only
    # return failure for a builtin and mislead the caller.
    [ -n "$OHC_WIFI_MODULE" ] || return 1
    modprobe "$OHC_WIFI_MODULE" >/dev/null 2>&1 || return 1
    i=0
    while [ $i -lt 20 ]; do
        [ -d "/sys/class/net/$WIFI" ] && return 0
        sleep 1; i=$((i + 1))
    done
    return 1
}

start() {
    [ -n "$WIFI" ] || { echo "Wi-Fi AP: no radio on this board, skipping"; return 0; }
    if ! load_radio; then
        echo "Wi-Fi AP: $WIFI never appeared (module '${OHC_WIFI_MODULE:-builtin}')"
        return 0
    fi
    if on=$(wired_online); then
        echo "Wi-Fi AP: $on is on the network, staying down"
        return 0
    fi
    echo "Wi-Fi AP: no wired interface has an address -- this is what the AP is for"

    if sta_join; then
        echo "Wi-Fi: joined saved network on $WIFI ($(ip -4 -o addr show $WIFI | awk '{print $4}'))"
        return 0
    fi
    # station join failed or no saved network — clean up and offer the setup portal
    killall wpa_supplicant 2>/dev/null
    ip addr flush dev "$WIFI" 2>/dev/null
    if [ "$OHC_WIFI_AP_CAPABLE" != 1 ]; then
        # Say so rather than failing quietly inside start_ap: on a station-only
        # radio the AP is not misconfigured, it is impossible, and the operator
        # needs to know the box is reachable over Ethernet only.
        echo "Wi-Fi: $WIFI is station-only ($OHC_WIFI_DRIVER) — no setup AP on this board."
        echo "Wi-Fi: put credentials in $STA_CONF and re-run this script."
        return 0
    fi
    scan_networks
    start_ap
}

stop() {
    rm -f "$PORTAL_FLAG"   # stop webd redirecting to the portal
    start-stop-daemon -K -q --exec "$PORTAL" 2>/dev/null
    start-stop-daemon -K -q --exec /usr/sbin/dnsmasq 2>/dev/null
    start-stop-daemon -K -q --exec /usr/sbin/hostapd 2>/dev/null
    killall wpa_supplicant 2>/dev/null
    [ -n "$WIFI" ] && { ip addr flush dev "$WIFI" 2>/dev/null; ip link set "$WIFI" down 2>/dev/null; }
}

case "$1" in
    # `|| true` so a board with no splash does not make this script exit 1.
    start) start; { [ -x /etc/init.d/S01splash ] && /etc/init.d/S01splash restart >/dev/null 2>&1; } || true ;;
    stop) stop ;;
    restart) stop; start ;;
    *) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
