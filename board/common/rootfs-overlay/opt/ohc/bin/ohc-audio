#!/bin/sh
# ohc-audio — N Spotify Connect + N AirPlay endpoints, and input routes, mapped
# onto named audio outputs.
#
#   ohc-audio start|stop|restart     (S95ohcaudio calls start/stop)
#   ohc-audio status                 what is configured and what is running
#   ohc-audio set spotify|airplay|routes "<list>"   change one list + restart
#   ohc-audio save "<spotify>" "<airplay>" "<routes>"  all three, one restart (iod)
#
# OUTPUTS AND INPUTS are hardware, so they come from board.env and never from
# the user:
#
#   OHC_AUDIO_OUTPUTS="analog1 analog2 coax hdmi"
#   OHC_AUDIO_OUT_analog1="hw:CARD=Intel,DEV=0|Analog 1 (rear)"   device|label
#   OHC_AUDIO_INPUTS="linein"
#   OHC_AUDIO_IN_linein="hw:CARD=Intel,DEV=0|Line in (rear)"
#
# ENDPOINTS are the user's, "name@output" separated by ';' (names may have
# spaces). board.env carries the defaults; the config file overrides them:
#
#   OHC_SPOTIFY="Living Room@analog1;Patio@analog2"
#   OHC_AIRPLAY="Living Room@analog1;Den@hdmi"
#   OHC_AUDIO_ROUTES="linein@analog2;linein@hdmi"   input@output, plays live
#
# The config file is $OHC_DATA/ohc/audio.conf when a persistent /data exists
# (S08ohcdata), else /etc/ohc/audio.conf — which on a RAM rootfs lasts until
# reboot.
#
# HOW SHARING WORKS. Every output is an ALSA dmix at one fixed rate, so any
# number of endpoints can play into the same jack at once (they mix); every
# input is a dsnoop, so it can feed several outputs. 44100 Hz throughout: Spotify
# and AirPlay are both 44.1 kHz sources, so nothing resamples. Volume is per
# endpoint, in software (librespot's and shairport-sync's own), and the codec's
# hardware levels are left at 0 dB by the board's mixer script.
#
# Each instance runs under /opt/ohc/libexec/ohc-run (restart on exit, output to
# syslog under ohc-spotify-N / ohc-airplay-N / ohc-route-N).
[ -r /opt/ohc/board.env ] && . /opt/ohc/board.env
PATH=/opt/ohc/bin:/usr/bin:/usr/sbin:/bin:/sbin

RUN=/run/ohc/audio
RUNNER=/opt/ohc/libexec/ohc-run
RATE="${OHC_AUDIO_RATE:-44100}"
DATA="${OHC_DATA:-/data}"
if [ -d "$DATA/ohc" ]; then
    CONF="$DATA/ohc/audio.conf"
else
    CONF=/etc/ohc/audio.conf
fi
[ -r "$CONF" ] && . "$CONF"

LIBRESPOT=/usr/bin/librespot
SHAIRPORT=/usr/bin/shairport-sync

die() { echo "ohc-audio: $*" >&2; exit 1; }

# field <"device|label"> <1|2>
field() { echo "$1" | cut -d'|' -f"$2"; }
out_dev()   { eval "field \"\$OHC_AUDIO_OUT_$1\" 1"; }
out_label() { eval "field \"\$OHC_AUDIO_OUT_$1\" 2"; }
in_dev()    { eval "field \"\$OHC_AUDIO_IN_$1\" 1"; }
in_label()  { eval "field \"\$OHC_AUDIO_IN_$1\" 2"; }
is_output() { for o in $OHC_AUDIO_OUTPUTS; do [ "$o" = "$1" ] && return 0; done; return 1; }
is_input()  { for i in $OHC_AUDIO_INPUTS; do [ "$i" = "$1" ] && return 0; done; return 1; }

# each_entry "<a@b;c@d>" fn — fn NAME TARGET INDEX for each entry, blanks
# skipped. Runs in a pipeline subshell; the fns only write files, so that is fine.
each_entry() {
    fn=$2
    echo "$1" | tr ';' '\n' | {
        n=0
        while IFS= read -r e; do
            e=$(echo "$e" | sed 's/^ *//; s/ *$//')
            [ -n "$e" ] || continue
            name=${e%@*} target=${e##*@}
            if [ "$name" = "$e" ]; then
                echo "ohc-audio: '$e' has no @output, skipped" >&2
                continue
            fi
            "$fn" "$name" "$target" "$n"
            n=$((n + 1))
        done
    }
}

# ---- ALSA ------------------------------------------------------------------
write_asound() {
    key=7100
    {
        echo "# Generated by ohc-audio — edit board.env / $CONF, not this file."
        for o in $OHC_AUDIO_OUTPUTS; do
            key=$((key + 1))
            cat <<EOF

# output $o: $(out_label "$o")
pcm.ohc_${o}_dmix {
    type dmix
    ipc_key $key
    ipc_perm 0666
    slave {
        pcm "$(out_dev "$o")"
        rate $RATE
        format S16_LE
        channels 2
        period_size 1024
        buffer_size 8192
    }
}
pcm.ohc_$o {
    type plug
    slave.pcm "ohc_${o}_dmix"
    hint.description "$(out_label "$o")"
}
EOF
        done
        for i in $OHC_AUDIO_INPUTS; do
            key=$((key + 1))
            cat <<EOF

# input $i: $(in_label "$i")
pcm.ohc_in_${i}_dsnoop {
    type dsnoop
    ipc_key $key
    ipc_perm 0666
    slave {
        pcm "$(in_dev "$i")"
        rate $RATE
        format S16_LE
        channels 2
        period_size 1024
        buffer_size 8192
    }
}
pcm.ohc_in_$i {
    type plug
    slave.pcm "ohc_in_${i}_dsnoop"
    hint.description "$(in_label "$i")"
}
EOF
        done
        first=${OHC_AUDIO_OUTPUTS%% *}
        [ -n "$first" ] && printf '\npcm.!default "ohc_%s"\n' "$first"
    } > /etc/asound.conf.new && mv /etc/asound.conf.new /etc/asound.conf
}

# ---- instances ---------------------------------------------------------------
launch() {  # TAG CMD...
    tag=$1; shift
    # -p per instance: without it start-stop-daemon matches on the executable
    # and refuses every launch after the first ("already running").
    start-stop-daemon -S -q -b -p "$RUN/$tag.pid" -x "$RUNNER" -- "$tag" "$RUN/$tag.pid" "$@"
    echo "$tag" >> "$RUN/instances"
}

spotify_one() {  # NAME OUTPUT N
    is_output "$2" || { echo "ohc-audio: spotify '$1': no output '$2'" >&2; return; }
    [ -x "$LIBRESPOT" ] || return
    launch "ohc-spotify-$3" "$LIBRESPOT" --name "$1" --backend alsa --device "ohc_$2" \
        --bitrate 320 --disable-audio-cache --zeroconf-port $((5700 + $3))
    printf '{"kind":"spotify","name":"%s","output":"%s","tag":"ohc-spotify-%s"}\n' \
        "$(json_esc "$1")" "$2" "$3" >> "$RUN/endpoints.jsonl"
}

airplay_one() {  # NAME OUTPUT N
    is_output "$2" || { echo "ohc-audio: airplay '$1': no output '$2'" >&2; return; }
    [ -x "$SHAIRPORT" ] || return
    cfg="$RUN/shairport-$3.conf"
    # Classic AirPlay: each instance hashes its device ID from its name, so N
    # instances on one host are N distinct devices; each needs its own RTSP port
    # and UDP range.
    cat > "$cfg" <<EOF
general = {
    name = "$(echo "$1" | sed 's/"/\\"/g')";
    port = $((5000 + $3));
    udp_port_base = $((6001 + 20 * $3));
    udp_port_range = 20;
    output_backend = "alsa";
    mdns_backend = "avahi";
};
alsa = {
    output_device = "ohc_$2";
};
metadata = {
    enabled = "no";
};
EOF
    launch "ohc-airplay-$3" "$SHAIRPORT" -c "$cfg"
    printf '{"kind":"airplay","name":"%s","output":"%s","tag":"ohc-airplay-%s"}\n' \
        "$(json_esc "$1")" "$2" "$3" >> "$RUN/endpoints.jsonl"
}

route_one() {  # INPUT OUTPUT N
    is_input "$1"  || { echo "ohc-audio: route: no input '$1'" >&2; return; }
    is_output "$2" || { echo "ohc-audio: route: no output '$2'" >&2; return; }
    command -v alsaloop >/dev/null || { echo "ohc-audio: alsaloop missing" >&2; return; }
    launch "ohc-route-$3" alsaloop -C "ohc_in_$1" -P "ohc_$2" -r "$RATE" -c 2 -f S16_LE -t 50000
    printf '{"kind":"route","input":"%s","output":"%s","tag":"ohc-route-%s"}\n' \
        "$1" "$2" "$3" >> "$RUN/endpoints.jsonl"
}

json_esc() { echo "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

write_state() {
    {
        printf '{"config":"%s","rate":%s,"spotify":"%s","airplay":"%s","routes":"%s","outputs":[' \
            "$CONF" "$RATE" "$(json_esc "$OHC_SPOTIFY")" "$(json_esc "$OHC_AIRPLAY")" "$(json_esc "$OHC_AUDIO_ROUTES")"
        sep=
        for o in $OHC_AUDIO_OUTPUTS; do
            printf '%s{"id":"%s","label":"%s","device":"%s","pcm":"ohc_%s"}' \
                "$sep" "$o" "$(json_esc "$(out_label "$o")")" "$(out_dev "$o")" "$o"; sep=,
        done
        printf '],"inputs":['
        sep=
        for i in $OHC_AUDIO_INPUTS; do
            printf '%s{"id":"%s","label":"%s","device":"%s","pcm":"ohc_in_%s"}' \
                "$sep" "$i" "$(json_esc "$(in_label "$i")")" "$(in_dev "$i")" "$i"; sep=,
        done
        printf '],"endpoints":['
        [ -s "$RUN/endpoints.jsonl" ] && tr '\n' ',' < "$RUN/endpoints.jsonl" | sed 's/,$//'
        printf ']}\n'
    } > "$RUN/state.json.new" && mv "$RUN/state.json.new" "$RUN/state.json"
}

do_stop() {
    if [ -f "$RUN/instances" ]; then
        while read -r tag; do
            [ -f "$RUN/$tag.pid" ] && kill "$(cat "$RUN/$tag.pid")" 2>/dev/null
        done < "$RUN/instances"
        sleep 1
    fi
    rm -f "$RUN/instances" "$RUN/endpoints.jsonl" "$RUN"/shairport-*.conf
}

do_start() {
    [ -n "$OHC_AUDIO_OUTPUTS" ] || { echo "ohc-audio: no OHC_AUDIO_OUTPUTS on this board"; return 0; }
    mkdir -p "$RUN" "$(dirname "$CONF")"
    do_stop
    write_asound
    : > "$RUN/endpoints.jsonl"
    each_entry "$OHC_SPOTIFY" spotify_one
    each_entry "$OHC_AIRPLAY" airplay_one
    each_entry "$OHC_AUDIO_ROUTES" route_one
    # Board helpers that must run alongside (e.g. the HC-800's ADV7513 keeper).
    n=0
    for h in $OHC_AUDIO_HELPERS; do
        [ -x "$h" ] && launch "ohc-audio-helper-$n" "$h"
        n=$((n + 1))
    done
    write_state
    echo "ohc-audio: $(grep -c spotify "$RUN/endpoints.jsonl") spotify, $(grep -c airplay "$RUN/endpoints.jsonl") airplay, $(grep -c route "$RUN/endpoints.jsonl") route(s) on: $OHC_AUDIO_OUTPUTS"
}

do_status() {
    echo "config: $CONF ($( [ -r "$CONF" ] && echo present || echo 'absent: board.env defaults'))"
    echo "outputs:"
    for o in $OHC_AUDIO_OUTPUTS; do printf '  %-8s %-28s %s\n' "$o" "$(out_label "$o")" "$(out_dev "$o")"; done
    echo "inputs:"
    for i in $OHC_AUDIO_INPUTS; do printf '  %-8s %-28s %s\n' "$i" "$(in_label "$i")" "$(in_dev "$i")"; done
    echo "spotify: ${OHC_SPOTIFY:-(none)}"
    echo "airplay: ${OHC_AIRPLAY:-(none)}"
    echo "routes:  ${OHC_AUDIO_ROUTES:-(none)}"
    echo "running:"
    if [ -f "$RUN/instances" ]; then
        while read -r tag; do
            pid=$(cat "$RUN/$tag.pid" 2>/dev/null)
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then st=up; else st=DOWN; fi
            printf '  %-22s %s\n' "$tag" "$st"
        done < "$RUN/instances"
    fi
}

# The config file is SOURCED by this script, so a value must never carry shell
# syntax: no $ ` \ " or newline. Names with spaces, apostrophes, & etc. are fine.
safe() {
    case "$1" in
        *'$'*|*'`'*|*'\'*|*'"'*) return 1 ;;
    esac
    [ "$(printf '%s' "$1" | wc -l)" -eq 0 ]
}

save_var() {  # VAR VALUE — replace VAR's line in the config file
    safe "$2" || die "refusing $1: a value may not contain \$ \` \\ \" or a newline"
    mkdir -p "$(dirname "$CONF")"
    touch "$CONF"
    grep -v "^$1=" "$CONF" > "$CONF.new"
    printf '%s="%s"\n' "$1" "$2" >> "$CONF.new"
    mv "$CONF.new" "$CONF"
}

do_set() {  # spotify|airplay|routes "<list>"
    case "$1" in
        spotify) var=OHC_SPOTIFY ;;
        airplay) var=OHC_AIRPLAY ;;
        routes)  var=OHC_AUDIO_ROUTES ;;
        *) die "set what? spotify|airplay|routes" ;;
    esac
    save_var "$var" "$2"
    sync
    echo "ohc-audio: $var saved to $CONF"
    exec "$0" restart
}

do_save() {  # "<spotify>" "<airplay>" "<routes>"
    for v in "$1" "$2" "$3"; do
        safe "$v" || die "refusing: a value may not contain \$ \` \\ \" or a newline"
    done
    save_var OHC_SPOTIFY "$1"
    save_var OHC_AIRPLAY "$2"
    save_var OHC_AUDIO_ROUTES "$3"
    sync
    echo "ohc-audio: saved to $CONF"
    exec "$0" restart
}

case "${1:-status}" in
    start) do_start ;;
    stop) do_stop; echo "ohc-audio: stopped" ;;
    restart) do_start ;;
    status) do_status ;;
    set) [ $# -eq 3 ] || die 'usage: ohc-audio set spotify|airplay|routes "name@output;..."'; do_set "$2" "$3" ;;
    save) [ $# -eq 4 ] || die 'usage: ohc-audio save "<spotify>" "<airplay>" "<routes>"'; do_save "$2" "$3" "$4" ;;
    *) echo "usage: ohc-audio {start|stop|restart|status|set ...|save ...}"; exit 1 ;;
esac
