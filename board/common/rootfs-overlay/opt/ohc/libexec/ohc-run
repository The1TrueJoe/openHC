#!/bin/sh
# ohc-run TAG PIDFILE CMD [ARGS...] — keep CMD running, its output in syslog.
#
# The supervisor ohc-audio starts each receiver under (start-stop-daemon -b runs
# THIS, detached). CMD is restarted 3 s after it exits, so a librespot that dies
# on a network blip comes back on its own. On TERM/INT the current child is
# killed and the loop exits — which is how ohc-audio stops one instance without
# touching the others (they share binaries, so "killall librespot" is not an
# option).
#
# Output goes to syslog under TAG through a FIFO: busybox ash has no process
# substitution, and piping into logger would leave $! pointing at logger.
tag=$1 pidf=$2
shift 2
dir=/run/ohc/audio
mkdir -p "$dir"
echo $$ > "$pidf"
child=
logp=
cleanup() {
    [ -n "$child" ] && kill "$child" 2>/dev/null
    [ -n "$logp" ] && kill "$logp" 2>/dev/null
    rm -f "$pidf" "$dir/$tag.fifo"
    exit 0
}
trap cleanup TERM INT
while :; do
    fifo="$dir/$tag.fifo"
    rm -f "$fifo"; mkfifo "$fifo"
    logger -t "$tag" < "$fifo" & logp=$!
    "$@" > "$fifo" 2>&1 & child=$!
    wait "$child"
    rc=$?
    child=
    wait "$logp" 2>/dev/null; logp=
    logger -t "$tag" "exited ($rc), restarting in 3 s"
    sleep 3
done
