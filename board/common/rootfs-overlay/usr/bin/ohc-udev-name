#!/bin/sh
# Name one device for /dev/ohc. Called by udev; prints a leaf name, or exits 1
# when this device is not ours.
#
#   ohc-udev-name lirc lirc3     -> ir/out4
#   ohc-udev-name gpio gpiochip1 -> gpiochip
#
# It prints the WHOLE leaf path, so one udev rule and one exec covers a device
# whatever it turns out to be. A helper rather than a match expression because
# the IR label is on the PARENT rc device. Serial ports and radios need none:
# the board's own rules (60-openhc-board.rules) say which tty is which.
kind=$1
dev=$2
[ -n "$dev" ] || exit 1

case "$kind" in
lirc)
    # gpio-ohc-iomcu labels every node it registers. Anything else on the
    # system — a USB IR dongle, an HDMI-CEC adapter — is not ours.
    name=$(sed -n 's/^DEV_NAME=//p' "/sys/class/lirc/$dev/device/uevent" 2>/dev/null)
    case "$name" in
        "openHC IR "*) ;;
        *) exit 1 ;;
    esac
    # "openHC IR out 3" -> out3;  "openHC IR front blaster" -> front-blaster
    slug=$(echo "${name#openHC IR }" | tr "[:upper:] " "[:lower:]-")
    case "$slug" in out-*) slug="out${slug#out-}" ;; esac
    echo "ir/$slug"
    ;;

gpio)
    # The chip carrying the relays and contacts. Its NUMBER moves with probe
    # order; its label does not.
    #
    # Three ways to read the label because only one of them is guaranteed:
    # /sys/class/gpio is the deprecated sysfs ABI and may be compiled out, the
    # bus attribute is not on every kernel, and gpiodetect always works because
    # it asks the chardev itself.
    for f in "/sys/class/gpio/$dev/label" "/sys/bus/gpio/devices/$dev/label"; do
        [ -r "$f" ] && { read -r l < "$f"; [ "$l" = "ohc-iomcu" ] && { echo gpiochip; exit 0; }; exit 1; }
    done
    gpiodetect 2>/dev/null | grep -q "^$dev \[ohc-iomcu\]" || exit 1
    echo gpiochip
    ;;

*)
    exit 1
    ;;
esac
