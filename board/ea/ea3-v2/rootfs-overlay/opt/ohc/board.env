# openHomeController board config — EA3 kernel-up build.
# Sourced by /opt/ohc/bin/ohc and the individual services. Shell assignments only.

OHC_MODEL=3                     # EA3 (1/3/5 across the family)
OHC_ID_IFACE=eth0               # the MAC that names this box (always the wired one)
OHC_MDNS_IFACE="eth0"           # no Wi-Fi on this board — wired only
OHC_TIMEZONE=America/New_York   # host timezone; change with `ohc-tz <Zone>`

# BCM53125 managed-switch port netdevs (DSA). Consumed by the shared
# common/rootfs-overlay/etc/init.d/S40net; empty on a plain single-MAC board.
OHC_DSA_PORTS="lan1 lan2"

# --- the unified IO description every board answers ---------------------------
# OHC_IO_BACKEND says HOW the IO is reached, and it is the only thing ohc-iod
# branches on:
#   mcu   relays/contacts/IR live behind a microcontroller on a serial port,
#         spoken to with the DLE/STX protocol
#   gpio  they are native SoC GPIO lines
#   none  the board has no local IO at all
# Counts are ZERO WHEN ABSENT, and absent means the UI does not draw the panel.
OHC_IO_BACKEND=mcu
OHC_IO_MCU_PART=tm4c1231d5
OHC_IO_MCU_TTY=/dev/ttyS1
# Line discipline number S12iomcu attaches to OHC_IO_MCU_TTY, turning any
# relays and contacts into a standard gpiochip. 29 is N_DEVELOPMENT, the slot
# reserved for out-of-tree disciplines.
OHC_IO_MCU_LDISC=29
OHC_IO_MCU_BAUD=460800
OHC_IR_OUT=6
# COMBO PORTS: 3 of those 6 jacks can be switched to SERIAL instead of IR.
# That is not a coincidence with OHC_IO_UARTS below — they are the same physical
# connectors. A port is IR or serial, never both at once, so iod has to treat
# "how many user UARTs exist" and "how many IR outputs exist" as a shared budget
# rather than two independent counts, and the UI must not offer a port to both.
OHC_IR_COMBO=3
OHC_IR_BLASTER=1                # 7 outputs total
OHC_IR_IN=1
OHC_RELAYS=1
OHC_CONTACTS=1
OHC_IO_UARTS=3
OHC_SERIALS=""

# --- radios ------------------------------------------------------------------
# Every EA board has the EM357 Zigbee NCP behind a CP2104 USB bridge
# (/dev/ttyUSB0), the same path as the ea1-v1/ea1-v2, 115200 8N1. "No Wi-Fi" on
# this board does not mean no Zigbee.
# Not yet watched coming up on this variant: confirm /dev/ttyUSB0 appears and
# S91ohczigbee logs RSTACK on first boot.
OHC_RADIOS="zigbee:ttyUSB0"
OHC_ZIGBEE_TTY=/dev/ttyUSB0
OHC_ZIGBEE_BAUD=115200
# Network radio for Home Assistant / ZHA (EM357 ships on EZSP v4; ohc-zigbee reflashes it to 6.7.8 / EZSP v8 at boot):
# ohc-zigbee relays the port over TCP and S91 advertises _zigbee-coordinator._tcp.
OHC_ZIGBEE_TCP_PORT=6638
OHC_ZIGBEE_RADIO_TYPE=ezsp

# --- hardware return-to-stock button ------------------------------------------
# Holding the front ID button for OHC_RESTORE_BUTTON_HOLD seconds runs
# `ohc-restore stock` (openHC's software return-to-stock). The board DTB leaves
# line 32 (the common EA id_button) unclaimed, so S96 polls it with libgpiod.
# active-low is the EA family default; polarity NOT yet confirmed on EA3 hardware,
# but S96 only arms after one clean released reading, so a wrong line/polarity
# stays inert rather than wiping at boot. EA3 also has the recessed CEFDK recovery
# button; this is the software equivalent. Confirm with:
#   gpioget gpiochip0 32   # expect 1 released, 0 pressed
OHC_RESTORE_BUTTON="gpiochip0 32"
OHC_RESTORE_BUTTON_HOLD=10
OHC_RESTORE_BUTTON_ACTIVE=low
OHC_RESTORE_BUTTON_LED=warn::red

# --- audio: CE5300 I2S1 -> ADAU1451 SigmaDSP -> AK4621 -> analog out ---------
# The same scheme as the HC-800: ohc-audiod runs Spotify Connect and AirPlay
# endpoints onto named outputs, each output's level is a softvol in ALSA, and
# its tone is set from the web UI. The difference is where the tone happens:
# here the DSP does it, so `dsp=` names the profile that describes the DSP's
# knobs (the same file its firmware is built from, see
# board/ea/common/firmware/dsp/adau1451/), and audiod sets them as the card's
# DSP controls instead of putting its software tone stage in front.
#
# It boots silent and stays muted while idle: the DSP's volume starts at 0
# until audiod has restored the saved level and tone, and the DAC unmutes only
# while a stream plays.
#
# The card is "openhcea" (the board DTB's simple-audio-card). Until the CE5300
# I2S's PCM is finished (ce5300_i2s.enable_pcm) it has the DSP controls but no
# playable PCM, so the endpoints below come up and cannot play yet.
OHC_AUDIO_OUTPUTS="analog"
OHC_AUDIO_OUT_analog="hw:CARD=openhcea,DEV=0|Analog|dsp=/usr/share/openhc/dsp/adau1451-ea3.json"
OHC_AUDIO_INPUTS=""
OHC_AUDIO_RATE=48000            # the DSP program's one rate
OHC_SPOTIFY="EA-3@analog"
OHC_AIRPLAY="EA-3@analog"
OHC_AUDIO_ROUTES=""
# The music-library player (mpd over the drives ohc-storaged mounts on /media).
OHC_LIBRARY="EA-3 Library@analog"
