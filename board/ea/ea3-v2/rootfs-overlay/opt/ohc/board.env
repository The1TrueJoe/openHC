# openHomeController board config — EA3 kernel-up build.
# Sourced by /opt/ohc/bin/ohc and the individual services. Shell assignments only.

OHC_MODEL=3                     # EA3 (1/3/5 across the family)
OHC_ID_IFACE=eth0               # the MAC that names this box (always the wired one)
OHC_MDNS_IFACE="eth0"           # no Wi-Fi on this board — wired only
OHC_TIMEZONE=America/New_York   # host timezone; change with `ohc-tz <Zone>`

# BCM53125 managed-switch port netdevs (DSA). Consumed by the shared
# common/rootfs-overlay/etc/init.d/S40net; empty on a plain single-MAC board.
OHC_DSA_PORTS="lan1 lan2"

# --- the unified IO description every board answers ---------------------------
# OHC_IO_BACKEND says HOW the IO is reached, and it is the only thing ohc-iod
# branches on:
#   mcu   relays/contacts/IR live behind a microcontroller on a serial port,
#         spoken to with the DLE/STX protocol
#   gpio  they are native SoC GPIO lines
#   none  the board has no local IO at all
# Counts are ZERO WHEN ABSENT, and absent means the UI does not draw the panel.
OHC_IO_BACKEND=mcu
OHC_IO_MCU_PART=tm4c1231d5
# WHAT sits behind the part — relays, contacts, IR jacks, the front blaster and
# receiver, the MCU-routed serial ports — and its UART and line rate are NOT
# here. They are in this board's device tree (&io_mcu in ea3-v2.dts), the
# kernel binds the part from it at boot, and iod reads the counts back from
# /sys/class/ohc/iomcu. One description, so the two cannot disagree. The combo
# jacks are the MCU-routed UARTs: a jack is IR or serial, never both.
OHC_SERIALS=""

# --- radios ------------------------------------------------------------------
# Every EA board has the EM357 Zigbee NCP behind a CP2104 USB bridge
# (/dev/ttyUSB0), the same path as the ea1-v1/ea1-v2, 115200 8N1. "No Wi-Fi" on
# this board does not mean no Zigbee.
# Not yet watched coming up on this variant: confirm /dev/ttyUSB0 appears and
# S91ohczigbee logs RSTACK on first boot.
OHC_RADIOS="zigbee:ttyUSB0"
OHC_ZIGBEE_TTY=/dev/ttyUSB0
OHC_ZIGBEE_BAUD=115200
# Network radio for Home Assistant / ZHA (EM357 is EZSP v4; z2m can't drive it):
# ohc-zigbee relays the port over TCP and S91 advertises _zigbee-coordinator._tcp.
OHC_ZIGBEE_TCP_PORT=6638
OHC_ZIGBEE_RADIO_TYPE=ezsp

# --- hardware return-to-stock button ------------------------------------------
# Holding the front ID button for OHC_RESTORE_BUTTON_HOLD seconds runs
# `ohc-restore stock` (openHC's software return-to-stock). The board DTB leaves
# line 32 (the common EA id_button) unclaimed, so S96 polls it with libgpiod.
# active-low is the EA family default; polarity NOT yet confirmed on EA3 hardware,
# but S96 only arms after one clean released reading, so a wrong line/polarity
# stays inert rather than wiping at boot. EA3 also has the recessed CEFDK recovery
# button; this is the software equivalent. Confirm with:
#   gpioget gpiochip0 32   # expect 1 released, 0 pressed
OHC_RESTORE_BUTTON="gpiochip0 32"
OHC_RESTORE_BUTTON_HOLD=10
OHC_RESTORE_BUTTON_ACTIVE=low
OHC_RESTORE_BUTTON_LED=warn::red
