# EA3 v2 deltas on board/ea/common/linux/common.fragment. No Wi-Fi; switch, eMMC
# and the rest come from ohc.features.

# pci=realloc,nocrs is required, or the kernel hangs before userspace.
# memmap=exactmap reclaims CEFDK's reserved 1.8 GB. Every entry is load-bearing
# (60K#0x11000 = the ACPI tables) and nothing may go past 0x78000000.
# These numbers are this board's map only. See docs ea/kernel-config.
CONFIG_CMDLINE="console=ttyS0,115200 earlyprintk=serial,ttyS0,115200 pci=realloc,nocrs,routeirq memmap=exactmap memmap=68K@0 memmap=60K#0x11000 memmap=512K@0x20000 memmap=255M@1M memmap=1536M@0x10000000"

CONFIG_BUILTIN_DTB_NAME="ea3-v2"
