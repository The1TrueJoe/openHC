/* Control4 EA-1: what every board revision has. */
#include "ea.dtsi"

/* Four IR jacks; IR 1 and 2 double as serial ports 1 and 2. */
&io_mcu {
	control4,ir-blaster;
	control4,ir-receiver;

	jack@1 {
		reg = <1>;
		label = "IR / Serial 1";
		control4,ir-channel = <0>;
		control4,uart = <0>;
	};
	jack@2 {
		reg = <2>;
		label = "IR / Serial 2";
		control4,ir-channel = <1>;
		control4,uart = <1>;
	};
	jack@3 {
		reg = <3>;
		label = "IR 3";
		control4,ir-channel = <2>;
	};
	jack@4 {
		reg = <4>;
		label = "IR 4";
		control4,ir-channel = <3>;
	};
};
