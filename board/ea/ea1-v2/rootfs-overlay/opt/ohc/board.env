# openHomeController board config — EA1 board revision 2.
# Sourced by /opt/ohc/bin/ohc and the individual services. Shell assignments only.
#
# INHERITED FROM ea1-v1, NOT READ OFF THIS VARIANT. ea1-v2_defconfig records the
# relationship: "close to the ea1-v1 (Wi-Fi, no managed switch) with possible
# BOOT differences". Boot is where the two might part company — whether the
# CEFDK secure-boot fuse is blown here is still open — and boot is not described
# by this file, so copying the v1's IO and networking is a reasonable reading
# rather than a guess.
#
# It is still a reading. Every value below should be confirmed against hardware
# the first time a v2 is on the bench; the IR and UART counts in particular are
# the ones a variant is most likely to change.
#
# Before this file existed the board shipped with NO board.env at all, which is
# not the safer option: every init script then silently fell back to a default
# that is neither written down nor reviewed.

OHC_MODEL=1                     # EA1 (1/3/5 across the family)
OHC_ID_IFACE=eth0               # the MAC that names this box (always the wired one)
OHC_MDNS_IFACE="eth0 wlan0"     # preferred interface order for the mDNS identity
OHC_TIMEZONE=America/New_York   # host timezone; change with `ohc-tz <Zone>`

# --- IO: the TM4C behind ttyS1, same as every EA ------------------------------
# See board/ea/ea1-v1/rootfs-overlay/opt/ohc/board.env for what each key means;
# the comments are not repeated here so the two cannot drift apart in wording
# while agreeing in value.
OHC_IO_BACKEND=mcu
OHC_IO_MCU_PART=tm4c1231d5
# WHAT sits behind the part — relays, contacts, IR jacks, the front blaster and
# receiver, the MCU-routed serial ports — and its UART and line rate are NOT
# here. They are in this board's device tree (&io_mcu in ea1-v2.dts), the
# kernel binds the part from it at boot, and iod reads the counts back from
# /sys/class/ohc/iomcu. One description, so the two cannot disagree. The combo
# jacks are the MCU-routed UARTs: a jack is IR or serial, never both.
OHC_SERIALS=""

# --- radios ------------------------------------------------------------------
# Same Zigbee path as ea1-v1: an EM357 behind a CP2104 USB bridge (/dev/ttyUSB0),
# held reset on gpio29 (hogged high=released by the board DTB at boot), 115200 8N1.
# Every EA board has this radio, including the ea1-v2-poe (it drops Wi-Fi, not Zigbee).
OHC_RADIOS="zigbee:ttyUSB0"
OHC_ZIGBEE_TTY=/dev/ttyUSB0
OHC_ZIGBEE_BAUD=115200
# Network radio for Home Assistant / ZHA (EM357 ships on EZSP v4; ohc-zigbee reflashes it to 6.7.8 / EZSP v8 at boot):
# ohc-zigbee relays the port over TCP and S91 advertises _zigbee-coordinator._tcp.
OHC_ZIGBEE_TCP_PORT=6638
OHC_ZIGBEE_RADIO_TYPE=ezsp

# --- hardware return-to-stock button ------------------------------------------
# Holding the front ID button for OHC_RESTORE_BUTTON_HOLD seconds and releasing
# it runs `ohc-restore stock` (openHC's software return-to-stock). The button is
# a gpio-keys-polled node in the board DTB (ea.dtsi: line, polarity, debounce),
# so S96 watches /dev/ohc/input/id-button; nothing here names a line.
# The native CEFDK button recovery does NOT rewrite mtd0 on a fuse-blown EA1, so
# this is the dependable path. Only a press the watcher saw start and end
# counts, so a stuck button stays inert rather than wiping at boot.
OHC_RESTORE_BUTTON_HOLD=10
OHC_RESTORE_BUTTON_LED=warn::red

# --- kexec cmdline extra: RAM reclaim ----------------------------------------
# Same CE5310 as the ea1-v1, where this is PROVEN (176 MB -> 1.7 GB). Appended to
# S00kexec's cmdline. Unverified on THIS variant's hardware — confirm MemTotal on
# first boot; the kexec path is recoverable (power-cycle -> bootstrap kernel).
OHC_KEXEC_CMDLINE_EXTRA="memmap=exactmap memmap=68K@0 memmap=60K#0x11000 memmap=512K@0x20000 memmap=255M@1M memmap=1536M@0x10000000"
