# openHC board config — Control4 EA3 v1: the ea3-v2 plus Wi-Fi. Shell assignments only.
# Key reference and background: site/src/content/docs/ea/board-config.md.

OHC_MODEL=3
OHC_ID_IFACE=eth0
OHC_MDNS_IFACE="eth0 wlan0"
OHC_TIMEZONE=America/New_York   # change with `ohc-tz <Zone>`

# BCM53125 ports (DSA).
OHC_DSA_PORTS="lan1 lan2"

# IO: counts and jacks come from the device tree (&io_mcu in ea3-v1.dts).
OHC_IO_BACKEND=mcu
OHC_IO_MCU_PART=tm4c1231d5
OHC_SERIALS=""

# Zigbee: EM357 behind the CP2104 USB bridge, 115200 8N1. Not yet seen up on this board.
OHC_RADIOS="zigbee:ttyUSB0"
OHC_ZIGBEE_TTY=/dev/ttyUSB0
OHC_ZIGBEE_BAUD=115200
OHC_ZIGBEE_TCP_PORT=6638
OHC_ZIGBEE_RADIO_TYPE=ezsp
OHC_ZIGBEE_STOCK_ARCHIVE=/dev/mmcblk0p2:/recfs.tar.xz

# ID button held this long runs `restore stock`. Active-low NOT yet confirmed on an EA3.
OHC_RESTORE_BUTTON_HOLD=10
OHC_RESTORE_BUTTON_LED=warn::red

# Audio: DSP analog out (tone set on the DSP via dsp=), HDMI, the CE5300's S/PDIF on the coax jacks. 48 kHz is the DSP program's rate.
OHC_AUDIO_OUTPUTS="analog hdmi coax"
OHC_AUDIO_OUT_analog="hw:CARD=openhcea,DEV=0|Analog|dsp=/usr/share/openhc/dsp/adau1451-ea3-openhc.json|format=S32_LE"
OHC_AUDIO_OUT_hdmi="hw:CARD=HDMI,DEV=0|HDMI|format=S32_LE"
OHC_AUDIO_OUT_coax="hw:CARD=openhcea,DEV=1|Coax|format=S32_LE"
OHC_AUDIO_INPUTS="coaxin"
OHC_AUDIO_IN_coaxin="hw:CARD=openhcea,DEV=2|Coax in|format=S32_LE"
OHC_AUDIO_RATE=48000
OHC_SPOTIFY="EA-3@analog"
OHC_AIRPLAY="EA-3@analog"
OHC_AUDIO_ROUTES=""
OHC_LIBRARY="EA-3 Library@analog"
