# openHomeController board config — EA3 board revision 1.
# Sourced by /opt/ohc/bin/ohc and the individual services. Shell assignments only.
#
# THE ea3-v2's CONFIG PLUS THE RADIO IT DROPPED. ea3-v1_defconfig states the
# relationship outright: "Same board as the ea3-v2 (CE5300, BCM53125 switch,
# PoE) EXCEPT it still has the Wi-Fi radio the v2 dropped." So the only line
# that differs from its sibling is OHC_MDNS_IFACE.
#
# UNVERIFIED ON HARDWARE. The open question on this variant is secure boot, not
# IO: the v2's CEFDK fuse is blown and the v1's may be clear. That does not
# change anything in this file, but it does change how the board is installed —
# netboot it first, which writes nothing.

OHC_MODEL=3                     # EA3 (1/3/5 across the family)
OHC_ID_IFACE=eth0               # the MAC that names this box (always the wired one)
OHC_MDNS_IFACE="eth0 wlan0"     # the radio the v2 does not have
OHC_TIMEZONE=America/New_York   # host timezone; change with `ohc-tz <Zone>`

# BCM53125 managed-switch port netdevs (DSA). Consumed by the shared
# common/rootfs-overlay/etc/init.d/S40net; empty on a plain single-MAC board.
OHC_DSA_PORTS="lan1 lan2"

# --- IO: identical to the ea3-v2 ----------------------------------------------
OHC_IO_BACKEND=mcu
OHC_IO_MCU_PART=tm4c1231d5
OHC_IO_MCU_TTY=/dev/ttyS1
OHC_IO_MCU_LDISC=29
OHC_IO_MCU_BAUD=460800
OHC_IR_OUT=6
OHC_IR_COMBO=3                  # rear jacks; IR or serial, never both at once
OHC_IR_BLASTER=1                # 7 outputs total
OHC_IR_IN=1
OHC_RELAYS=1
OHC_CONTACTS=1
OHC_IO_UARTS=3                  # MCU-routed, not host ttys
OHC_SERIALS=""
