# EA3 v1 deltas. Wi-Fi + eMMC come from the shared feature fragments; the
# BCM53125 switch is handled as on the ea3-v2 (see that fragment for DSA status).
# pci=routeirq enables the CE5300 UART interrupt link (LUAR/GSI 38) for the IO-MCU
# on ttyS1 — see board/ea/common/linux/common.fragment.
#
# RAM reclaim: the same memmap as the ea3-v2 (see that fragment for the map and
# the 0x78000000 stop line). Without it the v1 boots with CEFDK's ~200 MB, which
# is too little to unpack the 166 MB RAM rootfs ("Initramfs unpacking failed:
# write error", seen on a netboot) and leaves the box starved once installed.
# PROVEN on v1 hardware: a v1 EA3 has run the ea3-v2 image, with exactly this
# line, durably (1.7 GB).
CONFIG_CMDLINE="console=ttyS0,115200 earlyprintk=serial,ttyS0,115200 pci=realloc,nocrs,routeirq memmap=exactmap memmap=68K@0 memmap=60K#0x11000 memmap=512K@0x20000 memmap=255M@1M memmap=1536M@0x10000000"

# Board device tree: board/ea/ea3-v1/ea3-v1.dts (see common.fragment).
CONFIG_BUILTIN_DTB_NAME="ea3-v1"
