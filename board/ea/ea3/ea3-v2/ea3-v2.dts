// SPDX-License-Identifier: GPL-2.0
/* Control4 EA-3 v2. Includes mirror ohc.features. */
/dts-v1/;

#include "ea3.dtsi"
#include "ea-gpio-names.dtsi"

/ {
	model = "Control4 EA-3 v2";
	compatible = "control4,ea3-v2", "intel,ce5300";
	/* What the board-ID straps read here (stock /proc/c4board). */
	control4,board-type = <2>;
	control4,board-revisions = <9>;
};

/*
 * The fan is not on the PWM: ldo_enable (GPIO 43) switches its regulator and
 * an AD5246 sets its speed (stock c4faultd's AD5246 path). See docs ea/fan.
 * Same node label as ea.dtsi's pwm-fan, so its cooling maps carry over.
 */
/delete-node/ &fan;

&gpio {
	/delete-node/ ldo-enable-hog;
};

&i2c0 {
	/* Variant not read off the part: only IIO's scale depends on it. */
	fan_speed: potentiometer@2e {
		compatible = "adi,ad5246-010";
		reg = <0x2e>;
		vdd-supply = <&fan_pot_vdd>;
		#io-channel-cells = <0>;
	};
};

/ {
	/* The pot's always-on board rail; its voltage isn't measured. */
	fan_pot_vdd: regulator-fan-pot-vdd {
		compatible = "regulator-fixed";
		regulator-name = "fan_pot_vdd";
		regulator-always-on;
	};

	fan_ldo: regulator-fan {
		compatible = "regulator-fixed";
		regulator-name = "fan";
		gpios = <&gpio 43 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	fan: fan {
		compatible = "io-channel-fan";
		label = "Fan";
		io-channels = <&fan_speed>;
		fan-supply = <&fan_ldo>;
		/* off, then 20% (lowest that starts from a stop) to 100% in even steps */
		cooling-levels = <0 51 80 109 138 168 197 226 255>;
		#cooling-cells = <2>;
	};
};
