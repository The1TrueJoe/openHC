# openHC — eMMC storage kernel side, shared by EA variants that run from eMMC
# instead of a RAM initramfs.
#
# The SD controller is PCI 8086:070b (class 0x0805); mainline sdhci-pci binds it
# generically via its PCI_DEVICE_CLASS(SYSTEM_SDHCI) entry — no out-of-tree driver
# needed, despite what the top-level README long assumed.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_EXT4_FS=y
