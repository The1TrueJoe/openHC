# openHC — Wi-Fi userspace, shared by every EA variant that HAS a radio
# (ea1-v1, ea1-v2, ea3-v1). Concatenated by build/build.sh when the board's
# ohc.features list contains "wifi". The ath9k kernel side is in
# ea-common/features/wifi/linux.fragment.
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_IW=y
