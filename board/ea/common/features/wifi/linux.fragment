# Wi-Fi: AR9485, mainline ath9k. Modules, not optional: built in (~1 MB) the
# kernel overruns the copy window and does not boot. See docs ea/kernel-config.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH_COMMON=m
CONFIG_ATH9K=m
CONFIG_ATH9K_PCI=y

# WPA crypto built in: a missing one fails as an unexplained association failure.
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_ARC4=y
