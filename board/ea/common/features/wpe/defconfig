# wpe: the on-screen UI, proprietary half of 3D. See docs: ea/board-config.

# DDK EGL + GLES2, fetched at build. Must be the driver's DDK version; it refuses a mismatch.
BR2_PACKAGE_SGX545_UM=y

# WPE WebKit (its wpebackend-fdo and Wayland deps are unused).
BR2_PACKAGE_WPEWEBKIT=y

# libwpe backend that reaches the display.
BR2_PACKAGE_WPEBACKEND_PVR=y

# The surface that puts a page on screen (WebKit has no MiniBrowser).
BR2_PACKAGE_WEBVIEW=y
