# CE5300: give Linux the framebuffer CEFDK leaves running.
# common.fragment turns graphics off wholesale, so this MUST go AFTER it in
# BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES for these to win. Cost ~150K of bzImage.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_SYS_FILLRECT=y
CONFIG_FB_SYS_COPYAREA=y
CONFIG_FB_SYS_IMAGEBLIT=y
CONFIG_FB_SYSMEM_HELPERS=y
# No fbcon: the splash is drawn straight onto /dev/fb0 and the console stays on
# ttyS0 — a text console clears the framebuffer on takeover (it ate the first splash).
# CONFIG_FRAMEBUFFER_CONSOLE is not set
