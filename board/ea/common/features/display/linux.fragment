# simplefb on the framebuffer CEFDK leaves running. Must merge after common.fragment.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_SYS_FILLRECT=y
CONFIG_FB_SYS_COPYAREA=y
CONFIG_FB_SYS_IMAGEBLIT=y
CONFIG_FB_SYSMEM_HELPERS=y
# No fbcon: it clears the framebuffer on takeover and erases the splash.
# CONFIG_FRAMEBUFFER_CONSOLE is not set
