# audio: ALSA userspace, Avahi and Spotify Connect. Kernel half: linux.fragment.
# AirPlay 2 comes from board/common/features/audio; D-Bus from board/common.

BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_LIB_PCM=y
BR2_PACKAGE_ALSA_LIB_MIXER=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y

# There is no BR2_PACKAGE_SHAIRPORT_SYNC_ALSA; kconfig would drop it silently.

# Full mDNS responder for AirPlay.
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
BR2_PACKAGE_AVAHI_LIBDNSSD_COMPATIBILITY=y

# Spotify Connect (packages/librespot).
BR2_PACKAGE_LIBRESPOT=y
