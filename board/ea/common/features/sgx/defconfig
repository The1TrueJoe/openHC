# PowerVR SGX545 3D — kernel driver for the CE5300's GPU (PCI 01:02.0, 8086:089b),
# ported from Intel's Cedarview GPL DDK 1.7. Kernel half gives /dev/dri/card0;
# GLES2 also needs the userspace blobs below.
BR2_PACKAGE_SGX545_CE=y
# Userspace: EGL + GLES2 from the DDK. Must be the SAME DDK version as the driver
# — the driver checks on connect and refuses a mismatch.
BR2_PACKAGE_SGX545_UM=y

# WPE WebKit: browser engine rendering through EGL/GLES with no X/window system.
# Needs board/buildroot-patches/0001-wpewebkit-do-not-require-wpebackend-fdo.patch
# — Buildroot wires WPE to the Wayland backend, which this DDK cannot provide.
BR2_PACKAGE_WPEWEBKIT=y

# ...the libwpe backend it loads at runtime to reach the display (stock is Wayland).
BR2_PACKAGE_WPEBACKEND_PVR=y

# ...and the surface that puts a page on screen (WebKit built ENABLE_MINIBROWSER=OFF).
BR2_PACKAGE_WEBVIEW=y
