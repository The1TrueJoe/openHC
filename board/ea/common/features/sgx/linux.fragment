# PowerVR SGX545 (sgx545ce; mirrors board/ea/common/sgx545-ce/kernel's fragment).
# Must merge after common.fragment, which turns DRM off.
# merge_config scrapes assignments even inside comments: write symbols without "=".

# Userspace reaches the GPU through a DRM node. Modules: DRM core is ~1.25 MiB.
CONFIG_DRM=m
CONFIG_SGX545_CE=m

# Write-combining for the SGX command buffers (uncached without it: much slower).
CONFIG_X86_PAT=y
CONFIG_MTRR=y

# sgxregs reads the SGX BAR through /dev/mem.
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set

# DRM drivers for hardware this board lacks (keeps them off the rootfs).
# CONFIG_DRM_I915 is not set
# CONFIG_DRM_VIRTIO_GPU is not set
# CONFIG_DRM_TTM is not set
# CONFIG_DRM_GEM_SHMEM_HELPER is not set
# CONFIG_DRM_BUDDY is not set
# CONFIG_DRM_PANEL_ORIENTATION_QUIRKS is not set
# CONFIG_INTEL_GTT is not set
# CONFIG_AGP is not set
