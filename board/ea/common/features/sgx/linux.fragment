# PowerVR SGX545: powervr_sgx (the powervr_sgx submodule's drm/powervr_sgx).
# Must merge after common.fragment, which turns DRM off. The fat kernel builds
# both in (real-kernel.fragment).
# merge_config scrapes assignments even inside comments: write symbols without "=".

# Render-only DRM driver (/dev/dri/renderD128). Modules: DRM core is ~1.25 MiB.
CONFIG_DRM=m
CONFIG_DRM_POWERVR_SGX=m

# Write-combining for the GPU's buffers (uncached without it: much slower).
CONFIG_X86_PAT=y
CONFIG_MTRR=y

# Register reads with devmem when debugging the GPU.
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set

# DRM drivers for hardware this board lacks (keeps them off the rootfs).
# CONFIG_DRM_I915 is not set
# CONFIG_DRM_VIRTIO_GPU is not set
# CONFIG_DRM_TTM is not set
# CONFIG_DRM_BUDDY is not set
# CONFIG_DRM_PANEL_ORIENTATION_QUIRKS is not set
# CONFIG_INTEL_GTT is not set
# CONFIG_AGP is not set
