# Kernel options for the PowerVR SGX545 driver (packages/sgx545-ce). Mirrors that
# repo's own linux.fragment.
#
# NOTE ON COMMENTS IN THIS FILE: Buildroot's merge_config.sh scrapes any line that
# looks like a kconfig assignment, including inside prose. Do not write a symbol
# name followed by "=" or by "is not set" in a sentence — it lands in the merge
# diagnostics as a redefinition. Refer to symbols without the assignment, as below.
#
# Ordering: the common fragment disables DRM, so this MUST come after it (build.sh
# appends feature fragments after the board file — which is why this is a feature).

# Userspace finds the GPU through libdrm's drmOpen(), so a DRM node must exist.
# The driver registers no modesetting and owns no GEM objects; display stays on
# ce5300-fb. Built as a module (CONFIG_MODULES in common.fragment) because the
# DRM core + helpers it drags in cost ~1.25 MiB of bzImage; that weight lands in
# the rootfs instead. (The helpers are not trimmable here — DRM_KMS_HELPER /
# DRM_DISPLAY_HELPER have no prompt and disabling them in a fragment is ignored.)
CONFIG_DRM=m

# PAT gives real write-combining for the SGX command buffers. Without it the
# driver falls back to uncached: correct, markedly slower.
CONFIG_X86_PAT=y
CONFIG_MTRR=y

# sgxregs reads the SGX identity registers through /dev/mem before any driver is
# loaded; strict devmem would block exactly the BAR range it looks at.
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set

# Turn off the DRM drivers CONFIG_DRM drags in for hardware this board lacks.
# Costs nothing in bzImage (modules either way); just stops the rootfs carrying
# drivers that can never bind (i915 alone is 2.6 MB). DRM core/helpers stay —
# pvrsrvkm needs them.
# CONFIG_DRM_I915 is not set
# CONFIG_DRM_VIRTIO_GPU is not set
# CONFIG_DRM_TTM is not set
# CONFIG_DRM_GEM_SHMEM_HELPER is not set
# CONFIG_DRM_BUDDY is not set
# CONFIG_DRM_PANEL_ORIENTATION_QUIRKS is not set
# CONFIG_INTEL_GTT is not set
# CONFIG_AGP is not set
