# storage, EA kernel half: the shared fragment as modules (copy window).
# ext4 stays built in for the emmc feature.
CONFIG_SCSI=m
CONFIG_BLK_DEV_SD=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_VFAT_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_HFSPLUS_FS=m
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_ISO8859_1=m
CONFIG_NLS_UTF8=m
CONFIG_SMB_SERVER=m

# Built-ins those menus bring back from the defconfig (~450 KB); unused.
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_9P_FS is not set
# CONFIG_MSDOS_FS is not set
# CONFIG_BLK_DEV_SR is not set
# CONFIG_SCSI_LOWLEVEL is not set
# CONFIG_SCSI_SPI_ATTRS is not set
