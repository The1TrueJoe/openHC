# BCM53125 switch (DSA/b53 over SPI). See docs ea/kernel-config and ea/switch.
# COMMON_CLK is required: SPI_PXA2XX_PCI is derived from it. Do not remove.
CONFIG_COMMON_CLK=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_PXA2XX=y

# Modules (copy window); S39ea-switch loads them before S40net. The symbols are
# B53 / B53_SPI_DRIVER: the NET_DSA_B53 names do not exist.
CONFIG_NET_DSA=m
CONFIG_B53=m
CONFIG_B53_SPI_DRIVER=m
CONFIG_NET_DSA_TAG_BRCM=m
CONFIG_NET_DSA_TAG_BRCM_PREPEND=m
CONFIG_BRIDGE=m
CONFIG_VLAN_8021Q=m
# Compiled into bridge.ko; switchd's VLAN programming needs it.
CONFIG_BRIDGE_VLAN_FILTERING=y
