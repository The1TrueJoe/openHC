[
  {"call": "CreateNewProject", "args": ["openhc-ea3"], "allow-fail": true},
  ["GetAvailableCanvas"],
  ["GetAllShapes"],
  {"call": "AddShapeV2", "args": ["diagram", "ADAU1451", [0, 0]], "as": "dsp"},
  {"call": "AddShapeV2", "args": ["diagram", "AnalogDevices.Plugins.Controllers.PC_v1.0.0.0", [0, 0]], "as": "pc"},
  {"call": "AddShapeV2", "args": ["diagram", "AnalogDevices.Plugins.Communication.USBi_v1.0.0.0", [0, 0]], "as": "usbi"},
  {"call": "GetPinCollections", "args": ["${dsp}"], "allow-fail": true},
  {"call": "GetPinCollections", "args": ["${usbi}"], "allow-fail": true},
  {"call": "AddConnectionV2", "args": ["${pc}", "USB", "${usbi}", "USB"], "allow-fail": true},
  {"call": "AddConnectionV2", "args": ["${usbi}", "SPI", "${dsp}", "SPI"], "allow-fail": true},
  ["GetAvailableCanvas"],
  ["GetAllShapes"],
  {"call": "AddShapeV2", "args": ["schematic_0", "AnalogDevices.Plugins.Algorithms.IO.Sigma300.Sample.Input0to15_v1.0.0.0", [0, 0]], "as": "in"},
  {"call": "AddShapeV2", "args": ["schematic_0", "AnalogDevices.Plugins.Algorithms.Sigma300.Output_v1.0.0.0", [0, 0]], "as": "outl"},
  {"call": "AddShapeV2", "args": ["schematic_0", "AnalogDevices.Plugins.Algorithms.Sigma300.Output_v1.0.0.0", [0, 0]], "as": "outr"},
  {"call": "GetPinCollections", "args": ["${in}"], "allow-fail": true},
  {"call": "GetPinCollections", "args": ["${outl}"], "allow-fail": true},
  {"call": "GetPluginProperties", "args": ["${outr}"], "allow-fail": true},
  {"call": "AddConnectionV2", "args": ["${in}", "Ch0_out", "${outl}", "Input"], "allow-fail": true},
  {"call": "AddConnectionV2", "args": ["${in}", "Ch1_out", "${outr}", "Input"], "allow-fail": true},
  {"call": "UpdatePropertiesV2", "args": ["${outr}", "SelectedOPChannel", "Ch1"], "allow-fail": true},
  ["SaveProject", "${env:DSP_OUT}\\openhc-ea3.ssprj"],
  ["LinkCompileConnect"],
  ["Export", "openhc-ea3", "${env:DSP_OUT}\\export"],
  {"call": "GetOutputViewEntries", "allow-fail": true}
]
