config DRM_CE5300
	tristate "Intel Atom CE5300 display controller (VDC + HDMI)"
	depends on DRM && PCI && X86 && OF && I2C
	select APERTURE_HELPERS
	select DRM_BRIDGE
	select DRM_BRIDGE_CONNECTOR
	select DRM_CLIENT_SELECTION
	select DRM_DISPLAY_HELPER
	select DRM_GEM_DMA_HELPER
	select DRM_KMS_HELPER
	select IOSF_MBI
	help
	  KMS driver for the display controller of the Intel Atom CE5300
	  media SoC (PCI 8086:2e61) and its HDMI transmitter (PCI 8086:2e63),
	  a DRM bridge whose audio is a child device for the ALSA driver.
	  It takes over the mode the firmware set up.
