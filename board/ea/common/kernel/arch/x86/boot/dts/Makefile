# Control4 EA-series board trees. Mirrored into the kernel by
# OHC_KERNEL_MIRROR_HOOK; each board's linux fragment picks one with
# CONFIG_BUILTIN_DTB_NAME and patches/linux/0015 links it into vmlinux. All of
# them are compiled on every EA build, so a broken tree fails CI for any board.
dtb-y += ea1-v1.dtb ea1-v2.dtb ea1-v2-poe.dtb ea3-v1.dtb ea3-v2.dtb
