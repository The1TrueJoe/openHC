/*
 * EA-3 audio (`audio-dsp`): CE5300 I2S -> ADAU1451 at i2c3 0x38 -> AK4621.
 * See board/ea/common/firmware/dsp/adau1451/README.md.
 */
#include "ea-adau1451.dtsi"

#define EA_LINE_10	"audio_sense0"
#define EA_LINE_61	"dac_mute"

&audio {
	#sound-dai-cells = <0>;
};

&i2c3 {
	dsp: audio-codec@38 {
		compatible = "adi,adau1451";
		reg = <0x38>;
		#sound-dai-cells = <0>;
		mute-gpios = <&gpio 61 GPIO_ACTIVE_HIGH>;
		firmware-name = "openhc/adau1451-ea3-openhc.bin";
		control4,program-version = <0x0dfd 2>;
	};
};

/ {
	sound {
		compatible = "simple-audio-card";
		/* ALSA card id "openhcea" */
		simple-audio-card,name = "openhc-ea";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&dsp_dai>;
		simple-audio-card,frame-master = <&dsp_dai>;

		simple-audio-card,cpu {
			sound-dai = <&audio>;
		};
		dsp_dai: simple-audio-card,codec {
			sound-dai = <&dsp>;
		};
	};
};
