/* Control4 EA-3 (both board revisions). */
#include "ea.dtsi"

#define EA_LINE_80	"ac_pwr"

/* Six IR jacks; IR 1-3 double as serial ports 1-3. */
&io_mcu {
	control4,relays = <1>;
	control4,contacts = <1>;
	control4,ir-blaster;
	control4,ir-receiver;

	jack@1 {
		reg = <1>;
		label = "IR / Serial 1";
		control4,ir-channel = <0>;
		control4,uart = <0>;
	};
	jack@2 {
		reg = <2>;
		label = "IR / Serial 2";
		control4,ir-channel = <1>;
		control4,uart = <1>;
	};
	jack@3 {
		reg = <3>;
		label = "IR / Serial 3";
		control4,ir-channel = <2>;
		control4,uart = <2>;
	};
	jack@4 {
		reg = <4>;
		label = "IR 4";
		control4,ir-channel = <3>;
	};
	jack@5 {
		reg = <5>;
		label = "IR 5";
		control4,ir-channel = <4>;
	};
	jack@6 {
		reg = <6>;
		label = "IR 6";
		control4,ir-channel = <5>;
	};
};
