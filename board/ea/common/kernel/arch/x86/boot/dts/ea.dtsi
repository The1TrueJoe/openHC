// SPDX-License-Identifier: GPL-2.0
/*
 * What every Control4 EA board shares: front-panel LEDs, the ID button, the
 * reset/enable lines stock firmware releases at boot, the heatsink sensor, and
 * the framebuffer CEFDK leaves scanning out. Boards add their own differences
 * on top.
 */
#include <dt-bindings/input/input.h>
#include "ce5300.dtsi"

/ {
	chosen {
		/*
		 * CEFDK leaves the VDC pipe running 720x480 out of a fixed buffer in
		 * an e820-reserved window; simplefb takes it over as /dev/fb0.
		 * Values read off the VDC on an EA-3 (upp_c surface 0x7fc00000,
		 * stride 0xb80 = 736 px * 4). Size = stride * height.
		 */
		framebuffer@7fc00000 {
			compatible = "simple-framebuffer";
			reg = <0x7fc00000 (2944 * 480)>;
			width = <720>;
			height = <480>;
			stride = <2944>;
			format = "a8r8g8b8";
		};
	};

	/*
	 * Recovered verbatim from the stock kernel's gpio_led[] (num_leds = 6);
	 * the two 4-ball LEDs are active low. The names are ABI: iod and
	 * OHC_RESTORE_BUTTON_LED address them under /sys/class/leds.
	 */
	leds {
		compatible = "gpio-leds";

		led-network {
			label = "c4::network";
			gpios = <&gpio 15 GPIO_ACTIVE_HIGH>;
		};
		led-warn-red {
			label = "warn::red";
			gpios = <&gpio 99 GPIO_ACTIVE_HIGH>;
		};
		led-warn-yellow {
			label = "warn::yellow";
			gpios = <&gpio 16 GPIO_ACTIVE_HIGH>;
		};
		led-warn-blue {
			label = "warn::blue";
			gpios = <&gpio 100 GPIO_ACTIVE_HIGH>;
		};
		led-4ball-red {
			label = "c4::4ball_red";
			gpios = <&gpio 102 GPIO_ACTIVE_LOW>;
		};
		led-4ball-blue {
			label = "c4::4ball_blue";
			gpios = <&gpio 34 GPIO_ACTIVE_LOW>;
		};
	};

	/*
	 * The front ID button: active low (released reads 1, pressed 0,
	 * verified on an EA1), and the trigger for ohc-restore-button's
	 * long-press return-to-stock. Polled, as on stock (gpio-keys-polled,
	 * 40 ms poll, 20 ms debounce, from the stock kernel's tables), because
	 * gpio-intelce has no interrupts. The input device's name is ABI: udev
	 * links it as /dev/ohc/input/id-button (70-openhc-io.rules). Stock
	 * sent KEY_F5; KEY_RESTART is the usual code for a reset button, and
	 * a browser on the display does not read it as "reload".
	 */
	id-button {
		compatible = "gpio-keys-polled";
		label = "id-button";
		poll-interval = <40>;

		button-id {
			label = "id_button";
			gpios = <&gpio 32 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <20>;
		};
	};
};

/*
 * Boot-time states from stock /etc/init.d/c4_gpio_config, setup_gpio_common(),
 * for the lines EVERY EA board uses. Lines that belong to one feature (the
 * switch, the DSP, Wi-Fi) or one board (EA3) live in that feature's or board's
 * .dtsi, so a board without the hardware never drives them. A line no file
 * hogs keeps whatever CEFDK left it at.
 *
 * These have to be driven from the kernel, not an init script: by the time
 * userspace runs, everything the kernel probes at boot has already missed its
 * device (measured on an EA3: gpio26 usb_2_serial_reset was an output driven
 * LOW, holding the USB-serial bridge down). Outputs are hogged high (released
 * from reset / enabled). Names for all of them are assembled in
 * ea-gpio-names.dtsi, which every board includes last.
 */
&gpio {
	/* IO microcontroller (relays, contacts, IR) */
	io-reset-hog {
		gpio-hog;
		gpios = <7 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "io_reset";
	};
	/* CP2104 USB-serial bridge in front of the EM357 Zigbee radio */
	usb-2-serial-reset-hog {
		gpio-hog;
		gpios = <26 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "usb_2_serial_reset";
	};
	/* EM357: released, so it runs its application from power-on */
	zigbee-reset-hog {
		gpio-hog;
		gpios = <29 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "zigbee_reset";
	};
	ldo-enable-hog {
		gpio-hog;
		gpios = <43 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "ldo_enable";
	};
	n-fpga-reload-hog {
		gpio-hog;
		gpios = <57 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "n_fpga_reload";
	};
	/*
	 * Power block shared by the EA1 and EA3: stock setup_gpio_ea1() and
	 * setup_gpio_ea3() both drive these two high (setup_gpio_ea3() adds
	 * only ac_pwr, in ea3.dtsi), and c4_board_name() is "ea1" for the PoE
	 * board too. poe_type (54) and twelve_volt_ok (122) are the inputs of
	 * the same block: named, not hogged.
	 */
	n-twelve-volt-current-limit-hog {
		gpio-hog;
		gpios = <75 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "n_twelve_volt_current_limit";
	};
	n-usb-current-limit-hog {
		gpio-hog;
		gpios = <121 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "n_usb_current_limit";
	};
};

/*
 * Rear USB port power: a load switch on gpio44 (EHCI 01:0d.1). NOT in the stock
 * script: the stock kernel's closed c4overcurrent driver drives it, registered
 * by ninjago_board_init() on every board type with platform data
 * { gpio_oc = 97, gpio_pwr = 44 }. Its probe drives 44 low, waits, then high;
 * on a falling edge of 97 (the load switch's active-low fault flag) it cuts 44
 * for 2500 jiffies and powers it back up. Measured on an EA3 (PR #51):
 * the bootloader leaves 44 low and the port sees nothing (PORTSC SE0, no
 * connect); high, a USB stick enumerates as high-speed; low again, it
 * disconnects. "usb_rear_power" and "usb_rear_oc" are ours; the vendor names
 * are only the driver's gpio_pwr/gpio_oc. Nothing in openHC acts on the fault
 * line yet: it is named so it can be watched.
 *
 * Not a hog: a fixed regulator that is the controller's vbus-supply (patch
 * 0016), so it follows root-hub port power and usbcore's port control cuts the
 * port's 5 V --
 *   echo 1 > /sys/bus/usb/devices/<roothub>-0:1.0/<roothub>-port1/disable
 * or uhubctl. Needs the regulator core, which only the fat kernel carries
 * (linux/real-kernel.fragment); the size-limited bootstrap kernel has none,
 * so on it the rear port stays unpowered -- it only has to reach p1 and kexec.
 */
/ {
	usb_rear_vbus: regulator-usb-rear-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_rear_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpios = <&gpio 44 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};
};

&usb_rear {
	vbus-supply = <&usb_rear_vbus>;
};

/* Heatsink sensor: the thermal zone below reads it through its hwmon. */
&i2c0 {
	heatsink_temp: temperature-sensor@48 {
		compatible = "national,lm75";
		reg = <0x48>;
		label = "Heatsink";	/* hwmon `label`: what the Health panel calls it */
		#thermal-sensor-cells = <0>;
	};
};

/*
 * THE FAN, AND THE CURVE THAT DRIVES IT. This replaces the shell daemon
 * ohc-fand: the kernel's pwm-fan is the cooling device, the thermal zone reads
 * the LM75 and the step_wise governor moves the fan between cooling-levels.
 *
 * The fan is a plain DC fan whose SUPPLY the PWM switches (no PWM input of its
 * own) on pwm-ce5300 channel 2. At 25 kHz its driver chip browns out below ~70%
 * duty and the motor stalls, chirping as it retries; at 100 kHz (period 10 us)
 * the supply is smooth enough for it to run clean at 30%. Below that it grinds,
 * and at ~206 Hz it never starts at all. Heard on an EA1, 2026-10-25 (PR #70).
 * So 30% (77/255) is the lowest level that is not off. From a standstill, 25%
 * already started clean at 100 kHz, so the floor needs no start kick; if a fan
 * ever needs one, it is pwm-fan's fan-stop-to-start-percent/-us.
 *
 * The curve is ohc-fand's, which was the stock [ea_fan] profile with a 30%
 * floor: on at 50 C, then +10% per degree, so 100% from 57 C. One active trip
 * per level, each mapped to exactly that level; step_wise takes the highest
 * level whose trip is reached. Each trip has 1 C of hysteresis so a 0.5 C
 * LM75 reading cannot flap it; a tree cannot say "hold for 60 s", so on the
 * first trip that same band does the job of ohc-fand's cool-down hold at the
 * floor (on at 50 C, off below 49 C).
 *
 * Until the zone takes over, pwm-fan holds the fan at its top level (its probe
 * sets the maximum), so a sensor that never binds leaves the fan at 100%.
 *
 * MANUAL CONTROL (the web UI, via sysmond) switches this zone's policy to
 * user_space and writes the fan's hwmon pwm1; "auto" switches it back to
 * step_wise. Manual cannot outlast the hot trip: at 80 C (ohc-fand's CRITICAL)
 * sysmond hands the fan back to the curve, which is at 100% by then. There is
 * deliberately no critical trip: ohc-fand never powered the box off, and where
 * 80 C on a heatsink sensor stands against the CE5300's real limit is unmeasured.
 */
/ {
	fan: pwm-fan {
		compatible = "pwm-fan";
		label = "Fan";		/* hwmon `label`, as above */
		pwms = <&pwm 2 10000 0>;
		/* off, then 30% to 100% in tens: one level per trip below */
		cooling-levels = <0 77 102 128 153 179 204 230 255>;
		#cooling-cells = <2>;
	};

	thermal-zones {
		heatsink-thermal {
			polling-delay = <5000>;
			polling-delay-passive = <0>;
			thermal-sensors = <&heatsink_temp>;

			trips {
				fan_on: fan-on {
					temperature = <50000>;
					hysteresis = <1000>;
					type = "active";
				};
				fan_40: fan-40 {
					temperature = <51000>;
					hysteresis = <1000>;
					type = "active";
				};
				fan_50: fan-50 {
					temperature = <52000>;
					hysteresis = <1000>;
					type = "active";
				};
				fan_60: fan-60 {
					temperature = <53000>;
					hysteresis = <1000>;
					type = "active";
				};
				fan_70: fan-70 {
					temperature = <54000>;
					hysteresis = <1000>;
					type = "active";
				};
				fan_80: fan-80 {
					temperature = <55000>;
					hysteresis = <1000>;
					type = "active";
				};
				fan_90: fan-90 {
					temperature = <56000>;
					hysteresis = <1000>;
					type = "active";
				};
				fan_full: fan-full {
					temperature = <57000>;
					hysteresis = <1000>;
					type = "active";
				};
				/* Ends a manual hold (sysmond); no kernel action. */
				heatsink-hot {
					temperature = <80000>;
					hysteresis = <0>;
					type = "hot";
				};
			};

			cooling-maps {
				map-30 {
					trip = <&fan_on>;
					cooling-device = <&fan 1 1>;
				};
				map-40 {
					trip = <&fan_40>;
					cooling-device = <&fan 2 2>;
				};
				map-50 {
					trip = <&fan_50>;
					cooling-device = <&fan 3 3>;
				};
				map-60 {
					trip = <&fan_60>;
					cooling-device = <&fan 4 4>;
				};
				map-70 {
					trip = <&fan_70>;
					cooling-device = <&fan 5 5>;
				};
				map-80 {
					trip = <&fan_80>;
					cooling-device = <&fan 6 6>;
				};
				map-90 {
					trip = <&fan_90>;
					cooling-device = <&fan 7 7>;
				};
				map-100 {
					trip = <&fan_full>;
					cooling-device = <&fan 8 8>;
				};
			};
		};
	};
};

/*
 * The IO microcontroller (TI Tiva TM4C1231D5) on uart1, the legacy 0x2F8 port.
 * A serdev child, so gpio-ohc-iomcu binds it at boot and owns the port: it runs
 * the TI bootloader bring-up itself and there is no ttyS1 left for userspace to
 * attach to. 460800 is the EA family's rate, not the HC-800's 115200. What sits
 * behind the part differs by board, so each board's .dts sets the counts on
 * &io_mcu; a count it leaves out is zero.
 */
&uart1 {
	io_mcu: io-mcu {
		compatible = "control4,io-mcu";
		current-speed = <460800>;
	};
};
