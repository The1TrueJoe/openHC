/*
 * What every Control4 EA board shares. Boards add their differences on top.
 * See site/src/content/docs/ea/device-tree.md.
 */
#include <dt-bindings/input/input.h>
#include "ce5300.dtsi"

/ {
	chosen {
		/* The 720x480 buffer CEFDK leaves scanning out; size = stride * height */
		framebuffer@7fc00000 {
			compatible = "simple-framebuffer";
			reg = <0x7fc00000 (2944 * 480)>;
			width = <720>;
			height = <480>;
			stride = <2944>;
			format = "a8r8g8b8";
		};
	};

	/* Front-panel LEDs. Names are ABI: iod and the restore button use them. */
	leds {
		compatible = "gpio-leds";

		led-network {
			label = "c4::network";
			gpios = <&gpio 15 GPIO_ACTIVE_HIGH>;
		};
		led-warn-red {
			label = "warn::red";
			gpios = <&gpio 99 GPIO_ACTIVE_HIGH>;
		};
		led-warn-yellow {
			label = "warn::yellow";
			gpios = <&gpio 16 GPIO_ACTIVE_HIGH>;
		};
		led-warn-blue {
			label = "warn::blue";
			gpios = <&gpio 100 GPIO_ACTIVE_HIGH>;
		};
		led-4ball-red {
			label = "c4::4ball_red";
			gpios = <&gpio 102 GPIO_ACTIVE_LOW>;
		};
		led-4ball-blue {
			label = "c4::4ball_blue";
			gpios = <&gpio 34 GPIO_ACTIVE_LOW>;
		};
	};

	/*
	 * Front ID button, active low; polled (gpio-intelce has no IRQs). Its name
	 * is ABI: udev links it as /dev/ohc/input/id-button.
	 */
	id-button {
		compatible = "gpio-keys-polled";
		label = "id-button";
		poll-interval = <40>;

		button-id {
			label = "id_button";
			gpios = <&gpio 32 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <20>;
		};
	};
};

/*
 * Lines every EA board releases at boot (stock c4_gpio_config); driven from the
 * kernel so devices probe out of reset. Feature lines live with the feature.
 */
&gpio {
	/* IO microcontroller (relays, contacts, IR) */
	io-reset-hog {
		gpio-hog;
		gpios = <7 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "io_reset";
	};
	/* CP2104 USB-serial bridge in front of the EM357 Zigbee radio */
	usb-2-serial-reset-hog {
		gpio-hog;
		gpios = <26 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "usb_2_serial_reset";
	};
	/* EM357: released, so it runs its application from power-on */
	zigbee-reset-hog {
		gpio-hog;
		gpios = <29 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "zigbee_reset";
	};
	ldo-enable-hog {
		gpio-hog;
		gpios = <43 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "ldo_enable";
	};
	n-fpga-reload-hog {
		gpio-hog;
		gpios = <57 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "n_fpga_reload";
	};
	/* EA1/EA3 power block */
	n-twelve-volt-current-limit-hog {
		gpio-hog;
		gpios = <75 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "n_twelve_volt_current_limit";
	};
	n-usb-current-limit-hog {
		gpio-hog;
		gpios = <121 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "n_usb_current_limit";
	};
};

/*
 * Rear USB port 5 V: a load switch on gpio44. A regulator, not a hog, so
 * usbcore port power can cut it. Fat kernel only (needs the regulator core).
 */
/ {
	usb_rear_vbus: regulator-usb-rear-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_rear_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpios = <&gpio 44 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};
};

&usb_rear {
	vbus-supply = <&usb_rear_vbus>;
};

/* Heatsink sensor: the thermal zone below reads it through its hwmon. */
&i2c0 {
	heatsink_temp: temperature-sensor@48 {
		compatible = "national,lm75";
		reg = <0x48>;
		label = "Heatsink";	/* hwmon `label`: what the Health panel calls it */
		#thermal-sensor-cells = <0>;
	};
};

/*
 * Fan (pwm-fan) and the heatsink thermal zone that drives it.
 * See site/src/content/docs/ea/fan.md.
 */
/ {
	fan: pwm-fan {
		compatible = "pwm-fan";
		label = "Fan";		/* hwmon `label`, as above */
		pwms = <&pwm 2 10000 0>;
		/* off, then 30% to 100% in tens: one level per trip below */
		cooling-levels = <0 77 102 128 153 179 204 230 255>;
		#cooling-cells = <2>;
	};

	thermal-zones {
		heatsink-thermal {
			polling-delay = <5000>;
			polling-delay-passive = <0>;
			thermal-sensors = <&heatsink_temp>;

			trips {
				fan_on: fan-on {
					temperature = <50000>;
					hysteresis = <1000>;
					type = "active";
				};
				fan_40: fan-40 {
					temperature = <51000>;
					hysteresis = <1000>;
					type = "active";
				};
				fan_50: fan-50 {
					temperature = <52000>;
					hysteresis = <1000>;
					type = "active";
				};
				fan_60: fan-60 {
					temperature = <53000>;
					hysteresis = <1000>;
					type = "active";
				};
				fan_70: fan-70 {
					temperature = <54000>;
					hysteresis = <1000>;
					type = "active";
				};
				fan_80: fan-80 {
					temperature = <55000>;
					hysteresis = <1000>;
					type = "active";
				};
				fan_90: fan-90 {
					temperature = <56000>;
					hysteresis = <1000>;
					type = "active";
				};
				fan_full: fan-full {
					temperature = <57000>;
					hysteresis = <1000>;
					type = "active";
				};
				/* Ends a manual hold (sysmond); no kernel action. */
				heatsink-hot {
					temperature = <80000>;
					hysteresis = <0>;
					type = "hot";
				};
				/* Cooling has failed: orderly poweroff. *//* Cooling has failed: power off (see above for 95 C). */
				heatsink-crit {
					temperature = <95000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-30 {
					trip = <&fan_on>;
					cooling-device = <&fan 1 1>;
				};
				map-40 {
					trip = <&fan_40>;
					cooling-device = <&fan 2 2>;
				};
				map-50 {
					trip = <&fan_50>;
					cooling-device = <&fan 3 3>;
				};
				map-60 {
					trip = <&fan_60>;
					cooling-device = <&fan 4 4>;
				};
				map-70 {
					trip = <&fan_70>;
					cooling-device = <&fan 5 5>;
				};
				map-80 {
					trip = <&fan_80>;
					cooling-device = <&fan 6 6>;
				};
				map-90 {
					trip = <&fan_90>;
					cooling-device = <&fan 7 7>;
				};
				map-100 {
					trip = <&fan_full>;
					cooling-device = <&fan 8 8>;
				};
			};
		};
	};
};

/* IO microcontroller on uart1; each model .dtsi adds its jacks. */
&uart1 {
	io_mcu: io-mcu {
		compatible = "control4,io-mcu";
		current-speed = <460800>;
		#address-cells = <1>;
		#size-cells = <0>;
	};
};
