/*
 * gpio-line-names for the CE5300's 128 lines. Include LAST from every board
 * .dts.
 *
 * It is one property, so it cannot be split across files the way the hogs
 * are. Lines every board has are named here; a line that belongs to a feature
 * or a board is EA_LINE_<n>, which that feature's/board's .dtsi defines
 * alongside its hog. A board without the feature leaves the line unnamed --
 * the name says the hardware is there. Names are the stock c4_gpio_config's.
 *
 * Inputs (board-id straps, the ID button) are named but never hogged, so
 * gpioget/gpiofind can read them; 32 (id_button) must stay free for
 * ohc-restore-button. 23 (src_reset) stays unnamed and untouched, as in stock.
 */
#ifndef EA_LINE_5
#define EA_LINE_5 ""
#endif
#ifndef EA_LINE_8
#define EA_LINE_8 ""
#endif
#ifndef EA_LINE_24
#define EA_LINE_24 ""
#endif
#ifndef EA_LINE_27
#define EA_LINE_27 ""
#endif
#ifndef EA_LINE_44
#define EA_LINE_44 ""
#endif
#ifndef EA_LINE_54
#define EA_LINE_54 ""
#endif
#ifndef EA_LINE_75
#define EA_LINE_75 ""
#endif
#ifndef EA_LINE_80
#define EA_LINE_80 ""
#endif
#ifndef EA_LINE_101
#define EA_LINE_101 ""
#endif
#ifndef EA_LINE_121
#define EA_LINE_121 ""
#endif
#ifndef EA_LINE_122
#define EA_LINE_122 ""
#endif

&gpio {
	gpio-line-names =
		/*   0 */ "", "", "", "", "", EA_LINE_5, "", "io_reset",
		/*   8 */ EA_LINE_8, "", "", "", "", "", "", "",
		/*  16 */ "", "board_id0", "board_id1", "board_id2", "board_id3", "board_id4", "board_id5", "",
		/*  24 */ EA_LINE_24, "", "usb_2_serial_reset", EA_LINE_27, "", "zigbee_reset", "", "",
		/*  32 */ "id_button", "", "", "", "", "", "", "",
		/*  40 */ "", "", "", "ldo_enable", EA_LINE_44, "", "", "",
		/*  48 */ "", "", "", "", "", "", EA_LINE_54, "",
		/*  56 */ "", "n_fpga_reload", "", "", "", "", "", "",
		/*  64 */ "", "", "", "", "", "", "", "",
		/*  72 */ "", "", "", EA_LINE_75, "", "", "", "",
		/*  80 */ EA_LINE_80, "", "", "", "", "", "", "",
		/*  88 */ "", "", "", "", "", "", "", "",
		/*  96 */ "", "", "", "", "", EA_LINE_101, "", "",
		/* 104 */ "", "", "", "", "", "", "", "",
		/* 112 */ "", "", "", "", "", "", "", "",
		/* 120 */ "", EA_LINE_121, EA_LINE_122, "", "", "", "", "";
};
