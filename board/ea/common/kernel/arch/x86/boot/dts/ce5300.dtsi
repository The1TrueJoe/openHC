// SPDX-License-Identifier: GPL-2.0
/*
 * Intel Atom CE5300 (CE5310): the SoC functions openHC describes in a device
 * tree. ACPI still owns the platform -- CPUs, interrupts, PCI routing --
 * because arch/x86/kernel/devicetree.c only takes those from a tree when ACPI
 * is disabled. The tree exists to hang board devices off PCI functions.
 *
 * MATCHING. A PCI device gets a node when one sits under its bus's node with
 * reg = <devfn>: pcibios_get_phb_of_node() finds the root bus by device_type +
 * bus-range, pci_set_of_node() finds each device by the devfn in reg[0]
 * (bits 15:8; the bus bits above are informational). No compatible on these
 * nodes on purpose: the PCI ids already bind the drivers, and a compatible on
 * the root node would make of_platform_default_populate() create a stray
 * platform device for it.
 *
 * Layout follows arch/x86/platform/ce4100/falconfalls.dts, which the CE5300
 * keeps for the functions used here (audio 01:06.2, GPIO 01:0b.1, I2C 01:0b.2,
 * SPI 01:0b.4, GbE 01:0c.0 -- all measured on EA boards).
 */
#include <dt-bindings/gpio/gpio.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;

	aliases {
		/* Fix the adapter numbers: i2c-pxa takes them from these when it
		 * probes from DT, and userspace (lm75 on i2c-0) and the audio
		 * machine driver ("adau1451.3-0038") name buses by number. */
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		/* Line numbers the console relies on; they also match the legacy
		 * slots these ports take over. uart1 hosts the IO microcontroller
		 * as a serdev device (ea.dtsi), so it has no ttyS1 of its own. */
		serial0 = &uart0;
		serial1 = &uart1;
		serial3 = &uart3;
	};

	chosen {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
	};

	/*
	 * The SoC's three GEN3 UARTs, on legacy I/O ports. They are an XScale/PXA
	 * block ("GEN3_serial" in Control4's kernel), clocked at 14.7456 MHz, and
	 * they run TIMER-POLLED: stock's routed IRQ (GSI 38) registers but never
	 * fires under openHC (measured), so there is deliberately no `interrupts`
	 * -- 8250_of then gives the port irq 0 and serial8250 services it from a
	 * timer (TX via patch 0010). The fixed XScale type replaces patch 0006's
	 * probe override; the clock replaces the legacy table's 1.8432 MHz for
	 * these ports. 8250 matches each node to the legacy slot at the same
	 * address, so ttyS numbers do not move. 0x3E8 is the 8051 power PIC, a
	 * real 8250, and stays a plain legacy port.
	 *
	 * The node is named "isa" because that is what OF address translation keys
	 * on for I/O space (of_bus_isa_match); simple-bus so the default populate
	 * creates the ports. uart1 (0x2F8) carries the IO microcontroller.
	 */
	isa {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <1>;
		ranges = <1 0 0 0x10000>;

		uart0: serial@1,3f8 {
			compatible = "intel,xscale-uart";
			reg = <1 0x3f8 8>;
			clock-frequency = <14745600>;
		};

		uart1: serial@1,2f8 {
			compatible = "intel,xscale-uart";
			reg = <1 0x2f8 8>;
			clock-frequency = <14745600>;
		};

		uart3: serial@1,2e8 {
			compatible = "intel,xscale-uart";
			reg = <1 0x2e8 8>;
			clock-frequency = <14745600>;
		};
	};

	pci@80000000 {
		#address-cells = <3>;
		#size-cells = <2>;
		device_type = "pci";
		bus-range = <0 0>;
		/* 32-bit memory space, identity-mapped. Informational: ACPI assigns
		 * the windows and nothing translates through these nodes. */
		ranges = <0x02000000 0 0x80000000 0x80000000 0 0x80000000>;

		/* The A/V bridge (8086:0700) to bus 1, at 00:01.0 as on falconfalls.
		 * Measured on an EA3 (lspci -tvnn), as is every devfn below. */
		pci@1,0 {
			#address-cells = <3>;
			#size-cells = <2>;
			device_type = "pci";
			bus-range = <1 1>;
			reg = <0x0800 0 0 0 0>;
			ranges;

			/* ce5300-i2s (8086:2e60) */
			audio: multimedia@6,2 {
				reg = <0x13200 0 0 0 0>;
			};

			/* UART1's PCI face (8086:2e66, MMIO). The same block is the
			 * legacy 0x2F8 port the IO microcontroller is wired to, and
			 * binding this function (8250_pci's CE4100 entry) switches it to
			 * PCI decode, killing 0x2F8: tx counts, the MCU never hears it.
			 * Disabled, pci_bus_add_device() never lets a driver bind it --
			 * this replaces patch 0011. */
			serial@b,0 {
				reg = <0x15800 0 0 0 0>;
				status = "disabled";
			};

			/* gpio-intelce (8086:2e67): 4 banks x 32, base 0 */
			gpio: gpio@b,1 {
				reg = <0x15900 0 0 0 0>;
				gpio-controller;
				#gpio-cells = <2>;
			};

			/* i2c-pxa-pci (8086:2e68): one adapter per BAR. The CE5300 has
			 * four; the fourth (BAR3, 0xdffe0e00) carries the audio codec.
			 * Children are matched by BAR index -- patches/linux/0001. */
			i2c@b,2 {
				reg = <0x15a00 0 0 0 0>;
				#address-cells = <1>;
				#size-cells = <0>;

				i2c0: i2c@0 {
					compatible = "intel,ce4100-i2c";
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
				};

				i2c1: i2c@1 {
					compatible = "intel,ce4100-i2c";
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;
				};

				i2c2: i2c@2 {
					compatible = "intel,ce4100-i2c";
					reg = <2>;
					#address-cells = <1>;
					#size-cells = <0>;
				};

				i2c3: i2c@3 {
					compatible = "intel,ce4100-i2c";
					reg = <3>;
					#address-cells = <1>;
					#size-cells = <0>;
				};
			};

			/* spi-pxa2xx-pci (8086:2e6a, CE5X00_SSP via patch 0009). The
			 * controller is the PCI device itself, so its children here are
			 * the SPI devices. */
			ssp: spi@b,4 {
				reg = <0x15c00 0 0 0 0>;
				#address-cells = <1>;
				#size-cells = <0>;
			};

			/* e1000 (8086:2e6e), fake-PHY mode via patch 0003. Labelled so
			 * a DSA CPU port can point at it as its conduit. */
			gbe: ethernet@c,0 {
				reg = <0x16000 0 0 0 0>;
			};

			/* ehci-pci (TDI 192e:0101, patch 0014): the rear USB port.
			 * 01:0d.0 and 01:0d.2 (the Zigbee CP2104) need no node. */
			usb_rear: usb@d,1 {
				reg = <0x16900 0 0 0 0>;
			};
		};
	};
};
