// SPDX-License-Identifier: GPL-2.0
/*
 * Intel Atom CE5300 (CE5310) SoC functions. ACPI still owns the platform; this
 * tree hangs board devices off PCI functions, matched by devfn in reg.
 * See site/src/content/docs/ea/device-tree.md.
 */
#include <dt-bindings/gpio/gpio.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;

	aliases {
		/* Bus numbers are ABI: userspace and the audio driver name them. */
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		/* ttyS numbers the console relies on. */
		serial0 = &uart0;
		serial1 = &uart1;
		serial3 = &uart3;
	};

	chosen {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
	};

	/*
	 * GEN3 UARTs on legacy I/O ports. Timer-polled: no `interrupts` on purpose.
	 * The node name "isa" is what OF I/O-space translation keys on.
	 */
	isa {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <1>;
		ranges = <1 0 0 0x10000>;

		uart0: serial@1,3f8 {
			compatible = "intel,xscale-uart";
			reg = <1 0x3f8 8>;
			clock-frequency = <14745600>;
		};

		uart1: serial@1,2f8 {
			compatible = "intel,xscale-uart";
			reg = <1 0x2f8 8>;
			clock-frequency = <14745600>;
		};

		uart3: serial@1,2e8 {
			compatible = "intel,xscale-uart";
			reg = <1 0x2e8 8>;
			clock-frequency = <14745600>;
		};
	};

	pci@80000000 {
		#address-cells = <3>;
		#size-cells = <2>;
		device_type = "pci";
		bus-range = <0 0>;
		/* Informational: ACPI assigns the windows. */
		ranges = <0x02000000 0 0x80000000 0x80000000 0 0x80000000>;

		/* A/V bridge (8086:0700) to bus 1 */
		pci@1,0 {
			#address-cells = <3>;
			#size-cells = <2>;
			device_type = "pci";
			bus-range = <1 1>;
			reg = <0x0800 0 0 0 0>;
			ranges;

			/* ce5300-i2s (8086:2e60) */
			audio: multimedia@6,2 {
				reg = <0x13200 0 0 0 0>;
			};

			/* UART1's PCI face (8086:2e66). Keep disabled: binding it
			 * kills the legacy 0x2F8 port the IO-MCU is on. */
			serial@b,0 {
				reg = <0x15800 0 0 0 0>;
				status = "disabled";
			};

			/* gpio-intelce (8086:2e67): 4 banks x 32, base 0 */
			gpio: gpio@b,1 {
				reg = <0x15900 0 0 0 0>;
				gpio-controller;
				#gpio-cells = <2>;
			};

			/* i2c-pxa-pci (8086:2e68): one adapter per BAR, children
			 * matched by BAR index (patch 0001). */
			i2c@b,2 {
				reg = <0x15a00 0 0 0 0>;
				#address-cells = <1>;
				#size-cells = <0>;

				i2c0: i2c@0 {
					compatible = "intel,ce4100-i2c";
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
				};

				i2c1: i2c@1 {
					compatible = "intel,ce4100-i2c";
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;
				};

				i2c2: i2c@2 {
					compatible = "intel,ce4100-i2c";
					reg = <2>;
					#address-cells = <1>;
					#size-cells = <0>;
				};

				i2c3: i2c@3 {
					compatible = "intel,ce4100-i2c";
					reg = <3>;
					#address-cells = <1>;
					#size-cells = <0>;
				};
			};

			/* spi-pxa2xx-pci (8086:2e6a); children are SPI devices */
			ssp: spi@b,4 {
				reg = <0x15c00 0 0 0 0>;
				#address-cells = <1>;
				#size-cells = <0>;
			};

			/* pwm-ce5300 (8086:089f): <channel period-ns flags> */
			pwm: pwm@b,6 {
				reg = <0x15e00 0 0 0 0>;
				#pwm-cells = <3>;
			};

			/* e1000 (8086:2e6e), fake-PHY; the DSA conduit */
			gbe: ethernet@c,0 {
				reg = <0x16000 0 0 0 0>;
			};

			/* ehci-pci (192e:0101): the rear USB port */
			usb_rear: usb@d,1 {
				reg = <0x16900 0 0 0 0>;
			};

			/* spi-ea-ce5xx (8086:08a0): the boot-flash controller */
			bootflash: spi@17,0 {
				reg = <0x1b800 0 0 0 0>;
				#address-cells = <1>;
				#size-cells = <0>;

				flash@0 {
					compatible = "jedec,spi-nor";
					reg = <0>;
					spi-max-frequency = <16670000>;

					/*
					 * Read-only views; mtd0 stays the whole chip and
					 * all writes go through it.
					 */
					partitions {
						compatible = "fixed-partitions";
						#address-cells = <1>;
						#size-cells = <1>;

						partition@0 {
							label = "cefdk";
							reg = <0x0 0x80000>;
							read-only;
						};
						partition@80000 {
							label = "mfh";
							reg = <0x80000 0x800>;
							read-only;
						};
						partition@80800 {
							label = "mfh-items";
							reg = <0x80800 0xf7f800>;
							read-only;
						};
					};
				};
			};
		};
	};
};
