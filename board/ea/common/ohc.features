# Capabilities every EA-series controller has. A board adds only what makes it
# different (Wi-Fi, a switch, the DSP) in its own ohc.features.
iomcu       # relays/contacts/IR behind the IO microcontroller
splash      # boot splash on the display
display     # the CEFDK framebuffer: simplefb, simpledrm on the fat kernel (/dev/fb0)
sgx         # PowerVR SGX545 GPU: powervr_sgx + its open microkernel
wpe         # the on-screen UI: Mesa sgx + WPE WebKit's DRM platform
emmc        # persistent ext4 rootfs on the eMMC
zigbee      # EM357 NCP on a CP2104 USB bridge (/dev/ttyUSB0); node + cp210x
audio       # ALSA + Spotify Connect + AirPlay userspace
audio-hdmi  # HDMI audio out (ce5300-hdmi-audio), every EA; the EA3 adds its DSP (audio-dsp)
restore     # software return-to-stock: restore edits the MFH over mtd0
storage     # USB drives mounted and shared over SMB (storaged)
usb-input   # USB keyboards, mice and game controllers (hubs too) for the on-screen UI
