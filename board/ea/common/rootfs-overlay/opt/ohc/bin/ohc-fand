#!/bin/sh
# ohc-fand — fan controller for the kernel-up build.
#
# Temp in : the LM75 heatsink sensor on i2c-0 @ 0x48, via the standard hwmon
#           class (drivers/hwmon/lm75). milli-C.
# Fan out : the standard mainline PWM sysfs on our pwm-ce5300 chip. The EA1 fan
#           is channel 2. period/duty_cycle are in ns; enable is 0/1. No vendor
#           "claim" dance — that was a property of the old binary driver.
#
# Curve follows the stock [ea_fan] profile: on_temp 50, 10%/deg, 60s cool-hold,
# 80C critical, and fail-SAFE to 100% if the sensor read ever fails. The minimum
# is 30%, not stock's 10%; the PWM runs at 100 kHz, not 25 kHz; and every start
# from stopped gets a short full-power kick.
#
# WHY 100 kHz: the EA1 fan is a plain DC fan whose SUPPLY is switched, not a
# 4-wire fan with a PWM input. At 25 kHz its own driver chip browns out below
# ~70% duty and the motor stalls, chirping like a buzzer as it retries the start
# (heard on an EA1, 2026-10-25). At 100 kHz the supply is smooth enough that it
# runs cleanly at 30%. Below that it is marginal: 20% grinds, and from a
# standstill it chirps and stalls before it catches, hence the kick.
# Slow PWM is worse still: at ~206 Hz (the block's power-up period) it never
# starts at all, even at 60%.
#
# MANUAL OVERRIDE — the state file.
#   Path     : /run/ohc/fan.override  (OHC_FAN_OVERRIDE)
#   Contents : an integer 0-100  -> hold the fan at THAT percent (manual mode),
#              the word "auto" or no file -> run the temperature curve.
#   Lifetime : /run is tmpfs, so the override is cleared on reboot and the board
#              always comes up in automatic mode. The control loop re-reads this
#              file every iteration, which is why `set` now PERSISTS instead of
#              being quietly overwritten by the next curve pass.
#   Safety   : manual mode still forces 100% on CRITICAL temp or a failed sensor
#              read. Manual does not mean "disable the thermal fail-safe".
#
#   ohc-fand            run the control loop (service backgrounds it)
#   ohc-fand set <pct>  manual override 0-100 (persists until `auto`)
#   ohc-fand off        manual override 0% (persists until `auto`)
#   ohc-fand auto       clear the override, return to the curve
#   ohc-fand status     print "mode:", "pct:" and "override:" for the backend
PATH=/bin:/sbin:/usr/bin:/usr/sbin
[ -f /opt/ohc/board.env ] && . /opt/ohc/board.env

PWMCHIP=${OHC_FAN_PWMCHIP:-/sys/class/pwm/pwmchip0}
PWMCH=${OHC_FAN_PWMCH:-2}
PERIOD_NS=${OHC_FAN_PERIOD_NS:-10000}     # 100 kHz (see WHY above)
ON_TEMP=${OHC_FAN_ON_TEMP:-50}
MIN_PCNT=${OHC_FAN_MIN_PCNT:-30}          # slowest that runs clean
PCNT_PER_DEG=${OHC_FAN_PCNT_PER_DEG:-10}
COOL_HOLD=${OHC_FAN_COOL_HOLD:-60}
CRITICAL=${OHC_FAN_CRITICAL:-80}
INTERVAL=${OHC_FAN_INTERVAL:-15}
OVERRIDE=${OHC_FAN_OVERRIDE:-/run/ohc/fan.override}
KICK_S=${OHC_FAN_KICK_S:-2}               # full power for this long on a start

PWM="$PWMCHIP/pwm$PWMCH"

# Locate the LM75 hwmon (order isn't guaranteed, so match by name).
find_temp() {
  for d in /sys/class/hwmon/hwmon*; do
    [ -r "$d/name" ] || continue
    case "$(cat "$d/name" 2>/dev/null)" in
      lm75) echo "$d/temp1_input"; return 0 ;;
    esac
  done
  # fall back to any temp1_input
  for d in /sys/class/hwmon/hwmon*; do
    [ -r "$d/temp1_input" ] && { echo "$d/temp1_input"; return 0; }
  done
  return 1
}

pwm_setup() {
  [ -d "$PWM" ] || echo "$PWMCH" > "$PWMCHIP/export" 2>/dev/null
  [ -d "$PWM" ] || return 1
  # Only touch the period when it differs. sysfs refuses a period shorter than
  # the current duty, so drop the duty first.
  [ "$(cat "$PWM/period" 2>/dev/null)" = "$PERIOD_NS" ] && return 0
  echo 0 > "$PWM/duty_cycle" 2>/dev/null
  echo "$PERIOD_NS" > "$PWM/period" 2>/dev/null
}

set_pct() {                                # 0-100 -> duty_cycle + enable
  pct=$1
  pwm_setup || { echo "ohc-fand: no pwm at $PWM" >&2; return 1; }
  [ "$pct" -lt 0 ] 2>/dev/null && pct=0
  [ "$pct" -gt 100 ] 2>/dev/null && pct=100
  # Below the floor the fan stalls and chirps rather than turning slowly, so a
  # non-zero request (curve or manual) never goes under it.
  [ "$pct" -gt 0 ] && [ "$pct" -lt "$MIN_PCNT" ] && pct=$MIN_PCNT
  if [ "$pct" -eq 0 ]; then
    echo 0 > "$PWM/enable" 2>/dev/null
    echo 0; return 0
  fi
  # Starting from stopped: full power first, so the motor is turning before it
  # is asked to hold a low duty.
  if [ "$(cat "$PWM/enable" 2>/dev/null)" != 1 ]; then
    echo "$PERIOD_NS" > "$PWM/duty_cycle" 2>/dev/null
    echo 1 > "$PWM/enable" 2>/dev/null
    sleep "$KICK_S"
  fi
  # Then change the duty in place. Disabling first (as this used to, every
  # pass) stopped the output for a moment each INTERVAL, a tick you could hear.
  echo "$((PERIOD_NS * pct / 100))" > "$PWM/duty_cycle" 2>/dev/null
  echo "$pct"
}

# Current actual duty, as a percent of period — 0 when the channel is disabled.
# This is what the hardware is doing right now, not what we last asked for.
cur_pct() {
  [ -d "$PWM" ] || { echo 0; return; }
  en=$(cat "$PWM/enable" 2>/dev/null)
  [ "$en" = "1" ] || { echo 0; return; }
  per=$(cat "$PWM/period" 2>/dev/null)
  duty=$(cat "$PWM/duty_cycle" 2>/dev/null)
  [ -n "$per" ] && [ "$per" -gt 0 ] 2>/dev/null || { echo 0; return; }
  echo $((duty * 100 / per))
}

# The override as a bare token: an integer, or "auto" when absent/cleared.
read_override() {
  [ -r "$OVERRIDE" ] || { echo auto; return; }
  v=$(cat "$OVERRIDE" 2>/dev/null)
  case "$v" in
    ''|auto) echo auto ;;
    *[!0-9]*) echo auto ;;                  # anything non-numeric -> auto
    *) echo "$v" ;;
  esac
}

write_override() {                          # "<pct>" or "auto"
  mkdir -p "$(dirname "$OVERRIDE")" 2>/dev/null
  printf '%s\n' "$1" > "$OVERRIDE" 2>/dev/null
}

read_temp_c() {
  f=$(find_temp) || return 1
  t=$(cat "$f" 2>/dev/null) || return 1
  [ -n "$t" ] || return 1
  echo $((t / 1000))
}

duty_for() {
  t=$1
  [ "$t" -lt "$ON_TEMP" ] && { echo 0; return; }
  pct=$((MIN_PCNT + (t - ON_TEMP) * PCNT_PER_DEG))
  [ "$pct" -gt 100 ] && pct=100
  echo "$pct"
}

case "$1" in
  set)
    pct=${2:-0}
    write_override "$pct"
    set_pct "$pct" >/dev/null
    echo "fan set to ${pct}% (manual)"; exit 0 ;;
  off)
    write_override 0
    set_pct 0 >/dev/null
    echo "fan off (manual)"; exit 0 ;;
  auto)
    write_override auto
    echo "fan returned to automatic"; exit 0 ;;
  status)
    ov=$(read_override)
    if [ "$ov" = auto ]; then echo "mode: auto"; else echo "mode: manual"; fi
    echo "pct: $(cur_pct)"
    echo "override: $ov"
    exit 0 ;;
esac

TEMPF=$(find_temp) || { echo "ohc-fand: no hwmon temp sensor (lm75 not bound?)" >&2; exit 1; }
echo "ohc-fand: temp=$TEMPF pwm=$PWM on=${ON_TEMP}C min=${MIN_PCNT}% slope=${PCNT_PER_DEG}%/C crit=${CRITICAL}C override=$OVERRIDE"
last_on=0; now=0
while :; do
  t=$(read_temp_c)
  # Fail-safe FIRST, and regardless of mode: a sensor we cannot read means we do
  # not get to decide the fan is allowed to be slow.
  if [ -z "$t" ]; then
    set_pct 100 >/dev/null; echo "ohc-fand: temp read failed -> fan 100%"
    sleep "$INTERVAL"; now=$((now + INTERVAL)); continue
  fi
  ov=$(read_override)
  if [ "$ov" != auto ]; then
    # Manual hold — honour the override, but CRITICAL still wins. Manual is not
    # a licence to cook the board.
    pct=$ov
    [ "$t" -ge "$CRITICAL" ] && { pct=100; echo "ohc-fand: CRITICAL ${t}C -> 100% (overriding manual)"; }
    set_pct "$pct" >/dev/null
    sleep "$INTERVAL"; now=$((now + INTERVAL)); continue
  fi
  # Automatic curve.
  pct=$(duty_for "$t")
  [ "$t" -ge "$CRITICAL" ] && { pct=100; echo "ohc-fand: CRITICAL ${t}C -> 100%"; }
  if [ "$pct" -gt 0 ]; then last_on=$now
  elif [ $((now - last_on)) -lt "$COOL_HOLD" ]; then pct=$MIN_PCNT; fi
  set_pct "$pct" >/dev/null
  sleep "$INTERVAL"; now=$((now + INTERVAL))
done
