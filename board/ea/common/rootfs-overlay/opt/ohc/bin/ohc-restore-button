#!/bin/sh
# openHC — hardware "return to stock" button watcher (EA / CEFDK boards).
#
# Holding the front ID button for OHC_RESTORE_BUTTON_HOLD seconds and letting go
# runs `ohc-restore stock` — openHC's software return-to-stock. This exists
# because the native CEFDK button recovery is not dependable on every EA unit: an
# EA1 with the boot fuse blown does not rewrite mtd0 from the button, so the
# physical gesture is offered in software instead.
#
# The button is a gpio-keys-polled node in the board device tree (ea.dtsi), which
# udev links as /dev/ohc/input/id-button; polarity and debounce live there. This
# reads its input events and measures the hold between the kernel's press and
# release timestamps, so the hold is exact however late this shell gets to run.
# OHC_RESTORE_BUTTON_LED blinks while the button is held and goes solid once it
# has been held long enough: let go then.
#
# FAIL-SAFE: only a press the watcher saw both start and end counts. A stuck or
# shorted button reads pressed from the first poll, which the kernel reports the
# moment the device is opened; that press is never armed. It can never wipe a
# box at boot.
[ -r /opt/ohc/board.env ] && . /opt/ohc/board.env

RESTORE=/opt/ohc/bin/ohc-restore
DEV=/dev/ohc/input/id-button
: "${OHC_RESTORE_BUTTON_HOLD:=10}"

[ -c "$DEV" ] || { echo "restore-button: no $DEV"; exit 0; }
[ -x "$RESTORE" ] || { echo "restore-button: $RESTORE not installed"; exit 0; }

# Best-effort arming feedback on a /sys/class/leds entry (OHC_RESTORE_BUTTON_LED).
led() {
    [ -n "$OHC_RESTORE_BUTTON_LED" ] || return 0
    d=/sys/class/leds/$OHC_RESTORE_BUTTON_LED
    [ -w "$d/brightness" ] || return 0
    # Writing brightness drops a kernel trigger; take control the first time.
    [ -w "$d/trigger" ] && echo none > "$d/trigger" 2>/dev/null
    if [ "$1" = 1 ]; then
        { cat "$d/max_brightness" 2>/dev/null || echo 1; } > "$d/brightness" 2>/dev/null
    else
        echo 0 > "$d/brightness" 2>/dev/null
    fi
}

blink() {
    i=0
    while [ "$i" -lt "$OHC_RESTORE_BUTTON_HOLD" ]; do
        led $(((i + 1) % 2)); sleep 1; i=$((i + 1))
    done
    led 1
}
blinker=
stop_blink() {
    [ -n "$blinker" ] && kill "$blinker" 2>/dev/null
    blinker=
    led 0
}

# Monotonic milliseconds. The event timestamps are wall-clock (evdev's default),
# so a clock step mid-hold (ntpd at boot) would fake a long hold; the hold only
# counts if this clock, read as each event arrives, agrees with them.
uptime_ms() {
    awk '{ printf "%d\n", $1 * 1000 }' /proc/uptime
}

# One fd for the watcher's lifetime, so no event falls between reads. Each read
# is one struct input_event (24 bytes on this x86_64 userspace): tv_sec, tv_usec
# (u64 each, read as low/high u32 words), type|code<<16, value.
exec 3< "$DEV" || exit 1
opened=$(date +%s)
echo "restore-button: watching $DEV (hold ${OHC_RESTORE_BUTTON_HOLD}s, then release)"

armed=1
down_ms=; down_up=
while :; do
    ev=$(dd bs=24 count=1 <&3 2>/dev/null | od -An -v -tu4)
    # shellcheck disable=SC2086
    set -- $ev
    [ $# -eq 6 ] || { echo "restore-button: $DEV went away"; stop_blink; exit 1; }
    [ $(($5 & 0xffff)) -eq 1 ] || continue          # EV_KEY only (skip EV_SYN)
    t=$(($1 * 1000 + $3 / 1000))
    case $6 in
    1)  if [ "$1" -le $((opened + 1)) ]; then
            # Reported as the device opened: held since before we started.
            echo "restore-button: button reads pressed at startup — not arming until it is released"
            armed=0
            continue
        fi
        [ "$armed" = 1 ] || continue
        down_ms=$t; down_up=$(uptime_ms)
        blink & blinker=$!
        ;;
    0)  stop_blink
        if [ "$armed" = 0 ]; then
            armed=1                                 # a clean release: safe to watch
            continue
        fi
        [ -n "$down_ms" ] || continue
        held=$((t - down_ms)); seen=$(($(uptime_ms) - down_up))
        down_ms=
        if [ "$held" -lt $((OHC_RESTORE_BUTTON_HOLD * 1000)) ]; then
            continue
        fi
        if [ $((held - seen)) -gt 1000 ] || [ $((seen - held)) -gt 1000 ]; then
            echo "restore-button: held ${held}ms by the event clock but ${seen}ms by uptime — clock stepped, ignoring"
            continue
        fi
        led 1
        echo "restore-button: held ${held}ms — returning to stock"
        logger -t ohc-restore-button "button held ${held}ms; running ohc-restore stock" 2>/dev/null
        "$RESTORE" stock                            # reverts the MFH and recovery-kexecs; reboots
        led 0
        ;;
    esac
done
