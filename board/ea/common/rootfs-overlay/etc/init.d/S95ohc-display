#!/bin/sh
# Opt-in on-panel web view.
#
# DISABLED BY DEFAULT: out of the box the panel shows the openHC splash (drawn by
# S01splash, and on the bootstrap kernel by S00kexec before the handoff). This
# service only takes over the panel when the web UI turns it on — webd writes
# /opt/ohc/display.conf (OHC_DISPLAY_ENABLE=1 + OHC_DISPLAY_URL=...) and reloads
# this script — live on a running view (the control FIFO's url/theme), a start
# or stop only when the view is turned on or off. So a fresh box is calm (splash), and the on-screen browser is a
# deliberate choice made from the dashboard, not the default.
#
# Runs AFTER webd (S90) so the default localhost dashboard is already being served
# by the time we point the view at it.
#
# The view is the i386 WPE WebKit + SGX545 DDK stack in /opt/sgx-i386-wpe (EA only;
# see board/ea/common/gpu-wpe-i386 and [[c4-ea-fat-kernel]]). It renders straight to /dev/fb0
# through the LinuxFB WSEGL, overdrawing the splash. Everything here degrades to a
# clean no-op (splash stays) when the stack is absent or fb0 is not up — this must
# never be able to wedge the boot.
CONF=/opt/ohc/display.conf
R=/opt/sgx-i386-wpe
PIDF=/run/ohc-display.pid
CTL="${OHC_DISPLAY_CTL:-/run/ohc-display.ctl}"

# Defaults, overridden by the config the web UI writes.
OHC_DISPLAY_ENABLE=0
OHC_DISPLAY_URL=http://localhost/
OHC_DISPLAY_THEME=auto
[ -r "$CONF" ] && . "$CONF"
# "auto" is dark from sunset to sunrise at the box's location: webd resolves it
# every minute into this file (and tells a running view when it flips).
[ "$OHC_DISPLAY_THEME" = auto ] && case "$(cat /run/ohc-display.scheme 2>/dev/null)" in
	light) OHC_DISPLAY_THEME=light ;; dark) OHC_DISPLAY_THEME=dark ;;
esac

start() {
	[ "$OHC_DISPLAY_ENABLE" = 1 ] || {
		echo "ohc-display: disabled — panel shows the splash (enable it from the web UI)"
		exit 0
	}
	[ -x "$R/usr/bin/webview" ] || {
		echo "ohc-display: no webview in $R — WPE stack not installed on this image" >&2
		exit 0
	}
	[ -e /dev/fb0 ] || { echo "ohc-display: no /dev/fb0 — no framebuffer" >&2; exit 0; }

	# WebKit forks the i386 WPEWebProcess with a bare execve, so its PT_INTERP
	# (/lib/ld-linux.so.2) has to resolve to the sysroot's 32-bit loader.
	[ -e /lib/ld-linux.so.2 ] || ln -sf "$R/lib/ld-linux.so.2" /lib/ld-linux.so.2

	# Make the UI's web fonts resolve on the panel. The dashboard CSS leads its
	# font stack with system-ui / -apple-system / Segoe UI / Roboto — ideal on a
	# phone, none of which exist here — and the embedded WebKit does NOT fall
	# through to the generic family that DOES resolve (sans-serif -> DejaVu, from
	# the image's /usr/share/fonts), so every glyph rendered invisibly: icons and
	# layout but no text. Alias those families to the generic. Written here rather
	# than shipped inside the harvested sysroot, so it applies to any baked
	# /opt/sgx-i386-wpe without rebuilding it; idempotent (rewritten each start).
	if [ -d "$R/etc/fonts" ]; then
		mkdir -p "$R/etc/fonts/conf.d"
		cat > "$R/etc/fonts/conf.d/99-openhc-ui.conf" <<-'XEOF'
			<?xml version="1.0"?>
			<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
			<fontconfig>
			  <match target="pattern"><test name="family"><string>system-ui</string></test><edit name="family" mode="prepend" binding="strong"><string>sans-serif</string></edit></match>
			  <match target="pattern"><test name="family"><string>-apple-system</string></test><edit name="family" mode="prepend" binding="strong"><string>sans-serif</string></edit></match>
			  <match target="pattern"><test name="family"><string>BlinkMacSystemFont</string></test><edit name="family" mode="prepend" binding="strong"><string>sans-serif</string></edit></match>
			  <match target="pattern"><test name="family"><string>Segoe UI</string></test><edit name="family" mode="prepend" binding="strong"><string>sans-serif</string></edit></match>
			  <match target="pattern"><test name="family"><string>Roboto</string></test><edit name="family" mode="prepend" binding="strong"><string>sans-serif</string></edit></match>
			  <match target="pattern"><test name="family"><string>ui-sans-serif</string></test><edit name="family" mode="prepend" binding="strong"><string>sans-serif</string></edit></match>
			  <match target="pattern"><test name="family"><string>ui-monospace</string></test><edit name="family" mode="prepend" binding="strong"><string>monospace</string></edit></match>
			</fontconfig>
		XEOF
	fi

	# The SGX services are already up: S60sgx runs their init client at boot.

	echo "ohc-display: starting the on-panel web view -> $OHC_DISPLAY_URL (theme=$OHC_DISPLAY_THEME)"
	# WEBVIEW_RETRY: webd may still be coming up; webview reloads until the page
	# answers instead of sitting on a failed load. FONTCONFIG_PATH points at the
	# sysroot fonts; the UI uses system fonts so there is no webfont to fetch.
	# OHC_DISPLAY_THEME (auto|light|dark): webview applies it NATIVELY as the
	# browser's prefers-color-scheme (WebKit's per-view dark mode,
	# board/common/patches/wpewebkit/0001), so ANY page responds — like OS dark
	# mode — not just one that reads a query param.
	LD_PRELOAD="$R/usr/lib/sgx-busidshim.so" \
	WEBKIT_EXEC_PATH="$R/usr/libexec/wpe-webkit-2.0" \
	LD_LIBRARY_PATH="$R/usr/lib:$R/lib" \
	FONTCONFIG_PATH="$R/etc/fonts" \
	OHC_DISPLAY_THEME="$OHC_DISPLAY_THEME" \
	WEBVIEW_URL="$OHC_DISPLAY_URL" WEBVIEW_RETRY=5 \
	setsid "$R/lib/ld-linux.so.2" --library-path "$R/usr/lib:$R/lib" \
		"$R/usr/bin/webview" </dev/null >/var/log/ohc-display.log 2>&1 &
	echo $! > "$PIDF"
	printf '%s\n' "$OHC_DISPLAY_URL" > /run/ohc-display.url
}

stop() {
	[ -f "$PIDF" ] && kill "$(cat "$PIDF")" 2>/dev/null
	# webview spawns the WPE Web/Network processes; sweep the whole set. BusyBox
	# has killall but NOT pkill, so match by applet name (killall) with a `ps`
	# fallback for anything it missed — using pkill here silently left the old
	# view running, so a restart raced two webviews over /dev/fb0.
	for n in webview WPEWebProcess WPENetworkProcess; do
		killall -q "$n" 2>/dev/null || true
	done
	for p in $(ps 2>/dev/null | grep -E 'webview|WPEWebProcess|WPENetworkProcess' \
	           | grep -v grep | awk '{print $1}'); do
		kill -9 "$p" 2>/dev/null || true
	done
	rm -f "$PIDF"
	# NOTE: the splash is NOT redrawn here — fb0 keeps whatever was last presented
	# until something overdraws it. A caller that wants the splash back can run
	# /etc/init.d/S01splash start.
}

# Apply the config without tearing the view down when it can be helped: a
# running webview takes the URL and theme on its control FIFO, and the theme
# switches live. Opened read-write, so the write can never block even if the
# view has just exited (a FIFO opened write-only waits for a reader).
reload() {
	if [ "$OHC_DISPLAY_ENABLE" != 1 ]; then
		stop
	elif [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null && [ -p "$CTL" ]; then
		exec 3<>"$CTL"
		printf 'theme %s\n' "$OHC_DISPLAY_THEME" >&3
		# Only a changed URL: re-loading the same page is not needed for a theme.
		[ "$(cat /run/ohc-display.url 2>/dev/null)" = "$OHC_DISPLAY_URL" ] ||
			printf 'url %s\n' "$OHC_DISPLAY_URL" >&3
		exec 3>&-
		printf '%s\n' "$OHC_DISPLAY_URL" > /run/ohc-display.url
		echo "ohc-display: view -> $OHC_DISPLAY_URL (theme=$OHC_DISPLAY_THEME)"
	else
		stop; sleep 1; start
	fi
}

case "$1" in
	start)   start ;;
	stop)    stop ;;
	restart) stop; sleep 1; start ;;
	reload)  reload ;;
	*) echo "Usage: $0 {start|stop|restart|reload}"; exit 1 ;;
esac
