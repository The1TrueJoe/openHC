#!/bin/sh
# Start the openHomeController services after networking is up — S40wifi on the
# EA1, S40net on the EA3; both occupy the S40 slot so this ordering holds either
# way.
case "$1" in
  start) /opt/ohc/bin/ohc boot ;;
  stop)  /opt/ohc/bin/ohc stop ;;
  restart) /opt/ohc/bin/ohc stop; /opt/ohc/bin/ohc boot ;;
  status) /opt/ohc/bin/ohc status ;;
  *) echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
