#!/bin/sh
# openHC bring-up marker: proves we reached userspace on a modern kernel.
# Board-neutral — the model is the device tree's.
[ "$1" = start ] || exit 0
board=$(ohc-hw model)
echo ""
echo "  openHC ${board:-unknown board} — kernel-up bring-up rootfs"
echo "  kernel: $(uname -r)   $(uname -m)"
echo ""
