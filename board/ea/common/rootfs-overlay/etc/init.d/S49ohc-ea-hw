#!/bin/sh
# EA-family hardware bring-up: the lm75 heatsink sensor + the PWM fan daemon.
# The universal identity layer (mDNS, timezone) is the fleet S50ohc, which runs
# right after this. S49 so the hardware is up before S50 reports state.
BIN=/opt/ohc/bin

start() {
    [ -x "$BIN/ohc-ea-hw" ] && "$BIN/ohc-ea-hw"
    if [ -x "$BIN/ohc-fand" ]; then
        start-stop-daemon -S -q -b -m -p /var/run/ohc-fand.pid --exec "$BIN/ohc-fand" \
            && echo "ohc-ea-hw: fan daemon started"
    fi
}
stop() {
    [ -f /var/run/ohc-fand.pid ] && start-stop-daemon -K -q -p /var/run/ohc-fand.pid
    rm -f /var/run/ohc-fand.pid
}
case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    *) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
