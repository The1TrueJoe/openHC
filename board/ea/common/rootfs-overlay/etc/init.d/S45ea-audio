#!/bin/sh
# Wait for the EA's sound cards so audiod, librespot and shairport find them.
# udev coldplug loads every driver from its modalias; nothing is loaded here.
#   HDMI       every EA (ce5300-hdmi)
#   openhcea   EA-3: CE5300 I2S + ADAU1451 (simple-audio-card)
#   openhcea5  EA-5: the audio FPGA + two ADAU1451s (snd-soc-ea5-fpga)

wait_card() { # <id> <what>
    i=0
    while [ $i -lt 10 ]; do
        [ -e "/proc/asound/$1" ] && { echo "ea-audio: $2 card ready"; return 0; }
        sleep 1; i=$((i + 1))
    done
    echo "ea-audio: $2 card not up yet"
}

start() {
    grep -q "ce5300-hdmi.ko" "/lib/modules/$(uname -r)/modules.dep" 2>/dev/null &&
        wait_card HDMI HDMI
    dt=/sys/firmware/devicetree/base/sound
    [ -e $dt ] || return 0
    case "$(tr -d '\0' < $dt/compatible)" in
        control4,ea5-audio) wait_card openhcea5 FPGA ;;
        *) wait_card openhcea DSP ;;
    esac
    return 0
}

case "$1" in
    start) start ;;
    stop) ;;
    restart) start ;;
    *) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
