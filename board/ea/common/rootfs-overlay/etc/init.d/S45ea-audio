#!/bin/sh
# Wait for the CE5300 DSP sound card (the `audio-dsp` feature, EA3) so
# S92ohcaudiod finds the DSP controls it sets and S95librespot and shairport
# find a PCM device when they open /dev/snd/*.
#
# Nothing to load: udev's coldplug modprobes each driver off its device's
# modalias, and deferred probe sorts out the order --
#   ce5300-i2s           CPU DAI (+ the PCM once enable_pcm=1), by its PCI id
#   adau1451-c4          codec, by the "adi,adau1451" node on i2c-3; loads
#                        /lib/firmware/openhc/adau1451-ea3.bin (the DSP parameters)
#   snd-soc-simple-card  the card, by the "simple-audio-card" node
# (both nodes are in ea-audio-dsp.dtsi; each driver has a
# MODULE_DEVICE_TABLE(of, ...)). A board without the DSP has no card node, so
# there is nothing to wait for.

start() {
    [ -e /sys/firmware/devicetree/base/sound ] || return 0
    # By id, not number: "openhcea" is the simple-audio-card's name with the
    # dash dropped.
    i=0
    while [ $i -lt 10 ]; do
        [ -e /proc/asound/openhcea ] && { echo "ea-audio: card ready"; return 0; }
        sleep 1; i=$((i + 1))
    done
    echo "ea-audio: card not up yet"
}

case "$1" in
    start) start ;;
    stop) ;;
    restart) start ;;
    *) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
