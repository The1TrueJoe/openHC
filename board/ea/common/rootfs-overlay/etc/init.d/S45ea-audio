#!/bin/sh
# Load the CE5300 ASoC audio stack (the `audio-dsp` feature, built =m to keep the
# EA-3 bzImage inside CEFDK's bootlinux window — see
# board/ea/common/features/audio-dsp/linux.fragment).
#
# WHY an init script and not modules-load.d: this image has no systemd and no
# modules-load.d reader, so modules are loaded by modprobe from init, the same way
# S39ea-switch loads b53. Features have no rootfs-overlay hook of their own, so the
# autoload lives in the EA family overlay; it is a NO-OP on EA boards built without
# audio-dsp (the .ko simply are not in the image, so each modprobe fails
# harmlessly — same guard style as S39ea-switch / S41wifi-ap).
#
# WHY before S95librespot: librespot (and shairport) open /dev/snd/*, which only
# exists once the card is registered. Each modprobe pulls snd / snd-pcm /
# snd-soc-core (and the codec the sigmadsp core) by modules.dep; the drivers
# themselves bind by name/alias, not by symbol dep, so they are loaded explicitly
# and in order:
#   ce5300-i2s           CPU DAI (+ the PCM once enable_pcm=1), binds its PCI device
#   adau1451-c4          codec, binds the i2c-3 0x38 node in the board DTB; loads
#                        /lib/firmware/openhc/adau1451-ea3.bin (the DSP parameters)
#   snd-soc-simple-card  the card, from the board DTB's simple-audio-card node
# Deferred probe makes the order forgiving, but this is the natural bring-up order.

MODS="ce5300-i2s adau1451-c4 snd-soc-simple-card"

start() {
    loaded=0
    for m in $MODS; do
        if modprobe "$m" >/dev/null 2>&1; then
            loaded=$((loaded + 1))
        fi
    done
    if [ "$loaded" -eq 0 ]; then
        echo "ea-audio: no audio-dsp modules in this image, skipping"
        return 0
    fi
    # Best-effort wait for the card (and with it the DSP controls ohc-audiod sets)
    # so S92ohcaudiod and S95librespot find it. By id, not number: "openhcea" is
    # the simple-audio-card's name with the dash dropped.
    i=0
    while [ $i -lt 10 ]; do
        [ -e /proc/asound/openhcea ] && { echo "ea-audio: card ready"; return 0; }
        sleep 1; i=$((i + 1))
    done
    echo "ea-audio: modules loaded (card not up yet)"
}

stop() {
    for m in snd-soc-simple-card adau1451-c4 ce5300-i2s; do
        modprobe -r "$m" >/dev/null 2>&1 || true
    done
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    *) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
