# EA "real" kernel: the fat kernel S00kexec loads from p1, past the copy-window
# limit. Merged last, so each line here wins. Background: docs ea/kernel-config.
# merge_config scrapes "SYMBOL=" even inside comments: write symbols without "=".

# --- GPU: PowerVR SGX545, built in (a module in features/sgx) ---
CONFIG_DRM=y
CONFIG_SGX545_CE=y

# --- framebuffer (simplefb from the board DTB), built in as on the bootstrap ---
CONFIG_FB=y
CONFIG_FB_SIMPLE=y

# --- regulator core: rear-USB VBUS (gpio44) under port power control (patch 0016) ---
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# Modules stay on: the ASoC audio stack still loads from p1.
CONFIG_MODULES=y

# --- keep the IOMMU off: Cedarview VT-d breaks SDHCI ADMA and the eMMC never comes up ---
# CONFIG_INTEL_IOMMU is not set
# CONFIG_INTEL_IOMMU_DEFAULT_ON is not set

# No module signing (secure boot is off on this hardware).
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_ALL is not set
