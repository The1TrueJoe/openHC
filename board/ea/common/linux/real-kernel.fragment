# EA "real" kernel: the fat kernel S00kexec loads from p1, past the copy-window
# limit. Merged last, so each line here wins. Background: docs ea/kernel-config.
# merge_config scrapes "SYMBOL=" even inside comments: write symbols without "=".

# --- GPU: PowerVR SGX545 (powervr_sgx), built in (a module in features/sgx) ---
# Its microkernel is linked in too (mk-real-kernel.sh: EXTRA_FIRMWARE): it probes
# before the rootfs is mounted.
CONFIG_DRM=y
CONFIG_DRM_POWERVR_SGX=y

# --- display: simpledrm on the CEFDK framebuffer (the DTB's simple-framebuffer) ---
# A KMS device for the GPU's buffers (kmsro); /dev/fb0 is its fbdev emulation.
CONFIG_FB=y
# CONFIG_FB_SIMPLE is not set
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y

# --- phylib: the EA1's RTL8211E behind e1000 (patch 0022) and its jack LEDs ---
# The bootstrap kernel has no phylib; e1000 drives the PHY itself there.
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y

# --- regulator core: rear-USB VBUS (gpio44) under port power control (patch 0016) ---
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# Modules stay on: the ASoC audio stack still loads from p1.
CONFIG_MODULES=y

# --- keep the IOMMU off: Cedarview VT-d breaks SDHCI ADMA and the eMMC never comes up ---
# CONFIG_INTEL_IOMMU is not set
# CONFIG_INTEL_IOMMU_DEFAULT_ON is not set

# No module signing (secure boot is off on this hardware).
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_ALL is not set
