# EA-family kernel config delta on the mainline i386 defconfig.
# Background for the settings below: docs ea/kernel-config.

# --- serial console + IO-MCU port (CE5300 GEN3 UARTs) ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# SoC UARTs come from the DTB via 8250_of, timer-polled, reusing the legacy slots.
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_SERIAL_OF_PLATFORM=y
# No legacy ISA IRQ auto-probe.
# CONFIG_SERIAL_8250_DETECT_IRQ is not set
CONFIG_CMDLINE_BOOL=y
# x86 prepends this to whatever line CEFDK or kexec passes. pci=realloc,nocrs
# is required; memmap=exactmap reclaims CEFDK's 1.8 GB carve-out and every entry
# is load-bearing. See docs ea/kernel-config.
CONFIG_CMDLINE="console=ttyS0,115200 earlyprintk=serial,ttyS0,115200 pci=realloc,nocrs,routeirq memmap=exactmap memmap=68K@0 memmap=60K#0x11000 memmap=512K@0x20000 memmap=255M@1M memmap=1536M@0x10000000"

# --- external initrd (Buildroot supplies a separate rootfs.cpio.gz) ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Size: the bzImage must fit CEFDK bootlinux's 7,417,856-byte copy window.
CONFIG_KERNEL_XZ=y
# CONFIG_KERNEL_GZIP is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# USB host: TDI EHCI with an embedded TT; root-hub TT is required for full-speed devices.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_EHCI_ROOT_HUB_TT=y
CONFIG_USB_EHCI_TT_NEWSCHED=y
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MMC is not set
# CONFIG_EXT4_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_BTRFS_FS is not set

# --- Atom / platform ---
CONFIG_MATOM=y
CONFIG_HIGHMEM4G=y
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y

# --- networking core ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_CRYPTO=y

# --- radio: off by family default; the `wifi` feature turns it back on ---
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set

# --- wired NIC: on-board Intel GbE (e1000) ---
CONFIG_E1000=y

# --- size trim ---
# Modules on: new functionality goes in as a module, not built in (size budget).
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Stack protector off: the musl canary panics the secondary CPU in do_idle.
# CONFIG_STACKPROTECTOR is not set
# CONFIG_STACKPROTECTOR_STRONG is not set

# Boot is CEFDK's legacy 16-bit entry, never EFI.
# CONFIG_EFI is not set

# Symbol table off for size; turn back on to resolve a crash.
# CONFIG_KALLSYMS is not set

# Bare metal, never a VM guest.
# CONFIG_HYPERVISOR_GUEST is not set
# CONFIG_PARAVIRT is not set
# CONFIG_KVM_GUEST is not set
# CONFIG_XEN is not set
# CONFIG_VIRTUALIZATION is not set

# No debug/trace/instrumentation.
# CONFIG_FTRACE is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_KPROBES is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_IKCONFIG is not set
# CONFIG_PROFILING is not set
# CONFIG_KGDB is not set

# Networking: plain IPv4.
# CONFIG_NETFILTER is not set
# CONFIG_IPV6 is not set
# CONFIG_NET_SCHED is not set
# CONFIG_XFRM_USER is not set
# CONFIG_INET_DIAG is not set
# CONFIG_WIRELESS_EXT is not set

# Storage and filesystems: features (emmc, storage) add back what they need.
# CONFIG_MD is not set
# CONFIG_NVME_CORE is not set
# CONFIG_MTD is not set

# CONFIG_EXT3_FS is not set
# CONFIG_EXT2_FS is not set
# CONFIG_JBD2 is not set
# CONFIG_F2FS_FS is not set
# CONFIG_FS_DAX is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_QUOTA is not set
# CONFIG_FUSE_FS is not set

# Graphics/sound/media off here; the display, sgx and audio features add them.
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_VGA_CONSOLE is not set
# CONFIG_AGP is not set

# The thermal framework stays on (below): it runs the fan.
# CONFIG_WATCHDOG is not set
# CONFIG_POWER_SUPPLY is not set

# CONFIG_CRYPTO_USER is not set
# CONFIG_CRYPTO_HW is not set

# --- CE5310 SoC ---
# Built-in board DTB (patch 0015); gpio-intelce, not gpio-sodaville, drives 8086:2e67.
CONFIG_OF=y
# CONFIG_X86_INTEL_CE is not set
CONFIG_BUILTIN_DTB=y
CONFIG_GPIOLIB=y

# Front-panel LEDs and the ID button (ea.dtsi).
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_NETDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO_POLLED=m
# Wrong line count for the CE5300 (12 of 128).
# CONFIG_GPIO_SODAVILLE is not set
# GPIO_CDEV_V1 is required: libgpiod 1.6 speaks only the v1 ABI.
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_SYSFS_LEGACY=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_CDEV_V1=y

# I2C: i2c-pxa needs patches 0001 and 0013, or the symbol is dropped on x86_64.
CONFIG_I2C=y
CONFIG_I2C_PXA=y
CONFIG_I2C_CHARDEV=y

# Required for SPI_PXA2XX_PCI (a derived symbol); do not remove.
CONFIG_COMMON_CLK=y

# LM75 heatsink sensor on i2c-0 @ 0x48.
CONFIG_HWMON=y
CONFIG_SENSORS_LM75=y

# Fan PWM. pwm-ce5300 is obj-y with no Kconfig symbol; do not add one.
CONFIG_PWM=y
CONFIG_PWM_SYSFS=y

# The kernel runs the fan curve (pwm-fan + LM75 thermal zone in ea.dtsi).
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_USER_SPACE=y
CONFIG_SENSORS_PWM_FAN=y

# Unused NICs and filesystems: trimmed to buy back copy window.
# CONFIG_E1000E is not set
# CONFIG_E1000E_HWTS is not set
# CONFIG_SKY2 is not set
# CONFIG_8139TOO is not set
# CONFIG_R8169 is not set
# CONFIG_ISO9660_FS is not set

# x86_64_defconfig extras no EA uses: 7.3 outgrew the copy window by up to 87 KB.
# CONFIG_TIGON3 is not set
# CONFIG_NET_TULIP is not set
# CONFIG_E100 is not set
# CONFIG_FORCEDETH is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VIRTIO_PCI is not set
# CONFIG_VIRTIO_NET is not set
# CONFIG_VIRTIO_BLK is not set
# CONFIG_VIRTIO_CONSOLE is not set
# CONFIG_VIRTIO_INPUT is not set
# CONFIG_NET_9P is not set
# CONFIG_PCCARD is not set
# CONFIG_HOTPLUG_PCI is not set
# CONFIG_MACINTOSH_DRIVERS is not set
# CONFIG_EEEPC_LAPTOP is not set
# CONFIG_AMD_IOMMU is not set
# CONFIG_ACPI_DOCK is not set
# CONFIG_I2C_I801 is not set
# CONFIG_NVRAM is not set
# The CE5300 has one TDI EHCI and no companion controllers.
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_USB_UHCI_HCD is not set
# CONFIG_USB_PRINTER is not set
# CONFIG_USB_MON is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_SECURITY is not set
# CONFIG_AUDIT is not set
# CONFIG_NETLABEL is not set
# CONFIG_NUMA is not set
# CONFIG_HIBERNATION is not set
# CONFIG_PM_DEBUG is not set
# CONFIG_X86_CHECK_BIOS_CORRUPTION is not set
# CONFIG_CGROUP_DEBUG is not set
# CONFIG_TASKSTATS is not set
# CONFIG_BSD_PROCESS_ACCT is not set
# CONFIG_IP_MROUTE is not set
# CONFIG_HUGETLBFS is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_DEBUG_WX is not set
# CONFIG_PROVIDE_OHCI1394_DMA_INIT is not set
# CONFIG_EARLY_PRINTK_DBGP is not set

# --- boot SPI-NOR as /dev/mtd0 (spi-ea-ce5xx, PCI 8086:08a0) ---
# Back up mtd0 before writing it. SPI must be on, or MTD_SPI_NOR is dropped silently.
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_PXA2XX=y

CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_SPI_NOR=y
CONFIG_SPI_MEM=y
# DTB partitions, plus the whole chip kept as mtd0 (all tools write whole-chip offsets).
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_PARTITIONED_MASTER=y

# Warnings are not errors (the vendor SGX DDK code warns a lot on x86_64).
# CONFIG_WERROR is not set
