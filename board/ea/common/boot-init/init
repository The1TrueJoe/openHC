#!/bin/sh
# openHC tiny boot-initramfs /init — self-install + pivot, all on-device.
#
# The CEFDK autoscript loads the kernel and THIS ~1-2 MB initramfs into RAM and
# bootlinux runs it (on a secure-boot EA that is the only path past the blown
# fuse). Its whole job is to get onto the persistent rootfs on p1 with the least
# possible RAM held:
#
#   * p1 already holds a valid openHC  -> switch_root into it. The initramfs is
#     then freed, so steady-state RAM is exactly a disk-rooted system's — none
#     of the rootfs sits in RAM. This is the case on every normal boot.
#
#   * p1 is empty / stock / corrupt    -> FIRST-BOOT INSTALL: a gzipped ext2
#     rootfs image was staged in the raw eMMC gap by the flasher; stream it
#     straight to p1 (eMMC -> gunzip -> eMMC, no network, no RAM copy of the
#     512 MB image), then pivot. Nothing else ever loads the full rootfs into
#     RAM.
#
# One fixed autoscript covers install and every boot after, so openHC needs no
# MTD tools and the unit stays factory-restore-friendly. The staged image lives
# in the raw region ahead of p1 (see ROOTFS_STAGE_MB), which factory-restore
# leaves alone — but p1 reverts to stock, whose lack of /etc/openhc-release
# makes this /init run the installer again (re-laying openHC), OR you clear the
# autoscript for a truly-stock box.

PATH=/bin:/sbin
/bin/mount -t proc     proc     /proc 2>/dev/null
/bin/mount -t sysfs    sysfs    /sys  2>/dev/null
/bin/mount -t devtmpfs devtmpfs /dev  2>/dev/null

ROOT=/dev/mmcblk0p1
NEW=/mnt/root
/bin/mkdir -p "$NEW"

# WAIT for the eMMC to appear. sdhci-pci probes asynchronously, so /init often
# runs before /dev/mmcblk0p1 exists; without this the mount below fails and we
# fall back to RAM even though p1 is fine (the bug that made the first pivot
# silently not happen). Re-trigger devtmpfs each spin in case /dev was empty.
i=0
while [ ! -b "$ROOT" ] && [ $i -lt 100 ]; do
    /bin/mount -t devtmpfs devtmpfs /dev 2>/dev/null
    /bin/sleep 0.1 2>/dev/null || /bin/usleep 100000 2>/dev/null || :
    i=$((i + 1))
done
[ -b "$ROOT" ] || echo "openHC: WARNING $ROOT never appeared after ${i} tries"

# Where the flasher staged the gzipped ext2 rootfs, in MiB from the start of
# /dev/mmcblk0 (Linux view). Must match the flasher's ROOTFS_STAGE_OFF. It sits
# after the kernel container (0x400) and the initrd, still ahead of p1 (32 MiB).
ROOTFS_STAGE_MB=16

valid_p1() {
    for fs in ext4 ext2; do
        if /bin/mount -t "$fs" -o rw "$ROOT" "$NEW" 2>/dev/null; then
            if [ -f "$NEW/etc/openhc-release" ] && [ -x "$NEW/sbin/init" ]; then
                return 0
            fi
            /bin/umount "$NEW" 2>/dev/null
        fi
    done
    return 1
}

# NO-SERIAL NETWORK INSTALL. openHC's EA rootfs (~512 MB, ~47 MB gzipped) is far
# bigger than the 16 MiB raw gap ahead of p1, so it cannot be staged there for
# the on-device install above. Instead the flasher RAM-boots THIS initramfs with
# no staged image, we come up on the network, and the flasher streams the rootfs
# straight to p1 over SSH (ohc-flash's stage2_write_rootfs: `dd of=/dev/mmcblk0p1`).
# It then reboots us; the next run of /init finds a valid p1 and pivots. We never
# touch p1 here, so there is no race with the flasher's write and nothing to undo
# if it is interrupted — a power cycle just lands back in stock (p2 untouched).
#
# WHY eth0 reaches the network without the switch driver: b53 is a module loaded
# from the real rootfs (S39ea-switch), absent here, so DSA never attaches and
# eth0 is a plain e1000. Measured on a live EA3: without DSA the PRIMARY jack
# forwards to the CPU, which is exactly the one path an installer needs.
net_serve() {
    [ -x /usr/sbin/dropbear ] || { echo "openHC: no dropbear in boot-init"; return 1; }
    /bin/mount -t devpts devpts /dev/pts 2>/dev/null
    /sbin/ifconfig lo 127.0.0.1 up 2>/dev/null
    /sbin/ifconfig eth0 up 2>/dev/null
    echo "openHC: requesting an address on eth0..."
    /sbin/udhcpc -i eth0 -n -q -t 15 -T 2 2>/dev/null \
        || echo "openHC: no DHCP lease (the flasher can still reach a static/link-local box)"
    ip=$(/sbin/ifconfig eth0 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p')
    echo "openHC: boot-init up at ${ip:-<no address>} — waiting for the flasher to write p1 over SSH"
    # -R: generate host keys on demand (none are baked in). Daemonises, so /init
    # continues to the wait below. root logs in with the openHC password (see
    # build/mk-boot-init.sh), which is what ohc-flash tries first.
    /usr/sbin/dropbear -R -p 22 2>/dev/null
    # Hold the box up with SSH available. The flasher writes p1 and reboots us;
    # we do NOT poll valid_p1 here (mounting p1 mid-write would corrupt it).
    while :; do /bin/sleep 3600; done
}

if ! valid_p1; then
    echo "openHC: no rootfs on $ROOT — installing from the eMMC-staged image..."
    # Raw stream: eMMC gap -> gunzip -> p1. dd/gunzip work on tiny buffers, so
    # the 512 MB rootfs is never held in RAM.
    if /bin/dd if=/dev/mmcblk0 bs=1M skip="$ROOTFS_STAGE_MB" 2>/dev/null \
        | /bin/gunzip 2>/dev/null | /bin/dd of="$ROOT" bs=1M 2>/dev/null; then
        /bin/sync
        echo "openHC: rootfs written to $ROOT"
    else
        echo "openHC: install stream failed"
    fi
    if ! valid_p1; then
        echo "openHC: no staged image to install — coming up on the network instead."
        net_serve   # does not return on success (reboots or pivots)
        echo "openHC: no valid rootfs and no network — dropping to a shell."
        exec /bin/sh
    fi
fi

# ONE-SHOT STOCK RESTORE. `restore stock` run on durable openHC cannot reformat
# its own root (p1), so it drops this flag on p1 and reboots with the autoscript
# still enabled. Here, pre-pivot, p1 is only a mount — so restore can reimage it
# from p2's recfs.tar.xz and then clear the autoscript, exactly the context the
# durable run lacked. Consume the flag FIRST (while p1 is still mounted) so no
# future reboot can re-trigger a wipe; then only reimage once /dev/mtd0 is reachable
# (finalize must clear the autoscript afterwards). mtd0 absent -> skip, p1 untouched,
# boot openHC. On success the box reboots straight to stock Control4; a finalize that
# fails after unmounting falls back to network recovery rather than pivoting a partial p1.
if [ -f "$NEW/.ohc-stock-pending" ]; then
    echo "openHC: stock restore requested — reimaging p1 to Control4"
    # Consume the flag now, while p1 is still mounted: this boot owns the request, so
    # a later unrelated reboot can never re-trigger a wipe. (If we skip below, the
    # user simply re-runs `restore stock`.)
    /bin/rm -f "$NEW/.ohc-stock-pending"
    /bin/sync
    # finalize clears the autoscript enable byte over /dev/mtd0, so the restore is
    # only safe if mtd0 is reachable: reimaging p1 and THEN failing to clear the
    # autoscript would destroy openHC with no way to boot stock. The SPI-NOR probes
    # asynchronously (like the eMMC wait above), so wait for the node BEFORE we
    # unmount and wipe. If it never appears, SKIP the restore and boot openHC — p1 is
    # untouched (still mounted at $NEW), so the pivot below just works.
    j=0
    while [ ! -c /dev/mtd0 ] && [ $j -lt 50 ]; do
        /bin/mount -t devtmpfs devtmpfs /dev 2>/dev/null
        /bin/sleep 0.1 2>/dev/null || /bin/usleep 100000 2>/dev/null || :
        j=$((j + 1))
    done
    if [ -c /dev/mtd0 ]; then
        /bin/umount "$NEW" 2>/dev/null
        if /usr/sbin/restore reimage-finalize; then
            echo "openHC: restored to stock — rebooting"
            /bin/sync
            /sbin/reboot -f
        fi
        # finalize failed after unmounting; p1 may be partially stock, so do not
        # pivot into it — re-check and fall back to network recovery.
        echo "openHC: stock restore did not complete — recovering"
        valid_p1 || {
            echo "openHC: p1 no longer valid after a partial restore — network recovery"
            net_serve
            exec /bin/sh
        }
    else
        echo "openHC: /dev/mtd0 never appeared — skipping stock restore, booting openHC (p1 intact)"
        # p1 is still mounted at $NEW; fall through to the normal pivot below.
    fi
fi

echo "openHC: booting the persistent rootfs on $ROOT"
/bin/mount --move /proc "$NEW/proc" 2>/dev/null
/bin/mount --move /sys  "$NEW/sys"  2>/dev/null
/bin/mount --move /dev  "$NEW/dev"  2>/dev/null
exec /sbin/switch_root "$NEW" /sbin/init
