net: dsa: b53: spi: read a register in one full-duplex transfer

b53_spi_read_reg() sends the read command and register with
spi_write_then_read(), which is two transfers: two command bytes out, then
`len` bytes in. On the Intel CE5300's SSP (Control4 EA3) the chip select is the
SSP's frame signal, selected by number in SSSR: the controller drives it while
it shifts, and it drops when the FIFO runs dry between two transfers. The
BCM53125 takes that as the end of the read cycle, so every read returns
garbage and b53_switch_detect() fails with -EINVAL.

Control4's own spi-bcm53125 driver for this board never splits a read: it
sends command, register and dummy bytes as one spi_sync_transfer() and takes
the data from the tail of the receive buffer. Do the same. On a controller
with a real chip select the two forms are the same bus cycle, so this changes
nothing elsewhere.

The buffer is kmalloc'd, as spi_write_then_read()'s bounce buffer is, so it is
DMA-safe.

Author: Joseph Telaak <joseph@telaak.dev>
---
--- a/drivers/net/dsa/b53/b53_spi.c
+++ b/drivers/net/dsa/b53/b53_spi.c
@@ -21,6 +21,7 @@
 #include <linux/delay.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
+#include <linux/slab.h>
 #include <linux/spi/spi.h>
 #include <linux/platform_data/b53.h>
 
@@ -39,15 +40,33 @@
 
 #define B53_SPI_PAGE_SELECT	0xff
 
+/*
+ * One full-duplex transfer, not spi_write_then_read()'s two: on some
+ * controllers (the Intel CE5300's SSP) the chip select is the frame signal,
+ * which drops between transfers and ends the switch's read cycle.
+ */
 static inline int b53_spi_read_reg(struct spi_device *spi, u8 reg, u8 *val,
 				   unsigned int len)
 {
-	u8 txbuf[2];
+	struct spi_transfer t = { .len = 2 + len };
+	u8 *buf;
+	int ret;
 
-	txbuf[0] = B53_SPI_CMD_NORMAL | B53_SPI_CMD_READ;
-	txbuf[1] = reg;
+	buf = kzalloc(2 * (2 + len), GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
 
-	return spi_write_then_read(spi, txbuf, 2, val, len);
+	buf[0] = B53_SPI_CMD_NORMAL | B53_SPI_CMD_READ;
+	buf[1] = reg;
+	t.tx_buf = buf;
+	t.rx_buf = buf + 2 + len;
+
+	ret = spi_sync_transfer(spi, &t, 1);
+	if (!ret)
+		memcpy(val, buf + 2 + len + 2, len);
+
+	kfree(buf);
+	return ret;
 }
 
 static inline int b53_spi_clear_status(struct spi_device *spi)
