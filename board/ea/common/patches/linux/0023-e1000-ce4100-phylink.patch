+static struct e1000_adapter *e1000_phylink_adapter(struct phylink_config *config)
+{
+	return netdev_priv(to_net_dev(config->dev));
+}
+
+static void e1000_mac_config(struct phylink_config *config, unsigned int mode,
+			     const struct phylink_link_state *state)
+{
+}
+
+static void e1000_mac_link_down(struct phylink_config *config,
+				unsigned int mode, phy_interface_t interface)
+{
+	struct e1000_adapter *adapter = e1000_phylink_adapter(config);
+
+	adapter->phylink_up = false;
+	adapter->link_speed = 0;
+	adapter->link_duplex = 0;
+}
+
+static void e1000_mac_link_up(struct phylink_config *config,
+			      struct phy_device *phy, unsigned int mode,
+			      phy_interface_t interface, int speed, int duplex,
+			      bool tx_pause, bool rx_pause)
+{
+	struct e1000_adapter *adapter = e1000_phylink_adapter(config);
+	struct e1000_hw *hw = &adapter->hw;
+
+	hw->forced_speed = speed;
+	hw->forced_full_duplex = duplex == DUPLEX_FULL;
+	if (tx_pause && rx_pause)
+		hw->fc = E1000_FC_FULL;
+	else if (tx_pause)
+		hw->fc = E1000_FC_TX_PAUSE;
+	else if (rx_pause)
+		hw->fc = E1000_FC_RX_PAUSE;
+	else
+		hw->fc = E1000_FC_NONE;
+	hw->original_fc = hw->fc;
+
+	e1000_setup_forced_link(hw);
+
+	adapter->link_speed = speed;
+	adapter->link_duplex = duplex == DUPLEX_FULL ? FULL_DUPLEX : HALF_DUPLEX;
+	adapter->tx_timeout_factor = speed == SPEED_10 ? 16 : 1;
+	adapter->phylink_up = true;
+
+	if (!test_bit(__E1000_DOWN, &adapter->flags))
+		ew32(TCTL, er32(TCTL) | E1000_TCTL_EN);
+}
+
+static const struct phylink_mac_ops e1000_phylink_mac_ops = {
+	.mac_config = e1000_mac_config,
+	.mac_link_down = e1000_mac_link_down,
+	.mac_link_up = e1000_mac_link_up,
+};
+
+/**
+ * e1000_phylink_init - hand the link of a CE4100 to phylink
+ * @adapter: board private structure
+ *
+ * If the device's OF node has a fixed-link or a phy-handle, let phylink
+ * manage the link and force the MAC to whatever it resolves. Without
+ * either, the MAC manages its PHY itself as before.
+ *
+ * Return: 0 if phylink is not used or is set up, else an error.
+ */
+static int e1000_phylink_init(struct e1000_adapter *adapter)
+{
+	struct device_node *np = adapter->pdev->dev.of_node;
+	struct phylink_config *config = &adapter->phylink_config;
+	struct e1000_hw *hw = &adapter->hw;
+	phy_interface_t interface;
+	struct phylink *phylink;
+	int err;
+
+	if (!np ||
+	    (!of_phy_is_fixed_link(np) && !of_property_present(np, "phy-handle")))
+		return 0;
+
+	if (of_get_phy_mode(np, &interface) ||
+	    !phy_interface_mode_is_rgmii(interface)) {
+		e_dev_err("phylink needs an rgmii phy-mode\n");
+		return -EINVAL;
+	}
+
+	config->dev = &adapter->netdev->dev;
+	config->type = PHYLINK_NETDEV;
+	config->mac_capabilities = MAC_SYM_PAUSE | MAC_ASYM_PAUSE | MAC_10 |
+				   MAC_100 | MAC_1000FD;
+	phy_interface_set_rgmii(config->supported_interfaces);
+
+	phylink = phylink_create(config, of_fwnode_handle(np), interface,
+				 &e1000_phylink_mac_ops);
+	if (IS_ERR(phylink))
+		return PTR_ERR(phylink);
+
+	err = phylink_of_phy_connect(phylink, np, 0);
+	if (err) {
+		phylink_destroy(phylink);
+		return err;
+	}
+
+	adapter->phylink = phylink;
+	hw->phylink = true;
+	hw->forced_speed = SPEED_1000;
+	hw->forced_full_duplex = true;
+	hw->autoneg = 0;
+	adapter->fc_autoneg = 0;
+	hw->fc = E1000_FC_NONE;
+	hw->original_fc = hw->fc;
+
+	return 0;
+}
+
+static void e1000_phylink_destroy(struct e1000_adapter *adapter)
+{
+	if (!adapter->phylink)
+		return;
+
+	phylink_disconnect_phy(adapter->phylink);
+	phylink_destroy(adapter->phylink);
+	adapter->phylink = NULL;
+}
