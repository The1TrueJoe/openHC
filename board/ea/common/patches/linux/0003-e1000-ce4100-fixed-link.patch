From 94df282b5d2c0da5001a1dda23a0a1e32205a52e Mon Sep 17 00:00:00 2001
From: Joseph Telaak <joseph@telaak.dev>
Date: Mon, 9 Nov 2026 16:56:31 -0500
Subject: [PATCH] e1000: support a fixed link on the CE4100 GbE

The CE4100 family's GbE MAC (8086:2e6e) has an external RGMII/RMII
interface. Boards built on the Intel Atom CE5300 wire it straight to a
switch port, a Broadcom BCM53125 for example, with nothing on the MAC's
MDIO bus. On those boards e1000_probe() scans all 32 PHY addresses,
finds no PHY and fails with -EIO, so the interface never appears.

Let the device tree describe such a link the usual way, with phy-mode
and a fixed-link child node on the PCI device's node:

	ethernet@c,0 {
		reg = <0x16000 0 0 0 0>;
		phy-mode = "rgmii";

		fixed-link {
			speed = <1000>;
			full-duplex;
		};
	};

When a ce4100 MAC has a fixed-link node, take speed and duplex from it
and skip the PHY scan. Link setup then forces the MAC instead of
configuring a PHY: CTRL gets SLU, FRCSPD and FRCDPX, with the speed bits
and FD written explicitly rather than inherited from the boot firmware,
and CTL_AUX selects RGMII. Flow control is off unless the node has
"pause". e1000_check_for_link() reports the link up without asking a
PHY. PHY register access, PHY reset, the MII ioctls, changing the link
settings and the PHY loopback self-test are refused or skipped, and
ethtool reports the fixed speed and duplex on an MII port.

Only phy-mode "rgmii" is accepted: the MAC has no RGMII delay control
that I know of, and RMII is untested. Boards without a fixed-link node
are unchanged.

The node is read through the device's OF node rather than its fwnode.
If an ACPI companion ever ends up as the device's primary fwnode, the
device_property helpers would look in ACPI and miss the fixed link,
while dev->of_node still points at the DT node. On the CE5300 the GbE
has no ACPI companion today: the DSDT gives it a wildcard _ADR
(0x000CFFFF) that Linux does not match.

Converting e1000 to phylink for one MAC type seemed out of proportion;
the driver has its own PHY layer and no phylib users.
---
 .../net/ethernet/intel/e1000/e1000_ethtool.c  | 60 +++++++++++++++++
 drivers/net/ethernet/intel/e1000/e1000_hw.c   | 67 ++++++++++++++++++-
 drivers/net/ethernet/intel/e1000/e1000_hw.h   |  3 +
 drivers/net/ethernet/intel/e1000/e1000_main.c | 67 ++++++++++++++++++-
 4 files changed, 192 insertions(+), 5 deletions(-)

diff --git a/drivers/net/ethernet/intel/e1000/e1000_ethtool.c b/drivers/net/ethernet/intel/e1000/e1000_ethtool.c
index 4dcbeab..4b83796 100644
--- a/drivers/net/ethernet/intel/e1000/e1000_ethtool.c
+++ b/drivers/net/ethernet/intel/e1000/e1000_ethtool.c
@@ -83,6 +83,49 @@ static const char e1000_gstrings_test[][ETH_GSTRING_LEN] = {
 
 #define E1000_TEST_LEN	ARRAY_SIZE(e1000_gstrings_test)
 
+static int e1000_get_fixed_link_ksettings(struct net_device *netdev,
+					  struct ethtool_link_ksettings *cmd)
+{
+	struct e1000_adapter *adapter = netdev_priv(netdev);
+	struct e1000_hw *hw = &adapter->hw;
+	u32 supported = SUPPORTED_MII;
+
+	switch (hw->fixed_link_speed) {
+	case SPEED_1000:
+		supported |= SUPPORTED_1000baseT_Full;
+		break;
+	case SPEED_100:
+		supported |= hw->fixed_link_full_duplex ?
+			     SUPPORTED_100baseT_Full : SUPPORTED_100baseT_Half;
+		break;
+	default:
+		supported |= hw->fixed_link_full_duplex ?
+			     SUPPORTED_10baseT_Full : SUPPORTED_10baseT_Half;
+		break;
+	}
+
+	ethtool_convert_legacy_u32_to_link_mode(cmd->link_modes.supported,
+						supported);
+	ethtool_convert_legacy_u32_to_link_mode(cmd->link_modes.advertising,
+						supported);
+
+	cmd->base.port = PORT_MII;
+	cmd->base.autoneg = AUTONEG_DISABLE;
+	cmd->base.eth_tp_mdix = ETH_TP_MDI_INVALID;
+	cmd->base.eth_tp_mdix_ctrl = ETH_TP_MDI_INVALID;
+
+	if (netif_carrier_ok(netdev)) {
+		cmd->base.speed = hw->fixed_link_speed;
+		cmd->base.duplex = hw->fixed_link_full_duplex ?
+				   DUPLEX_FULL : DUPLEX_HALF;
+	} else {
+		cmd->base.speed = SPEED_UNKNOWN;
+		cmd->base.duplex = DUPLEX_UNKNOWN;
+	}
+
+	return 0;
+}
+
 static int e1000_get_link_ksettings(struct net_device *netdev,
 				    struct ethtool_link_ksettings *cmd)
 {
@@ -90,6 +133,9 @@ static int e1000_get_link_ksettings(struct net_device *netdev,
 	struct e1000_hw *hw = &adapter->hw;
 	u32 supported, advertising;
 
+	if (hw->fixed_link)
+		return e1000_get_fixed_link_ksettings(netdev, cmd);
+
 	if (hw->media_type == e1000_media_type_copper) {
 		supported = (SUPPORTED_10baseT_Half |
 			     SUPPORTED_10baseT_Full |
@@ -168,6 +214,10 @@ static int e1000_set_link_ksettings(struct net_device *netdev,
 	struct e1000_hw *hw = &adapter->hw;
 	u32 advertising;
 
+	/* Speed and duplex of a fixed link come from firmware */
+	if (hw->fixed_link)
+		return -EOPNOTSUPP;
+
 	ethtool_convert_link_mode_to_legacy_u32(&advertising,
 						cmd->link_modes.advertising);
 
@@ -349,6 +399,9 @@ static void e1000_get_regs(struct net_device *netdev, struct ethtool_regs *regs,
 	regs_buff[11] = er32(TIDV);
 
 	regs_buff[12] = hw->phy_type;  /* PHY type (IGP=1, M88=0) */
+	if (hw->fixed_link)	/* no PHY: leave the PHY words zero */
+		goto no_phy;
+
 	if (hw->phy_type == e1000_phy_igp) {
 		e1000_write_phy_reg(hw, IGP01E1000_PHY_PAGE_SELECT,
 				    IGP01E1000_PHY_AGC_A);
@@ -403,6 +456,7 @@ static void e1000_get_regs(struct net_device *netdev, struct ethtool_regs *regs,
 	e1000_read_phy_reg(hw, PHY_1000T_STATUS, &phy_data);
 	regs_buff[24] = (u32)phy_data;  /* phy local receiver status */
 	regs_buff[25] = regs_buff[24];  /* phy remote receiver status */
+no_phy:
 	if (hw->mac_type >= e1000_82540 &&
 	    hw->media_type == e1000_media_type_copper) {
 		regs_buff[26] = er32(MANC);
@@ -1451,6 +1505,12 @@ static int e1000_run_loopback_test(struct e1000_adapter *adapter)
 
 static int e1000_loopback_test(struct e1000_adapter *adapter, u64 *data)
 {
+	if (adapter->hw.fixed_link) {
+		e_info(hw, "No PHY to loop back through on a fixed link\n");
+		*data = 0;
+		return 0;
+	}
+
 	*data = e1000_setup_desc_rings(adapter);
 	if (*data)
 		goto out;
diff --git a/drivers/net/ethernet/intel/e1000/e1000_hw.c b/drivers/net/ethernet/intel/e1000/e1000_hw.c
index 0e5de52..dbf0233 100644
--- a/drivers/net/ethernet/intel/e1000/e1000_hw.c
+++ b/drivers/net/ethernet/intel/e1000/e1000_hw.c
@@ -33,6 +33,7 @@ static void e1000_write_reg_io(struct e1000_hw *hw, u32 offset, u32 value);
 static s32 e1000_set_phy_type(struct e1000_hw *hw);
 static void e1000_phy_init_script(struct e1000_hw *hw);
 static s32 e1000_setup_copper_link(struct e1000_hw *hw);
+static s32 e1000_setup_fixed_link(struct e1000_hw *hw);
 static s32 e1000_setup_fiber_serdes_link(struct e1000_hw *hw);
 static s32 e1000_adjust_serdes_amplitude(struct e1000_hw *hw);
 static s32 e1000_phy_force_speed_duplex(struct e1000_hw *hw);
@@ -747,8 +748,12 @@ s32 e1000_setup_link(struct e1000_hw *hw)
 	}
 
 	/* Call the necessary subroutine to configure the link. */
-	ret_val = (hw->media_type == e1000_media_type_copper) ?
-	    e1000_setup_copper_link(hw) : e1000_setup_fiber_serdes_link(hw);
+	if (hw->fixed_link)
+		ret_val = e1000_setup_fixed_link(hw);
+	else if (hw->media_type == e1000_media_type_copper)
+		ret_val = e1000_setup_copper_link(hw);
+	else
+		ret_val = e1000_setup_fiber_serdes_link(hw);
 
 	/* Initialize the flow control address, type, and PAUSE timer
 	 * registers to their default values.  This is done even if flow
@@ -1407,6 +1412,49 @@ static s32 e1000_copper_link_postconfig(struct e1000_hw *hw)
 	return E1000_SUCCESS;
 }
 
+/**
+ * e1000_setup_fixed_link - force the MAC onto a fixed link
+ * @hw: Struct containing variables accessed by shared code
+ *
+ * The MAC is wired straight to its link partner over RGMII, with no PHY in
+ * between, so there is nothing to negotiate. Force speed, duplex and link up
+ * in the MAC rather than relying on what firmware left in CTRL.
+ */
+static s32 e1000_setup_fixed_link(struct e1000_hw *hw)
+{
+	u32 ctrl, ctrl_aux;
+
+	ctrl_aux = er32(CTL_AUX);
+	ctrl_aux &= ~E1000_CTL_AUX_RMII;
+	ew32(CTL_AUX, ctrl_aux);
+
+	ctrl = er32(CTRL);
+	ctrl &= ~(E1000_CTRL_ASDE | E1000_CTRL_SPD_SEL | E1000_CTRL_FD);
+	ctrl |= E1000_CTRL_SLU | E1000_CTRL_FRCSPD | E1000_CTRL_FRCDPX;
+
+	switch (hw->fixed_link_speed) {
+	case SPEED_1000:
+		ctrl |= E1000_CTRL_SPD_1000;
+		break;
+	case SPEED_100:
+		ctrl |= E1000_CTRL_SPD_100;
+		break;
+	default:
+		ctrl |= E1000_CTRL_SPD_10;
+		break;
+	}
+
+	if (hw->fixed_link_full_duplex)
+		ctrl |= E1000_CTRL_FD;
+
+	ew32(CTRL, ctrl);
+	E1000_WRITE_FLUSH();
+
+	e1000_config_collision_dist(hw);
+
+	return e1000_force_mac_fc(hw);
+}
+
 /**
  * e1000_setup_copper_link - phy/speed/duplex setting
  * @hw: Struct containing variables accessed by shared code
@@ -2375,6 +2423,12 @@ s32 e1000_check_for_link(struct e1000_hw *hw)
 	s32 ret_val;
 	u16 phy_data;
 
+	/* A fixed link is always up and has no PHY to ask */
+	if (hw->fixed_link) {
+		hw->get_link_status = false;
+		return E1000_SUCCESS;
+	}
+
 	er32(CTRL);
 	status = er32(STATUS);
 
@@ -2787,6 +2841,9 @@ s32 e1000_read_phy_reg(struct e1000_hw *hw, u32 reg_addr, u16 *phy_data)
 	u32 ret_val;
 	unsigned long flags;
 
+	if (hw->fixed_link)
+		return -E1000_ERR_PHY;
+
 	spin_lock_irqsave(&e1000_phy_lock, flags);
 
 	if ((hw->phy_type == e1000_phy_igp) &&
@@ -2924,6 +2981,9 @@ s32 e1000_write_phy_reg(struct e1000_hw *hw, u32 reg_addr, u16 phy_data)
 	u32 ret_val;
 	unsigned long flags;
 
+	if (hw->fixed_link)
+		return -E1000_ERR_PHY;
+
 	spin_lock_irqsave(&e1000_phy_lock, flags);
 
 	if ((hw->phy_type == e1000_phy_igp) &&
@@ -3041,6 +3101,9 @@ s32 e1000_phy_hw_reset(struct e1000_hw *hw)
 	u32 ctrl, ctrl_ext;
 	u32 led_ctrl;
 
+	if (hw->fixed_link)
+		return E1000_SUCCESS;
+
 	e_dbg("Resetting Phy...\n");
 
 	if (hw->mac_type > e1000_82543) {
diff --git a/drivers/net/ethernet/intel/e1000/e1000_hw.h b/drivers/net/ethernet/intel/e1000/e1000_hw.h
index 95cdd17..a8f799a 100644
--- a/drivers/net/ethernet/intel/e1000/e1000_hw.h
+++ b/drivers/net/ethernet/intel/e1000/e1000_hw.h
@@ -1388,6 +1388,9 @@ struct e1000_hw {
 	e1000_dsp_config dsp_config_state;
 	bool get_link_status;
 	bool serdes_has_link;
+	bool fixed_link;
+	bool fixed_link_full_duplex;
+	u16 fixed_link_speed;
 	bool tbi_compatibility_en;
 	bool tbi_compatibility_on;
 	bool laa_is_present;
diff --git a/drivers/net/ethernet/intel/e1000/e1000_main.c b/drivers/net/ethernet/intel/e1000/e1000_main.c
index d7f5c6f..3247258 100644
--- a/drivers/net/ethernet/intel/e1000/e1000_main.c
+++ b/drivers/net/ethernet/intel/e1000/e1000_main.c
@@ -7,6 +7,8 @@
 #include <linux/prefetch.h>
 #include <linux/bitops.h>
 #include <linux/if_vlan.h>
+#include <linux/of.h>
+#include <linux/of_net.h>
 
 char e1000_driver_name[] = "e1000";
 static char e1000_driver_string[] = "Intel(R) PRO/1000 Network Driver";
@@ -901,6 +903,57 @@ static int e1000_init_hw_struct(struct e1000_adapter *adapter,
 	return 0;
 }
 
+/**
+ * e1000_get_fixed_link - read the device tree's fixed-link description
+ * @adapter: board private structure
+ *
+ * Some boards wire the MAC straight to a switch port over RGMII, with no PHY
+ * on the MDIO bus. Take speed and duplex from a fixed-link child node and run
+ * without a PHY. Boards without one keep the PHY scan.
+ *
+ * Return: 0 if there is no fixed-link node or it is valid, -EINVAL if not.
+ */
+static int e1000_get_fixed_link(struct e1000_adapter *adapter)
+{
+	struct device_node *np = adapter->pdev->dev.of_node;
+	struct e1000_hw *hw = &adapter->hw;
+	struct device_node *fixed __free(device_node) =
+		of_get_child_by_name(np, "fixed-link");
+	phy_interface_t interface;
+	bool full_duplex;
+	u32 speed;
+
+	if (!fixed)
+		return 0;
+
+	if (of_get_phy_mode(np, &interface) ||
+	    interface != PHY_INTERFACE_MODE_RGMII) {
+		e_dev_err("fixed-link needs phy-mode \"rgmii\"\n");
+		return -EINVAL;
+	}
+
+	full_duplex = of_property_read_bool(fixed, "full-duplex");
+	if (of_property_read_u32(fixed, "speed", &speed) ||
+	    (speed != SPEED_10 && speed != SPEED_100 && speed != SPEED_1000) ||
+	    (speed == SPEED_1000 && !full_duplex)) {
+		e_dev_err("unsupported fixed-link speed/duplex\n");
+		return -EINVAL;
+	}
+
+	hw->fixed_link = true;
+	hw->fixed_link_speed = speed;
+	hw->fixed_link_full_duplex = full_duplex;
+	hw->autoneg = 0;
+	adapter->fc_autoneg = 0;
+	hw->fc = of_property_read_bool(fixed, "pause") ?
+		 E1000_FC_FULL : E1000_FC_NONE;
+
+	e_dev_info("fixed link, %u Mbps %s duplex\n", speed,
+		   full_duplex ? "full" : "half");
+
+	return 0;
+}
+
 /**
  * e1000_probe - Device Initialization Routine
  * @pdev: PCI device information struct
@@ -1174,8 +1227,14 @@ static int e1000_probe(struct pci_dev *pdev, const struct pci_device_id *ent)
 	adapter->wol = adapter->eeprom_wol;
 	device_set_wakeup_enable(&adapter->pdev->dev, adapter->wol);
 
-	/* Auto detect PHY address */
 	if (hw->mac_type == e1000_ce4100) {
+		err = e1000_get_fixed_link(adapter);
+		if (err)
+			goto err_eeprom;
+	}
+
+	/* Auto detect PHY address */
+	if (hw->mac_type == e1000_ce4100 && !hw->fixed_link) {
 		for (i = 0; i < 32; i++) {
 			hw->phy_addr = i;
 			e1000_read_phy_reg(hw, PHY_ID2, &tmp);
@@ -1184,8 +1243,10 @@ static int e1000_probe(struct pci_dev *pdev, const struct pci_device_id *ent)
 				break;
 		}
 
-		if (i >= 32)
+		if (i >= 32) {
+			err = -EIO;
 			goto err_eeprom;
+		}
 	}
 
 	/* reset the hardware with the new settings */
@@ -4768,7 +4829,7 @@ static int e1000_mii_ioctl(struct net_device *netdev, struct ifreq *ifr,
 	u16 mii_reg;
 	unsigned long flags;
 
-	if (hw->media_type != e1000_media_type_copper)
+	if (hw->media_type != e1000_media_type_copper || hw->fixed_link)
 		return -EOPNOTSUPP;
 
 	switch (cmd) {
