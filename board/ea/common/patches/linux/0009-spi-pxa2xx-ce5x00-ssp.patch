+
+/*
+ * CEFDK leaves the CE5300's SSP with its DDS clock stopped and stale words in
+ * the TX FIFO, and toggling SSE does not empty it. Clock them out once, or the
+ * first transfer shifts them out ahead of its own data.
+ */
+static void ce5x00_drain_tx_fifo(struct driver_data *drv_data)
+{
+	unsigned int i;
+
+	/* 100 MHz * 0x40000 / 2^24 = 1.5625 MHz with SCR = 0 */
+	pxa2xx_spi_write(drv_data, DDS_RATE, 0x40000);
+	pxa_ssp_enable(drv_data->ssp);
+	for (i = 0; i < 1000; i++) {
+		while (read_SSSR_bits(drv_data, SSSR_RNE))
+			pxa2xx_spi_read(drv_data, SSDR);
+		if (!read_SSSR_bits(drv_data, QUARK_X1000_SSSR_TFL_MASK | SSSR_BSY))
+			break;
+		udelay(10);
+	}
+	while (read_SSSR_bits(drv_data, SSSR_RNE))
+		pxa2xx_spi_read(drv_data, SSDR);
+	pxa_ssp_disable(drv_data->ssp);
+	write_SSSR_CS(drv_data, SSSR_ROR);
 }
 
