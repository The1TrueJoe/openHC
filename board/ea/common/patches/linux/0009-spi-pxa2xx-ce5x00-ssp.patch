spi: pxa2xx: add CE5X00_SSP for the Intel CE5300's SSP

The CE5300 (Control4 EA) exposes an SSP behind the same PCI id as the CE4100
(8086:2e6a), so spi-pxa2xx-pci treats it as a CE4100. It is not one. It is
Quark X1000's SSP: the same register layout and the same DDS clock.

                  mainline CE4100      CE5300 (= Quark X1000)
    SSCR1 TFT         bits  7:6  (2 bits)  bits 10:6  (5 bits)
    SSCR1 RFT         bits 11:10 (2 bits)  bits 15:11 (5 bits)
    SSSR  TFL         bits  9:8  (2 bits)  bits 12:8  (5 bits)
    FIFO depth        4                    32
    bit clock         3.6864 MHz / 2(SCR+1)  100 MHz * DDS_RATE / 2^24 / (SCR+1)

So CE5X00_SSP falls through to `case QUARK_X1000_SSP:` at every site that
selects a register layout or the clock divider, and DDS_RATE (+0x28) is written
for it as for Quark. The clock was measured on an EA3: with DDS_RATE = 1000,
1024 bits take 1.74 s at SCR = 9 and 0.88 s at SCR = 4, and DDS_RATE = 2000 at
SCR = 9 takes 0.88 s, which is Quark's 100 MHz reference to within 2%. With
DDS_RATE = 0 the SSP does not shift at all. The port is registered at 50 MHz,
Quark's ceiling.

Unlike Quark, the chip select is the CE4100 one: the CS number is written into
SSSR[1:0]. CE5X00 joins CE4100 in cs_assert()/cs_deassert()/setup(), and in
write_SSSR_CS() so that the status clears before every transfer don't reset
the CS to 0.

CE5X00 is pxa25x_ssp_comp(), as in Control4's driver. If it isn't, spi-pxa2xx
treats it as a PXA27x and writes SSTO, also at +0x28, i.e. DDS_RATE: 1000 at
the start of every transfer (a ~2 kHz bit clock) and 0 at the end (clock
stopped mid-shift). That is the "wedge" seen on every kexec boot: BSY set, the
TX FIFO full (SSSR = 0x1F14), b53's chip-id read garbage, probe -EINVAL.

Finally, CEFDK leaves the SSP with DDS_RATE = 0 and up to 25 stale words in the
TX FIFO (SSSR TFL = 25 just before the kexec), and toggling SSE does not empty
it. Probe clocks those out once, or the first transfer would shift them ahead
of its own data and every read after it would be misaligned.

The CE5300 is identified by the SoC host bridge (8086:0c40 at 0000:00:00.0)
rather than by the SSP function's own id, which it shares with the CE4100, so
genuine CE4100 hardware is unaffected.

Author: Joseph Telaak <joseph@telaak.dev>
---
--- a/include/linux/pxa2xx_ssp.h
+++ b/include/linux/pxa2xx_ssp.h
@@ -219,6 +219,7 @@
 	PXA168_SSP,
 	PXA910_SSP,
 	CE4100_SSP,
+	CE5X00_SSP,
 	MMP2_SSP,
 	MRFLD_SSP,
 	QUARK_X1000_SSP,
--- a/drivers/spi/spi-pxa2xx.h
+++ b/drivers/spi/spi-pxa2xx.h
@@ -93,6 +93,7 @@
 	switch (drv_data->ssp_type) {
 	case PXA25x_SSP:
 	case CE4100_SSP:
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		return 1;
 	default:
@@ -113,6 +114,7 @@
 static inline void write_SSSR_CS(const struct driver_data *drv_data, u32 val)
 {
 	if (drv_data->ssp_type == CE4100_SSP ||
+	    drv_data->ssp_type == CE5X00_SSP ||
 	    drv_data->ssp_type == QUARK_X1000_SSP)
 		val |= read_SSSR_bits(drv_data, SSSR_ALT_FRM_MASK);
 
--- a/drivers/spi/spi-pxa2xx.c
+++ b/drivers/spi/spi-pxa2xx.c
@@ -213,6 +213,7 @@
 static u32 pxa2xx_spi_get_ssrc1_change_mask(const struct driver_data *drv_data)
 {
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		return QUARK_X1000_SSCR1_CHANGE_MASK;
 	case CE4100_SSP:
@@ -226,6 +227,7 @@
 pxa2xx_spi_get_rx_default_thre(const struct driver_data *drv_data)
 {
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		return RX_THRESH_QUARK_X1000_DFLT;
 	case CE4100_SSP:
@@ -240,6 +242,7 @@
 	u32 mask;
 
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		mask = QUARK_X1000_SSSR_TFL_MASK;
 		break;
@@ -260,6 +263,7 @@
 	u32 mask;
 
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		mask = QUARK_X1000_SSCR1_RFT;
 		break;
@@ -277,6 +281,7 @@
 				   u32 *sccr1_reg, u32 threshold)
 {
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		*sccr1_reg |= QUARK_X1000_SSCR1_RxTresh(threshold);
 		break;
@@ -293,6 +298,7 @@
 				  u32 clk_div, u8 bits)
 {
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		return clk_div
 			| QUARK_X1000_SSCR0_Motorola
@@ -420,7 +426,7 @@
 	struct driver_data *drv_data =
 		spi_controller_get_devdata(spi->controller);
 
-	if (drv_data->ssp_type == CE4100_SSP) {
+	if (drv_data->ssp_type == CE4100_SSP || drv_data->ssp_type == CE5X00_SSP) {
 		pxa2xx_spi_write(drv_data, SSSR, spi_get_chipselect(spi, 0));
 		return;
 	}
@@ -435,7 +441,7 @@
 		spi_controller_get_devdata(spi->controller);
 	unsigned long timeout;
 
-	if (drv_data->ssp_type == CE4100_SSP)
+	if (drv_data->ssp_type == CE4100_SSP || drv_data->ssp_type == CE5X00_SSP)
 		return;
 
 	/* Wait until SSP becomes idle before deasserting the CS */
@@ -467,6 +473,31 @@
 	write_SSSR_CS(drv_data, SSSR_ROR);
 
 	return limit;
+}
+
+/*
+ * CEFDK leaves the CE5300's SSP with its DDS clock stopped and stale words in
+ * the TX FIFO, and toggling SSE does not empty it. Clock them out once, or the
+ * first transfer shifts them out ahead of its own data.
+ */
+static void ce5x00_drain_tx_fifo(struct driver_data *drv_data)
+{
+	unsigned int i;
+
+	/* 100 MHz * 0x40000 / 2^24 = 1.5625 MHz with SCR = 0 */
+	pxa2xx_spi_write(drv_data, DDS_RATE, 0x40000);
+	pxa_ssp_enable(drv_data->ssp);
+	for (i = 0; i < 1000; i++) {
+		while (read_SSSR_bits(drv_data, SSSR_RNE))
+			pxa2xx_spi_read(drv_data, SSDR);
+		if (!read_SSSR_bits(drv_data, QUARK_X1000_SSSR_TFL_MASK | SSSR_BSY))
+			break;
+		udelay(10);
+	}
+	while (read_SSSR_bits(drv_data, SSSR_RNE))
+		pxa2xx_spi_read(drv_data, SSDR);
+	pxa_ssp_disable(drv_data->ssp);
+	write_SSSR_CS(drv_data, SSSR_ROR);
 }
 
 static void pxa2xx_spi_off(struct driver_data *drv_data)
@@ -583,6 +614,7 @@
 	}
 
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		mask |= QUARK_X1000_SSCR1_RFT;
 		break;
@@ -909,6 +941,7 @@
 	unsigned int clk_div;
 
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		clk_div = quark_x1000_get_clk_div(rate, &chip->dds_rate);
 		break;
@@ -1036,7 +1069,7 @@
 		pxa2xx_spi_update(drv_data, SFIFOTT, mask, thresh);
 	}
 
-	if (is_quark_x1000_ssp(drv_data))
+	if (is_quark_x1000_ssp(drv_data) || drv_data->ssp_type == CE5X00_SSP)
 		pxa2xx_spi_update(drv_data, DDS_RATE, GENMASK(23, 0), chip->dds_rate);
 
 	/* Stop the SSP */
@@ -1135,6 +1168,7 @@
 	uint tx_thres, tx_hi_thres, rx_thres;
 
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		tx_thres = TX_THRESH_QUARK_X1000_DFLT;
 		tx_hi_thres = 0;
@@ -1173,7 +1207,7 @@
 		break;
 	}
 
-	if (drv_data->ssp_type == CE4100_SSP) {
+	if (drv_data->ssp_type == CE4100_SSP || drv_data->ssp_type == CE5X00_SSP) {
 		if (spi_get_chipselect(spi, 0) > 4) {
 			dev_err(&spi->dev, "failed setup: cs number must not be > 4.\n");
 			return -EINVAL;
@@ -1208,6 +1242,7 @@
 	}
 
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		chip->threshold = (QUARK_X1000_SSCR1_RxTresh(rx_thres)
 				   & QUARK_X1000_SSCR1_RFT)
@@ -1309,6 +1344,7 @@
 
 	if (pxa25x_ssp_comp(drv_data)) {
 		switch (drv_data->ssp_type) {
+		case CE5X00_SSP:
 		case QUARK_X1000_SSP:
 			controller->bits_per_word_mask = SPI_BPW_RANGE_MASK(4, 32);
 			break;
@@ -1372,6 +1408,7 @@
 
 	/* Load default SSP configuration */
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		tmp = QUARK_X1000_SSCR1_RxTresh(RX_THRESH_QUARK_X1000_DFLT) |
 		      QUARK_X1000_SSCR1_TxTresh(TX_THRESH_QUARK_X1000_DFLT);
@@ -1409,6 +1446,9 @@
 		break;
 	}
 
+	if (drv_data->ssp_type == CE5X00_SSP)
+		ce5x00_drain_tx_fifo(drv_data);
+
 	if (!pxa25x_ssp_comp(drv_data))
 		pxa2xx_spi_write(drv_data, SSTO, 0);
 
--- a/drivers/spi/spi-pxa2xx-pci.c
+++ b/drivers/spi/spi-pxa2xx-pci.c
@@ -177,12 +177,30 @@
 static int ce4100_spi_setup(struct pci_dev *dev, struct pxa2xx_spi_controller *c)
 {
 	struct ssp_device *ssp = &c->ssp;
+	struct pci_dev *hb;
 
-	ssp->type = PXA25x_SSP;
+	/*
+	 * The CE4100 and the CE5300 share this PCI id but not this SSP. Tell
+	 * them apart by the SoC host bridge, as Control4's own driver does.
+	 */
+	ssp->type = CE4100_SSP;
+	hb = pci_get_domain_bus_and_slot(0, 0, PCI_DEVFN(0, 0));
+	if (hb) {
+		if (hb->vendor == PCI_VENDOR_ID_INTEL && hb->device == 0x0c40)
+			ssp->type = CE5X00_SSP;
+		pci_dev_put(hb);
+	}
+	dev_info(&dev->dev, "SSP type %s\n",
+		 ssp->type == CE5X00_SSP ? "CE5X00" : "CE4100");
 	ssp->port_id = dev->devfn;
 	c->num_chipselect = dev->devfn;
 
-	return pxa2xx_spi_pci_clk_register(dev, ssp, 3686400);
+	/*
+	 * The CE5300's SSP is clocked like Quark's: 100 MHz through a DDS
+	 * and the SCR divider, so it tops out at 50 MHz, as Quark's does.
+	 */
+	return pxa2xx_spi_pci_clk_register(dev, ssp,
+					   ssp->type == CE5X00_SSP ? 50000000 : 3686400);
 }
 
 static const struct pxa_spi_info ce4100_info_config = {
