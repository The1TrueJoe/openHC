spi: pxa2xx: add CE5X00_SSP for the Intel CE5300's SSP

The CE5300 (Control4 EA) exposes an SSP behind the same PCI id as the CE4100
(8086:2e6a), so spi-pxa2xx-pci treats it as a CE4100. It is not one. Control4's
CE5300 kernel (GPL linux-3.12.74, kernel/intel_kernel_patches) carries a
separate SSP type for it, and the two parts disagree on the SSCR1/SSSR field
layout, the FIFO depth, AND the input clock:

                  mainline CE4100      CE5300
    SSCR1 TFT         bits  7:6  (2 bits)  bits 10:6  (5 bits)
    SSCR1 RFT         bits 11:10 (2 bits)  bits 15:11 (5 bits)
    SSSR  TFL         bits  9:8  (2 bits)  bits 12:8  (5 bits)
    FIFO depth        4                    32
    SSP input clock   3.6864 MHz           10 MHz

The register LAYOUT the CE5300 wants is Quark X1000's (SSCR0 Motorola at 6:5,
DataSize(x)=x-1, 5-bit thresholds, 32-deep FIFO, SSSR TFL/RFL). mainline's
QUARK_X1000_SSP already encodes exactly that, so CE5X00_SSP is defined as a new
enum value that falls through to `case QUARK_X1000_SSP:` at every site that
selects a register layout, and that joins CE4100_SSP at the three sites that
select a device by writing the chip-select into SSSR.

THE CLOCK IS NOT QUARK'S, AND MUST NOT BE ALIASED TO IT. Quark derives the bit
clock from a 24-bit DDS_RATE register plus an SCR divisor, and writes DDS_RATE
under an exact is_quark_x1000_ssp() test. THE CE5300 HAS NO DDS. Control4's
vendor driver clocks it like a CE4100/PXA25x part: ssp_get_clk_div() returns a
plain SCR for CE5X00 (divide by 2*(SCR+1), 8-bit field), and nothing ever
touches DDS_RATE. On the CE5300 the register at the DDS_RATE offset is not a
clock register at all, and writing it wedges the SSP (the bit clock dies, SSSR
stays BSY, pxa2xx_spi_flush() times out: "b53-switch spi92.1: Flush failed / SPI
transfer failed: -5 / probe -22"). So CE5X00_SSP deliberately stays OUT of the
Quark branch of pxa2xx_ssp_get_clk_div() -- it falls through to ssp_get_clk_div()
-- and is added to that function's PXA25x/CE4100 case so it gets the /2 SCR
divisor the hardware actually uses. transfer_one's DDS_RATE write remains gated
by is_quark_x1000_ssp(), so it never fires for CE5X00.

The second half is the input clock. spi-pxa2xx-pci registers the 8086:2e6a port
at the CE4100's 3.6864 MHz; the CE5300's SSP clock is 10 MHz (vendor
spi_clk_get_rate(): `case CE5X00_SSP: return 10000000;`). ssp_get_clk_div()
computes the SCR from this rate, so the wrong input clock produces the wrong bit
rate even once the divider is right. ce4100_spi_setup() therefore registers
10 MHz when it has identified a CE5300, 3.6864 MHz otherwise.

The CE5300 is identified by the SoC host bridge (8086:0c40 at 0000:00:00.0)
rather than by the SSP function's own id, which it shares with the CE4100, so
genuine CE4100 hardware is unaffected.

Finally, CE5X00 skips the flush at the top of pxa2xx_spi_transfer_one(). That
flush polls the SSP for BSY to clear, but the CE5300's bit clock comes up only
when CEFDK configured it and the port is otherwise stopped at this point, so the
poll times out ("b53-switch: Flush failed / SPI transfer failed: -5 / probe
-22") before any transfer runs. It is intermittent on a cold boot (it depends on
whether the clock happens to be live) and reliable after a kexec (the SSP is
inherited stopped), which matters because an installed EA boots its real kernel
via kexec. Control4's vendor driver never flushes a stopped SSP; it stops,
reloads SSCR1/SSCR0 and restarts the port, and the SSE off->on there empties the
FIFOs (mainline's own MMP2 comment confirms flipping SSE drains the FIFO on
non-MMP2 parts). So for CE5X00 the pre-flush is skipped and that restart, a few
lines down in transfer_one(), does the clearing — with the clock live by the
time data is shifted.

Author: Joseph Telaak <joseph@telaak.dev>
---
--- a/include/linux/pxa2xx_ssp.h
+++ b/include/linux/pxa2xx_ssp.h
@@ -219,6 +219,7 @@
 	PXA168_SSP,
 	PXA910_SSP,
 	CE4100_SSP,
+	CE5X00_SSP,
 	MMP2_SSP,
 	MRFLD_SSP,
 	QUARK_X1000_SSP,
--- a/drivers/spi/spi-pxa2xx.c
+++ b/drivers/spi/spi-pxa2xx.c
@@ -213,6 +213,7 @@
 static u32 pxa2xx_spi_get_ssrc1_change_mask(const struct driver_data *drv_data)
 {
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		return QUARK_X1000_SSCR1_CHANGE_MASK;
 	case CE4100_SSP:
@@ -226,6 +227,7 @@
 pxa2xx_spi_get_rx_default_thre(const struct driver_data *drv_data)
 {
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		return RX_THRESH_QUARK_X1000_DFLT;
 	case CE4100_SSP:
@@ -240,6 +242,7 @@
 	u32 mask;
 
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		mask = QUARK_X1000_SSSR_TFL_MASK;
 		break;
@@ -260,6 +263,7 @@
 	u32 mask;
 
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		mask = QUARK_X1000_SSCR1_RFT;
 		break;
@@ -277,6 +281,7 @@
 				   u32 *sccr1_reg, u32 threshold)
 {
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		*sccr1_reg |= QUARK_X1000_SSCR1_RxTresh(threshold);
 		break;
@@ -293,6 +298,7 @@
 				  u32 clk_div, u8 bits)
 {
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		return clk_div
 			| QUARK_X1000_SSCR0_Motorola
@@ -420,7 +426,7 @@
 	struct driver_data *drv_data =
 		spi_controller_get_devdata(spi->controller);
 
-	if (drv_data->ssp_type == CE4100_SSP) {
+	if ((drv_data->ssp_type == CE4100_SSP || drv_data->ssp_type == CE5X00_SSP)) {
 		pxa2xx_spi_write(drv_data, SSSR, spi_get_chipselect(spi, 0));
 		return;
 	}
@@ -435,7 +441,7 @@
 		spi_controller_get_devdata(spi->controller);
 	unsigned long timeout;
 
-	if (drv_data->ssp_type == CE4100_SSP)
+	if ((drv_data->ssp_type == CE4100_SSP || drv_data->ssp_type == CE5X00_SSP))
 		return;
 
 	/* Wait until SSP becomes idle before deasserting the CS */
@@ -583,6 +589,7 @@
 	}
 
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		mask |= QUARK_X1000_SSCR1_RFT;
 		break;
@@ -896,7 +903,8 @@
 	 * Calculate the divisor for the SCR (Serial Clock Rate), avoiding
 	 * that the SSP transmission rate can be greater than the device rate.
 	 */
-	if (ssp->type == PXA25x_SSP || ssp->type == CE4100_SSP)
+	if (ssp->type == PXA25x_SSP || ssp->type == CE4100_SSP ||
+	    ssp->type == CE5X00_SSP)
 		return (DIV_ROUND_UP(ssp_clk, 2 * rate) - 1) & 0xff;
 	else
 		return (DIV_ROUND_UP(ssp_clk, rate) - 1)  & 0xfff;
@@ -955,7 +963,18 @@
 	}
 
 	/* Setup the transfer state based on the type of transfer */
-	if (pxa2xx_spi_flush(drv_data) == 0) {
+	/*
+	 * CE5X00: do NOT flush-first. The flush polls the SSP for BSY to clear,
+	 * but on the CE5300 the SSP's bit clock is set up by CEFDK and is not
+	 * running yet at this point (the port is stopped, or left stale by a prior
+	 * kernel across kexec), so the poll times out — "Flush failed", -EIO —
+	 * before the transfer ever starts. Control4's vendor driver never flushes
+	 * a stopped SSP; it stops/reloads/restarts the port in the config block
+	 * below, and the SSE off->on there empties the FIFOs (as the MMP2 note
+	 * confirms for non-MMP2 parts). So skip the pre-flush for CE5X00 and let
+	 * that restart do the clearing — the clock is live by the time we transfer.
+	 */
+	if (drv_data->ssp_type != CE5X00_SSP && pxa2xx_spi_flush(drv_data) == 0) {
 		dev_err(&spi->dev, "Flush failed\n");
 		return -EIO;
 	}
@@ -1135,6 +1154,7 @@
 	uint tx_thres, tx_hi_thres, rx_thres;
 
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		tx_thres = TX_THRESH_QUARK_X1000_DFLT;
 		tx_hi_thres = 0;
@@ -1173,7 +1193,7 @@
 		break;
 	}
 
-	if (drv_data->ssp_type == CE4100_SSP) {
+	if ((drv_data->ssp_type == CE4100_SSP || drv_data->ssp_type == CE5X00_SSP)) {
 		if (spi_get_chipselect(spi, 0) > 4) {
 			dev_err(&spi->dev, "failed setup: cs number must not be > 4.\n");
 			return -EINVAL;
@@ -1208,6 +1228,7 @@
 	}
 
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		chip->threshold = (QUARK_X1000_SSCR1_RxTresh(rx_thres)
 				   & QUARK_X1000_SSCR1_RFT)
@@ -1309,7 +1330,8 @@
 
 	if (pxa25x_ssp_comp(drv_data)) {
 		switch (drv_data->ssp_type) {
-		case QUARK_X1000_SSP:
+		case CE5X00_SSP:
+	case QUARK_X1000_SSP:
 			controller->bits_per_word_mask = SPI_BPW_RANGE_MASK(4, 32);
 			break;
 		default:
@@ -1372,6 +1394,7 @@
 
 	/* Load default SSP configuration */
 	switch (drv_data->ssp_type) {
+	case CE5X00_SSP:
 	case QUARK_X1000_SSP:
 		tmp = QUARK_X1000_SSCR1_RxTresh(RX_THRESH_QUARK_X1000_DFLT) |
 		      QUARK_X1000_SSCR1_TxTresh(TX_THRESH_QUARK_X1000_DFLT);
--- a/drivers/spi/spi-pxa2xx-pci.c
+++ b/drivers/spi/spi-pxa2xx-pci.c
@@ -177,12 +177,31 @@
 static int ce4100_spi_setup(struct pci_dev *dev, struct pxa2xx_spi_controller *c)
 {
 	struct ssp_device *ssp = &c->ssp;
+	struct pci_dev *hb;
 
-	ssp->type = PXA25x_SSP;
+	/*
+	 * The CE4100 and the CE5300 share this PCI id but not this SSP. Tell
+	 * them apart by the SoC host bridge, as Control4's own driver does.
+	 */
+	ssp->type = CE4100_SSP;
+	hb = pci_get_domain_bus_and_slot(0, 0, PCI_DEVFN(0, 0));
+	if (hb) {
+		if (hb->vendor == PCI_VENDOR_ID_INTEL && hb->device == 0x0c40)
+			ssp->type = CE5X00_SSP;
+		pci_dev_put(hb);
+	}
+	dev_info(&dev->dev, "SSP type %s\n",
+		 ssp->type == CE5X00_SSP ? "CE5X00" : "CE4100");
 	ssp->port_id = dev->devfn;
 	c->num_chipselect = dev->devfn;
 
-	return pxa2xx_spi_pci_clk_register(dev, ssp, 3686400);
+	/*
+	 * The CE4100's SSP clock is 3.6864 MHz; the CE5300's is 10 MHz (from
+	 * Control4's vendor spi_clk_get_rate()). The divider in ssp_get_clk_div()
+	 * is computed from this rate, so a wrong input clock clocks the bus wrong.
+	 */
+	return pxa2xx_spi_pci_clk_register(dev, ssp,
+					   ssp->type == CE5X00_SSP ? 10000000 : 3686400);
 }
 
 static const struct pxa_spi_info ce4100_info_config = {
