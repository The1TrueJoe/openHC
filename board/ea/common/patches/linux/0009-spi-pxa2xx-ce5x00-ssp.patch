 }
+
+/*
+ * The CE5300's SSP selects a chip with its frame signal, which drops whenever
+ * the FIFO runs dry, so between any two transfers of a message. A device that
+ * needs CS held across a message (a command, then its response) sees two
+ * cycles. So run a multi-transfer message as one bounce-buffered transfer.
+ */
+struct ce5x00_merged_msg {
+	struct list_head orig;
+	struct spi_transfer xfer;
+	u8 *tx;
+	u8 *rx;
+};
 
+static int ce5x00_optimize_message(struct spi_message *msg)
+{
+	struct spi_transfer *first, *last, *xfer;
+	struct ce5x00_merged_msg *m;
+	unsigned int len = 0;
+
+	if (list_empty(&msg->transfers) || list_is_singular(&msg->transfers))
+		return 0;
+
+	first = list_first_entry(&msg->transfers, struct spi_transfer, transfer_list);
+	last = list_last_entry(&msg->transfers, struct spi_transfer, transfer_list);
+	list_for_each_entry(xfer, &msg->transfers, transfer_list) {
+		if (xfer->speed_hz != first->speed_hz ||
+		    xfer->bits_per_word != first->bits_per_word ||
+		    xfer->word_delay.value)
+			return 0;
+		if (xfer != last &&
+		    (xfer->cs_change || xfer->delay.value || xfer->cs_off))
+			return 0;
+		len += xfer->len;
+	}
+
+	m = kzalloc(sizeof(*m), GFP_KERNEL);
+	if (!m)
+		return -ENOMEM;
+	m->tx = kzalloc(len, GFP_KERNEL);
+	m->rx = kzalloc(len, GFP_KERNEL);
+	if (!m->tx || !m->rx) {
+		kfree(m->tx);
+		kfree(m->rx);
+		kfree(m);
+		return -ENOMEM;
+	}
+
+	m->xfer.tx_buf = m->tx;
+	m->xfer.rx_buf = m->rx;
+	m->xfer.len = len;
+	m->xfer.speed_hz = first->speed_hz;
+	m->xfer.bits_per_word = first->bits_per_word;
+	m->xfer.delay = last->delay;
+	m->xfer.cs_change = last->cs_change;
+	m->xfer.cs_change_delay = last->cs_change_delay;
+
+	INIT_LIST_HEAD(&m->orig);
+	list_splice_init(&msg->transfers, &m->orig);
+	list_add(&m->xfer.transfer_list, &msg->transfers);
+	msg->opt_state = m;
+
+	return 0;
+}
+
+static int ce5x00_unoptimize_message(struct spi_message *msg)
+{
+	struct ce5x00_merged_msg *m = msg->opt_state;
+
+	if (!m)
+		return 0;
+
+	list_del(&m->xfer.transfer_list);
+	list_splice(&m->orig, &msg->transfers);
+	kfree(m->tx);
+	kfree(m->rx);
+	kfree(m);
+
+	return 0;
+}
+
+static int ce5x00_prepare_message(struct spi_controller *controller,
+				  struct spi_message *msg)
+{
+	struct ce5x00_merged_msg *m = msg->opt_state;
+	struct spi_transfer *xfer;
+	u8 *p;
+
+	if (!m)
+		return 0;
+
+	p = m->tx;
+	list_for_each_entry(xfer, &m->orig, transfer_list) {
+		if (xfer->tx_buf)
+			memcpy(p, xfer->tx_buf, xfer->len);
+		else
+			memset(p, 0, xfer->len);
+		p += xfer->len;
+	}
+
+	return 0;
+}
+
+static int ce5x00_unprepare_message(struct spi_controller *controller,
+				    struct spi_message *msg)
+{
+	struct ce5x00_merged_msg *m = msg->opt_state;
+	struct spi_transfer *xfer;
+	u8 *p;
+
+	if (!m)
+		return 0;
+
+	p = m->rx;
+	list_for_each_entry(xfer, &m->orig, transfer_list) {
+		if (xfer->rx_buf)
+			memcpy(xfer->rx_buf, p, xfer->len);
+		p += xfer->len;
+	}
+
+	return 0;
+}
+
 static void pxa2xx_spi_handle_err(struct spi_controller *controller,
 				 struct spi_message *msg)
 {
