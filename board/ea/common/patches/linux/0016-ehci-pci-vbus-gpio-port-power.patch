usb: ehci-pci: switch a board VBUS GPIO from root-hub port power

The Control4 EA's rear USB port (Intel CE5300, TDI EHCI 01:0d.1) has its 5 V
behind a load switch on SoC GPIO 44. Nothing in the controller knows about it:
the stock kernel's closed board driver simply drove the line high at boot.
Measured on an EA3: low, the port sees nothing (PORTSC SE0, no connect);
high, a USB stick enumerates as high-speed; low again, it disconnects.

Hogging the line high would work but takes the port out of Linux's hands.
Instead, read an optional vbus-gpios from the controller's device-tree node
(the board DTB, patch 0015) and drive it from the ehci .port_power hook --
the same hook chipidea uses for its VBUS regulator. Root-hub port power then
switches real VBUS, so the port's "disable" attribute, uhubctl and port
power-off work as on any hub with per-port power switching.

Advertising that needs HCS_PPC in the root hub descriptor; without it
usbcore never sends PORT_POWER at all. The board switches power even if the
controller cannot, so set the bit in the cached hcs_params when a VBUS GPIO
is present (writes to a read-only PORTSC.PP are ignored). Only for
single-port controllers: one switch cannot follow several ports, so a
multi-port controller just gets VBUS on.

A GPIO and not a regulator because the EA slot kernel sits ~40 KB under
CEFDK's bootlinux copy window, and the regulator core would not fit.

Author: Joseph Telaak <joseph@telaak.dev>
---
--- a/drivers/usb/host/ehci-pci.c
+++ b/drivers/usb/host/ehci-pci.c
@@ -5,6 +5,7 @@
  * Copyright (c) 2000-2004 by David Brownell
  */
 
+#include <linux/gpio/consumer.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/pci.h>
@@ -86,6 +87,59 @@
 }
 
 /* called during probe() after chip reset completes */
+/*
+ * Board-switched VBUS. Some boards put a port's 5 V behind a load switch on a
+ * GPIO the controller knows nothing about (Control4 EA: the rear USB port on
+ * an Intel CE5300, whose stock kernel just drove the line high at boot). Given
+ * vbus-gpios on the controller's device-tree node, root-hub port power drives
+ * that switch, so usbcore's port power control -- the port's "disable"
+ * attribute, uhubctl, port power-off -- really cuts VBUS.
+ */
+struct ehci_pci_priv {
+	struct gpio_desc	*vbus;	/* board VBUS switch, or NULL */
+};
+
+static int ehci_pci_port_power(struct usb_hcd *hcd, int portnum, bool enable)
+{
+	struct ehci_pci_priv *priv = (struct ehci_pci_priv *)hcd_to_ehci(hcd)->priv;
+
+	if (priv->vbus)
+		gpiod_set_value_cansleep(priv->vbus, enable);
+	return 0;
+}
+
+static int ehci_pci_vbus_setup(struct ehci_hcd *ehci, struct pci_dev *pdev)
+{
+	struct ehci_pci_priv *priv = (struct ehci_pci_priv *)ehci->priv;
+	struct gpio_desc *vbus;
+
+	/* Off until the root hub powers the port. */
+	vbus = devm_gpiod_get_optional(&pdev->dev, "vbus", GPIOD_OUT_LOW);
+	if (IS_ERR(vbus))
+		return dev_err_probe(&pdev->dev, PTR_ERR(vbus),
+				     "cannot get VBUS gpio\n");
+	if (!vbus)
+		return 0;
+
+	/* One switch cannot follow several ports' power; just keep it on. */
+	if (HCS_N_PORTS(ehci->hcs_params) != 1) {
+		ehci_warn(ehci, "vbus-gpios on a %d-port controller, leaving VBUS on\n",
+			  HCS_N_PORTS(ehci->hcs_params));
+		gpiod_set_value_cansleep(vbus, 1);
+		return 0;
+	}
+
+	/*
+	 * The board switches port power even where the controller cannot, so
+	 * advertise per-port power switching (HCS_PPC) in the root hub. Without
+	 * it usbcore never sends SET/CLEAR_FEATURE(PORT_POWER), and VBUS would
+	 * stay off. Writes to a read-only PORTSC.PP are ignored by the hardware.
+	 */
+	priv->vbus = vbus;
+	ehci->hcs_params |= 1 << 4;
+	return 0;
+}
+
 static int ehci_pci_setup(struct usb_hcd *hcd)
 {
 	struct ehci_hcd		*ehci = hcd_to_ehci(hcd);
@@ -272,6 +326,10 @@
 	}
 
 	retval = ehci_setup(hcd);
+	if (retval)
+		return retval;
+
+	retval = ehci_pci_vbus_setup(ehci, pdev);
 	if (retval)
 		return retval;
 
@@ -388,7 +446,9 @@
 static struct hc_driver __read_mostly ehci_pci_hc_driver;
 
 static const struct ehci_driver_overrides pci_overrides __initconst = {
+	.extra_priv_size =	sizeof(struct ehci_pci_priv),
 	.reset =		ehci_pci_setup,
+	.port_power =		ehci_pci_port_power,
 };
 
 /*-------------------------------------------------------------------------*/
