e1000: attach a CE4100 PHY through phylink

If the device's OF node has a phy-handle, register the MAC's MDIO bus
from the node's "mdio" child and let phylink connect the PHY when the
interface is opened. The bus exists only while phylink owns the PHY and
e1000's own PHY accesses are refused, so the bus lock serializes the MDIO
accesses, which wait for completion sleeping. The bus is unregistered
before the MDIO registers are unmapped.

Without a phy-handle, nothing changes.

Author: Joseph Telaak <joseph@telaak.dev>
---
diff --git a/drivers/net/ethernet/intel/e1000/e1000.h b/drivers/net/ethernet/intel/e1000/e1000.h
index 0c1986e..348e2ab 100644
--- a/drivers/net/ethernet/intel/e1000/e1000.h
+++ b/drivers/net/ethernet/intel/e1000/e1000.h
@@ -42,6 +42,7 @@
 #include <linux/mii.h>
 #include <linux/ethtool.h>
 #include <linux/if_vlan.h>
+#include <linux/phy.h>
 #include <linux/phylink.h>
 
 #define BAR_0		0
@@ -273,6 +274,7 @@ struct e1000_adapter {
 
 	/* structs defined in e1000_hw.h */
 	struct e1000_hw hw;
+	struct mii_bus *mii_bus;
 	struct phylink *phylink;
 	struct phylink_config phylink_config;
 	/* phylink's link state vs. MAC resets and TX enable */
diff --git a/drivers/net/ethernet/intel/e1000/e1000_hw.c b/drivers/net/ethernet/intel/e1000/e1000_hw.c
index fddcb14..60c1501 100644
--- a/drivers/net/ethernet/intel/e1000/e1000_hw.c
+++ b/drivers/net/ethernet/intel/e1000/e1000_hw.c
@@ -6,6 +6,7 @@
  */
 
 #include <linux/bitfield.h>
+#include <linux/iopoll.h>
 #include "e1000.h"
 
 static s32 e1000_check_downshift(struct e1000_hw *hw);
@@ -2835,6 +2836,61 @@ static u16 e1000_shift_in_mdi_bits(struct e1000_hw *hw)
 	return data;
 }
 
+/* The CE4100 MDIO bus is only registered while phylink owns the PHY, and
+ * e1000's own PHY accesses are refused then: the bus lock serializes these.
+ */
+static int e1000_ce4100_mdio_cmd(struct e1000_hw *hw, u32 cmd)
+{
+	u32 val;
+
+	writel(cmd | INTEL_CE_GBE_MDIC_GO, E1000_MDIO_CMD);
+
+	return readl_poll_timeout(E1000_MDIO_CMD, val,
+				  !(val & INTEL_CE_GBE_MDIC_GO), 50, 3200);
+}
+
+/**
+ * e1000_ce4100_mdio_read - read a register of a PHY on the CE4100 MDIO bus
+ * @hw: Struct containing variables accessed by shared code
+ * @addr: PHY address
+ * @reg: register number
+ *
+ * Return: the register value, or a negative error code.
+ */
+int e1000_ce4100_mdio_read(struct e1000_hw *hw, int addr, int reg)
+{
+	int ret;
+	u32 sts;
+
+	ret = e1000_ce4100_mdio_cmd(hw, (reg << E1000_MDIC_REG_SHIFT) |
+				    (addr << E1000_MDIC_PHY_SHIFT) |
+				    INTEL_CE_GBE_MDIC_OP_READ);
+	if (ret)
+		return ret;
+
+	sts = readl(E1000_MDIO_STS);
+	if (sts & INTEL_CE_GBE_MDIC_READ_ERROR)
+		return -EIO;
+
+	return sts & 0xffff;
+}
+
+/**
+ * e1000_ce4100_mdio_write - write a register of a PHY on the CE4100 MDIO bus
+ * @hw: Struct containing variables accessed by shared code
+ * @addr: PHY address
+ * @reg: register number
+ * @val: value to write
+ *
+ * Return: 0, or a negative error code.
+ */
+int e1000_ce4100_mdio_write(struct e1000_hw *hw, int addr, int reg, u16 val)
+{
+	return e1000_ce4100_mdio_cmd(hw, val | (reg << E1000_MDIC_REG_SHIFT) |
+				     (addr << E1000_MDIC_PHY_SHIFT) |
+				     INTEL_CE_GBE_MDIC_OP_WRITE);
+}
+
 /**
  * e1000_read_phy_reg - read a phy register
  * @hw: Struct containing variables accessed by shared code
diff --git a/drivers/net/ethernet/intel/e1000/e1000_hw.h b/drivers/net/ethernet/intel/e1000/e1000_hw.h
index c28f811..acdd12a 100644
--- a/drivers/net/ethernet/intel/e1000/e1000_hw.h
+++ b/drivers/net/ethernet/intel/e1000/e1000_hw.h
@@ -273,6 +273,8 @@ void e1000_set_media_type(struct e1000_hw *hw);
 s32 e1000_setup_link(struct e1000_hw *hw);
 s32 e1000_setup_forced_link(struct e1000_hw *hw);
 void e1000_set_fc_watermarks(struct e1000_hw *hw);
+int e1000_ce4100_mdio_read(struct e1000_hw *hw, int addr, int reg);
+int e1000_ce4100_mdio_write(struct e1000_hw *hw, int addr, int reg, u16 val);
 s32 e1000_phy_setup_autoneg(struct e1000_hw *hw);
 void e1000_config_collision_dist(struct e1000_hw *hw);
 s32 e1000_check_for_link(struct e1000_hw *hw);
diff --git a/drivers/net/ethernet/intel/e1000/e1000_main.c b/drivers/net/ethernet/intel/e1000/e1000_main.c
index 5a493f2..3f6f678 100644
--- a/drivers/net/ethernet/intel/e1000/e1000_main.c
+++ b/drivers/net/ethernet/intel/e1000/e1000_main.c
@@ -928,6 +928,72 @@ static int e1000_init_hw_struct(struct e1000_adapter *adapter,
 	return 0;
 }
 
+static int e1000_mdio_read(struct mii_bus *bus, int addr, int reg)
+{
+	return e1000_ce4100_mdio_read(bus->priv, addr, reg);
+}
+
+static int e1000_mdio_write(struct mii_bus *bus, int addr, int reg, u16 val)
+{
+	return e1000_ce4100_mdio_write(bus->priv, addr, reg, val);
+}
+
+/**
+ * e1000_mdio_register - register the CE4100 MDIO bus from the device tree
+ * @adapter: board private structure
+ *
+ * Register the MAC's MDIO bus with the PHYs its "mdio" child node
+ * describes, so that their drivers probe. The bus goes before the MAC's
+ * registers are unmapped, so it is not device-managed.
+ *
+ * Return: 0 on success, else an error.
+ */
+static int e1000_mdio_register(struct e1000_adapter *adapter)
+{
+	struct device *dev = &adapter->pdev->dev;
+	struct device_node *np;
+	struct mii_bus *bus;
+	int err;
+
+	np = of_get_child_by_name(dev->of_node, "mdio");
+	if (!np) {
+		e_dev_err("phy-handle needs an mdio node\n");
+		return -EINVAL;
+	}
+
+	bus = mdiobus_alloc();
+	if (!bus) {
+		err = -ENOMEM;
+		goto out;
+	}
+
+	bus->name = "e1000 CE4100 MDIO";
+	snprintf(bus->id, MII_BUS_ID_SIZE, "%s", pci_name(adapter->pdev));
+	bus->priv = &adapter->hw;
+	bus->parent = dev;
+	bus->read = e1000_mdio_read;
+	bus->write = e1000_mdio_write;
+
+	err = of_mdiobus_register(bus, np);
+	if (err)
+		mdiobus_free(bus);
+	else
+		adapter->mii_bus = bus;
+out:
+	of_node_put(np);
+	return err;
+}
+
+static void e1000_mdio_unregister(struct e1000_adapter *adapter)
+{
+	if (!adapter->mii_bus)
+		return;
+
+	mdiobus_unregister(adapter->mii_bus);
+	mdiobus_free(adapter->mii_bus);
+	adapter->mii_bus = NULL;
+}
+
 static struct e1000_adapter *e1000_from_phylink(struct phylink_config *config)
 {
 	return netdev_priv(to_net_dev(config->dev));
@@ -997,9 +1063,10 @@ static const struct phylink_mac_ops e1000_phylink_mac_ops = {
  * e1000_phylink_init - hand the link of a CE4100 to phylink
  * @adapter: board private structure
  *
- * If the device's OF node has a fixed-link, let phylink manage the link
- * and force the MAC to whatever it resolves. Without one, the MAC
- * manages its PHY itself as before.
+ * If the device's OF node has a fixed-link or a phy-handle, let phylink
+ * manage the link and force the MAC to whatever it resolves. A PHY is
+ * found on the MAC's own MDIO bus, which is registered for it. Without
+ * either property, the MAC manages its PHY itself as before.
  *
  * Return: 0 if phylink is not used or is set up, else an error.
  */
@@ -1010,8 +1077,10 @@ static int e1000_phylink_init(struct e1000_adapter *adapter)
 	struct e1000_hw *hw = &adapter->hw;
 	phy_interface_t interface;
 	struct phylink *phylink;
+	int err;
 
-	if (!np || !of_phy_is_fixed_link(np))
+	if (!np || (!of_phy_is_fixed_link(np) &&
+		    !of_property_present(np, "phy-handle")))
 		return 0;
 
 	if (of_get_phy_mode(np, &interface) ||
@@ -1027,10 +1096,18 @@ static int e1000_phylink_init(struct e1000_adapter *adapter)
 				   MAC_100 | MAC_1000FD;
 	phy_interface_set_rgmii(config->supported_interfaces);
 
+	if (of_property_present(np, "phy-handle")) {
+		err = e1000_mdio_register(adapter);
+		if (err)
+			return err;
+	}
+
 	phylink = phylink_create(config, of_fwnode_handle(np), interface,
 				 &e1000_phylink_mac_ops);
-	if (IS_ERR(phylink))
+	if (IS_ERR(phylink)) {
+		e1000_mdio_unregister(adapter);
 		return PTR_ERR(phylink);
+	}
 
 	adapter->phylink = phylink;
 	hw->phylink = true;
@@ -1051,6 +1128,7 @@ static void e1000_phylink_destroy(struct e1000_adapter *adapter)
 
 	phylink_destroy(adapter->phylink);
 	adapter->phylink = NULL;
+	e1000_mdio_unregister(adapter);
 }
 
 /**
@@ -1525,6 +1603,13 @@ int e1000_open(struct net_device *netdev)
 
 	netif_carrier_off(netdev);
 
+	if (adapter->phylink) {
+		err = phylink_of_phy_connect(adapter->phylink,
+					     adapter->pdev->dev.of_node, 0);
+		if (err)
+			return err;
+	}
+
 	/* allocate transmit descriptors */
 	err = e1000_setup_all_tx_resources(adapter);
 	if (err)
@@ -1581,6 +1666,8 @@ err_setup_rx:
 	e1000_free_all_tx_resources(adapter);
 err_setup_tx:
 	e1000_reset(adapter);
+	if (adapter->phylink)
+		phylink_disconnect_phy(adapter->phylink);
 
 	return err;
 }
@@ -1611,8 +1698,10 @@ int e1000_close(struct net_device *netdev)
 	set_bit(__E1000_DOWN, &adapter->flags);
 	clear_bit(__E1000_RESETTING, &adapter->flags);
 
-	if (adapter->phylink)
+	if (adapter->phylink) {
 		phylink_stop(adapter->phylink);
+		phylink_disconnect_phy(adapter->phylink);
+	}
 
 	e1000_down(adapter);
 	e1000_power_down_phy(adapter);
