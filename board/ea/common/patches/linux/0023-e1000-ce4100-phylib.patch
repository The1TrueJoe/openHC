diff --git a/drivers/net/ethernet/intel/e1000/e1000_main.c b/drivers/net/ethernet/intel/e1000/e1000_main.c
index 0e7f40e..00e8813 100644
--- a/drivers/net/ethernet/intel/e1000/e1000_main.c
+++ b/drivers/net/ethernet/intel/e1000/e1000_main.c
@@ -1033,6 +1033,75 @@ static void e1000_mdio_unregister(struct e1000_adapter *adapter)
 	adapter->mii_bus = NULL;
 }
 
+static void e1000_adjust_link(struct net_device *netdev)
+{
+	struct e1000_adapter *adapter = netdev_priv(netdev);
+	struct phy_device *phydev = netdev->phydev;
+	struct e1000_hw *hw = &adapter->hw;
+	bool full_duplex = phydev->duplex == DUPLEX_FULL;
+
+	if (phydev->link && (phydev->speed != hw->fixed_link_speed ||
+			     full_duplex != hw->fixed_link_full_duplex)) {
+		hw->fixed_link_speed = phydev->speed;
+		hw->fixed_link_full_duplex = full_duplex;
+		e1000_setup_fixed_link(hw);
+	}
+
+	phy_print_status(phydev);
+}
+
+/**
+ * e1000_connect_phy - attach the PHY a phy-handle points to
+ * @adapter: board private structure
+ *
+ * If the device has a phy-handle, let phylib drive that PHY and force the
+ * MAC to the speed and duplex phylib reports, as for a fixed link. Without
+ * one, or without OF_MDIO, the MAC drives its PHY itself as before.
+ *
+ * Return: 0 if there is no phy-handle or the PHY is attached, else an error.
+ */
+static int e1000_connect_phy(struct e1000_adapter *adapter)
+{
+	struct device_node *np = adapter->pdev->dev.of_node;
+	struct e1000_hw *hw = &adapter->hw;
+	phy_interface_t interface;
+	struct device_node *phy_np;
+	struct phy_device *phydev;
+	int err = -EINVAL;
+
+	if (!IS_REACHABLE(CONFIG_OF_MDIO))
+		return 0;
+
+	phy_np = of_parse_phandle(np, "phy-handle", 0);
+	if (!phy_np)
+		return 0;
+
+	if (of_get_phy_mode(np, &interface) ||
+	    !phy_interface_mode_is_rgmii(interface)) {
+		e_dev_err("phy-handle needs an rgmii phy-mode\n");
+		goto out;
+	}
+
+	phydev = of_phy_connect(adapter->netdev, phy_np, e1000_adjust_link, 0,
+				interface);
+	if (!phydev) {
+		err = -ENODEV;
+		goto out;
+	}
+
+	hw->fixed_link = true;
+	hw->fixed_link_speed = SPEED_1000;
+	hw->fixed_link_full_duplex = true;
+	hw->autoneg = 0;
+	adapter->fc_autoneg = 0;
+	hw->fc = E1000_FC_NONE;
+	hw->original_fc = hw->fc;
+	err = 0;
+out:
+	of_node_put(phy_np);
+	return err;
+}
+
 /**
  * e1000_probe - Device Initialization Routine
  * @pdev: PCI device information struct
@@ -1310,6 +1379,8 @@ static int e1000_probe(struct pci_dev *pdev, const struct pci_device_id *ent)
 		err = e1000_get_fixed_link(adapter);
 		if (!err)
 			err = e1000_mdio_register(adapter);
+		if (!err && !hw->fixed_link)
+			err = e1000_connect_phy(adapter);
 		if (err)
 			goto err_eeprom;
 	}
@@ -1359,6 +1430,8 @@ static int e1000_probe(struct pci_dev *pdev, const struct pci_device_id *ent)
 	return 0;
 
 err_register:
+	if (e1000_phydev(netdev))
+		phy_disconnect(netdev->phydev);
 err_eeprom:
 	e1000_phy_hw_reset(hw);
 	e1000_mdio_unregister(adapter);
@@ -1404,6 +1477,9 @@ static void e1000_remove(struct pci_dev *pdev)
 
 	unregister_netdev(netdev);
 
+	if (e1000_phydev(netdev))
+		phy_disconnect(netdev->phydev);
+
 	/* Only kill reset task if adapter is not resetting */
 	if (!test_bit(__E1000_RESETTING, &adapter->flags))
 		cancel_work_sync(&adapter->reset_task);
@@ -1549,6 +1625,9 @@ int e1000_open(struct net_device *netdev)
 	/* fire a link status change interrupt to start the watchdog */
 	ew32(ICS, E1000_ICS_LSC);
 
+	if (e1000_phydev(netdev))
+		phy_start(netdev->phydev);
+
 	return E1000_SUCCESS;
 
 err_req_irq:
@@ -1588,6 +1667,9 @@ int e1000_close(struct net_device *netdev)
 	set_bit(__E1000_DOWN, &adapter->flags);
 	clear_bit(__E1000_RESETTING, &adapter->flags);
 
+	if (e1000_phydev(netdev))
+		phy_stop(netdev->phydev);
+
 	e1000_down(adapter);
 	e1000_power_down_phy(adapter);
 	e1000_free_irq(adapter);
@@ -2530,8 +2612,12 @@ static void e1000_82547_tx_fifo_stall_task(struct work_struct *work)
 bool e1000_has_link(struct e1000_adapter *adapter)
 {
 	struct e1000_hw *hw = &adapter->hw;
+	struct phy_device *phydev = e1000_phydev(adapter->netdev);
 	bool link_active = false;
 
+	if (phydev)
+		return phydev->link;
+
 	/* get_link_status is set on LSC (link status) interrupt or rx
 	 * sequence error interrupt (except on intel ce4100).
 	 * get_link_status will stay false until the
@@ -4912,6 +4998,9 @@ static int e1000_mii_ioctl(struct net_device *netdev, struct ifreq *ifr,
 	u16 mii_reg;
 	unsigned long flags;
 
+	if (e1000_phydev(netdev))
+		return phy_mii_ioctl(netdev->phydev, ifr, cmd);
+
 	if (hw->media_type != e1000_media_type_copper || hw->fixed_link)
 		return -EOPNOTSUPP;
 
