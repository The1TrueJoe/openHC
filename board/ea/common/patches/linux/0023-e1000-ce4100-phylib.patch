e1000: attach a CE4100 PHY through phylib

If the device's OF node has a phy-handle, attach that PHY with phylib
instead of driving it from e1000, and force the MAC to the speed and
duplex phylib reports, as for a fixed link. Only rgmii phy modes are
accepted, since the MAC adds no delays. Link state, ethtool link
settings, autonegotiation restart and the MII ioctls go to phylib.
Without a phy-handle, or without OF_MDIO, nothing changes.

Author: Joseph Telaak <joseph@telaak.dev>
---
diff --git a/drivers/net/ethernet/intel/e1000/e1000.h b/drivers/net/ethernet/intel/e1000/e1000.h
index 40182ab..bc2efab 100644
--- a/drivers/net/ethernet/intel/e1000/e1000.h
+++ b/drivers/net/ethernet/intel/e1000/e1000.h
@@ -54,6 +54,12 @@ struct e1000_adapter;
 
 #include "e1000_hw.h"
 
+/* The PHY phylib drives through the CE4100 MDIO bus, if any */
+static inline struct phy_device *e1000_phydev(struct net_device *netdev)
+{
+	return IS_REACHABLE(CONFIG_OF_MDIO) ? netdev->phydev : NULL;
+}
+
 #define E1000_MAX_INTR			10
 
 /*
diff --git a/drivers/net/ethernet/intel/e1000/e1000_ethtool.c b/drivers/net/ethernet/intel/e1000/e1000_ethtool.c
index 009ba6f..9dad235 100644
--- a/drivers/net/ethernet/intel/e1000/e1000_ethtool.c
+++ b/drivers/net/ethernet/intel/e1000/e1000_ethtool.c
@@ -133,6 +133,11 @@ static int e1000_get_link_ksettings(struct net_device *netdev,
 	struct e1000_hw *hw = &adapter->hw;
 	u32 supported, advertising;
 
+	if (e1000_phydev(netdev)) {
+		phy_ethtool_ksettings_get(netdev->phydev, cmd);
+		return 0;
+	}
+
 	if (hw->fixed_link)
 		return e1000_get_fixed_link_ksettings(netdev, cmd);
 
@@ -214,6 +219,9 @@ static int e1000_set_link_ksettings(struct net_device *netdev,
 	struct e1000_hw *hw = &adapter->hw;
 	u32 advertising;
 
+	if (e1000_phydev(netdev))
+		return phy_ethtool_ksettings_set(netdev->phydev, cmd);
+
 	/* Speed and duplex of a fixed link come from firmware */
 	if (hw->fixed_link) {
 		u8 duplex = hw->fixed_link_full_duplex ? DUPLEX_FULL :
@@ -1875,6 +1883,9 @@ static int e1000_nway_reset(struct net_device *netdev)
 {
 	struct e1000_adapter *adapter = netdev_priv(netdev);
 
+	if (e1000_phydev(netdev))
+		return phy_restart_aneg(netdev->phydev);
+
 	if (netif_running(netdev))
 		e1000_reinit_locked(adapter);
 	return 0;
