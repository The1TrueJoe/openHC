diff --git a/drivers/net/ethernet/intel/e1000/e1000_hw.h b/drivers/net/ethernet/intel/e1000/e1000_hw.h
index 6f336b9..f2a0350 100644
--- a/drivers/net/ethernet/intel/e1000/e1000_hw.h
+++ b/drivers/net/ethernet/intel/e1000/e1000_hw.h
@@ -271,6 +271,7 @@ void e1000_set_media_type(struct e1000_hw *hw);
 
 /* Link Configuration */
 s32 e1000_setup_link(struct e1000_hw *hw);
+s32 e1000_setup_fixed_link(struct e1000_hw *hw);
 int e1000_ce4100_mdio_read(struct e1000_hw *hw, int addr, int reg);
 int e1000_ce4100_mdio_write(struct e1000_hw *hw, int addr, int reg, u16 val);
 s32 e1000_phy_setup_autoneg(struct e1000_hw *hw);
