+/**
+ * e1000_phylink_init - hand the link of a CE4100 to phylink
+ * @adapter: board private structure
+ *
+ * If the device's OF node has a fixed-link, let phylink manage the link
+ * and force the MAC to whatever it resolves. Without one, the MAC
+ * manages its PHY itself as before.
+ *
+ * Return: 0 if phylink is not used or is set up, else an error.
+ */
+static int e1000_phylink_init(struct e1000_adapter *adapter)
+{
+	struct device_node *np = adapter->pdev->dev.of_node;
+	struct phylink_config *config = &adapter->phylink_config;
+	struct e1000_hw *hw = &adapter->hw;
+	phy_interface_t interface;
+	struct phylink *phylink;
+
+	if (!np || !of_phy_is_fixed_link(np))
+		return 0;
+
+	if (of_get_phy_mode(np, &interface) ||
+	    !phy_interface_mode_is_rgmii(interface)) {
+		e_dev_err("phylink needs an rgmii phy-mode\n");
+		return -EINVAL;
+	}
+
+	config->dev = &adapter->netdev->dev;
+	config->type = PHYLINK_NETDEV;
+	config->mac_managed_pm = true;
+	config->mac_capabilities = MAC_SYM_PAUSE | MAC_ASYM_PAUSE | MAC_10 |
+				   MAC_100 | MAC_1000FD;
+	phy_interface_set_rgmii(config->supported_interfaces);
+
+	phylink = phylink_create(config, of_fwnode_handle(np), interface,
+				 &e1000_phylink_mac_ops);
+	if (IS_ERR(phylink))
+		return PTR_ERR(phylink);
+
+	adapter->phylink = phylink;
+	hw->phylink = true;
+	hw->forced_speed = SPEED_1000;
+	hw->forced_full_duplex = true;
+	hw->autoneg = 0;
+	adapter->fc_autoneg = 0;
+	hw->fc = E1000_FC_NONE;
+	hw->original_fc = hw->fc;
+
+	return 0;
+}
+
+static void e1000_phylink_destroy(struct e1000_adapter *adapter)
+{
+	if (!adapter->phylink)
+		return;
+
+	phylink_destroy(adapter->phylink);
+	adapter->phylink = NULL;
+}
