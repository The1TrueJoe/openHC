+static struct e1000_adapter *e1000_from_phylink(struct phylink_config *config)
+{
+	return netdev_priv(to_net_dev(config->dev));
+}
+
+static void e1000_mac_config(struct phylink_config *config, unsigned int mode,
+			     const struct phylink_link_state *state)
+{
+}
+
+static void e1000_mac_link_down(struct phylink_config *config,
+				unsigned int mode, phy_interface_t interface)
+{
+	struct e1000_adapter *adapter = e1000_from_phylink(config);
+	struct e1000_hw *hw = &adapter->hw;
+
+	mutex_lock(&adapter->phylink_lock);
+	adapter->phylink_up = false;
+	adapter->link_speed = 0;
+	adapter->link_duplex = 0;
+	ew32(TCTL, er32(TCTL) & ~E1000_TCTL_EN);
+	mutex_unlock(&adapter->phylink_lock);
+}
+
+static void e1000_mac_link_up(struct phylink_config *config,
+			      struct phy_device *phy, unsigned int mode,
+			      phy_interface_t interface, int speed, int duplex,
+			      bool tx_pause, bool rx_pause)
+{
+	struct e1000_adapter *adapter = e1000_from_phylink(config);
+	struct e1000_hw *hw = &adapter->hw;
+
+	mutex_lock(&adapter->phylink_lock);
+	hw->forced_speed = speed;
+	hw->forced_full_duplex = duplex == DUPLEX_FULL;
+	if (tx_pause && rx_pause)
+		hw->fc = E1000_FC_FULL;
+	else if (tx_pause)
+		hw->fc = E1000_FC_TX_PAUSE;
+	else if (rx_pause)
+		hw->fc = E1000_FC_RX_PAUSE;
+	else
+		hw->fc = E1000_FC_NONE;
+	hw->original_fc = hw->fc;
+
+	e1000_setup_forced_link(hw);
+	e1000_set_fc_watermarks(hw);
+
+	adapter->link_speed = speed;
+	adapter->link_duplex = duplex == DUPLEX_FULL ? FULL_DUPLEX :
+						       HALF_DUPLEX;
+	adapter->tx_timeout_factor = speed == SPEED_10 ? 16 : 1;
+	adapter->phylink_up = true;
+
+	if (!test_bit(__E1000_DOWN, &adapter->flags))
+		ew32(TCTL, er32(TCTL) | E1000_TCTL_EN);
+	mutex_unlock(&adapter->phylink_lock);
+}
+
+static const struct phylink_mac_ops e1000_phylink_mac_ops = {
+	.mac_config = e1000_mac_config,
+	.mac_link_down = e1000_mac_link_down,
+	.mac_link_up = e1000_mac_link_up,
+};
