+/**
+ * e1000_setup_forced_link - force the MAC to the link phylink resolved
+ * @hw: Struct containing variables accessed by shared code
+ *
+ * phylink owns the link, so set speed, duplex and link up in the MAC from
+ * what it last reported rather than from autonegotiation.
+ */
+s32 e1000_setup_forced_link(struct e1000_hw *hw)
+{
+	u32 ctrl, ctrl_aux;
+
+	ctrl_aux = er32(CTL_AUX);
+	ctrl_aux &= ~E1000_CTL_AUX_RMII;
+	ew32(CTL_AUX, ctrl_aux);
+
+	ctrl = er32(CTRL);
+	ctrl &= ~(E1000_CTRL_ASDE | E1000_CTRL_SPD_SEL | E1000_CTRL_FD);
+	ctrl |= E1000_CTRL_SLU | E1000_CTRL_FRCSPD | E1000_CTRL_FRCDPX;
+
+	switch (hw->forced_speed) {
+	case SPEED_1000:
+		ctrl |= E1000_CTRL_SPD_1000;
+		break;
+	case SPEED_100:
+		ctrl |= E1000_CTRL_SPD_100;
+		break;
+	default:
+		ctrl |= E1000_CTRL_SPD_10;
+		break;
+	}
+
+	if (hw->forced_full_duplex)
+		ctrl |= E1000_CTRL_FD;
+
+	ew32(CTRL, ctrl);
+	E1000_WRITE_FLUSH();
+
+	e1000_config_collision_dist(hw);
+
+	return e1000_force_mac_fc(hw);
+}
