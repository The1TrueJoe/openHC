+static int e1000_mdio_read(struct mii_bus *bus, int addr, int reg)
+{
+	return e1000_ce4100_mdio_read(bus->priv, addr, reg);
+}
+
+static int e1000_mdio_write(struct mii_bus *bus, int addr, int reg, u16 val)
+{
+	return e1000_ce4100_mdio_write(bus->priv, addr, reg, val);
+}
+
+/**
+ * e1000_mdio_register - register the CE4100 MDIO bus from the device tree
+ * @adapter: board private structure
+ *
+ * If the device has an "mdio" child node, register the MAC's MDIO bus with
+ * the PHYs it describes, so that their drivers can probe. Without one,
+ * nothing is registered. The bus goes before the MAC's
+ * registers are unmapped, so it is not device-managed.
+ *
+ * Return: 0 on success or if there is nothing to register, else an error.
+ */
+static int e1000_mdio_register(struct e1000_adapter *adapter)
+{
+	struct device *dev = &adapter->pdev->dev;
+	struct device_node *np;
+	struct mii_bus *bus;
+	int err;
+
+	np = of_get_child_by_name(dev->of_node, "mdio");
+	if (!np)
+		return 0;
+
+	bus = mdiobus_alloc();
+	if (!bus) {
+		err = -ENOMEM;
+		goto out;
+	}
+
+	bus->name = "e1000 CE4100 MDIO";
+	snprintf(bus->id, MII_BUS_ID_SIZE, "%s", pci_name(adapter->pdev));
+	bus->priv = &adapter->hw;
+	bus->parent = dev;
+	bus->read = e1000_mdio_read;
+	bus->write = e1000_mdio_write;
+
+	err = of_mdiobus_register(bus, np);
+	if (err)
+		mdiobus_free(bus);
+	else
+		adapter->mii_bus = bus;
+out:
+	of_node_put(np);
+	return err;
+}
+
+static void e1000_mdio_unregister(struct e1000_adapter *adapter)
+{
+	if (!adapter->mii_bus)
+		return;
+
+	mdiobus_unregister(adapter->mii_bus);
+	mdiobus_free(adapter->mii_bus);
+	adapter->mii_bus = NULL;
+}
