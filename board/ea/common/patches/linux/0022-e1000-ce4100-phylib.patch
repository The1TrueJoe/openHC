@@ -1515,6 +1671,9 @@ int e1000_close(struct net_device *netdev)
 	set_bit(__E1000_DOWN, &adapter->flags);
 	clear_bit(__E1000_RESETTING, &adapter->flags);
 
+	if (e1000_phydev(netdev))
+		phy_stop(netdev->phydev);
+
 	e1000_down(adapter);
