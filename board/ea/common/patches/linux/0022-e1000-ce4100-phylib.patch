 #include <linux/phy.h>
 
 char e1000_driver_name[] = "e1000";
@@ -964,6 +966,150 @@ out:
 	return err;
 }
 
+static int e1000_ce4100_mdio_wait(struct e1000_hw *hw)
+{
+	u32 cmd;
+
+	return readl_poll_timeout(E1000_MDIO_CMD, cmd,
+				  !(cmd & INTEL_CE_GBE_MDIC_GO), 50, 3200);
+}
+
+static int e1000_ce4100_mdio_read(struct mii_bus *bus, int addr, int reg)
+{
+	struct e1000_hw *hw = bus->priv;
+	int err;
+	u32 sts;
+
+	writel((reg << E1000_MDIC_REG_SHIFT) | (addr << E1000_MDIC_PHY_SHIFT) |
+	       INTEL_CE_GBE_MDIC_OP_READ | INTEL_CE_GBE_MDIC_GO,
+	       E1000_MDIO_CMD);
+	err = e1000_ce4100_mdio_wait(hw);
+	if (err)
+		return err;
+
+	sts = readl(E1000_MDIO_STS);
+	if (sts & INTEL_CE_GBE_MDIC_READ_ERROR)
+		return -EIO;
+
+	return sts & 0xffff;
+}
+
+static int e1000_ce4100_mdio_write(struct mii_bus *bus, int addr, int reg,
+				   u16 val)
+{
+	struct e1000_hw *hw = bus->priv;
+
+	writel(val | (reg << E1000_MDIC_REG_SHIFT) |
+	       (addr << E1000_MDIC_PHY_SHIFT) |
+	       INTEL_CE_GBE_MDIC_OP_WRITE | INTEL_CE_GBE_MDIC_GO,
+	       E1000_MDIO_CMD);
+
+	return e1000_ce4100_mdio_wait(hw);
+}
+
+static void e1000_adjust_link(struct net_device *netdev)
+{
+	struct e1000_adapter *adapter = netdev_priv(netdev);
+	struct phy_device *phydev = netdev->phydev;
+	struct e1000_hw *hw = &adapter->hw;
+	bool full_duplex = phydev->duplex == DUPLEX_FULL;
+
+	if (phydev->link && (phydev->speed != hw->fixed_link_speed ||
+			     full_duplex != hw->fixed_link_full_duplex)) {
+		hw->fixed_link_speed = phydev->speed;
+		hw->fixed_link_full_duplex = full_duplex;
+		e1000_setup_fixed_link(hw);
+	}
+
+	phy_print_status(phydev);
+}
+
+/**
+ * e1000_get_phy - attach the PHY a phy-handle points to
+ * @adapter: board private structure
+ *
+ * Some boards wire the MAC to an RGMII PHY on its MDIO bus. If the device
+ * has a phy-handle, register the MDIO bus from the "mdio" child node and
+ * let phylib drive the PHY. The MAC is forced to the speed and duplex
+ * phylib reports, as for a fixed link. Without OF_MDIO the phy-handle is
+ * ignored.
+ *
+ * Return: 0 if there is no phy-handle or the PHY is attached, else an error.
+ */
+static int e1000_get_phy(struct e1000_adapter *adapter)
+{
+	struct device_node *np = adapter->pdev->dev.of_node;
+	struct device *dev = &adapter->pdev->dev;
+	struct e1000_hw *hw = &adapter->hw;
+	struct device_node *mdio, *phy_np;
+	phy_interface_t interface;
+	struct phy_device *phydev;
+	struct mii_bus *bus;
+	int err = -EINVAL;
+
+	phy_np = of_parse_phandle(np, "phy-handle", 0);
+	if (!phy_np)
+		return 0;
+
+	/* Without phylib, the PHY scan finds and drives the PHY as before */
+	if (!IS_REACHABLE(CONFIG_OF_MDIO)) {
+		err = 0;
+		goto out;
+	}
+
+	if (of_get_phy_mode(np, &interface) ||
+	    !phy_interface_mode_is_rgmii(interface)) {
+		e_dev_err("phy-handle needs an rgmii phy-mode\n");
+		goto out;
+	}
+
+	mdio = of_get_child_by_name(np, "mdio");
+	if (!mdio) {
+		e_dev_err("phy-handle needs an mdio node\n");
+		goto out;
+	}
+
+	bus = devm_mdiobus_alloc(dev);
+	if (!bus) {
+		of_node_put(mdio);
+		err = -ENOMEM;
+		goto out;
+	}
+
+	bus->name = "e1000 CE4100 MDIO";
+	snprintf(bus->id, MII_BUS_ID_SIZE, "%s", pci_name(adapter->pdev));
+	bus->priv = hw;
+	bus->parent = dev;
+	bus->read = e1000_ce4100_mdio_read;
+	bus->write = e1000_ce4100_mdio_write;
+
+	err = devm_of_mdiobus_register(dev, bus, mdio);
+	of_node_put(mdio);
+	if (err)
+		goto out;
+
+	phydev = of_phy_connect(adapter->netdev, phy_np, e1000_adjust_link, 0,
+				interface);
+	if (!phydev) {
+		err = -ENODEV;
+		goto out;
+	}
+	/* The MAC has no LPI support */
+	phy_disable_eee(phydev);
+
+	hw->fixed_link = true;
+	hw->fixed_link_speed = SPEED_1000;
+	hw->fixed_link_full_duplex = true;
+	hw->autoneg = 0;
+	adapter->fc_autoneg = 0;
+	hw->fc = E1000_FC_NONE;
+	hw->original_fc = hw->fc;
+	err = 0;
+out:
+	of_node_put(phy_np);
+	return err;
+}
+
 /**
  * e1000_probe - Device Initialization Routine
