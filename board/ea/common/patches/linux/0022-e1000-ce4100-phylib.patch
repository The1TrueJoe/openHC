 	e1000_free_irq(adapter);
@@ -2457,8 +2616,12 @@ static void e1000_82547_tx_fifo_stall_task(struct work_struct *work)
 bool e1000_has_link(struct e1000_adapter *adapter)
 {
 	struct e1000_hw *hw = &adapter->hw;
+	struct phy_device *phydev = e1000_phydev(adapter->netdev);
 	bool link_active = false;
 
+	if (phydev)
+		return phydev->link;
+
 	/* get_link_status is set on LSC (link status) interrupt or rx
 	 * sequence error interrupt (except on intel ce4100).
 	 * get_link_status will stay false until the
@@ -4839,6 +5002,9 @@ static int e1000_mii_ioctl(struct net_device *netdev, struct ifreq *ifr,
 	u16 mii_reg;
 	unsigned long flags;
 
+	if (e1000_phydev(netdev))
+		return phy_mii_ioctl(netdev->phydev, ifr, cmd);
+
 	if (hw->media_type != e1000_media_type_copper || hw->fixed_link)
 		return -EOPNOTSUPP;
 
