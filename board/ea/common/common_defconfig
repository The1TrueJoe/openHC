# openHC — EA family base, composed by build/build.sh (last assignment wins).
# Background for every setting here: docs ea/board-config.

# --- arch: x86_64 (every EA is a CE5310) ---
BR2_x86_64=y
BR2_x86_bonnell=y

# objtool needs host <gelf.h>; without it the kernel build fails on a host header.
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# The only opt-in for board/ea/common/kernel/{drivers,sound}; check here if they are missing.
BR2_OHC_EA_KERNEL_DRIVERS=y

# --- init / login ---
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y

# --- kernel: must fit CEFDK bootlinux's ~7 MB copy window ---
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_BZIMAGE=y

# --- rootfs: external gzipped initrd, never embedded (it would overrun CEFDK's loader) ---
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y

# --- on-target debugging ---
BR2_PACKAGE_PCIUTILS=y

# --- MTD tools for the boot SPI-NOR (/dev/mtd0) ---
BR2_PACKAGE_MTD=y

# --- kexec: S00kexec starts the full kernel staged on p1 ---
BR2_PACKAGE_KEXEC=y
BR2_PACKAGE_KEXEC_ZLIB=y

# --- ccache: one cache for the whole EA family (CI sets BR2_CCACHE_DIR) ---
BR2_CCACHE=y
BR2_CCACHE_INITIAL_SETUP="--max-size=3G"

# --- C library: glibc, the DDK blobs cannot load on musl ---
# BR2_TOOLCHAIN_BUILDROOT_MUSL is not set
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y

# Userspace at -O2, not the fleet's -Os.
# BR2_OPTIMIZE_S is not set
BR2_OPTIMIZE_2=y

# Needed by WPE WebKit; without them kconfig drops wpewebkit silently.
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_INSTALL_LIBSTDCPP=y
BR2_USE_WCHAR=y

# The i386 WPE sysroot has no fonts and reads this image's; without one the panel text is invisible.
BR2_PACKAGE_DEJAVU=y

BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_OPENHC_PATH)/common/patches $(BR2_EXTERNAL_OPENHC_PATH)/ea/common/patches"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_OPENHC_PATH)/ea/common/post-image.sh"
