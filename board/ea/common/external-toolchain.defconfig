# openHC — EA external toolchain, appended by build/build.sh only when OHC_EA_SDK is set.
# Flags must match the SDK and track both common_defconfigs. See docs: ea/board-config.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="x86_64-buildroot-linux-gnu"
BR2_TOOLCHAIN_EXTERNAL_GCC_15=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_7_1=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
# Never drop this: without it every C++ package (ICU, WPE WebKit) vanishes silently.
BR2_TOOLCHAIN_EXTERNAL_CXX=y
# glibc 2.26+ has no SunRPC; leaving this on fails the toolchain check.
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
# BR2_TOOLCHAIN_EXTERNAL_PATH is appended by build.sh from $OHC_EA_SDK.
