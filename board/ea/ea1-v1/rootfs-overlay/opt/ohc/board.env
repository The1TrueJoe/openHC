# openHomeController board config — EA1 kernel-up build.
# Sourced by /opt/ohc/bin/ohc and the individual services. Shell assignments only.

OHC_MODEL=1                     # EA1 (1/3/5 across the family)
OHC_ID_IFACE=eth0               # the MAC that names this box (always the wired one)
OHC_MDNS_IFACE="eth0 wlan0"     # preferred interface order for the mDNS identity
OHC_TIMEZONE=America/New_York   # host timezone; change with `ohc-tz <Zone>`

# --- the unified IO description every board answers ---------------------------
# OHC_IO_BACKEND says HOW the IO is reached, and it is the only thing ohc-iod
# branches on:
#   mcu   relays/contacts/IR live behind a microcontroller on a serial port,
#         spoken to with the DLE/STX protocol
#   gpio  they are native SoC GPIO lines
#   none  the board has no local IO at all
# Counts are ZERO WHEN ABSENT, and absent means the UI does not draw the panel.
OHC_IO_BACKEND=mcu
OHC_IO_MCU_PART=tm4c1231d5
OHC_IO_MCU_TTY=/dev/ttyS1
# Line discipline number S12iomcu attaches to OHC_IO_MCU_TTY, turning any
# relays and contacts into a standard gpiochip. 29 is N_DEVELOPMENT, the slot
# reserved for out-of-tree disciplines.
OHC_IO_MCU_LDISC=29
OHC_IO_MCU_BAUD=460800          # the EA family runs 460800, NOT the hc800's 115200
OHC_IR_OUT=4
# COMBO PORTS: 2 of those 4 jacks can be switched to SERIAL instead of IR.
# That is not a coincidence with OHC_IO_UARTS below — they are the same physical
# connectors. A port is IR or serial, never both at once, so iod has to treat
# "how many user UARTs exist" and "how many IR outputs exist" as a shared budget
# rather than two independent counts, and the UI must not offer a port to both.
OHC_IR_COMBO=2                    # rear jacks
OHC_IR_BLASTER=1                # internal front blaster (hence 5 outputs total)
OHC_IR_IN=1
OHC_RELAYS=0
OHC_CONTACTS=0
# User serial here is MCU-ROUTED, not host ttys: there is no /dev/ttyS* for it,
# the bytes go through the IO protocol's UART opcodes. That is the whole reason
# this key exists separately from OHC_SERIALS.
OHC_IO_UARTS=2
OHC_SERIALS=""

# --- radios ------------------------------------------------------------------
# Home-automation radios: "type:dev" per entry, the UI renders a panel per one.
# Enabled by the shared 'zigbee' feature (node + cp210x). The EA1 has only Zigbee
# (no Z-Wave), reached through a CP2104 USB bridge, NOT a host UART.
OHC_RADIOS="zigbee:ttyUSB0"
# EM357 NCP. Unlike the ca1 (DTR-reset) the EA1 holds reset on gpio29
# ("zigbee_reset", driven high=released by gpio-ea-board at boot), so the chip
# runs its app from power-on and answers EZSP/ASH directly -- opening the port
# does NOT drop it to the bootloader. Verified on hardware: a bare ASH RST
# returns RSTACK (0xc1). 115200 8N1, no RTS/CTS.
OHC_ZIGBEE_TTY=/dev/ttyUSB0
OHC_ZIGBEE_BAUD=115200

# --- hardware return-to-stock button ------------------------------------------
# Holding the front ID button for OHC_RESTORE_BUTTON_HOLD seconds runs
# `ohc-restore stock` (openHC's software return-to-stock). The button is a bare
# SoC GPIO — gpio-ea-board leaves line 32 unclaimed for us — so S96 polls it with
# libgpiod. active-low: released reads 1, pressed 0 (verified on EA1 hardware).
# The native CEFDK button recovery does NOT rewrite mtd0 on a fuse-blown EA1, so
# this is the dependable path. S96 only arms after one clean released reading, so
# a wrong line/polarity fails safe (stays inert) rather than wiping at boot.
OHC_RESTORE_BUTTON="gpiochip0 32"
OHC_RESTORE_BUTTON_HOLD=10
OHC_RESTORE_BUTTON_ACTIVE=low
OHC_RESTORE_BUTTON_LED=warn::red
