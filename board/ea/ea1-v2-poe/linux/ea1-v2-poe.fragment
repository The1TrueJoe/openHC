# EA1 v2 PoE deltas: no radio, wired-only through the BCM53125 switch.
# Explicitly off rather than merely absent, so the inherited i386 defconfig
# cannot drag the wireless stack back in.
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# pci=routeirq enables the CE5300 UART interrupt link (LUAR/GSI 38) so the IO-MCU
# on ttyS1 can take an RX interrupt — see board/ea-common/linux/common.fragment.
CONFIG_CMDLINE="console=ttyS0,115200 earlyprintk=serial,ttyS0,115200 pci=realloc,nocrs,routeirq"
