# openHomeController board config — EA1 v2 PoE.
# Sourced by /opt/ohc/bin/ohc and the individual services. Shell assignments only.
#
# A DELIBERATE MIX OF TWO SIBLINGS, and ea1-v2-poe_defconfig says which half
# comes from where: "drops the radio and gains the BCM53125 managed switch (the
# same switch the EA3s carry), so its reachability is wired-only — configure it
# like an ea3-v2 rather than like an ea1-v1."
#
#   networking  <- ea3-v2  (DSA switch ports, no radio)
#   IO counts   <- ea1-v1  (it is still an EA1: 4 IR out, no relays or contacts)
#
# UNVERIFIED ON HARDWARE, like everything else about this variant. The switch
# port names especially: OHC_DSA_PORTS has to match what the BCM53125 DSA driver
# actually registers on this board, and nobody has watched it come up.

OHC_MODEL=1                     # still an EA1 despite the EA3's switch
OHC_ID_IFACE=eth0               # the MAC that names this box
OHC_MDNS_IFACE="eth0"           # no radio on this board — wired only
OHC_TIMEZONE=America/New_York   # host timezone; change with `ohc-tz <Zone>`

# BCM53125 managed-switch port netdevs (DSA). Consumed by the shared
# common/rootfs-overlay/etc/init.d/S40net; empty on a plain single-MAC board.
OHC_DSA_PORTS="lan1 lan2"

# --- IO: the EA1's complement, not the EA3's ----------------------------------
OHC_IO_BACKEND=mcu
OHC_IO_MCU_PART=tm4c1231d5
OHC_IO_MCU_TTY=/dev/ttyS1
OHC_IO_MCU_LDISC=29
OHC_IO_MCU_BAUD=460800
OHC_IR_OUT=4
OHC_IR_COMBO=2                  # rear jacks; IR or serial, never both at once
OHC_IR_BLASTER=1                # internal front blaster (hence 5 outputs total)
OHC_IR_IN=1
OHC_RELAYS=0
OHC_CONTACTS=0
OHC_IO_UARTS=2                  # MCU-routed, not host ttys
OHC_SERIALS=""
