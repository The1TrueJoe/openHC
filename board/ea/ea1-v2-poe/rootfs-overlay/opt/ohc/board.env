# openHC board config — Control4 EA1 v2 PoE. Shell assignments only.
# Networking from the ea3-v2, IO from the ea1-v1; unverified on hardware.
# Key reference and background: site/src/content/docs/ea/board-config.md.

OHC_MODEL=1                     # still an EA1 despite the EA3's switch
OHC_ID_IFACE=eth0
OHC_MDNS_IFACE="eth0"           # no Wi-Fi
OHC_TIMEZONE=America/New_York   # change with `ohc-tz <Zone>`

# BCM53125 ports (DSA). Names unverified on this board.
OHC_DSA_PORTS="lan1 lan2"

# IO: counts and jacks come from the device tree (&io_mcu in ea1-v2-poe.dts).
OHC_IO_BACKEND=mcu
OHC_IO_MCU_PART=tm4c1231d5
OHC_SERIALS=""

# Zigbee: EM357 behind the CP2104 USB bridge, 115200 8N1. Not yet seen up on this board.
OHC_RADIOS="zigbee:ttyUSB0"
OHC_ZIGBEE_TTY=/dev/ttyUSB0
OHC_ZIGBEE_BAUD=115200
OHC_ZIGBEE_TCP_PORT=6638
OHC_ZIGBEE_RADIO_TYPE=ezsp
OHC_ZIGBEE_STOCK_ARCHIVE=/dev/mmcblk0p2:/recfs.tar.xz

# ID button held this long runs `restore stock`; the line is in the device tree.
OHC_RESTORE_BUTTON_HOLD=10
OHC_RESTORE_BUTTON_LED=warn::red

# Audio: HDMI only (32-bit words, 48 kHz only).
OHC_AUDIO_OUTPUTS="hdmi"
OHC_AUDIO_OUT_hdmi="hw:CARD=HDMI,DEV=0|HDMI|format=S32_LE"
OHC_AUDIO_INPUTS=""
OHC_AUDIO_RATE=48000
OHC_SPOTIFY="EA-1@hdmi"
OHC_AIRPLAY="EA-1@hdmi"
OHC_AUDIO_ROUTES=""
OHC_LIBRARY="EA-1 Library@hdmi"

# RAM reclaim as on the ea1-v1; unverified here, confirm MemTotal. Do NOT widen past 0x70000000.
OHC_KEXEC_CMDLINE_EXTRA="memmap=exactmap memmap=68K@0 memmap=60K#0x11000 memmap=512K@0x20000 memmap=255M@1M memmap=1536M@0x10000000"
