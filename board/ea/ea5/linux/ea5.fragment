# EA-5: the EA-3's command line and RAM map (unverified on an EA-5).
CONFIG_CMDLINE="console=ttyS0,115200 earlyprintk=serial,ttyS0,115200 pci=realloc,nocrs,routeirq memmap=exactmap memmap=68K@0 memmap=60K#0x11000 memmap=512K@0x20000 memmap=255M@1M memmap=1536M@0x10000000"

CONFIG_BUILTIN_DTB_NAME="ea5"
