# openHC board config — Control4 EA-5 (V1 and V2). Shell assignments only.
# Hardware notes: site/src/content/docs/ea/ea5.md.

OHC_MODEL=5
OHC_ID_IFACE=eth0
OHC_MDNS_IFACE="eth0 wlan0"     # wlan0 only exists on a V1
OHC_TIMEZONE=America/New_York

# BCM53125 ports (DSA, only with ohc.switch=1). Jack mapping unverified.
OHC_DSA_PORTS="lan0 lan1 lan2 lan3 lan4"

# IO: counts and jacks come from the device tree (&io_mcu in ea5.dtsi).
OHC_IO_BACKEND=mcu
OHC_IO_MCU_PART=tm4c1231d5
# SERIAL 1/2 (the DB9s) are not on the MCU; their tty is not identified yet.
OHC_SERIALS=""

OHC_RADIOS="zigbee:ttyUSB0"
OHC_ZIGBEE_TTY=/dev/ttyUSB0
OHC_ZIGBEE_BAUD=115200
OHC_ZIGBEE_TCP_PORT=6638
OHC_ZIGBEE_RADIO_TYPE=ezsp
OHC_ZIGBEE_STOCK_ARCHIVE=/dev/mmcblk0p2:/recfs.tar.xz

OHC_RESTORE_BUTTON_HOLD=10
OHC_RESTORE_BUTTON_LED=warn::red

# Audio: the FPGA card's four PCMs, routed straight to the DACs and S/PDIF
# (the DSPs are bypassed until an EA-5 DSP program exists), plus HDMI.
OHC_AUDIO_OUTPUTS="analog1 analog2 coax1 coax2 hdmi"
OHC_AUDIO_OUT_analog1="hw:CARD=openhcea5,DEV=0|Analog 1"
OHC_AUDIO_OUT_coax1="hw:CARD=openhcea5,DEV=1|Coax 1"
OHC_AUDIO_OUT_analog2="hw:CARD=openhcea5,DEV=2|Analog 2"
OHC_AUDIO_OUT_coax2="hw:CARD=openhcea5,DEV=3|Coax 2"
OHC_AUDIO_OUT_hdmi="hw:CARD=HDMI,DEV=0|HDMI|format=S32_LE"
OHC_AUDIO_INPUTS="linein1 linein2 coaxin1 coaxin2"
OHC_AUDIO_IN_linein1="hw:CARD=openhcea5,DEV=0|Line in 1"
OHC_AUDIO_IN_coaxin1="hw:CARD=openhcea5,DEV=1|Coax in 1"
OHC_AUDIO_IN_linein2="hw:CARD=openhcea5,DEV=2|Line in 2"
OHC_AUDIO_IN_coaxin2="hw:CARD=openhcea5,DEV=3|Coax in 2"
OHC_AUDIO_RATE=48000
OHC_SPOTIFY="EA-5 Analog 1@analog1;EA-5 Analog 2@analog2;EA-5 Coax 1@coax1;EA-5 Coax 2@coax2;EA-5 HDMI@hdmi"
OHC_AIRPLAY="EA-5 Analog 1@analog1;EA-5 Analog 2@analog2;EA-5 Coax 1@coax1;EA-5 Coax 2@coax2;EA-5 HDMI@hdmi"
OHC_AUDIO_ROUTES=""
OHC_LIBRARY="EA-5 Library@analog1"
