#!/bin/sh
# ohc — service orchestrator for the kernel-up headless controller.
# POSIX sh (busybox ash). Board config in /opt/ohc/board.env. Each subsystem is
# its own script in /opt/ohc/bin so it can be run standalone.
#
#   ohc boot                    full bring-up at boot (called from /etc/init.d)
#   ohc start | stop | status
#   ohc tz [zone] | mdns        run one step by hand
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin
export PATH
ROOT=/opt/ohc; BIN=$ROOT/bin; RUN=/var/run/ohc; LOG=$ROOT/log
[ -f $ROOT/board.env ] && . $ROOT/board.env
mkdir -p "$RUN" "$LOG"

start_one() {  # start_one <name> <cmd...>  — supervise a daemon by pidfile
  name=$1; shift; pidf=$RUN/$name.pid
  if [ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null; then
    echo "  $name already running (pid $(cat "$pidf"))"; return 0
  fi
  echo "  starting $name"
  nohup "$@" >"$LOG/$name.log" 2>&1 &
  echo $! > "$pidf"
}
stop_one() {
  name=$1; pidf=$RUN/$name.pid; [ -f "$pidf" ] || return 0
  pid=$(cat "$pidf")
  kill -0 "$pid" 2>/dev/null && { echo "  stopping $name (pid $pid)"; kill "$pid"; }
  rm -f "$pidf"
}

hw_bringup() {
  # LM75 heatsink sensor: i2c-pxa gives us i2c-0; instantiate the (builtin) lm75.
  if [ -d /sys/bus/i2c/devices/i2c-0 ] && [ ! -d /sys/bus/i2c/devices/0-0048 ]; then
    echo lm75 0x48 > /sys/bus/i2c/devices/i2c-0/new_device 2>/dev/null
    sleep 1
  fi
  # Self-report the SoC driver bring-up on the console (input over 921600 is
  # overrun-prone, so let the box tell us what bound instead of typing at it).
  gc=$(ls -d /sys/class/gpio/gpiochip* 2>/dev/null | wc -l)
  np=$(cat /sys/class/pwm/pwmchip0/npwm 2>/dev/null || echo none)
  ic=$(ls -d /sys/bus/i2c/devices/i2c-* 2>/dev/null | wc -l)
  echo "ohc-hw: gpiochips=$gc pwmchip0.npwm=$np i2c-buses=$ic"
  for d in /sys/class/hwmon/hwmon*; do
    [ "$(cat "$d/name" 2>/dev/null)" = lm75 ] && \
      echo "ohc-hw: lm75 temp=$(cat "$d/temp1_input" 2>/dev/null) milliC ($d)"
  done
}

boot() {
  echo "ohc: bring-up"
  "$BIN/ohc-tz"                      # host timezone
  "$BIN/ohc-mdns"                    # advertise openhc-<model>-<mac>.local
  start_one mdns-watch "$BIN/ohc-mdns" --watch
  hw_bringup                         # LM75 + report gpio/pwm/i2c driver state
  [ -x "$BIN/ohc-fand" ] && start_one fand "$BIN/ohc-fand"
  # --- still to adapt to kernel-up sysfs ---
  # [ -x "$BIN/ohc-io" ]    && "$BIN/ohc-io"        # Tiva IO MCU (ttyS1 + gpio7)
  # [ -x "$BIN/ohc-zigbee" ] && "$BIN/ohc-zigbee"   # EM357 NCP (+ gpio29)
  # [ -x "$BIN/ohc-led" ]   && "$BIN/ohc-led" boot
}

case "$1" in
  boot|start) boot ;;
  stop)  stop_one mdns-watch; "$BIN/ohc-mdns" --stop 2>/dev/null ;;
  status) "$BIN/ohc-mdns" --status; "$BIN/ohc-tz" --status ;;
  tz)    shift; "$BIN/ohc-tz" "$@" ;;
  mdns)  "$BIN/ohc-mdns" ;;
  *) echo "usage: ohc {boot|start|stop|status|tz [zone]|mdns}" ; exit 1 ;;
esac
