#!/bin/sh
#
# Draw the openHC banner on the HDMI output as early as possible.
#
# S01 so it lands before the network and the rest of the stack: the point is
# that the screen stops showing Control4's bootloader splash the moment openHC
# is up. /dev/fb0 comes from ce5300-fb (the scanout CEFDK leaves running), so
# there is no modeset to wait for -- if the node is there, it is drawable.
#
# figlet runs here on the device rather than at build time, so the banner is
# generated, not stored. That is also what makes it cheap to put per-unit text
# on screen later (hostname, address) instead of a fixed wordmark.
#
# The banner goes to the framebuffer and NOWHERE ELSE -- this is a splash
# screen, not console output. What does go to the console is one line saying
# whether it worked and, if not, why. This used to `exit 0` in silence when
# /dev/fb0 was missing or ohc-splash was unhappy, so a board that drew nothing
# also explained nothing, and there was no way to tell "no framebuffer" from
# "wrong pixel format" without reading the source.

BANNER_TEXT=${BANNER_TEXT:-openHC}
FBDEV=${FBDEV:-/dev/fb0}

case "$1" in
	start)
		[ -x /usr/bin/ohc-splash ] && [ -x /usr/bin/figlet ] || {
			echo "Splash: ohc-splash or figlet missing from this image"
			exit 0
		}
		if [ ! -e "$FBDEV" ]; then
			echo "Splash: no $FBDEV -- ce5300-fb did not bind (check FB_SIMPLE)"
			exit 0
		fi

		printf "Splash: "
		# ohc-splash explains itself on stderr (e.g. "need 32bpp, got 16").
		# Let that through: it is the whole diagnosis.
		if figlet -f slant "$BANNER_TEXT" | /usr/bin/ohc-splash - "$FBDEV"; then
			echo "OK ($FBDEV)"
		else
			echo "FAILED to draw to $FBDEV"
		fi
		;;
	stop)
		;;
	restart|reload)
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
