config BR2_PACKAGE_OHC_WEBVIEW
	bool "ohc-webview"
	depends on BR2_PACKAGE_WPEWEBKIT
	help
	  Full-screen web surface for openHC.

	  Creates one WPE WebKit view, loads a URL and runs a main loop. No
	  chrome, no navigation, no tabs -- the display path lives entirely in
	  the libwpe backend, so this is only the part WPE does not ship
	  (Buildroot builds WebKit with ENABLE_MINIBROWSER=OFF).

	  The URL comes from argv[1] or $OHC_WEBVIEW_URL, defaulting to
	  http://localhost/ -- the dashboard ohc-webd already serves on :80.
	  What any other URL serves is not openHC's concern.

comment "ohc-webview needs wpewebkit"
	depends on !BR2_PACKAGE_WPEWEBKIT
