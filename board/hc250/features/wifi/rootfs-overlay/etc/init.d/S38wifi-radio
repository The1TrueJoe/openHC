#!/bin/sh
# HC-250 Wi-Fi radio: the BCM4319 on MMC2, brought up as stock's wifipower.sh
# does. Firmware first (Broadcom's, kept from the unit's own stock by the SD
# install, never shipped), then the card in: wifi_carddetect is looped back to
# MMC2's card detect, low = present. S41wifi-ap takes wlan0 from there.
[ -r /opt/ohc/board.env ] && . /opt/ohc/board.env
WIFI="${OHC_WIFI_IFACE:-wlan0}"
DATA=/dev/mmcblk0p4
MNT=/run/ohc-wifi-data
KEPT=stock-io/etc/hotplug/firmware
FW=/lib/firmware/brcm/brcmfmac4319-sdio
PID=/run/wifi-carddetect.pid

firmware() {
    [ -e "$FW.bin" ] && return 0
    mkdir -p "$MNT" "${FW%/*}"
    mount -t ext4 -o ro "$DATA" "$MNT" 2>/dev/null || return 1
    [ -r "$MNT/$KEPT/rtecdc.bin" ] && [ -r "$MNT/$KEPT/wl-nvram.txt" ] &&
        cp "$MNT/$KEPT/rtecdc.bin" "$FW.bin" && cp "$MNT/$KEPT/wl-nvram.txt" "$FW.txt"
    umount "$MNT"
    [ -e "$FW.bin" ]
}

start() {
    [ -n "$OHC_WIFI_IFACE" ] || exit 0
    [ -d "/sys/class/net/$WIFI" ] && return 0
    if ! firmware; then
        echo "wifi: no BCM4319 firmware kept from stock (install from stock to keep it)"
        return 0
    fi
    modprobe brcmfmac || return 1
    line=$(gpiofind wifi_carddetect) || return 1
    # gpioset keeps the line driven only while it runs.
    gpioset -m signal $line=0 >/dev/null 2>&1 &
    echo $! > "$PID"
    i=0
    while [ $i -lt 20 ]; do
        [ -d "/sys/class/net/$WIFI" ] && { echo "wifi: $WIFI up (BCM4319)"; return 0; }
        sleep 1; i=$((i + 1))
    done
    echo "wifi: $WIFI never appeared"
}

stop() {
    [ -r "$PID" ] && kill "$(cat "$PID")" 2>/dev/null
    rm -f "$PID"
    modprobe -r brcmfmac 2>/dev/null
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    *) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
