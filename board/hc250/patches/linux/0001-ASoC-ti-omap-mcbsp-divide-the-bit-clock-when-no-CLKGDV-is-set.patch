From: openHC
Subject: [PATCH] ASoC: ti: omap-mcbsp: divide the bit clock when no CLKGDV is set

As bit-clock provider with no divider from the machine driver (simple-audio-card
sets the functional clock as sysclk and never calls set_clkdiv), McBSP runs the
bit clock at the full functional clock: 96 MHz on OMAP3, with a 2000-bit frame
at 48 kHz and FWID truncated to 8 bits. No I2S codec takes that.

Pick CLKGDV for 32-bit slots (64 fs for stereo) instead, and offer only the
rates the functional clock divides to within 0.1%. From 96 MHz that is the
44.1 kHz family (+400 ppm).

Found on an OMAP3630 driving an ADV7513's I2S input from McBSP4: silent at
96 MHz and at 40 fs, plays at 64 fs.
---
--- a/sound/soc/ti/omap-mcbsp.c
+++ b/sound/soc/ti/omap-mcbsp.c
@@ -757,8 +757,57 @@
 	frames.min = size / channels->min;
 	frames.integer = 1;
 	return snd_interval_refine(buffer_size, &frames);
+}
+
+/*
+ * Clock provider with no CLKGDV from the machine driver: divide the functional
+ * clock down to 32-bit slots, as an I2S codec expects (64 fs for stereo).
+ * Without this the bit clock runs at the full functional clock.
+ */
+static bool omap_mcbsp_auto_div(struct omap_mcbsp *mcbsp)
+{
+	return (mcbsp->fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) ==
+		SND_SOC_DAIFMT_BP_FP && !mcbsp->clk_div && mcbsp->in_freq;
+}
+
+/* The divider for @rate, or 0 if none lands within 0.1%. */
+static unsigned int omap_mcbsp_auto_clkgdv(struct omap_mcbsp *mcbsp,
+					   unsigned int rate,
+					   unsigned int channels)
+{
+	unsigned int bclk = rate * 32 * channels;
+	unsigned int div;
+
+	if (!bclk)
+		return 0;
+	div = DIV_ROUND_CLOSEST(mcbsp->in_freq, bclk);
+	if (!div || div > 128)
+		return 0;
+	if ((u64)abs_diff(mcbsp->in_freq / div, bclk) * 1000 > bclk)
+		return 0;
+	return div;
 }
 
+static int omap_mcbsp_hwrule_rate(struct snd_pcm_hw_params *params,
+				  struct snd_pcm_hw_rule *rule)
+{
+	static const unsigned int rates[] = {
+		8000, 11025, 16000, 22050, 32000, 44100, 48000, 88200, 96000,
+	};
+	struct snd_interval *channels = hw_param_interval(params,
+					SNDRV_PCM_HW_PARAM_CHANNELS);
+	struct omap_mcbsp *mcbsp = rule->private;
+	unsigned int list[ARRAY_SIZE(rates)];
+	unsigned int i, n = 0;
+
+	for (i = 0; i < ARRAY_SIZE(rates); i++)
+		if (omap_mcbsp_auto_clkgdv(mcbsp, rates[i], channels->min))
+			list[n++] = rates[i];
+
+	return snd_interval_list(hw_param_interval(params,
+				 SNDRV_PCM_HW_PARAM_RATE), n, list, 0);
+}
+
 static int omap_mcbsp_dai_startup(struct snd_pcm_substream *substream,
 				  struct snd_soc_dai *cpu_dai)
 {
@@ -801,6 +850,12 @@
 					   SNDRV_PCM_HW_PARAM_PERIOD_SIZE, 2);
 	}
 
+	if (omap_mcbsp_auto_div(mcbsp))
+		snd_pcm_hw_rule_add(substream->runtime, 0,
+				    SNDRV_PCM_HW_PARAM_RATE,
+				    omap_mcbsp_hwrule_rate, mcbsp,
+				    SNDRV_PCM_HW_PARAM_CHANNELS, -1);
+
 	return err;
 }
 
@@ -1020,7 +1075,15 @@
 	/* In McBSP master modes, FRAME (i.e. sample rate) is generated
 	 * by _counting_ BCLKs. Calculate frame size in BCLKs */
 	master = mcbsp->fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK;
-	if (master == SND_SOC_DAIFMT_BP_FP) {
+	if (master == SND_SOC_DAIFMT_BP_FP && omap_mcbsp_auto_div(mcbsp)) {
+		div = omap_mcbsp_auto_clkgdv(mcbsp, params_rate(params),
+					     channels);
+		if (!div)
+			return -EINVAL;
+		regs->srgr1	&= ~CLKGDV(0xff);
+		regs->srgr1	|= CLKGDV(div - 1);
+		framesize = 32 * channels;
+	} else if (master == SND_SOC_DAIFMT_BP_FP) {
 		div = mcbsp->clk_div ? mcbsp->clk_div : 1;
 		framesize = (mcbsp->in_freq / div) / params_rate(params);
 
