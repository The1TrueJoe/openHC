#!/bin/sh
# ohc-sd-install install <image|http-url> | uninstall | status
#
# HC-250: openHC on the interior SD card, booted by stock U-Boot. Run it from
# openHC in RAM (kexec'd from stock). What it changes:
#
#   SD   p1 (Control4 "Internal" data) untouched. p2 "Apps" (ext4, ~15 MB used)
#        shrunk to 2 GiB; p3 vfat "OHCBOOT" holds the uImage; p4 ext4 "ohcdata".
#   env  bootmode=ohc and a bootohc script that counts tries in ohc_try and
#        boots stock (bootnand) after three; S95ohcboot clears the count once
#        the uplink is up. restoresystem, the script factory restore runs, gets
#        "setenv bootmode nand; saveenv" appended, so a factory restore also
#        returns U-Boot to stock. NAND is never written except the env.
#
# uninstall puts bootmode and restoresystem back; the SD layout stays (stock
# never reads the card).
set -e

DEV=/dev/mmcblk0
P2=${DEV}p2; P3=${DEV}p3; P4=${DEV}p4
IMG=openhc.img
STOCK_RESTORE='run restorekern; run restorerootfs; run cleanboot'
OHC_RESTORE="$STOCK_RESTORE; setenv bootmode nand; saveenv"
# Generic MMC in U-Boot 2011.03 (no "mmc init", so stock's bootmmc cannot work):
# try both controllers. bootohcm boots what was loaded; bootnand is stock's boot.
BOOTOHCM='setenv bootargs mem=${memsize} eth=${ethaddr} ${ohc_bootargs}; bootm ${bootload}'
BOOTOHC='if itest ${ohc_try} -ge 3; then echo openHC: 3 failed boots, booting stock; run bootnand; fi;'
BOOTOHC="$BOOTOHC"' if itest ${ohc_try} -eq 2; then setenv ohc_try 3; elif itest ${ohc_try} -eq 1; then setenv ohc_try 2; else setenv ohc_try 1; fi; saveenv;'
BOOTOHC="$BOOTOHC"' if mmc rescan 0 && fatload mmc 0:3 ${bootload} openhc.img; then run bootohcm;'
BOOTOHC="$BOOTOHC"' elif mmc rescan 1 && fatload mmc 1:3 ${bootload} openhc.img; then run bootohcm; fi; run bootnand'
BOOTARGS='console=ttyS0,115200n8 panic=10 ohc.boot=sd'

die() { echo "ohc-sd-install: $*" >&2; exit 1; }
getenv() { fw_printenv -n "$1" 2>/dev/null; }

check_board() {
    grep -q "Control4 HC-250" /proc/device-tree/model 2>/dev/null || die "not an HC-250"
    [ -b "$DEV" ] || die "no $DEV (interior SD)"
    fw_printenv bootcmd >/dev/null 2>&1 || die "cannot read U-Boot's env (fw_env.config)"
    case "$(getenv bootcmd)" in *'run boot${bootmode}'*) ;; *) die "bootcmd is not stock's run boot\${bootmode}" ;; esac
}

# p1 and p2 exactly as Control4 left them, or already ours.
layout() {
    sfdisk -d "$DEV" | sed -n 's/^\/dev\/mmcblk0p\([0-9]\) : start= *\([0-9]*\), size= *\([0-9]*\).*/\1 \2 \3/p'
}

partition() {
    if [ -b "$P3" ] && [ -b "$P4" ]; then
        [ "$(blkid -s LABEL -o value "$P3")" = OHCBOOT ] || die "$P3 exists and is not OHCBOOT; refusing"
        echo "SD already partitioned"; return 0
    fi
    l=$(layout)
    echo "$l" | grep -q "^1 16 1750064$" || die "p1 is not stock's (16+1750064): $l"
    echo "$l" | grep -q "^2 1750080 " || die "p2 does not start at 1750080: $l"
    [ "$(echo "$l" | wc -l)" = 2 ] || die "expected two partitions: $l"
    grep -q "^$DEV" /proc/mounts && die "the SD is mounted"
    total=$(cat /sys/block/mmcblk0/size)
    p2=4194304                                  # 2 GiB
    p3s=$((1750080 + p2)); p3=524288            # 256 MiB vfat
    p4s=$((p3s + p3)); p4=$((total - p4s))
    [ "$p4" -gt 1048576 ] || die "card too small ($total sectors)"
    echo "shrinking p2 (Apps) to 2 GiB"
    e2fsck -fy "$P2" || [ $? -le 1 ] || die "e2fsck $P2 failed"
    resize2fs "$P2" 1900M
    sfdisk --no-reread "$DEV" <<SF
label: dos
start=16, size=1750064, type=83
start=1750080, size=$p2, type=83
start=$p3s, size=$p3, type=c
start=$p4s, size=$p4, type=83
SF
    blockdev --rereadpt "$DEV"; sleep 1
    resize2fs "$P2"
    mkfs.vfat -n OHCBOOT "$P3"
    mkfs.ext4 -q -L ohcdata "$P4"
}

put_image() {
    src=$1; mnt=/tmp/ohcboot
    mkdir -p "$mnt"; mount -t vfat "$P3" "$mnt"
    trap 'umount "$mnt" 2>/dev/null' EXIT
    case "$src" in
        http://*|https://*) wget -O "$mnt/$IMG.new" "$src" ;;
        *) cp "$src" "$mnt/$IMG.new" ;;
    esac
    magic=$(dd if="$mnt/$IMG.new" bs=4 count=1 2>/dev/null | hexdump -ve '1/1 "%02x"')
    [ "$magic" = 27051956 ] || { rm -f "$mnt/$IMG.new"; die "not a uImage"; }
    dd if="$mnt/$IMG.new" bs=1 skip=32 count=32 2>/dev/null | grep -q hc250 \
        || { rm -f "$mnt/$IMG.new"; die "uImage is not an hc250 image"; }
    mv "$mnt/$IMG.new" "$mnt/$IMG"; sync
    echo "image: $(ls -l "$mnt/$IMG" | awk '{print $5}') bytes on $P3"
    umount "$mnt"; trap - EXIT
}

install() {
    [ -n "$1" ] || die "usage: $0 install <image|http-url>"
    check_board
    rs=$(getenv restoresystem)
    [ "$rs" = "$STOCK_RESTORE" ] || [ "$rs" = "$OHC_RESTORE" ] || die "restoresystem is not stock's: $rs"
    partition
    put_image "$1"
    # One env write: everything lands together, or nothing does.
    f=/tmp/ohc-env.$$
    {
        echo "ohc_try 0"
        echo "ohc_bootargs $BOOTARGS"
        echo "bootohcm $BOOTOHCM"
        echo "bootohc $BOOTOHC"
        echo "restoresystem $OHC_RESTORE"
        echo "bootmode ohc"
    } > "$f"
    fw_setenv -s "$f"; rm -f "$f"
    [ "$(getenv bootmode)" = ohc ] || die "env write did not stick"
    echo "installed: U-Boot boots openHC from the SD; 3 failed boots or a factory restore go back to stock"
}

uninstall() {
    check_board
    f=/tmp/ohc-env.$$
    { echo "bootmode nand"; echo "restoresystem $STOCK_RESTORE"; echo "bootohc"; echo "bootohcm"; echo "ohc_try"; echo "ohc_bootargs"; } > "$f"
    fw_setenv -s "$f"; rm -f "$f"
    echo "uninstalled: U-Boot boots stock from NAND"
}

status() {
    echo "bootmode=$(getenv bootmode) ohc_try=$(getenv ohc_try)"
    echo "restoresystem=$(getenv restoresystem)"
    blkid "$DEV"p* 2>/dev/null
}

case "$1" in
    install) shift; install "$@" ;;
    uninstall) uninstall ;;
    status) status ;;
    *) echo "usage: $0 install <image|http-url> | uninstall | status" >&2; exit 2 ;;
esac
