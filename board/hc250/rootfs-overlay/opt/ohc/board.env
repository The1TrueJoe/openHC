# openHomeController board config — Control4 HC-250 (OMAP36xx): software defaults.
# The hardware is the kernel's: the device tree (linux/dts/ti/omap/c4-omap3-hc250.dts) and
# the udev rules (etc/udev/rules.d/60-openhc-board.rules).

OHC_ID_IFACE=eth0               # LAN9220, the MAC that names this box
OHC_UPLINK_IFACE=eth0
OHC_NET_WATCHDOG=0
OHC_WIFI_IFACE=                 # Broadcom SDIO radio not brought up yet
OHC_TIMEZONE=America/New_York
OHC_CONSOLE_TTY=/dev/ttyS0      # UART1, the header inside the case
