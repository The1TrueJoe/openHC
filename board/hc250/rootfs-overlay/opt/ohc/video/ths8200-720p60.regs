# THS8200 register state for 720p60, read off a live HC-250 on stock OS 2.10.6
# (/proc/driver/ths8200-dump, 2026-11-08), output configured by Control4's own
# kernel. Same chip as the HC-800, different input wiring: it sits on the OMAP's
# 24-bit DPI bus next to the ADV7513, so 24 registers differ from the HC-800 set.
# This file replaces that one in the HC-250 image (rootfs overlay).
#
# Format: <reg-hex> <value-hex>  # NAME   (names from mainline ths8200_regs.h)

00 00
01 00
02 04   # READ-ONLY, verify == 0x04
03 01   # THS8200_CHIP_CTL
04 00   # THS8200_CSC_R11
05 da   # THS8200_CSC_R12
06 80   # THS8200_CSC_R21
07 78   # THS8200_CSC_R22
08 02   # THS8200_CSC_R31
09 0c   # THS8200_CSC_R32
0A 02   # THS8200_CSC_G11
0B dc   # THS8200_CSC_G12
0C 81   # THS8200_CSC_G21
0D 94   # THS8200_CSC_G22
0E 81   # THS8200_CSC_G31
0F dc   # THS8200_CSC_G32
10 00   # THS8200_CSC_B11
11 4a   # THS8200_CSC_B12
12 02   # THS8200_CSC_B21
13 0c   # THS8200_CSC_B22
14 80   # THS8200_CSC_B31
15 30   # THS8200_CSC_B32
16 00   # THS8200_CSC_OFFS1
17 08   # THS8200_CSC_OFFS12
18 02   # THS8200_CSC_OFFS23
19 01   # THS8200_CSC_OFFS3
1A 00   # THS8200_TST_CNTL1
1B 00   # THS8200_TST_CNTL2
1C 68   # THS8200_DATA_CNTL
1D 00   # THS8200_DTG1_Y_SYNC1_LSB
1E 49   # THS8200_DTG1_Y_SYNC2_LSB
1F b6   # THS8200_DTG1_Y_SYNC3_LSB
20 00   # THS8200_DTG1_CBCR_SYNC1_LSB
21 00   # THS8200_DTG1_CBCR_SYNC2_LSB
22 00   # THS8200_DTG1_CBCR_SYNC3_LSB
