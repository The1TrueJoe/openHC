#!/bin/sh
# Tell U-Boot this openHC boot was good. HC-250 SD install (ohc-sd-install) only.
#
# The install makes U-Boot's bootohc count openHC boot attempts in EEPROM byte 6
# (0->1->2->3, written before booting us) and boot stock (bootnand) at 3. So a
# kernel that panics (panic=10), hangs (the watchdog U-Boot arms) or comes up
# deaf three times in a row lands the box back on stock Control4 with nobody
# touching it. This script is the other half: once the uplink has carrier and an
# address, it zeroes the count. The EEPROM, not U-Boot's env: mainline's NAND ECC
# layout is not Control4's, so openHC never writes the NAND.
#
# It also zeroes stock's own boot counters (bytes 0/1, both slots) and the clean
# count (2), which c4sys init bumps every boot and stock's setbootcnt clears; left
# alone they switch stock to its other slot after three boots.
#
# "Up" means reachable, not merely booted: if the uplink is not up within five
# minutes this reboots and lets the count go on climbing. A RAM boot (kexec from
# stock) leaves byte 6 alone, so then this does nothing.
[ -r /opt/ohc/board.env ] && . /opt/ohc/board.env
UPLINK="${OHC_UPLINK_IFACE:-eth0}"
LIMIT=300

reachable() {
    [ "$(cat "/sys/class/net/$UPLINK/carrier" 2>/dev/null)" = 1 ] || return 1
    ip -4 addr show "$UPLINK" 2>/dev/null | grep -q "inet "
}

EEPROM=/sys/bus/i2c/devices/0-0050/eeprom
TRY=6

byte() { dd if="$EEPROM" bs=1 skip="$1" count=1 2>/dev/null | hexdump -ve '1/1 "%u"'; }
zero() {
    v=$(byte "$1")
    [ -n "$v" ] && [ "$v" != 0 ] || return 0
    printf '\000' | dd of="$EEPROM" bs=1 seek="$1" count=1 conv=notrunc 2>/dev/null \
        && logger -t ohcboot "EEPROM byte $1: $v -> 0"
}

confirm() {
    t=0
    while [ "$t" -lt "$LIMIT" ]; do
        if reachable; then
            # Both slots' counts, not the env's bootsystem: Linux cannot read the
            # env reliably (Control4's NAND ECC layout), and zero is stock's own reset.
            zero 0; zero 1; zero 2
            zero "$TRY"
            logger -t ohcboot "boot confirmed"
            return 0
        fi
        sleep 5; t=$((t + 5))
    done
    logger -t ohcboot "$UPLINK not up after ${LIMIT}s; rebooting to count this attempt"
    reboot
}

case "$1" in
    start)
        [ -r "$EEPROM" ] || exit 0
        try=$(byte "$TRY")
        case "$try" in 1|2|3) ;; *) exit 0 ;; esac
        echo "ohcboot: SD boot attempt $try; confirming once $UPLINK is up"
        confirm >/dev/null 2>&1 &
        ;;
    stop) : ;;
    *) echo "usage: $0 {start|stop}"; exit 1 ;;
esac
