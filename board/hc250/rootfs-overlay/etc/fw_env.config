# U-Boot environment on the HC-250's NAND: two redundant copies at 0x280000 and
# 0x1ff20000, 0x20000 each with the 1-byte flag after the CRC (both CRCs match
# at that size in the unit's NAND dump). mtd2/mtd12 = "u-boot-env" and
# "u-boot-env-redund" in this board's device tree.
# device      offset  env-size  sector-size
/dev/mtd2     0x0     0x20000   0x20000
/dev/mtd12    0x0     0x20000   0x20000
