# HC-250: which tty is what (see 70-openhc-io.rules for the properties).
# The rear serial ports are MCU-routed (/dev/ohc/serial via gpio-ohc-iomcu).

# EM357 Zigbee NCP on UART2; ttySZigbee is the vendor's name for it.
SUBSYSTEM=="tty", KERNELS=="4806c000.serial", ENV{OHC_RADIO}="zigbee", SYMLINK+="ttySZigbee"

# Audio endpoints (audiod): the TPS65950 codec's rear out and line in, HDMI.
SUBSYSTEM=="sound", KERNEL=="pcmC*D0p", ATTRS{id}=="HC250", ENV{OHC_AUDIO_LABEL}="Analog"
SUBSYSTEM=="sound", KERNEL=="pcmC*D0c", ATTRS{id}=="HC250", ENV{OHC_AUDIO_LABEL}="Line in"
SUBSYSTEM=="sound", KERNEL=="pcmC*D0p", ATTRS{id}=="HDMI", ENV{OHC_AUDIO_LABEL}="HDMI"
