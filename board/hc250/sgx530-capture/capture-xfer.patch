 #include "pvr_debug.h"
 #include "sgxutils.h"
 #include "ttrace.h"
+
+/*
+ * (CAP-XFER) capture-only: the first XFERSNAP_SLOTS transfer commands as the
+ * client wrote them (0x100 bytes either side of the shared part's CCB offset)
+ * and the kick's command words, as debugfs blobs xfersnap<N>. Format (LE u32):
+ *   "XFER" slot shared_off from_off nbytes <bytes> "KICK" nbytes <bytes>
+ */
+#include <linux/debugfs.h>
+#include <linux/vmalloc.h>
+#define XFERSNAP_SLOTS	4
+static struct debugfs_blob_wrapper xfersnap_blob[XFERSNAP_SLOTS];
+static IMG_UINT32 xfersnap_n;
+
+static IMG_VOID XferSnap(PVRSRV_KERNEL_MEM_INFO *psCCBMemInfo, IMG_UINT32 ui32Shared,
+			 const SGXMKIF_COMMAND *psCommand)
+{
+	IMG_UINT32 from = ui32Shared > 0x100 ? ui32Shared - 0x100 : 0;
+	IMG_UINT32 to = ui32Shared + 0x100, n, *p, slot = xfersnap_n;
+	char name[16];
+
+	if (slot >= XFERSNAP_SLOTS)
+		return;
+	if (to > psCCBMemInfo->uAllocSize)
+		to = psCCBMemInfo->uAllocSize;
+	n = to - from;
+	p = vmalloc(32 + n + sizeof(*psCommand));
+	if (!p)
+		return;
+	xfersnap_n++;
+	memcpy(&p[0], "XFER", 4);
+	p[1] = slot;
+	p[2] = ui32Shared;
+	p[3] = from;
+	p[4] = n;
+	memcpy(&p[5], (IMG_UINT8 *)psCCBMemInfo->pvLinAddrKM + from, n);
+	memcpy((IMG_UINT8 *)&p[5] + n, "KICK", 4);
+	*(IMG_UINT32 *)((IMG_UINT8 *)&p[6] + n) = sizeof(*psCommand);
+	memcpy((IMG_UINT8 *)&p[7] + n, psCommand, sizeof(*psCommand));
+	xfersnap_blob[slot].data = p;
+	xfersnap_blob[slot].size = 28 + n + sizeof(*psCommand);
+	snprintf(name, sizeof(name), "xfersnap%u", slot);
+	debugfs_create_blob(name, 0400, NULL, &xfersnap_blob[slot]);
+}
 
