+/*
+ * (CAP-XFER) capture-only: the first XFERSNAP_SLOTS transfer commands as the
+ * client wrote them (0x100 bytes either side of the shared part's CCB offset)
+ * and the kick's command words, as debugfs blobs xfersnap<N>. Format (LE u32):
+ *   "XFER" slot shared_off from_off nbytes <bytes> "KICK" nbytes <bytes>
+ */
+#include <linux/debugfs.h>
+#include <linux/vmalloc.h>
+#define XFERSNAP_SLOTS	4
+static struct debugfs_blob_wrapper xfersnap_blob[XFERSNAP_SLOTS];
+static IMG_UINT32 xfersnap_n;
+
+static IMG_VOID XferSnap(PVRSRV_KERNEL_MEM_INFO *psCCBMemInfo, IMG_UINT32 ui32Shared,
+			 const SGXMKIF_COMMAND *psCommand)
+{
+	IMG_UINT32 from = ui32Shared > 0x100 ? ui32Shared - 0x100 : 0;
+	IMG_UINT32 to = ui32Shared + 0x100, n, *p, slot = xfersnap_n;
+	char name[16];
+
+	if (slot >= XFERSNAP_SLOTS)
+		return;
+	if (to > psCCBMemInfo->uAllocSize)
+		to = psCCBMemInfo->uAllocSize;
+	n = to - from;
+	p = vmalloc(32 + n + sizeof(*psCommand));
+	if (!p)
+		return;
+	xfersnap_n++;
+	memcpy(&p[0], "XFER", 4);
+	p[1] = slot;
+	p[2] = ui32Shared;
+	p[3] = from;
+	p[4] = n;
+	memcpy(&p[5], (IMG_UINT8 *)psCCBMemInfo->pvLinAddrKM + from, n);
+	memcpy((IMG_UINT8 *)&p[5] + n, "KICK", 4);
+	*(IMG_UINT32 *)((IMG_UINT8 *)&p[6] + n) = sizeof(*psCommand);
+	memcpy((IMG_UINT8 *)&p[7] + n, psCommand, sizeof(*psCommand));
+	xfersnap_blob[slot].data = p;
+	xfersnap_blob[slot].size = 28 + n + sizeof(*psCommand);
+	snprintf(name, sizeof(name), "xfersnap%u", slot);
+	debugfs_create_blob(name, 0400, NULL, &xfersnap_blob[slot]);
+}
+
+/*
+ * (CAP-XPOLL) capture-only: right after a transfer is queued, read five SGX
+ * registers in a tight loop and keep every change with its loop iteration and
+ * time, for the first XPOLL_SLOTS transfers, as debugfs blobs xferpoll<N>, plus
+ * the OR of every value 0x12c and 0x118 took. Register values only. Format
+ * (LE u32): "POL2" slot nchanges iterations elapsed_ns or_12c or_118, then
+ * nchanges x (iteration t_ns reg value); iteration 0 holds the starting values.
+ * Stops 20 ms after the queue.
+ */
+#include <linux/sched/clock.h>
+#define XPOLL_SLOTS	4
+#define XPOLL_MAX	16384
+#define XPOLL_HDR	7
+static const IMG_UINT32 xpoll_reg[] = { 0x12c, 0x118, 0x004, 0x4e4, 0x4ec };
+#define XPOLL_NREG	(sizeof(xpoll_reg) / sizeof(xpoll_reg[0]))
+static struct debugfs_blob_wrapper xpoll_blob[XPOLL_SLOTS];
+static IMG_UINT32 xpoll_n;
+
+static IMG_VOID XferPoll(IMG_HANDLE hDevHandle)
+{
+	PVRSRV_SGXDEV_INFO *psDevInfo = ((PVRSRV_DEVICE_NODE *)hDevHandle)->pvDevice;
+	IMG_UINT32 cur[XPOLL_NREG], *p, n = 0, i, v, it = 0, or12c = 0, or118 = 0, slot = xpoll_n;
+	u64 t0, t;
+	char name[16];
+
+	if (slot >= XPOLL_SLOTS)
+		return;
+	p = vmalloc((XPOLL_HDR + XPOLL_MAX * 4) * 4);
+	if (!p)
+		return;
+	xpoll_n++;
+	t0 = t = local_clock();
+	for (i = 0; i < XPOLL_NREG; i++) {
+		cur[i] = OSReadHWReg(psDevInfo->pvRegsBaseKM, xpoll_reg[i]);
+		p[XPOLL_HDR + 4 * n] = 0;
+		p[XPOLL_HDR + 4 * n + 1] = 0;
+		p[XPOLL_HDR + 4 * n + 2] = xpoll_reg[i];
+		p[XPOLL_HDR + 4 * n + 3] = cur[i];
+		n++;
+	}
+	while (t - t0 < 20000000ull) {
+		it++;
+		if (!(it & 63))
+			t = local_clock();
+		for (i = 0; i < XPOLL_NREG; i++) {
+			v = OSReadHWReg(psDevInfo->pvRegsBaseKM, xpoll_reg[i]);
+			if (i == 0)
+				or12c |= v;
+			else if (i == 1)
+				or118 |= v;
+			if (v == cur[i])
+				continue;
+			cur[i] = v;
+			if (n < XPOLL_MAX) {
+				p[XPOLL_HDR + 4 * n] = it;
+				p[XPOLL_HDR + 4 * n + 1] = (IMG_UINT32)(t - t0);
+				p[XPOLL_HDR + 4 * n + 2] = xpoll_reg[i];
+				p[XPOLL_HDR + 4 * n + 3] = v;
+				n++;
+			}
+		}
+	}
+	memcpy(&p[0], "POL2", 4);
+	p[1] = slot;
+	p[2] = n;
+	p[3] = it;
+	p[4] = (IMG_UINT32)(t - t0);
+	p[5] = or12c;
+	p[6] = or118;
+	xpoll_blob[slot].data = p;
+	xpoll_blob[slot].size = (XPOLL_HDR + n * 4) * 4;
+	snprintf(name, sizeof(name), "xferpoll%u", slot);
+	debugfs_create_blob(name, 0400, NULL, &xpoll_blob[slot]);
+}
