# Kernel delta for the HC-250 on omap2plus_defconfig.

# Stock U-Boot 2011.03: ATAGS + appended DTB.
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y

# Built in, so the first boot needs no modules.
CONFIG_SERIAL_8250_OMAP=y
CONFIG_SMSC911X=y
CONFIG_TWL4030_CORE=y
CONFIG_GPIO_TWL4030=y
CONFIG_REGULATOR_TWL4030=y
CONFIG_RTC_DRV_TWL4030=y
CONFIG_MMC_OMAP_HS=y
CONFIG_EEPROM_AT24=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_OMAP_WATCHDOG=y

# Rear USB (MUSB host via the TWL4030 PHY) and USB sticks.
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_OMAP2PLUS=y
CONFIG_TWL4030_USB=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_STORAGE=y

# NAND, read-only in the DT. Control4's BCH4 layout is unverified.
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_NAND_OMAP2=y
CONFIG_MTD_NAND_OMAP_BCH=y
CONFIG_MTD_NAND_ECC_SW_BCH=y

# TPS65950 monitoring ADC (MADC), for the ADC/DAC exploration.
CONFIG_IIO=y
CONFIG_TWL4030_MADC=y

CONFIG_KEXEC=y
