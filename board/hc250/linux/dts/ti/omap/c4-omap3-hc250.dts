// SPDX-License-Identifier: GPL-2.0
/*
 * Control4 HC-250 ("magneto"): OMAP36xx (DM3730 class), TPS65950, 512 MB,
 * 512 MB NAND, LAN9220, LM3S1162 IO-MCU, EM357 Zigbee.
 *
 * Pads stay as stock U-Boot muxed them, except the ones its kernel sets (DSS, McBSP4).
 * GPIOs read off a stock unit (/sys/kernel/debug/gpio, /dev/gpio).
 * Docs: https://the1truejoe.github.io/openHC/hc250/
 */
/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/omap.h>
#include <dt-bindings/gpio/control4,io-mcu.h>
#include "omap36xx.dtsi"

/ {
	model = "Control4 HC-250";
	compatible = "control4,hc250", "ti,omap3630", "ti,omap3";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x20000000>;
	};

	leds {
		compatible = "gpio-leds";

		led-power {
			label = "hc250::power";
			gpios = <&gpio4 15 GPIO_ACTIVE_LOW>;		/* gpio111 */
			linux,default-trigger = "default-on";
		};
		led-data {
			label = "hc250::data";
			gpios = <&gpio6 18 GPIO_ACTIVE_LOW>;		/* gpio178 */
		};
		led-link {
			label = "hc250::link";
			gpios = <&gpio6 22 GPIO_ACTIVE_LOW>;		/* gpio182 */
		};
		led-wifi-red {
			label = "hc250:red:wifi";
			gpios = <&gpio6 19 GPIO_ACTIVE_LOW>;		/* gpio179 */
		};
		led-wifi-yellow {
			label = "hc250:yellow:wifi";
			gpios = <&gpio6 20 GPIO_ACTIVE_LOW>;		/* gpio180 */
		};
		led-wifi-blue {
			label = "hc250:blue:wifi";
			gpios = <&gpio6 21 GPIO_ACTIVE_LOW>;		/* gpio181 */
			linux,default-trigger = "heartbeat";
		};
	};

	/* TPS65950 codec on McBSP2: the rear audio out and in. */
	sound {
		compatible = "ti,omap-twl4030";
		ti,model = "HC-250";
		ti,mcbsp = <&mcbsp2>;
		/* Stock plays out of DAC2 into HSOL/HSOR; line in on AUXL/AUXR. */
		ti,audio-routing =
			"Headset Stereophone", "HSOL",
			"Headset Stereophone", "HSOR",
			"AUXL", "Line In",
			"AUXR", "Line In";
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		label = "hdmi";
		type = "a";

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&adv7513_out>;
			};
		};
	};

	/* McBSP4 into the ADV7513's I2S: HDMI audio. */
	sound-hdmi {
		compatible = "simple-audio-card";
		simple-audio-card,name = "HC-250 HDMI";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&hdmi_dai_cpu>;
		simple-audio-card,frame-master = <&hdmi_dai_cpu>;

		/* No MCLK: the ADV7513 needs a 64 fs bit clock (2 x 32-bit slots). */
		hdmi_dai_cpu: simple-audio-card,cpu {
			sound-dai = <&mcbsp4>;
			dai-tdm-slot-num = <2>;
			dai-tdm-slot-width = <32>;
		};
		simple-audio-card,codec {
			sound-dai = <&adv7513>;
		};
	};

	/* ID button: held at power-on it is U-Boot's USB-script trigger. */
	id-button {
		compatible = "gpio-keys";
		label = "hc250-id-button";

		key-id {
			label = "id_button";
			gpios = <&gpio1 22 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_F5>;
			debounce-interval = <20>;
		};
	};

	/* Rear USB 5 V: TPS2553 enabled by TWL GPIO 7 (U-Boot c4sys usbcheck). */
	/* The BCM4319 module runs off a fixed rail (stock leaves the TWL LDOs off). */
	wifi_vmmc: regulator-wifi {
		compatible = "regulator-fixed";
		regulator-name = "wifi_vmmc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio6 16 GPIO_ACTIVE_LOW>;	/* wifi_reset */
		/* 50 ms is too short: CMD5 goes unanswered. 200 ms works. */
		post-power-on-delay-ms = <200>;
	};

	usb_vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&twl_gpio 7 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};
};

&gpio1 {
	gpio-line-names =
		/*  0 */ "", "", "", "", "", "", "", "",
		/*  8 */ "", "", "", "", "", "", "", "",
		/* 16 */ "", "", "", "hdmi_irq", "", "", "id_button", "",
		/* 24 */ "zigbee_reset", "zigrf_enable", "", "eth_irq", "", "", "", "";

	/* Held as the stock OS leaves them: NCP out of reset, RF on. */
	zigbee-reset-hog {
		gpio-hog;
		gpios = <24 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "zigbee_reset";
	};
	zigrf-enable-hog {
		gpio-hog;
		gpios = <25 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "zigrf_enable";
	};
};

&gpio4 {
	gpio-line-names =
		/*  96 */ "io_reset", "ths8200_reset", "", "", "", "wifi_carddetect", "", "",
		/* 104 */ "12v_enable", "", "", "", "", "", "12v_fault", "",
		/* 112 */ "", "", "", "", "", "", "", "",
		/* 120 */ "", "", "", "", "", "", "", "";

	/* X-Loader holds the THS8200 in reset; stock releases it. */
	ths8200-reset-hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "ths8200_reset";
	};
	/* Stock tps2533 driver holds this high; its fault input is gpio110. */
	pwr-12v-hog {
		gpio-hog;
		gpios = <8 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "12v_enable";
	};
};

&gpio6 {
	gpio-line-names =
		/* 160 */ "", "", "", "", "", "", "", "",
		/* 168 */ "", "", "", "", "", "", "", "",
		/* 176 */ "wifi_reset", "eth_reset", "", "", "", "", "", "",
		/* 184 */ "", "", "", "", "", "", "", "";
};

/* 400 kHz, not the TWL's 2.6 MHz HS mode: the 24C02 at 0x50 shares the bus. */
&i2c1 {
	clock-frequency = <400000>;

	twl: twl@48 {
		reg = <0x48>;
		interrupts = <7>;		/* SYS_NIRQ */
		interrupt-parent = <&intc>;

		twl_audio: audio {
			compatible = "ti,twl4030-audio";
			codec {
			};
		};
	};

	/*
	 * c4sys boot counters (0 bootcount0, 1 bootcount1, 2 cleancount, 3 cleanboot,
	 * 4 restore count, 5 restore state) and the MAC (8-13). Byte 6 is openHC's
	 * SD boot try count (U-Boot's bootohc). S95ohcboot zeroes 0/1, 2 and 6 after a
	 * good boot, as stock's setbootcnt does for its own; nothing else writes.
	 */
	eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		pagesize = <8>;
	};
};

#include "twl4030.dtsi"
#include "twl4030_omap3.dtsi"

/* THS8200 @21 (configured from userspace, S47video) and ADV7513 @39. */
&i2c2 {
	clock-frequency = <400000>;

	adv7513: hdmi@39 {
		compatible = "adi,adv7513";
		reg = <0x39>, <0x3f>, <0x3c>, <0x38>;
		reg-names = "main", "edid", "cec", "packet";
		interrupts-extended = <&gpio1 19 IRQ_TYPE_EDGE_FALLING>;
		#sound-dai-cells = <0>;

		/* As stock drives it: 24-bit RGB 4:4:4, separate syncs. */
		adi,input-depth = <8>;
		adi,input-colorspace = "rgb";
		adi,input-clock = "1x";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				adv7513_in: endpoint {
					remote-endpoint = <&dpi_out>;
				};
			};
			port@1 {
				reg = <1>;
				adv7513_out: endpoint {
					remote-endpoint = <&hdmi_connector_in>;
				};
			};
		};
	};
};

&i2c3 {
	status = "disabled";
};

/* Console. */
&uart1 {
	status = "okay";
};

/* EM357 Zigbee NCP, on the McBSP3 pads with RTS/CTS. */
&uart2 {
	uart-has-rtscts;
	status = "okay";
};

/* LM3S1162 IO-MCU. Pins: docs shared/io-mcu-pinmap (stock LM3S block 1). */
&uart3 {
	status = "okay";

	io_mcu: io-mcu {
		compatible = "control4,lm3s1162-io-mcu", "control4,io-mcu";
		current-speed = <115200>;
		reset-gpios = <&gpio4 0 GPIO_ACTIVE_LOW>;	/* gpio96 io_reset */
		/* openHC's image; a factory restore's stock OS puts Control4's back. */
		firmware-name = "openhc/io-mcu-lm3s1162.bin";
		control4,ir-carriers = <IOMCU_PORT_D 1>, <IOMCU_PORT_F 3>;
		control4,ir-gates-active-low;
		control4,hold-low-pins = <IOMCU_PORT_F 4>, <IOMCU_PORT_F 5>,
					 <IOMCU_PORT_A 7>, <IOMCU_PORT_A 6>;
		control4,heartbeat-pin = <IOMCU_PORT_F 1>;
		#address-cells = <1>;
		#size-cells = <0>;

		/* Jack 1 = UART1, jack 2 = UART2: inferred, not yet probed. */
		jack@1 {
			reg = <1>;
			label = "IR / Serial 1";
			control4,ir-channel = <0>;
			control4,ir-gates = <IOMCU_PORT_C 7 0>, <IOMCU_PORT_C 6 1>;
			control4,uart = <0>;
			control4,uart-pins = <IOMCU_PORT_D 2>, <IOMCU_PORT_D 3>;
			control4,uart-mux-pins = <IOMCU_PORT_B 0>;
		};
		jack@2 {
			reg = <2>;
			label = "IR / Serial 2";
			control4,ir-channel = <1>;
			control4,ir-gates = <IOMCU_PORT_C 5 0>, <IOMCU_PORT_C 4 1>;
			control4,uart = <1>;
			control4,uart-pins = <IOMCU_PORT_G 0>, <IOMCU_PORT_G 1>;
			control4,uart-mux-pins = <IOMCU_PORT_B 1>;
		};
		jack@3 {
			reg = <3>;
			label = "IR 3";
			control4,ir-channel = <2>;
			control4,ir-gates = <IOMCU_PORT_B 4 0>, <IOMCU_PORT_B 5 1>;
		};
		jack@4 {
			reg = <4>;
			label = "IR 4";
			control4,ir-channel = <3>;
			control4,ir-gates = <IOMCU_PORT_B 6 0>, <IOMCU_PORT_F 2 1>;
		};
		ir-blaster {
			control4,ir-channel = <4>;
			control4,ir-gates = <IOMCU_PORT_F 0 0>, <IOMCU_PORT_D 5 1>;
		};
		ir-receiver {
			control4,ir-pin = <IOMCU_PORT_D 4>;
		};

		relays {
			#address-cells = <1>;
			#size-cells = <0>;

			relay@0 {
				reg = <0>;
				label = "Relay 1";
				control4,pin = <IOMCU_PORT_E 0>;
			};
		};

		contacts {
			#address-cells = <1>;
			#size-cells = <0>;

			contact@0 {
				reg = <0>;
				label = "Contact 1";
				control4,pin = <IOMCU_PORT_E 1>;
				control4,active-low;
			};
		};
	};
};

/*
 * omap3-cpu-thermal's 90 °C critical trip (sensor + 20 °C) shuts a warm HC-250
 * down at boot; stock has no thermal shutdown. 105 °C, the DM3730 extended Tj max.
 */
&cpu_crit {
	temperature = <105000>;
};

&mcbsp2 {
	status = "okay";
};

&mcbsp4 {
	pinctrl-names = "default";
	pinctrl-0 = <&mcbsp4_pins>;
	status = "okay";
};

/* 24-bit DPI to the ADV7513 and THS8200, with DM3730's data0-5 and 18-23 moved. */
&dss {
	pinctrl-names = "default";
	pinctrl-0 = <&dss_dpi_pins &dss_dpi_pins_wkup>;
	vdds_dsi-supply = <&vpll2>;
	status = "okay";

	port {
		dpi_out: endpoint {
			remote-endpoint = <&adv7513_in>;
			data-lines = <24>;
		};
	};
};

&omap3_pmx_core {
	dss_dpi_pins: dss-dpi-pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x20d4, PIN_OUTPUT | MUX_MODE0)	/* dss_pclk */
			OMAP3_CORE1_IOPAD(0x20d6, PIN_OUTPUT | MUX_MODE0)	/* dss_hsync */
			OMAP3_CORE1_IOPAD(0x20d8, PIN_OUTPUT | MUX_MODE0)	/* dss_vsync */
			OMAP3_CORE1_IOPAD(0x20da, PIN_OUTPUT | MUX_MODE0)	/* dss_acbias */
			OMAP3_CORE1_IOPAD(0x20e8, PIN_OUTPUT | MUX_MODE0)	/* dss_data6 */
			OMAP3_CORE1_IOPAD(0x20ea, PIN_OUTPUT | MUX_MODE0)	/* dss_data7 */
			OMAP3_CORE1_IOPAD(0x20ec, PIN_OUTPUT | MUX_MODE0)	/* dss_data8 */
			OMAP3_CORE1_IOPAD(0x20ee, PIN_OUTPUT | MUX_MODE0)	/* dss_data9 */
			OMAP3_CORE1_IOPAD(0x20f0, PIN_OUTPUT | MUX_MODE0)	/* dss_data10 */
			OMAP3_CORE1_IOPAD(0x20f2, PIN_OUTPUT | MUX_MODE0)	/* dss_data11 */
			OMAP3_CORE1_IOPAD(0x20f4, PIN_OUTPUT | MUX_MODE0)	/* dss_data12 */
			OMAP3_CORE1_IOPAD(0x20f6, PIN_OUTPUT | MUX_MODE0)	/* dss_data13 */
			OMAP3_CORE1_IOPAD(0x20f8, PIN_OUTPUT | MUX_MODE0)	/* dss_data14 */
			OMAP3_CORE1_IOPAD(0x20fa, PIN_OUTPUT | MUX_MODE0)	/* dss_data15 */
			OMAP3_CORE1_IOPAD(0x20fc, PIN_OUTPUT | MUX_MODE0)	/* dss_data16 */
			OMAP3_CORE1_IOPAD(0x20fe, PIN_OUTPUT | MUX_MODE0)	/* dss_data17 */
			OMAP3_CORE1_IOPAD(0x2100, PIN_OUTPUT | MUX_MODE3)	/* dss_data18.dss_data0 */
			OMAP3_CORE1_IOPAD(0x2102, PIN_OUTPUT | MUX_MODE3)	/* dss_data19.dss_data1 */
			OMAP3_CORE1_IOPAD(0x2104, PIN_OUTPUT | MUX_MODE3)	/* dss_data20.dss_data2 */
			OMAP3_CORE1_IOPAD(0x2106, PIN_OUTPUT | MUX_MODE3)	/* dss_data21.dss_data3 */
			OMAP3_CORE1_IOPAD(0x2108, PIN_OUTPUT | MUX_MODE3)	/* dss_data22.dss_data4 */
			OMAP3_CORE1_IOPAD(0x210a, PIN_OUTPUT | MUX_MODE3)	/* dss_data23.dss_data5 */
		>;
	};

	/* U-Boot leaves both in camera mode; stock's kernel muxes them as GPIOs. */
	wifi_pins: wifi-pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x210c, PIN_INPUT_PULLUP | MUX_MODE4)	/* cam_hs.gpio94: card detect in */
			OMAP3_CORE1_IOPAD(0x211a, PIN_OUTPUT | MUX_MODE4)	/* cam_d2.gpio101: wifi_carddetect */
		>;
	};

	mcbsp4_pins: mcbsp4-pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x2184, PIN_INPUT | MUX_MODE0)	/* mcbsp4_clkx */
			OMAP3_CORE1_IOPAD(0x2186, PIN_INPUT | MUX_MODE0)	/* mcbsp4_dr */
			OMAP3_CORE1_IOPAD(0x2188, PIN_OUTPUT | MUX_MODE0)	/* mcbsp4_dx */
			OMAP3_CORE1_IOPAD(0x218a, PIN_INPUT | MUX_MODE0)	/* mcbsp4_fsx */
		>;
	};
};

&omap3_pmx_wkup {
	dss_dpi_pins_wkup: dss-dpi-wkup-pins {
		pinctrl-single,pins = <
			OMAP3_WKUP_IOPAD(0x2a0a, PIN_OUTPUT | MUX_MODE3)	/* sys_boot0.dss_data18 */
			OMAP3_WKUP_IOPAD(0x2a0c, PIN_OUTPUT | MUX_MODE3)	/* sys_boot1.dss_data19 */
			OMAP3_WKUP_IOPAD(0x2a10, PIN_OUTPUT | MUX_MODE3)	/* sys_boot3.dss_data20 */
			OMAP3_WKUP_IOPAD(0x2a12, PIN_OUTPUT | MUX_MODE3)	/* sys_boot4.dss_data21 */
			OMAP3_WKUP_IOPAD(0x2a14, PIN_OUTPUT | MUX_MODE3)	/* sys_boot5.dss_data22 */
			OMAP3_WKUP_IOPAD(0x2a16, PIN_OUTPUT | MUX_MODE3)	/* sys_boot6.dss_data23 */
		>;
	};
};

/* Stock never registers VAUX3 and VDAC, so they stay as the PMIC powers up. */
&vaux3 {
	regulator-always-on;
};

&vdac {
	regulator-always-on;
};

/* Interior SD slot (inferred). CD is TWL GPIO 0 but reads "empty" on stock, so poll. */
&mmc1 {
	vmmc-supply = <&vmmc1>;
	bus-width = <4>;
	broken-cd;
};

/*
 * BCM4319 SDIO Wi-Fi behind a direction-controlled level shifter (dat4-7 =
 * dir/clkin, U-Boot's mux; X-Loader sets DEVCONF1 clock loopback). Card detect
 * is wifi_carddetect looped back to gpio94, as on stock: the radio comes up
 * when S38wifi-radio drives it low, after the firmware is in place.
 */
&mmc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&wifi_pins>;
	vmmc-supply = <&wifi_vmmc>;
	mmc-pwrseq = <&wifi_pwrseq>;
	bus-width = <4>;
	cd-gpios = <&gpio3 30 GPIO_ACTIVE_LOW>;
	cap-power-off-card;
	keep-power-in-suspend;
	status = "okay";
};

&mmc3 {
	status = "disabled";
};

/* Rear USB: MUSB through the TWL4030 PHY, host only. */
&usb_otg_hs {
	interface-type = <0>;
	usb-phy = <&usb2_phy>;
	phys = <&usb2_phy>;
	phy-names = "usb2-phy";
	mode = <1>;
	dr_mode = "host";
	power = <250>;
};

&gpmc {
	ranges = <0 0 0x30000000 0x01000000>,	/* CS0: NAND */
		 <5 0 0x2c000000 0x01000000>;	/* CS5: LAN9220 */

	/*
	 * Partitions as stock /proc/mtd, all read-only: mainline's BCH4 OOB layout is
	 * not Control4's (its ECC sits at OOB 36-63), so a write from here would read
	 * back as uncorrectable in U-Boot. The env is written by stock's fw_setenv.
	 */
	nand@0,0 {
		compatible = "ti,omap2-nand";
		reg = <0 0 4>;
		interrupt-parent = <&gpmc>;
		interrupts = <0 IRQ_TYPE_NONE>, <1 IRQ_TYPE_NONE>;
		nand-bus-width = <16>;
		gpmc,device-width = <2>;
		ti,nand-ecc-opt = "bch4";
		gpmc,sync-clk-ps = <0>;
		gpmc,cs-on-ns = <0>;
		gpmc,cs-rd-off-ns = <44>;
		gpmc,cs-wr-off-ns = <44>;
		gpmc,adv-on-ns = <6>;
		gpmc,adv-rd-off-ns = <34>;
		gpmc,adv-wr-off-ns = <44>;
		gpmc,we-off-ns = <40>;
		gpmc,oe-off-ns = <54>;
		gpmc,access-ns = <64>;
		gpmc,rd-cycle-ns = <82>;
		gpmc,wr-cycle-ns = <82>;
		gpmc,wr-access-ns = <40>;
		gpmc,wr-data-mux-bus-ns = <0>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "x-loader";
				reg = <0x00000000 0x00080000>;
				read-only;
			};
			partition@80000 {
				label = "u-boot";
				reg = <0x00080000 0x00200000>;
				read-only;
			};
			partition@280000 {
				label = "u-boot-env";
				reg = <0x00280000 0x00040000>;
				read-only;
			};
			partition@2c0000 {
				label = "kernel0";
				reg = <0x002c0000 0x00400000>;
				read-only;
			};
			partition@6c0000 {
				label = "rootfs0";
				reg = <0x006c0000 0x08000000>;
				read-only;
			};
			partition@86c0000 {
				label = "recovery-kernel";
				reg = <0x086c0000 0x00400000>;
				read-only;
			};
			partition@8ac0000 {
				label = "recovery-rootfs";
				reg = <0x08ac0000 0x08000000>;
				read-only;
			};
			partition@10ac0000 {
				label = "jffs2";
				reg = <0x10ac0000 0x01800000>;
				read-only;
			};
			partition@122c0000 {
				label = "internal";
				reg = <0x122c0000 0x05060000>;
				read-only;
			};
			partition@17320000 {
				label = "kernel1";
				reg = <0x17320000 0x00400000>;
				read-only;
			};
			partition@17720000 {
				label = "rootfs1";
				reg = <0x17720000 0x08000000>;
				read-only;
			};
			partition@1f720000 {
				label = "logs";
				reg = <0x1f720000 0x00800000>;
				read-only;
			};
			partition@1ff20000 {
				label = "u-boot-env-redund";
				reg = <0x1ff20000 0x00040000>;
				read-only;
			};
		};
	};

	ethernet@gpmc {
		reg = <5 0 0xff>;
		interrupt-parent = <&gpio1>;
		interrupts = <27 IRQ_TYPE_LEVEL_LOW>;		/* gpio27 */
		reset-gpios = <&gpio6 17 GPIO_ACTIVE_LOW>;	/* gpio177 */
	};
};

#include "omap-gpmc-smsc911x.dtsi"
