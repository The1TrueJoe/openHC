# openHC — Control4 IO Extender V1 ("DM355 I/O Bar", board codename "hammer").
#
# Self-contained: no family base. TI DaVinci DM355 (ARM926EJ-S), 128 MB RAM,
# 256 MB NAND. Native IO — no companion IO-MCU: 8 relays and 8 contacts on SoC
# GPIO (named in the device tree, see /shared/io-naming/), 8 IR-out and 4 serial
# behind a Xilinx FPGA on async-EMIF CS1. dm9000 Ethernet is the only
# reachability path. Stock U-Boot's `run tst` netboots a uImage into RAM without
# touching flash — that is the bring-up loop.

# --- arch: ARM926EJ-S, ARMv5TE, no FPU so soft float (implied) ---
BR2_arm=y
BR2_arm926t=y

# musl, matching the EA family. Small and fine on ARMv5 against a 7.1 kernel.

# --- init / login ---
# Password login on the serial console AND ssh. Change after first boot.
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_TARGET_GENERIC_HOSTNAME="openhc-ioxv1"
BR2_TARGET_GENERIC_ISSUE="openHC IO Extender V1"

# --- kernel: mainline stable, same version as the EA family ---
# Mainline dropped DM355 in ~v6.2; the SoC (mach-davinci/dm355.c, clk psc/pll,
# irq-davinci-aintc) + the hammer device tree are re-added by the patches in
# ioxv1/patches/linux/. See https://the1truejoe.github.io/openHC/iox/kernel-port/.
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="multi_v5"
# The DM355 U-Boot (IOX v1.2.0) boots a legacy uImage and passes ATAGS, not a
# DTB. So we build a plain zImage + the board DTB and do the append + uImage
# wrap ourselves in post-image.sh (bootm loads at 0x82000000, kernel unpacks to
# 0x80008000). NOTE: Buildroot's own BR2_LINUX_KERNEL_APPENDED_UIMAGE mangles a
# vendored ("ti/davinci/...") DTS name into the output path and fails, so we do
# the wrap by hand — same pattern the EA boards use for their CEFDK container.
BR2_LINUX_KERNEL_ZIMAGE=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="ti/davinci/dm355-hammer"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_OPENHC_PATH)/ioxv1/linux/ioxv1.fragment"

# --- rootfs: initramfs embedded in the uImage (netboot) + JFFS2 (flash) ---
# A RAM rootfs we can netboot without touching flash, iterate, and only commit
# to NAND once the kernel is trusted. `run tst` bootm's a single uImage, so the
# initramfs is EMBEDDED in it. A standalone JFFS2 image (128K NAND erase block)
# is also emitted for flashing a bank later.
BR2_TARGET_ROOTFS_INITRAMFS=y
BR2_TARGET_ROOTFS_JFFS2=y
BR2_TARGET_ROOTFS_JFFS2_NANDFLASH_128K=y

# --- on-target tools ---
# NAND flashing / inspection (flash_erase, nandwrite, flashcp).
BR2_PACKAGE_MTD=y
# Host mkimage: post-image.sh wraps zImage+dtb into the U-Boot uImage.
BR2_PACKAGE_HOST_UBOOT_TOOLS=y

# --- mDNS identity: avahi (no D-Bus, light) ---

# --- rootfs overlay, image wrap, kernel patches ---
# BOTH overlays, common first. BR2_ROOTFS_OVERLAY is a space-separated list and
# kconfig takes the last assignment of a symbol, not the union, so naming only
# the board overlay silently dropped board/common/rootfs-overlay -- and with it
# S40net, which is what brings eth0 (dm9000) up. Also lost were S09hostname (the
# per-unit MAC suffix), S45netmon, S41wifi-ap and the avahi service file, so the
# board advertised nothing on mDNS either. ca1 and hc800 list both; this board
# and hc800 had the same bug.
#
# The shared scripts are board.env-driven and no-op on what this board does not
# have: OHC_WIFI_IFACE is unset in ioxv1's board.env (dm9000, wired only), so
# S41wifi-ap and S45netmon exit immediately, and S90ohcweb skips itself when
# webd was not built in. Order matters -- later overlays overwrite earlier
# ones, which is how ioxv1/rootfs-overlay/init replaces the EA pivot.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_OPENHC_PATH)/common/rootfs-overlay $(BR2_EXTERNAL_OPENHC_PATH)/ioxv1/rootfs-overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_OPENHC_PATH)/ioxv1/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="ioxv1"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_OPENHC_PATH)/ioxv1/patches"

# The FPGA slave-serial loader (board/ioxv1/kernel/drivers/misc). Without it the
# four RS-232 ports and eight IR outputs do not exist, because the part they
# live in boots blank.
BR2_OHC_IOXV1_KERNEL_DRIVERS=y

# kexec-tools, so a new kernel is scp + `kexec -l` + `kexec -e` rather than a
# netboot window and someone pulling the power. See CONFIG_KEXEC in the kernel
# fragment for why this board in particular needs it.
BR2_PACKAGE_KEXEC=y
BR2_PACKAGE_KEXEC_ZLIB=y
