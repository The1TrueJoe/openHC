#!/bin/sh
# openHC bring-up marker for the DM355 IOX family: proves we reached userspace
# on a modern (7.1.x) kernel. The model is the device tree's.
[ "$1" = start ] || exit 0
board=$(ohc-hw model)
echo ""
echo "  openHC ${board:-unknown IOX board} — kernel-up bring-up rootfs"
echo "  kernel: $(uname -r)   $(uname -m)"
echo ""
