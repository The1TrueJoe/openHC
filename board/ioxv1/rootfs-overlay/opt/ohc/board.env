# openHomeController board config — IO Extender V1 (DM355) kernel-up build.
# Sourced by the init scripts and (later) the ohc services. Shell assignments only.

OHC_MODEL=ioxv1                 # DM355 "hammer" I/O Bar (distinct from the EA family)
OHC_ID_IFACE=eth0               # the MAC that names this box (dm9000, wired only)
OHC_MDNS_IFACE="eth0"           # single wired NIC on this board
OHC_UPLINK_IFACE=eth0           # wired uplink; no radio, so nothing falls back to an AP
OHC_WIFI_IFACE=                 # deliberately EMPTY: this board has no radio at all
OHC_TIMEZONE=America/New_York   # host timezone

# --- native IO map (no companion IO-MCU on this board) ---
# Relays and contacts are plain SoC GPIO. The OFFSETS are not here: they are a
# property of this SoC's ball map and live in the device tree, as gpio-line-names
# on the gpio@1c67000 node. `gpiofind relay1` resolves the same string here as it
# does on an HC-800, where the IO microcontroller's driver names them — so
# nothing in userspace carries a per-board table of GPIO numbers.
#
# (Contacts 1 and 2 are GIO71 and GIO70, reversed. That is exactly the sort of
# thing a hand-maintained list of numbers gets wrong.) Every line here is
# confirmed against the vendor's own GPL board file, arch/arm/mach-davinci/
# board-hammer.c: relay1-8 = GIO88-95 active-high, contact1-8 = GIO71, 70,
# 82, 83, 84, 85, 86, 87, data-led = GIO75, link-led = GIO76, id-btn = GIO9,
# recovery-btn = GIO8.

# --- THE FPGA IS THE OTHER HALF OF THIS BOARD -------------------------------
# Relays, contacts and the front LEDs are SoC GPIO and work on their own. The
# four serial ports and the eight IR outputs DO NOT: they are registers inside a
# Xilinx FPGA on async EMIF CS1, and that FPGA comes out of reset BLANK.
#
# The vendor does not program it in U-Boot — its kernel does, from c4fpga.ko,
# by bit-banging a bitstream in over slave-serial GPIOs:
#
#   m2 = GIO55   m0 = GIO57   prog = GIO98   cclk = GIO96
#   din = GIO58  initb = GIO7 done = GIO97
#
# So until openHC loads a bitstream, /dev/ttyS1-4 do not exist and no IR output
# radiates, no matter what this file declares. See the IO Extender FPGA note in
# the docs for the loader sequence (it is GPL, in Control4's own U-Boot
# cmd_c4fpga.c) and for what still has to come off a vendor unit.
OHC_FPGA=xilinx-slave-serial
OHC_FPGA_FIRMWARE=/lib/firmware/c4/iox-fpga.bin
OHC_FPGA_BASE=0x04000200        # FPGA window on DAVINCI_ASYNC_EMIF_DATA_CE1 + 0x200

# --- the unified IO description every board answers ---------------------------
# OHC_IO_BACKEND says HOW the IO is reached, and it is the only thing ohc-iod
# branches on:
#   mcu   relays/contacts/IR live behind a microcontroller on a serial port,
#         spoken to with the DLE/STX protocol
#   gpio  they are native SoC GPIO lines
#   none  the board has no local IO at all
# Counts are ZERO WHEN ABSENT, and absent means the UI does not draw the panel.
OHC_IO_BACKEND=gpio
OHC_IO_MCU_PART=
# EIGHT IR outputs, from the FPGA's two IR blocks at OHC_FPGA_BASE + 0x20 and
# + 0x30 (16 bytes each, per the vendor board file's c4irout_fpga_resource).
# Not an MCU, and not a bitmask like the HC-800's: how those 32 bytes divide
# into eight emitters is NOT known yet, and nothing in the GPL drop says — the
# c4irout.c that would have said is the one file Control4 did not ship.
OHC_IR_OUT=8
OHC_IR_COMBO=0                  # every jack is IR-only; the serial ports are separate
OHC_IR_BLASTER=0                # no internal emitter on this box
OHC_IR_IN=0                     # and no receiver, so no learning here
OHC_RELAYS=8                    # native GPIO, named in the device tree
OHC_CONTACTS=8                  # native GPIO, named in the device tree
OHC_IO_UARTS=0                  # none MCU-routed — there is no MCU

# --- serial ------------------------------------------------------------------
# FOUR RS-232 ports on the back, and they are ordinary 16550As — just ones that
# live inside the FPGA rather than in the SoC. Their windows are 16 bytes each
# at OHC_FPGA_BASE + 0x40/0x50/0x60/0x70, one byte per register (reg-shift 0,
# NOT the SoC UART's 2), sharing a single rising-edge interrupt on GIO7.
#
# They support hardware flow control: Control4 patched 8250.c to let the MCR's
# AFE bit through for exactly these ports, "because the fpga supports flow
# control but is detected as a 16550A".
#
# ttyS0 is the SoC console at 0x01c20000, so these land as ttyS1-4 — which is
# why the kernel fragment sets CONFIG_SERIAL_8250_RUNTIME_UARTS=5.
#
# UNVERIFIED: the input clock. The vendor's SoC ports run at 27 MHz but these
# are clocked by the FPGA, and the GPL drop does not say. Read it off a vendor
# unit — `setserial -a /dev/ttyS1` reports baud_base, which is uartclk/16 —
# before trusting any rate here.
OHC_SERIALS="ttyS1:RS-232_port_1:115200 ttyS2:RS-232_port_2:115200 ttyS3:RS-232_port_3:115200 ttyS4:RS-232_port_4:115200"
OHC_CONSOLE_TTY=/dev/ttyS0      # SoC UART0, the header inside the case
