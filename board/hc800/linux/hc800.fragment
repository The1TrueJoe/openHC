# Kernel config delta on the mainline x86_64 defconfig, for a reachable HC-800.
#
# Read this next to board/ea-common/linux/common.fragment and note what is NOT
# here: there is no size trim. That fragment cuts hard because CEFDK's bootlinux
# copies the kernel into a ~7 MB window and overruns its own loader if the image
# is bigger. The HC-800 boots from GRUB 0.97, which has no such ceiling, so this
# fragment only turns things ON — every line below is a device that exists on
# the board, and the reason it is here is that a stock x86_64 defconfig either
# leaves it off or builds it as a module.
#
# Everything here is mainline. This board needs no patches. See
# https://the1truejoe.github.io/openHC/hc800/.

# ── all-builtin, no loadable modules ──────────────────────────────────────
# Same call as the EA family: the image is self-contained, so there is no
# depmod step, no module load ordering to get right, and no .ko files in the
# initrd.
#
# THE HAZARD THIS CREATES, and why so many symbols below are set explicitly:
# the x86_64 defconfig marks a lot of what we need as =m, and kconfig silently
# turns every =m into =n once MODULES is off. A driver that "is in the
# defconfig" is therefore not necessarily in this kernel. Anything the HC-800
# actually needs is forced =y here rather than inherited.
CONFIG_MODULES=n

# ── serial: five 8250 UARTs, and ttyS4 is the one that gets lost ──────────
# The UARTs are LPC/ISA-range and enumerate through PNPACPI (the live unit
# reports them as PNP devices "00:02".."00:06"), so SERIAL_8250_PNP is load
# bearing, not decoration.
#
# NR_UARTS *and* RUNTIME_UARTS both have to be 5. Mainline defaults RUNTIME to
# 4, which registers ttyS0..ttyS3 and silently drops ttyS4 — the Zigbee NCP.
# The vendor's own config sets both to 5 (read out of /proc/config.gz on the
# live unit); this is that same value, for that same reason.
#
#   ttyS0 0x3f8 console     ttyS1 0x2f8 rear RS-232 #1
#   ttyS2 0x3e8 rear RS-232 #2                  ttyS3 0x2e8 LM3S1162 IO-MCU
#   ttyS4 0x2f0 Zigbee EM357 NCP
CONFIG_PNP=y
CONFIG_PNPACPI=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PNP=y
CONFIG_SERIAL_8250_NR_UARTS=5
CONFIG_SERIAL_8250_RUNTIME_UARTS=5

# ── external initrd (GRUB `initrd` line hands us a rootfs.cpio.gz) ────────
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# ── storage: ICH7 AHCI ────────────────────────────────────────────────────
# ata1 is the internal 8 GB SanDisk SSD; ata2 is the rear eSATA jack, same
# controller. We do not boot from either — the rootfs is the initrd — but the
# disk must be readable to install our own kernel onto sda3 and to edit
# menu.lst on sda1, which is how openHC updates itself once it is the running
# image. USB storage is on for the front jack.
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_MSDOS_PARTITION=y

# The boot partitions (sda1, sda3) are ext3 and the vendor root (sda4) is ext4.
# One driver covers all three.
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# ── wired: Realtek RTL8111/8168 (10ec:8168 at 02:00.0) ────────────────────
# The vendor ships Realtek's out-of-tree r8168 8.043.02. Mainline's r8169 has
# covered this device for years and is what we use — this is the reachability
# path for bring-up, so it is builtin and not negotiable.
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y

# ── USB: four ICH7 UHCI companions + one EHCI ─────────────────────────────
# Not optional here: the Wi-Fi radio is a USB device on an internal port.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y

# ── Wi-Fi: no driver exists on this kernel ────────────────────────────────
# This block used to set CONFIG_R8712U=y for the board's USB RTL8192SU
# (0bda:8172), with a note saying "if drivers/staging/rtl8712 has been dropped
# by 7.1.8 then Wi-Fi is what breaks". It has been dropped: the directory is
# gone from mainline and the symbol does not exist in this kernel's Kconfig.
#
# That failed SILENTLY, which is the part worth remembering — Buildroot merges
# fragments with merge_config.sh, and an unknown symbol is dropped with a
# warning rather than an error. The build stayed green while the driver it named
# was never built, and the only way to see it was to extract the config back out
# of the finished bzImage (which is why CONFIG_IKCONFIG is on below).
#
# Nothing else claims 0x8172: not rtl8xxxu, not rtw88/rtw89, not the rtlwifi USB
# drivers. So WLAN/CFG80211/WIRELESS_EXT/STAGING are all off — there is no radio
# to support, WIRELESS_EXT has nothing to select it, and leaving them on only
# grows the kernel. The userspace was removed from hc800_defconfig to match.
#
# The hardware is still in the box and the vendor's 3.16 still drives it, so
# this is a software gap, not a missing part. See hc800_defconfig for what to
# turn back on the day a driver exists.
# CONFIG_WLAN is not set

# ── audio: ICH7 HD Audio + ALC888-VD ──────────────────────────────────────
# 2 line out (pins 0x14 rear, 0x1b front), 1 line in (0x1a), coax S/PDIF out
# (0x1e). The BIOS pin defaults describe the panel correctly, so the generic
# parser gets the jacks right and no model quirk is needed.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y

# ── ICH7 platform glue: LPC → GPIO, SMBus, watchdog ───────────────────────
# lpc_ich is the MFD that spawns gpio_ich; without it there is no GPIO chip and
# no way to touch zigbee_reset / io_reset / wlan_disable / lan_disable / the
# board-revision straps. GPIO_CDEV is the chardev ABI libgpiod uses. Note
# mainline gpio-ich supplies no line names — address lines by chip + offset,
# per rootfs-overlay/opt/ohc/board.env.
CONFIG_MFD_CORE=y
CONFIG_LPC_ICH=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_ICH=y
CONFIG_GPIO_CDEV=y

# SMBus. The ADV7511 HDMI transmitter (0x72) and THS8200 video DAC (0x21) live
# here; the vendor instantiates them from its board file. We instantiate
# nothing — this is on so the bus can be probed with i2c-tools when somebody
# takes the video question seriously.
CONFIG_I2C=y
CONFIG_I2C_I801=y
CONFIG_I2C_CHARDEV=y

# iTCO watchdog. The vendor runs /sbin/watchdog -t 10 against it, so it is
# known good on this silicon. Needs LPC_ICH (above) for the NO_REBOOT bit.
CONFIG_WATCHDOG=y
CONFIG_ITCO_WDT=y

# Atom package/core temperature. The vendor kernel registers no hwmon device at
# all; coretemp is free and this is a fanless box in a rack.
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=y

# CMOS RTC — an ordinary PC RTC, so hwclock works with no I2C part to hunt for.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y

# ── a head, after all: i915 + fbdev emulation for the boot splash ─────────
# This block used to read "no head" and turn DRM and FB off, on the grounds that
# openHC is headless everywhere and DRM is a large stack for an output nobody
# uses. That was true until somebody wanted the EA family's boot splash on this
# board, and it is cheap to change here for one reason: this is the board with
# NO image-size ceiling. ea-common has to fight CEFDK bootlinux's ~8.07 MB copy
# window (which is why it turned MODULES back on just to get DRM out of the
# bzImage); GRUB 0.97 has no such limit and sda3 has 165 MB free, so a few MB of
# builtin DRM costs nothing. MODULES=n above means builtin is the only option.
#
# The measured cost of USING it is also nothing, which is the other half of the
# argument: a full 1280x720x32 frame is 3.6 MB and the live unit writes one to
# /dev/fb0 at 434 MB/s -- about 8 ms. The splash draws one frame, once.
#
# Why the display comes up at all with no monitor attached: LVDS-1 reports
# connected with a ZERO-byte EDID and exactly one mode, 1280x720, because the
# timings come from the BIOS VBT rather than from a display. That LVDS port is
# wired to the THS8200 component DAC (i2c-6 @0x21) and the ADV7511 HDMI
# transmitter (@0x72). Mainline i915 parses the same VBT, so the mode should
# come up here exactly as it does under the vendor's 3.16.
#
# NOTE: getting PIXELS OUT OF THE JACKS is a separate problem this does not
# solve. The vendor configures the THS8200 in-kernel (ths8200.ko, GPL) and the
# ADV7511 from USERSPACE (/control4/lib/libvidcfg.so, via ioserver). Mainline's
# drm/bridge/adv7511 needs a DT bridge attachment and cannot attach to x86 i915,
# so HDMI will need a userspace i2c configurator. Until then this lights the
# pipe and draws into it; whether a TV sees it is unproven.
CONFIG_DRM=y
CONFIG_DRM_I915=y
# UNVERIFIED on 7.1.8: i915 has carried gen2/gen3 (Pineview is gen3) for the
# whole mainline era, but upstream has periodically discussed dropping the old
# gens. If this kernel's i915 no longer probes 8086:a001 the symptom is a boot
# with no /dev/fb0 and no "i915" line in dmesg -- check that first rather than
# suspecting the fragment. There is no fallback driver; gma500 is Poulsbo, not
# Pineview.

# /dev/fb0 from a DRM driver needs the fbdev emulation layer, and the legacy
# device node is its own symbol since 6.6: DRM_FBDEV_EMULATION selects FB_CORE,
# NOT FB, and FB_DEVICE (which creates /dev/fbX) defaults to the value of FB.
# Set all three rather than rely on that chain -- the failure mode is a working
# framebuffer console with no node for ohc-splash to open, which looks like a
# broken splash rather than a missing kconfig symbol.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y

# No fbcon, for the reason ea-common/linux/video.fragment records: the text
# console clears the framebuffer when it takes the surface over, and that is
# what ate the EA's first splash. The console is ttyS0 on this board and always
# was. Flip this to =y temporarily if you want the kernel log on the TV while
# debugging -- it and the splash cannot both have the screen.
# CONFIG_FRAMEBUFFER_CONSOLE is not set

# VGA_CONSOLE stays at its defconfig value so a monitor on the internal header
# still shows a panic before i915 takes over ("Replacing VGA console driver").

# ── read the config back off the running box ──────────────────────────────
# The vendor kernel has /proc/config.gz and it has been worth its weight in this
# port — every "does the vendor set X?" question was answered by reading it
# instead of guessing. Ours had no equivalent, which bit immediately: the CI
# artifact could not be checked for CONFIG_DRM_I915 because there was nothing
# embedded in the bzImage to extract, so the evidence had to come from grepping
# the build log for compiled object files.
#
# ~30 KB of gzipped config in the image, and the first person to debug this on
# hardware can run `zcat /proc/config.gz | grep DRM` instead of asking CI.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ── note on the stack protector ───────────────────────────────────────────
# ea-common has to disable STACKPROTECTOR: musl + i386 + 7.1.8 disagree about
# the per-CPU canary and the kernel panics in do_idle. x86_64 puts the canary at
# a fixed %gs offset and is expected to be fine, so it is left ON here. If this
# board panics with "stack-protector: Kernel stack is corrupted in: do_idle",
# the fix is the same two lines ea-common uses:
#   # CONFIG_STACKPROTECTOR is not set
#   # CONFIG_STACKPROTECTOR_STRONG is not set
