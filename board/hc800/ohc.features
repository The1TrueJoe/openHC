# The HC-800 has no family base — it is a PC, not a Control4 SoC board — so this
# is its whole feature list.
iomcu       # LM3S1162 on ttyS3: 4 relays, 4 contacts, 6 IR
splash      # component/HDMI out via the THS8200, so there is a framebuffer
zigbee      # EM357 NCP on ttyS4 (0x2f0); node (cp210x unused here)
audio       # ALC888 HDA: Analog 1 + 2 (rear RCA), coax, HDMI, line in;
            # N Spotify Connect + N AirPlay endpoints via audiod
restore     # on-box return to stock: restore arms Control4's factory
            # restore for one boot (flasher + web UI); the ID button stays
            # Control4's own power-on factory reset
storage     # USB (front) + eSATA (rear, ata2) drives mounted and shared over
            # SMB by storaged; music on them plays through audiod
wpe         # on-screen web surface (Mesa i915 + WPE WebKit's DRM platform),
            # on the component output, opt-in from the web UI (S95ohc-display)
update      # software updates from the web UI (updated): stable releases or
            # the dev channel, installed onto sda3 and rebooted
usb-input   # USB keyboards, mice, game controllers (front USB, hubs too) for the
            # on-screen UI
