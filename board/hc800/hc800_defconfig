# openHC — Control4 HC-800 (Lite-On AE100, Intel Atom D525 + NM10/ICH7).
#
# Self-contained: no family base, fed to Buildroot on its own. There will never
# be an "hc-common" — this board is an ordinary PC and shares nothing with the
# EA family's CE5310 SoC. Hardware inventory and bring-up notes:
# https://the1truejoe.github.io/openHC/hc800/
#
# It needs NO kernel patches: every driver is mainline and has been for a decade.

# --- arch: x86_64, Bonnell tuning ---
# The one deliberate departure from the vendor, who ships a 32-bit non-PAE
# kernel and strands 1149 MB of the 2 GB in HIGHMEM. The D525 reports `lm` and
# `nx`. GRUB 0.97 boots a 64-bit bzImage fine. To revert: BR2_i386=y, same
# BR2_x86_bonnell.
BR2_x86_64=y
BR2_x86_bonnell=y

# x86_64 pulls in objtool, which #includes <gelf.h>. Without this the kernel
# build dies on a missing HOST header while naming only itself:
#   tools/objtool/include/objtool/elf.h:10:10: fatal error: gelf.h
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# --- init / login ---
BR2_TARGET_GENERIC_HOSTNAME="openhc-hc800"
BR2_TARGET_GENERIC_ISSUE="openHC Control4 HC-800"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y

# --- kernel ---
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_BZIMAGE=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_OPENHC_PATH)/hc800/linux/hc800.fragment"

# --- rootfs: standalone gzipped cpio, GRUB loads it as an external initrd ---
# A separate file rather than initramfs-in-the-bzImage (ioxv1/ca1 style) because
# GRUB 0.97's `initrd` builtin works here — verified by string-dumping the
# installed stage2 — and a rootfs change then does not mean re-copying a kernel.
# Installing is two files on sda3 plus a menu.lst entry; sda2 and sda4 are never
# touched. See /shared/recovery/ before changing that.
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y

# --- Wi-Fi: not supported, and that is measured rather than assumed ---
# The radio is a USB RTL8191SU (0bda:8172). Its only ever mainline driver was
# drivers/staging/rtl8712, which has been DELETED — the symbol is not merely off
# in our build, it is absent from the kernel's Kconfig. rtl8xxxu, rtw88/rtw89
# and the rtlwifi USB drivers all cover different silicon.
#
# board.env leaves OHC_WIFI_IFACE empty to match, so the shared scripts say "no
# radio on this board" rather than hunting for a wlan0 that cannot appear.
#
# To restore the day a driver exists, re-add:
#   BR2_PACKAGE_LINUX_FIRMWARE=y + _RTL_87XX, BR2_PACKAGE_WPA_SUPPLICANT=y
#   (+_WEXT/_NL80211/_CLI/_PASSPHRASE), BR2_PACKAGE_IW=y

# --- on-target tools ---
# usbutils needs BR2_PACKAGE_HAS_UDEV, which the fleet has since board/common
# moved to eudev.
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_USBUTILS=y
# Mounting sda1/sda3 to install our own kernel, and fsck when a half-written
# menu.lst needs sorting out.
BR2_PACKAGE_E2FSPROGS=y
# kexec is HOW THIS BOARD IS UPDATED, and it is why the boot chain is pristine:
# a new image is loaded straight into the running kernel and started, touching
# no partition at all — so GRUB, the vendor root and the factory-restore path
# are exactly as they shipped. Without it in the image, updating means borrowing
# a static i686 kexec from somewhere, which is how it was done before this line.
# Zlib support because our bzImage is compressed.
BR2_PACKAGE_KEXEC=y
BR2_PACKAGE_KEXEC_ZLIB=y
# ALC888S verification: 2 line out, 1 line in, coax S/PDIF. iecset drives the
# IEC958 status bits, i.e. the coax jack specifically; alsactl is what S46audio
# calls after unmuting.
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSAMIXER=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
BR2_PACKAGE_ALSA_UTILS_IECSET=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y

# --- component video: the only output anything drives ---
# THS8200 DAC on i2c-6 @0x21. ths8200 replays a register set captured off this
# hardware at 720p60; it checks the VERSION register first and refuses to write
# unless it reads 0x04, so a wrong bus or address is a no-op. The ADV7513 beside
# it is fitted and answers, and is configured by nobody — not even the vendor OS.
BR2_PACKAGE_THS8200=y

# --- front panel: six LEDs and the ID button ---
# Injects board/hc800/kernel/drivers, which registers leds-gpio and
# gpio-keys-polled for wiring no x86 firmware describes. Offsets came out of the
# vendor kernel's own board file and are confirmed three ways; see board.env.
BR2_OHC_HC800_KERNEL_DRIVERS=y

# --- rootfs overlay + image publishing ---
# BOTH overlays, common first. BR2_ROOTFS_OVERLAY is a space-separated list and
# kconfig takes the LAST assignment, not the union — naming only the board
# overlay silently dropped board/common's, and with it S40net, so an image built
# to be reached over the network came up with no address. Later overlays
# overwrite earlier ones, which is how hc800's `init` replaces the EA pivot.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_OPENHC_PATH)/common/rootfs-overlay $(BR2_EXTERNAL_OPENHC_PATH)/hc800/rootfs-overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_OPENHC_PATH)/hc800/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="hc800"
