# openHomeController board config — Control4 HC-800 (Atom D525) kernel-up build.
# Sourced by the init scripts and (later) the ohc services. Shell assignments only.

OHC_MODEL=hc800                 # Lite-On AE100 board, no Lego codename on this generation
OHC_ID_IFACE=eth0               # the MAC that names this box (RTL8168, single port)
OHC_MDNS_IFACE="eth0"           # wired only — no wlan0 on 7.1.8, see the Wi-Fi note
OHC_UPLINK_IFACE=eth0           # RTL8168, single port, no managed switch
# (no OHC_DSA_PORTS: this board has one plain MAC, not a BCM53125 like the EA3)

# --- Wi-Fi: the radio exists, the DRIVER does not -----------------------------
# The hardware is real and the vendor kernel drives it: USB RTL8192SU
# (0bda:8172) on internal port 1-7, wlan0 = 44:6d:57:10:c7:aa under Control4's
# 3.16 via staging r8712u.
#
# But drivers/staging/rtl8712 has been DELETED from mainline, and nothing else
# claims 0x8172 — so on openHC's 7.1.8 there is no wlan0 to configure. See the
# long note in hc800_defconfig; the userspace was removed to match.
#
# OHC_WIFI_IFACE is deliberately EMPTY, not "wlan0". The shared S41wifi-ap and
# S45netmon branch on it: empty means "no radio on this board, skipping", which
# is the truth, while "wlan0" would make them hunt for an interface that can
# never appear and report a misleading failure.
OHC_WIFI_IFACE=
# Kept for the day a driver exists — these were measured against the live vendor
# system and are still correct about the HARDWARE:
#   OHC_WIFI_DRIVER=wext        r8712u sets wireless_handlers, registers no wiphy
#   OHC_WIFI_MODULE=            it was builtin in our kernel; nothing to modprobe
#   OHC_WIFI_AP_CAPABLE=0       station only; no AP mode, no nl80211 for hostapd

# --- UARTs -------------------------------------------------------------------
# Five ISA-range 8250 ports. ttyS4 only exists because the kernel fragment sets
# CONFIG_SERIAL_8250_RUNTIME_UARTS=5; mainline's default of 4 drops it.
OHC_CONSOLE_TTY=/dev/ttyS0      # 0x3f8 — GRUB's terminal and ours, 115200

# The two rear RS-232 ports present as HOST UARTs on this board — the vendor's
# ioserver opens them directly. On the EA family the equivalent combo ports hang
# off the TM4C with no /dev/ttyS* at all, so anything shared with those boards
# has to branch here. (Unresolved: https://the1truejoe.github.io/openHC/shared/io-mcu/ reads the LM3S image
# as also driving two user UARTs, which would mean these are bridged through the
# MCU rather than wired to the transceivers. Either way the tty is the same.)
OHC_SERIAL_TTYS="/dev/ttyS1 /dev/ttyS2"     # 0x2f8, 0x3e8

# --- IO-MCU ------------------------------------------------------------------
# TI Stellaris LM3S1162, same part as the HC-250 and the same DLE/STX framing
# and TI serial flash-loader as the EA family's TM4C. Behind it: 6 IR outputs,
# 4 relays, 4 contact inputs. There are no host GPIOs for any of that.
OHC_IOMCU=lm3s1162
OHC_IOMCU_TTY=/dev/ttyS3        # 0x2e8, vendor symlink /dev/ttySStellaris, 115200
OHC_IOMCU_BAUD=115200
# Panel counts, not firmware-decoded. Relays/contacts match the decoded TM4C
# profile table's 4+4 for this class of board; the IR count does NOT match
# io-mcu-firmware.md's four-timer reading of the LM3S image. See
# https://the1truejoe.github.io/openHC/hc800/#io-an-lm3s1162-on-ttys3 before wiring anything to these.
OHC_IR_OUTPUTS=6
OHC_RELAYS=4
OHC_CONTACTS=4

# --- Zigbee ------------------------------------------------------------------
# EM357 EmberZNet NCP on an on-SoC UART (the EA family puts its NCP behind a
# CP2104 USB bridge instead). Baud is UNCONFIRMED — nothing held this port
# during the recon pull, so the 9600 it was sitting at is just the 8250 default.
OHC_ZIGBEE_TTY=/dev/ttyS4       # 0x2f0, vendor symlink /dev/ttySZigbee
OHC_ZIGBEE_BAUD=115200          # EZSP/ASH usual; verify against the NCP

# --- GPIO: the ICH GPIO block ------------------------------------------------
# lpc_ich spawns one chip labelled "gpio_ich". These are OFFSETS WITHIN THAT
# CHIP, not the sysfs numbers the vendor's /etc/init.d/gpio uses: on the stock
# 3.16 kernel the chip base happened to be 206, so its zigbee_reset (offset 0)
# appeared as /sys/class/gpio/gpio206. The base is dynamic on a modern kernel
# and the number will differ — the offset will not.
#
# Mainline gpio-ich sets no line names, so `gpiofind` cannot resolve these the
# way it does on the CA-1's device tree. Use chip + offset:
#
#   gpioget $(gpiodetect | awk '/gpio_ich/{print $1}') 24     # reset button
#
OHC_GPIO_CHIP_LABEL=gpio_ich
OHC_GPIO_ZIGBEE_RESET=0         # out, 1 = released
OHC_GPIO_WLAN_DISABLE=14        # out, 0 = radio enabled
OHC_GPIO_LAN_DISABLE=15         # out, 0 = NIC enabled
OHC_GPIO_RESET_BUTTON=24        # in  — the ID/setup button
OHC_GPIO_IO_RESET=33            # out, 1 = LM3S1162 released
OHC_GPIO_BOARD_ID0=34           # in  \
OHC_GPIO_BOARD_ID1=38           # in   } 3-bit strap = BOARD REVISION (100b = 4
OHC_GPIO_BOARD_ID2=39           # in  /  on the recon unit, matching c4board)

# LEDs are deliberately absent. The vendor exposes six (c4::power, c4::data,
# c4::network, wifi::{red,yellow,blue}) from a leds-gpio platform device
# registered in its board file; which ICH offsets they sit on is not recoverable
# from a running system and is still an open question in https://the1truejoe.github.io/openHC/hc800/.

# --- audio: ALC888-VD on ICH7 HD Audio ---------------------------------------
# Pin defaults from the BIOS map straight to the panel, so the generic Realtek
# parser needs no quirk. Every node below is from a live codec dump
# (/proc/asound/card0/codec#2), and EVERY pin not listed here reads the
# canonical "not connected" default 0x411111f0 -- 0x12, 0x15-0x19, 0x1c, 0x1f.
#
# The codec answers at HDA address 2, not 0: the proc node is codec#2. The card
# is still 0; only tools that address the codec directly care.
OHC_AUDIO_CARD=0
OHC_AUDIO_CODEC="Realtek ALC888-VD"
OHC_AUDIO_HDA_ADDR=2            # /proc/asound/card0/codec#2, NOT codec#0
# Jacks are RCA on this box, not the 1/8" the codec's generic defaults imply.
OHC_AUDIO_LINE_OUT=2            # 0x14 Line Out, Ext Rear, RCA green
                                # 0x1b HP Out,   Ext Front, RCA green
OHC_AUDIO_LINE_IN=1             # 0x1a Line In,  Ext Rear, RCA blue
OHC_AUDIO_SPDIF_COAX=1          # 0x1e SPDIF Out, Ext Rear, RCA black
# The one the old note missed entirely: an INTERNAL digital output, pin default
# 0x18561130 = "Digital Out at Int HDMI", association 3 / sequence 0, marked
# NO_PRESENCE (no jack detect, because there is no jack -- it is board wiring).
# This is the audio half of the ADV7511 HDMI path, so HDMI audio does not need
# the SPDIF jack looped back externally. Untested; nothing has driven it.
OHC_AUDIO_HDMI_DIGITAL=1        # 0x11 Digital Out, Int HDMI -> ADV7511
# Level S46audio sets on every unmuted playback control at boot. An HDA codec
# comes out of reset muted and at zero, so without that script a perfectly
# working board is simply silent.
OHC_AUDIO_BOOT_LEVEL=70%
# Four PCMs follow from the above: pcm0p/pcm0c analog play+capture, pcm2p the
# second analog out, and pcm1p/pcm3p the TWO digital outs (coax 0x1e + HDMI
# 0x11). Mixer controls present: Master, Headphone, Front, Line, IEC958,
# IEC958 Default PCM. There is no Mic control -- no mic pin is wired.

# --- boot / storage ----------------------------------------------------------
# GRUB 0.97 lives on sda1 and reads menu.lst from there. Our kernel and initrd
# go on sda3, the ext3 kernel-only partition, because GRUB cannot read the ext4
# root. Nothing openHC does touches sda2 (factory restore) or sda4 (vendor root).
OHC_BOOT_GRUB_PART=/dev/sda1    # /boot/grub/menu.lst
OHC_BOOT_KERNEL_PART=/dev/sda3  # ext3, ~165 MB free
OHC_BOOT_KERNEL=/boot/openhc-bzImage
OHC_BOOT_INITRD=/boot/openhc-initrd.gz

# --- eSATA and USB -----------------------------------------------------------
# ICH7 AHCI reports "4 ports 3 Gbps 0x3 impl" — only TWO ports are real and
# ata3/ata4 enumerate as DUMMY. ata1 is the internal SanDisk SSD U100 8GB
# (linked at 3.0 Gb/s); ata2 is the REAR eSATA jack on the same controller,
# link-down with nothing plugged. AHCI hot-plug is available, so a disk
# appearing later shows up as sdb without a reboot. Nothing mounts it
# automatically — openHC does not own the user's storage.
# --- video output ------------------------------------------------------------
# S47video runs ohc-ths8200 against these. The THS8200 is the only output
# anything drives on this board; the ADV7511 at 0x72 on the same bus is fitted,
# answers, and is configured by nobody — not even the vendor's OS 3.x.
OHC_VIDEO_AUTOCONFIG=1
OHC_VIDEO_I2C_BUS=6             # ICH7 SMBus (i801). i2c-0..5 are i915 gmbus.
OHC_VIDEO_THS8200_ADDR=0x21
OHC_VIDEO_ADV7511_ADDR=0x72     # present, unconfigured, no driver written yet
OHC_VIDEO_REGS=/opt/ohc/video/ths8200-720p60.regs

OHC_ESATA_ATA_PORT=ata2
OHC_ESATA_HOTPLUG=1
#
# USB: one EHCI controller plus four UHCI companions (the ICH7 arrangement).
# The only device on the whole bus is the Wi-Fi radio, on an INTERNAL port at
# 1-7 — the front jack is free.
OHC_USB_WIFI_PORT=1-7
