# openHomeController board config — Control4 HC-800 (Atom D525) kernel-up build.
# Sourced by the init scripts and (later) the ohc services. Shell assignments only.

OHC_MODEL=hc800                 # Lite-On AE100 board, no Lego codename on this generation
OHC_ID_IFACE=eth0               # the MAC that names this box (RTL8168, single port)
OHC_MDNS_IFACE="eth0"           # wired only — no wlan0 on 7.1.8, see the Wi-Fi note
OHC_UPLINK_IFACE=eth0           # RTL8168, single port, no managed switch
# (no OHC_DSA_PORTS: this board has one plain MAC, not a BCM53125 like the EA3)

# --- Wi-Fi: the radio exists, the DRIVER does not -----------------------------
# The hardware is real and the vendor kernel drives it: USB RTL8191SU
# (0bda:8172, marked RTL8191SU on the module — the USB descriptor agrees,
# "RTL8191S WLAN Adapter"; earlier notes here called it a 8192SU) on internal
# port 1-7, wlan0 = 44:6d:57:10:c7:aa under Control4's 3.16 via staging r8712u.
#
# But drivers/staging/rtl8712 has been DELETED from mainline, and nothing else
# claims 0x8172 — so on openHC's 7.1.8 there is no wlan0 to configure. See the
# long note in hc800_defconfig; the userspace was removed to match.
#
# OHC_WIFI_IFACE is deliberately EMPTY, not "wlan0". The shared S41wifi-ap and
# S45netmon branch on it: empty means "no radio on this board, skipping", which
# is the truth, while "wlan0" would make them hunt for an interface that can
# never appear and report a misleading failure.
OHC_WIFI_IFACE=
# Kept for the day a driver exists — these were measured against the live vendor
# system and are still correct about the HARDWARE:
#   OHC_WIFI_DRIVER=wext        r8712u sets wireless_handlers, registers no wiphy
#   OHC_WIFI_MODULE=            it was builtin in our kernel; nothing to modprobe
#   OHC_WIFI_AP_CAPABLE=0       station only; no AP mode, no nl80211 for hostapd

# --- UARTs -------------------------------------------------------------------
# Five ISA-range 8250 ports, and they are NOT the ICH's: they come from a
# Winbond W83627UHG Super I/O behind the LPC bridge, sitting on the board beside
# the console header, the two rear RS-232 ports and the IO microcontroller. They
# enumerate through PNPACPI as devices 00:02..00:06.
#
# The UHG is the SIX-uart variant of that family, so a sixth may exist that the
# BIOS does not enumerate — unconfirmed, and worth a look if a spare port would
# ever help. The same chip carries the hardware monitor and the FAN PWM; see the
# thermal note at the bottom.
#
# ttyS4 only exists because the kernel fragment sets
# CONFIG_SERIAL_8250_RUNTIME_UARTS=5; mainline's default of 4 drops it.
OHC_CONSOLE_TTY=/dev/ttyS0      # 0x3f8 — GRUB's terminal and ours, 115200

# The two rear RS-232 ports present as HOST UARTs on this board — the vendor's
# ioserver opens them directly. On the EA family the equivalent combo ports hang
# off the TM4C with no /dev/ttyS* at all, so anything shared with those boards
# has to branch here. (Unresolved: https://the1truejoe.github.io/openHC/shared/io-mcu/ reads the LM3S image
# as also driving two user UARTs, which would mean these are bridged through the
# MCU rather than wired to the transceivers. Either way the tty is the same.)
OHC_SERIAL_TTYS="/dev/ttyS1 /dev/ttyS2"     # 0x2f8, 0x3e8
#
# The SHARED form the daemons actually read — dev:label:baud, space separated.
# webd has parsed OHC_SERIALS since the CA-1, so declaring it here is what
# gives this board the browser serial terminal with no code change at all.
# Labels use underscores; the parser turns them into spaces.
OHC_SERIALS="ttyS1:RS-232_port_1:115200 ttyS2:RS-232_port_2:115200"

# --- IO-MCU ------------------------------------------------------------------
# TI Stellaris LM3S1162, same part as the HC-250 and the same DLE/STX framing
# and TI serial flash-loader as the EA family's TM4C. Behind it: 6 IR outputs,
# 4 relays, 4 contact inputs. There are no host GPIOs for any of that.
# --- the unified IO description every board answers ---------------------------
# OHC_IO_BACKEND says HOW the IO is reached, and it is the only thing ohc-iod
# branches on:
#   mcu   relays/contacts/IR live behind a microcontroller on a serial port,
#         spoken to with the DLE/STX protocol (hc800: LM3S1162, ea*: TM4C1231D5)
#   gpio  they are native SoC GPIO lines (ioxv1)
#   none  the board has no local IO at all (ca1)
OHC_IO_BACKEND=mcu
OHC_IO_MCU_PART=lm3s1162
# Line discipline number S12iomcu attaches to OHC_IO_MCU_TTY, turning the relays
# and contacts into a standard gpiochip. 29 is N_DEVELOPMENT, the slot reserved
# for out-of-tree disciplines.
OHC_IO_MCU_LDISC=29
OHC_IO_MCU_TTY=/dev/ttyS3       # 0x2e8, vendor symlink /dev/ttySStellaris
OHC_IO_MCU_BAUD=115200          # CONFIRMED on hardware, unlike the EA's 460800

# Counts. ZERO MEANS ABSENT, and absent means the UI does not draw it — a board
# with no relays gets no relay panel, not an empty one.
# SEVEN emitters: six rear jacks plus the internal front blaster. Settled by
# sweeping the IROUT_SEND output bitmask with a Global Caché learner watching —
# bit 0 lit jack 1, bit 5 lit jack 6, bit 6 lit the front of the box, and
# nothing else in the 24 bits did anything. Driving bits 5 and 6 together fired
# both, which is also what proves the field is a mask rather than an index.
OHC_IR_OUT=6                    # rear jacks, mask bits 0..5
OHC_IR_BLASTER=1                # internal front emitter, mask bit 6
OHC_IR_IN=1                     # front receiver (learning)
# FOUR relays, all four working. This used to say 3 and 4 were dead; they were
# not. The selector is a 0-BASED INDEX and was being read as a bitmask, so
# 1<<index sent 0x04 and 0x08 — which the firmware echoes back happily while
# addressing nothing. A TOGGLE sweep on live hardware settled it: 0x00..0x03
# each flip one relay, 0x04 and above do nothing at all.
OHC_RELAYS=4
OHC_CONTACTS=4
# ZERO MCU-routed UARTs. This board's two rear RS-232 ports are HOST 16550As
# (ttyS1/ttyS2, declared in OHC_SERIALS above) — established from a live unit,
# where the vendor's ioserver holds them directly alongside the MCU port. The EA
# family is the opposite: its user serial goes through the MCU.
OHC_IO_UARTS=0

# Kept for compatibility with anything still reading the old names.
OHC_IOMCU=lm3s1162
OHC_IOMCU_TTY=/dev/ttyS3
OHC_IOMCU_BAUD=115200
# Panel counts, not firmware-decoded. Relays/contacts match the decoded TM4C
# profile table's 4+4 for this class of board; the IR count does NOT match
# io-mcu-firmware.md's four-timer reading of the LM3S image. See
# https://the1truejoe.github.io/openHC/hc800/#io-an-lm3s1162-on-ttys3 before wiring anything to these.
OHC_IR_OUTPUTS=6                # legacy name for OHC_IR_OUT

# --- Zigbee ------------------------------------------------------------------
# EM357 EmberZNet NCP on an on-SoC UART (the EA family puts its NCP behind a
# CP2104 USB bridge instead). Baud is UNCONFIRMED — nothing held this port
# during the recon pull, so the 9600 it was sitting at is just the 8250 default.
OHC_ZIGBEE_TTY=/dev/ttyS4       # 0x2f0, vendor symlink /dev/ttySZigbee
# 115200 is CONFIRMED, not assumed (2026-09-08, from openHC on the metal). An
# ASH RST frame (1A C0 38 BC 7E) was sent at 115200/57600/38400/19200/9600; only
# 115200 produced anything, and what it produced was a valid RSTACK:
#
#     1a c1 02 0b 0a 52 7e
#        |  |  |  |     `- flag
#        |  |  |  `------- CRC
#        |  |  `---------- reset code 0x0B = RESET_SOFTWARE (our RST did it)
#        |  `------------- ASH protocol version 2
#        `---------------- RSTACK control byte
#
# So the EM357 is present, out of reset, and speaking EZSP/ASH. It also did NOT
# need the EM35x bootloader "run application" dance the EA family needs — a bare
# RST was answered directly.
OHC_ZIGBEE_BAUD=115200
#
# Shared radio form, kind:/dev/node — the same key the CA-1 uses, so one parser
# covers both. This board has no Z-Wave.
OHC_RADIOS="zigbee:ttyS4"

# --- GPIO: the ICH GPIO block ------------------------------------------------
# lpc_ich spawns one chip labelled "gpio_ich". These are OFFSETS WITHIN THAT
# CHIP, not the sysfs numbers the vendor's /etc/init.d/gpio uses: on the stock
# 3.16 kernel the chip base happened to be 206, so its zigbee_reset (offset 0)
# appeared as /sys/class/gpio/gpio206. The base is dynamic on a modern kernel
# and the number will differ — the offset will not.
#
# Mainline gpio-ich sets no line names, so `gpiofind` cannot resolve these the
# way it does on the CA-1's device tree. Use chip + offset:
#
#   gpioget $(gpiodetect | awk '/gpio_ich/{print $1}') 24     # reset button
#
OHC_GPIO_CHIP_LABEL=gpio_ich
OHC_GPIO_ZIGBEE_RESET=0         # out, 1 = released
OHC_GPIO_WLAN_DISABLE=14        # out, 0 = radio enabled
OHC_GPIO_LAN_DISABLE=15         # out, 0 = NIC enabled
OHC_GPIO_RESET_BUTTON=24        # in  — "reset" in the vendor's script
# CONFIRMED against the vendor OS (2026-09-09): every offset below is exported
# in its /sys/class/gpio at base 206, so gpio206=offset 0 .. gpio245=offset 39,
# and the directions and levels read:
#
#   0  zigbee_reset   out 1     14 wlan_disable  out 0    15 lan_disable  out 0
#   24 reset_button   in  0     33 io_reset      out 1
#   34 board_id0      in  0     38 board_id1     in  0    39 board_id2    in  1
#
# So io_reset IS active-low-released-high: the vendor leaves it at 1 with the
# part running. The offset and sense in this file are right, which means the
# earlier failure to revive a wedged MCU by pulsing it was NOT a wrong pin —
# the part simply does not recover from that state by reset. A POWER CYCLE
# remains the cure.
#
# The straps read id2,id1,id0 = 100b = 4, matching c4board on the recon unit.
OHC_GPIO_IO_RESET=33            # out, 1 = LM3S1162 released (CONFIRMED)
OHC_GPIO_BOARD_ID0=34           # in  \
OHC_GPIO_BOARD_ID1=38           # in   } 3-bit strap = BOARD REVISION (100b = 4
OHC_GPIO_BOARD_ID2=39           # in  /  on the recon unit, matching c4board)

# LEDs: six channels, MAPPED. Read out of the vendor kernel's own board file
# (its struct gpio_led array), not guessed — and the offsets agree exactly with
# an independent EBUSY probe of every line on the running vendor OS.
#
#   LED            gpio  offset  active_low  default trigger
#   wifi::red       214     8         0      off
#   wifi::yellow    215     9         0      off
#   wifi::blue      216    10         0      slowblink
#   c4::data        232    26        0      off
#   c4::network     233    27        0      off
#   c4::power       234    28        0      on   (default-on)
#
# Two physical groups: {8,9,10} is ONE tri-colour wifi indicator, {26,27,28}
# are the three c4 status LEDs. All active-HIGH. The vendor's own userspace only
# links five of them into /dev/gpio — c4::power is left to its default-on
# trigger, i.e. a power indicator rather than a software LED.
#
# The EBUSY probe also found offsets 2 and 3 claimed and NOT LEDs. Offset 2 is
# now identified as the ID button (see below). OFFSET 3 IS STILL UNKNOWN: it is
# BIOS-muxed as GPIO and held by some driver, but it appears in neither the
# gpio_led nor the gpio_keys_button array in the vendor binary.
#
# MAINLINE CAN REACH THEM — settled, no patch needed. The ICH's GPIO_USE_SEL
# register says which pins the BIOS wired as GPIO, one bit each, and the vendor
# kernel prints it: 0x1f40f7cd at boot, i.e.
#
#   GPIO 0 2 3 6 7 8 9 10 12 13 14 15 22 24 25 26 27 28
#
# The LED lines 8,9,10,26,27,28 are all in that set, so mainline gpio-ich will
# accept them and no USE_SEL patch is required. It also explains the vendor's
# force-GPIO code exactly: pins 4 and 5 are NOT in the set, which is why its log
# reads "GPIO (4) REQUEST FAILED ... SUCCESS TO MAKE IT GPIO" and the register
# then reads 0x1f40f7dd and 0x1f40f7fd — bits 4 and 5 appearing one at a time.
# We need none of that.
#
# Everything reconciles three independent ways — the board file in the vendor
# binary, an EBUSY/ENODEV probe of every line on the running box, and this
# register. The ENODEV lines are precisely the un-muxed ones
# (1, 11, 16-21, 23, 29-31), so ngpio=50 is the chip, not the board.

# --- the ID button is offset 2, NOT offset 24 --------------------------------
# Read out of the vendor kernel's gpio_keys_polled platform data, and confirmed
# by /proc/bus/input/devices reporting KEY=80000000 (bit 63) on its one key:
#
#   code = 63 (KEY_F5)   gpio = 208 (offset 2)   active_low = 1
#   desc = "id_button"   type = EV_KEY   poll 40 ms   debounce 20 ms
#
# So there are TWO distinct inputs and this file used to conflate them: offset 2
# is the ID/setup button behind gpio-keys-polled, while offset 24 is what the
# vendor's own /etc/init.d/gpio exports as plain "reset". OHC_GPIO_RESET_BUTTON
# below is offset 24 and keeps that name.
#
# Worth copying: a key event is easier to consume than a poll loop, and it is
# what every Linux tool expects of a button.
OHC_GPIO_ID_BUTTON=2            # in, active-LOW, KEY_F5 via gpio-keys-polled

# --- mainline gpio-ich sees FEWER lines than the vendor's ---------------------
# The vendor patched gpio-ich to FORCE a pin into GPIO mode when the BIOS did
# not: its log says "GPIO (4) REQUEST FAILED ... SUCCESS TO MAKE IT GPIO ...
# USE REG: 0x1f40f7dd", i.e. it rewrites the USE_SEL register. Mainline refuses
# any line the BIOS left un-muxed, which is why offsets outside
# {2,3,4,5,6,7,8,9,10,12,13,22,25,26,27,28,35,36} answer ENODEV for us.

# --- audio: ALC888-VD on ICH7 HD Audio ---------------------------------------
# Pin defaults from the BIOS map straight to the panel, so the generic Realtek
# parser needs no quirk. Every node below is from a live codec dump
# (/proc/asound/card0/codec#2), and EVERY pin not listed here reads the
# canonical "not connected" default 0x411111f0 -- 0x12, 0x15-0x19, 0x1c, 0x1f.
#
# The codec answers at HDA address 2, not 0: the proc node is codec#2. The card
# is still 0; only tools that address the codec directly care.
OHC_AUDIO_CARD=0
# The part is marked ALC888S on the board; the codec ID resolves to "ALC888-VD"
# in the kernel's Realtek table, which is the string /proc/asound shows. Both
# are recorded because you will meet each one somewhere.
OHC_AUDIO_CODEC="Realtek ALC888S"
OHC_AUDIO_CODEC_KERNEL="Realtek ALC888-VD"
OHC_AUDIO_HDA_ADDR=2            # /proc/asound/card0/codec#2, NOT codec#0
# Jacks are RCA on this box, not the 1/8" the codec's generic defaults imply.
OHC_AUDIO_LINE_OUT=2            # 0x14 Line Out, Ext Rear, RCA green
                                # 0x1b HP Out,   Ext Front, RCA green
OHC_AUDIO_LINE_IN=1             # 0x1a Line In,  Ext Rear, RCA blue
OHC_AUDIO_SPDIF_COAX=1          # 0x1e SPDIF Out, Ext Rear, RCA black
# The one the old note missed entirely: an INTERNAL digital output, pin default
# 0x18561130 = "Digital Out at Int HDMI", association 3 / sequence 0, marked
# NO_PRESENCE (no jack detect, because there is no jack -- it is board wiring).
# This is the audio half of the ADV7513 HDMI path, so HDMI audio does not need
# the SPDIF jack looped back externally. Untested; nothing has driven it.
OHC_AUDIO_HDMI_DIGITAL=1        # 0x11 Digital Out, Int HDMI -> ADV7513
# Level S46audio sets on every unmuted playback control at boot. An HDA codec
# comes out of reset muted and at zero, so without that script a perfectly
# working board is simply silent.
OHC_AUDIO_BOOT_LEVEL=70%
# Four PCMs follow from the above: pcm0p/pcm0c analog play+capture, pcm2p the
# second analog out, and pcm1p/pcm3p the TWO digital outs (coax 0x1e + HDMI
# 0x11). Mixer controls present: Master, Headphone, Front, Line, IEC958,
# IEC958 Default PCM. There is no Mic control -- no mic pin is wired.

# --- thermal and the fan -----------------------------------------------------
# THIS BOARD HAS A FAN, and the Winbond already regulates it in hardware.
# Earlier notes called the board fanless; they were wrong.
#
# CPU TEMPERATURE IS temp2 / CPUTIN on hwmon "w83627uhg" — NOT coretemp.
# Measured under a 4-thread load on the live box:
#
#            idle   loaded   delta
#   CPUTIN    46 C    53 C    +7     <- use this
#   SYSTIN    32 C    32 C     0     board ambient
#   coretemp   6 C    12 C    +6     tracks load, absolute value is junk
#   fan2    1041rpm 1102rpm   +61    ramped on its own
#
# coretemp is not broken, it is OFFSET: the kernel logs "Unable to read TjMax
# from CPU 0" and falls back to a default, and the readings sit a consistent
# 40 C below CPUTIN. The delta is right, so it is usable as a RELATIVE signal
# and useless as an absolute one. This Atom's DTS is known to be poorly
# calibrated away from Tj_max.
#
# FAN CONTROL IS ALREADY AUTOMATIC and needs no daemon. The BIOS leaves the
# Super I/O in Smart Fan IV:
#
#   pwm2_enable = 4        smart fan IV, closed loop on CPUTIN
#   pwm2_target = 75000    hold CPUTIN at 75 C
#   pwm2_tolerance = 1000  +/- 1 C
#   pwm2_max_output = 200  of 255
#   temp2_max = 80 C, hyst 75 C
#
# Every one of those is writable, so retuning is an echo: a lower target means
# a cooler, louder box. pwm1 is manual at 250/255 and drives nothing — header 1
# has no fan (fan1 reads 0 rpm).
#
# temp1_max reads -67 C, which is an uninitialised limit rather than a reading.

# --- unidentified parts ------------------------------------------------------
# CV1842APAG — on NEITHER bus. lspci accounts for every PCI function (Atom
# D4xx/D5xx bridge + graphics, NM10/ICH7 audio/USB/LPC/SATA/SMBus, RTL8111
# GbE) and an i2c-6 scan finds only the THS8200 and the ADV7513. So it is
# analog, glue or power — likely somewhere in the video path given its
# neighbours — and identifying it needs the silkscreen or tracing, not software.
#
# The heatsinked part next to the CPU is NOT a mystery: it is the NM10, i.e.
# 00:1f.0 "NM10 Family LPC Controller". There is no third bridge.

# --- boot / storage ----------------------------------------------------------
# GRUB 0.97 lives on sda1 and reads menu.lst from there. Our kernel and initrd
# go on sda3, the ext3 kernel-only partition, because GRUB cannot read the ext4
# root. Nothing openHC does touches sda2 (factory restore) or sda4 (vendor root).
OHC_BOOT_GRUB_PART=/dev/sda1    # /boot/grub/menu.lst
OHC_BOOT_KERNEL_PART=/dev/sda3  # ext3, ~165 MB free
OHC_BOOT_KERNEL=/boot/openhc-bzImage
OHC_BOOT_INITRD=/boot/openhc-initrd.gz

# --- eSATA and USB -----------------------------------------------------------
# ICH7 AHCI reports "4 ports 3 Gbps 0x3 impl" — only TWO ports are real and
# ata3/ata4 enumerate as DUMMY. ata1 is the internal SanDisk SSD U100 8GB
# (linked at 3.0 Gb/s); ata2 is the REAR eSATA jack on the same controller,
# link-down with nothing plugged. AHCI hot-plug is available, so a disk
# appearing later shows up as sdb without a reboot. Nothing mounts it
# automatically — openHC does not own the user's storage.
# --- video output ------------------------------------------------------------
# S47video runs ths8200 against these. The ADV7513 at 0x72 is fitted, answers,
# and is configured by NOBODY — not the vendor's OS, not us — and HDMI OUTPUT
# WORKS ANYWAY. Both facts are true, and the reason is that the ADV is not on
# the display pipeline as far as Linux is concerned:
#
#   i915 sees ONE connector, LVDS-1, connected and enabled (VGA-1 is
#   disconnected). The LVDS goes to a DS90CF386MTD, which deserialises it to
#   parallel RGB, and that RGB feeds BOTH the THS8200 (analog component) and
#   the ADV7513 (HDMI). The ADV converts in a strapped default mode.
#
# So HDMI needs no driver for PICTURE. What it does still gate is everything
# reached over I2C: CEC, EDID, InfoFrames and HDMI audio configuration. (Earlier notes
# called it an ADV7513; the part is a 7513. Same family, same four-address I2C
# map, which a live scan of i2c-6 shows in full: 0x38 packet, 0x39 main,
# 0x3c CEC, 0x3f EDID, alongside the THS8200 at 0x21 — and nothing else.)
#
# THE VIDEO CHAIN, as far as it is understood: the GMA 3150 drives LVDS, a
# DS90CF386MTD deserialises that back to parallel RGB, and the RGB feeds BOTH
# the THS8200 (analog component) and the ADV7513 (HDMI). That is why there are
# two encoders and why neither is on the PCI bus.
OHC_VIDEO_AUTOCONFIG=1
OHC_VIDEO_I2C_BUS=6             # ICH7 SMBus (i801). i2c-0..5 are i915 gmbus.
OHC_VIDEO_THS8200_ADDR=0x21
OHC_VIDEO_ADV7513_ADDR=0x72     # present, unconfigured, no driver written yet
OHC_VIDEO_REGS=/opt/ohc/video/ths8200-720p60.regs

OHC_ESATA_ATA_PORT=ata2
OHC_ESATA_HOTPLUG=1
#
# USB: one EHCI controller plus four UHCI companions (the ICH7 arrangement).
# The only device on the whole bus is the Wi-Fi radio, on an INTERNAL port at
# 1-7 — the front jack is free.
OHC_USB_WIFI_PORT=1-7
