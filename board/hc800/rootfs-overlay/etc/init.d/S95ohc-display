#!/bin/sh
# Opt-in on-screen web view — HC-800.
#
# Same contract as the EAs' S95ohc-display (board/ea/common): DISABLED BY
# DEFAULT, the screen shows the openHC splash (S01splash) until the web UI turns
# the view on. webd's POST /api/display writes the config (OHC_DISPLAY_ENABLE=1,
# OHC_DISPLAY_URL=..., OHC_DISPLAY_THEME=auto|light|dark) and reloads this.
# Here the config lives on /data (board.env OHC_DISPLAY_CONF): /opt is the
# initramfs on this board, so it would not survive a reboot.
#
# The view is the same program as the EAs' (packages/webview), built here on
# WebKit's WPE Platform API: its DRM platform renders on the GMA 3150 through
# Mesa i915 and scans out straight to KMS (the wpe feature). Restarted if it
# exits.
#
# reload is live: a running view takes the URL and theme on its control FIFO, so
# a URL or theme change never drops to the splash — only enabling/disabling
# starts or stops it. The theme is WebKit's own dark mode
# (WPE_SETTING_DARK_MODE), so any page sees it as prefers-color-scheme, like an
# OS setting.
[ -r /opt/ohc/board.env ] && . /opt/ohc/board.env
CONF="${OHC_DISPLAY_CONF:-/opt/ohc/display.conf}"
CTL="${OHC_DISPLAY_CTL:-/run/ohc-display.ctl}"
RUN=/run/ohc/display
PIDF=/run/ohc-display.pid

# Read the config into $url and $theme.
load() {
	OHC_DISPLAY_ENABLE=0
	OHC_DISPLAY_URL=http://localhost/
	OHC_DISPLAY_THEME=auto
	[ -r "$CONF" ] && . "$CONF"
	url="$OHC_DISPLAY_URL"
	case "$OHC_DISPLAY_THEME" in light|dark) theme="$OHC_DISPLAY_THEME" ;; *) theme=auto ;; esac
}
load

running() {
	[ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null && pidof webview >/dev/null && [ -p "$CTL" ]
}

start() {
	[ "$OHC_DISPLAY_ENABLE" = 1 ] || {
		echo "ohc-display: disabled — the screen shows the splash (enable it from the web UI)"
		exit 0
	}
	[ -x /usr/bin/webview ] || { echo "ohc-display: no webview — the wpe feature is not in this image" >&2; exit 0; }
	[ -e /dev/dri/card0 ] || { echo "ohc-display: no /dev/dri/card0" >&2; exit 0; }
	mkdir -p "$RUN" && chmod 0700 "$RUN"
	echo "ohc-display: starting the on-screen web view -> $url (theme=$theme)"
	start-stop-daemon -S -q -b -m -p "$PIDF" -x /bin/sh -- "$0" run
}

stop() {
	[ -f "$PIDF" ] && start-stop-daemon -K -q -p "$PIDF"
	rm -f "$PIDF"
	for n in webview WPEWebProcess WPENetworkProcess; do
		killall -q "$n" 2>/dev/null || true
	done
	# Give the screen back to the splash.
	[ -x /etc/init.d/S01splash ] && /etc/init.d/S01splash start >/dev/null 2>&1
}

# Apply the config without tearing the view down: the running view takes the
# theme (live) and, only if it changed, the URL on its control FIFO. Opened
# read-write, so the write can never block even if the view has just exited.
reload() {
	if [ "$OHC_DISPLAY_ENABLE" != 1 ]; then
		stop
	elif running; then
		exec 3<>"$CTL"
		printf 'theme %s\n' "$theme" >&3
		[ "$(cat "$RUN/url" 2>/dev/null)" = "$url" ] || printf 'url %s\n' "$url" >&3
		exec 3>&-
		printf '%s\n' "$url" > "$RUN/url"
		echo "ohc-display: view -> $url (theme=$theme)"
	else
		stop; sleep 1; start
	fi
}

# The supervisor: webview, restarted if it exits, each time on the current
# config. WebKit wants a HOME for its caches and an XDG_RUNTIME_DIR. WPE_DISPLAY
# names the DRM platform outright, so a failure to drive KMS is an error in the
# log rather than a silent fall back to the headless platform. WEBVIEW_RETRY:
# webd may still be starting; a failed load is retried after that many seconds.
run() {
	export HOME="$RUN" XDG_RUNTIME_DIR="$RUN"
	while :; do
		load
		printf '%s\n' "$url" > "$RUN/url"
		WPE_DISPLAY=wpe-display-drm OHC_DISPLAY_CTL="$CTL" OHC_DISPLAY_THEME="$theme" \
		WEBVIEW_URL="$url" WEBVIEW_RETRY=5 \
			/usr/bin/webview 2>&1 | logger -t ohc-display
		sleep 3
	done
}

case "$1" in
	start)   start ;;
	stop)    stop ;;
	restart) stop; sleep 1; start ;;
	reload)  reload ;;
	run)     run ;;
	*) echo "Usage: $0 {start|stop|restart|reload}"; exit 1 ;;
esac
