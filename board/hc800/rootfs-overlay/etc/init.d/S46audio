#!/bin/sh
# ALC888-VD bring-up — HC-800 only.
#
# An HDA codec comes out of reset with its outputs MUTED and its volumes at
# zero, so a board with perfectly working audio is silent until something
# touches the mixer. This is that something. It is not a policy daemon: it puts
# the panel into a known, audible state once at boot and gets out of the way.
#
# Every control named here was read off the live codec dump, not guessed —
# /proc/asound/card0/codec#2 (note: the codec answers at HDA address 2, NOT 0,
# so a bare `amixer` with no -c will still find card 0 but anything addressing
# the codec directly needs 2). Connected pins are:
#
#   0x11  Digital Out at Int HDMI   -> the ADV7513. Internal wiring, no jack,
#                                      marked NO_PRESENCE, association 3.
#   0x14  Line Out,  Ext Rear       RCA green
#   0x1a  Line In,   Ext Rear       RCA blue
#   0x1b  "HP" Out   (rear RCA — "Analog 2"; the BIOS label says front)
#   0x1e  SPDIF Out, Ext Rear       RCA black (coax)
#
# Everything else — 0x12, 0x15..0x19, 0x1c, 0x1f — reads the canonical
# not-connected default 0x411111f0. There is no microphone pin, which is why
# there is no Mic control to unmute.
#
# S46: after the network (S40/S41) so a failure here cannot cost reachability,
# and before the services in S50.
[ -r /opt/ohc/board.env ] && . /opt/ohc/board.env
CARD="${OHC_AUDIO_CARD:-0}"
LEVEL="${OHC_AUDIO_BOOT_LEVEL:-100%}"

# amixer returns non-zero for a control this codec does not have, which is not
# an error worth failing a boot over — the point is to set what exists.
set_one() {
    amixer -c "$CARD" -q sset "$1" "$2" unmute >/dev/null 2>&1 \
        && printf "%s " "$1"
}

case "${1:-start}" in
    start)
        [ -d "/proc/asound/card$CARD" ] || {
            echo "audio: no card $CARD (snd_hda_intel bound? check dmesg)"
            exit 0
        }
        command -v amixer >/dev/null 2>&1 || {
            echo "audio: amixer missing (BR2_PACKAGE_ALSA_UTILS_AMIXER)"
            exit 0
        }

        # Analog 2 on its own DAC. The control exists because of the indep_hp
        # hint (/lib/firmware/hda-hc800.fw); with it off, Analog 2 mirrors
        # Analog 1 and its PCM (device 2) refuses to open. Must be set before
        # anything opens a PCM, which is why it is here and not in ohc-audio.
        amixer -c "$CARD" -q cset name='Independent HP' Enabled >/dev/null 2>&1 \
            && printf "audio: independent HP " || printf "audio: (no Independent HP control) "

        printf "unmuted "
        set_one Master     "$LEVEL"
        set_one 'Line Out' "$LEVEL"
        set_one Front      "$LEVEL"
        set_one Headphone  "$LEVEL"

        # NOT `Line`. That control is the line INPUT's analog passthrough to the
        # outputs, not an output level — unmuting it pipes whatever is on the
        # rear line-in jack straight to the outputs, which is a surprise at best
        # and a feedback loop at worst. Line-in reaches an output only through an
        # ohc-audio route.
        amixer -c "$CARD" -q sset Line 0% mute >/dev/null 2>&1 && printf "Line=muted "
        # Line-in capture at 0 dB, capture enabled, no boost: what ohc-audio
        # routes (and arecord) read.
        amixer -c "$CARD" -q sset Capture 0dB cap >/dev/null 2>&1 && printf "Capture=0dB "
        amixer -c "$CARD" -q sset 'Line Boost' 0 >/dev/null 2>&1
        # IEC958 switches, one per digital output: index 0 is the primary
        # digital PCM (HDMI), index 16 the coax one the indep_dig_outs hint
        # splits off (hda puts an S/PDIF secondary behind an HDMI primary at 16).
        amixer -c "$CARD" -q sset IEC958,0 on >/dev/null 2>&1 && printf "IEC958(hdmi) "
        amixer -c "$CARD" -q sset IEC958,16 on >/dev/null 2>&1 && printf "IEC958(coax) "
        echo

        # Persist so alsactl restores this on the next boot if state is ever
        # made writable. Harmless on a RAM rootfs; useful the day it is not.
        alsactl store -f /var/lib/alsa/asound.state >/dev/null 2>&1 || true
        ;;
    stop)
        amixer -c "$CARD" -q sset Master mute >/dev/null 2>&1 || true
        ;;
    restart|reload) "$0" stop; "$0" start ;;
    *) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
