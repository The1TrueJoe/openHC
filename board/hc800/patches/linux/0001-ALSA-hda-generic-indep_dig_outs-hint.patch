From: openHC
Subject: [PATCH] ALSA: hda/generic: "indep_dig_outs" hint — give a second
 digital output its own PCM instead of mirroring the first

The generic parser supports exactly one digital PCM. Any further S/PDIF/HDMI
output pin is set up as a "follower": it is bound to the same stream tag as the
first, so every digital jack plays the same audio. That is the right default
for a codec with a coax jack and an optical jack wired to one converter, and
the wrong one for a board that wires two converters to two different places.

The HC-800's ALC888 is the second kind. It has two digital converters:

  0x10 -> pin 0x11  "Digital Out at Int HDMI"  -> the ADV7513 HDMI encoder
  0x06 -> pin 0x1e  "SPDIF Out at Ext Rear"    -> the coax jack

and the owner wants them as independent outputs (different endpoints on HDMI
and on coax at the same time), which mainline cannot express.

With the hint set (hda patch file, [hint] indep_dig_outs = yes), the second
digital output gets its own struct hda_multi_out, its own IEC958 controls
(snd_hda_create_dig_out_ctls already handles an HDMI primary plus an S/PDIF
secondary, putting the latter at index 16), and its own PCM, " Alt Digital",
typed from its pin (S/PDIF here, so ALSA device 1; the HDMI primary keeps
device 3). Without the hint nothing changes: the follower path, including its
bound of one follower, is exactly as before.

---
--- a/sound/hda/codecs/generic.h	2026-10-03 02:32:37
+++ b/sound/hda/codecs/generic.h	2026-10-03 02:32:37
@@ -93,6 +93,7 @@
 	const struct hda_pcm_stream *stream_analog_capture;
 
 	char stream_name_alt_analog[32]; /* alternative analog PCM stream */
+	char stream_name_alt_digital[32]; /* independent 2nd digital PCM */
 	const struct hda_pcm_stream *stream_analog_alt_playback;
 	const struct hda_pcm_stream *stream_analog_alt_capture;
 
@@ -112,6 +113,12 @@
 	hda_nid_t alt_dac_nid;
 	hda_nid_t follower_dig_outs[3];	/* optional - for auto-parsing */
 	int dig_out_type;
+
+	/* independent second digital output ("indep_dig_outs" hint): its own
+	 * multi_out and PCM instead of being a follower of the first
+	 */
+	struct hda_multi_out alt_dig_multiout;
+	int alt_dig_out_type;
 
 	/* capture */
 	unsigned int num_adc_nids;
@@ -148,7 +155,7 @@
 	int const_channel_count;	/* channel count for all */
 
 	/* PCM information */
-	struct hda_pcm *pcm_rec[3];	/* used in build_pcms() */
+	struct hda_pcm *pcm_rec[4];	/* used in build_pcms() */
 
 	/* dynamic controls, init_verbs and input_mux */
 	struct auto_pin_cfg autocfg;
@@ -226,6 +233,7 @@
 	unsigned int vmaster_mute_led:1; /* add SPK-LED flag to vmaster mute switch */
 	unsigned int mic_mute_led:1; /* add MIC-LED flag to capture mute switch */
 	unsigned int indep_hp:1; /* independent HP supported */
+	unsigned int indep_dig_outs:1; /* 2nd digital out gets its own PCM */
 	unsigned int prefer_hp_amp:1; /* enable HP amp for speaker if any */
 	unsigned int add_stereo_mix_input:2; /* add aamix as a capture src */
 	unsigned int add_jack_modes:1; /* add i/o jack mode enum ctls */
--- a/sound/hda/codecs/generic.c	2026-10-03 02:32:37
+++ b/sound/hda/codecs/generic.c	2026-10-03 02:32:59
@@ -168,6 +168,9 @@
 	val = snd_hda_get_bool_hint(codec, "indep_hp");
 	if (val >= 0)
 		spec->indep_hp = !!val;
+	val = snd_hda_get_bool_hint(codec, "indep_dig_outs");
+	if (val >= 0)
+		spec->indep_dig_outs = !!val;
 	val = snd_hda_get_bool_hint(codec, "add_stereo_mix_input");
 	if (val >= 0)
 		spec->add_stereo_mix_input = !!val;
@@ -4014,11 +4017,14 @@
 {
 	struct hda_gen_spec *spec = codec->spec;
 	struct nid_path *path;
-	int i, nums;
+	int i, nums, nfollow;
 	hda_nid_t dig_nid, pin;
 
-	/* support multiple SPDIFs; the secondary is set up as a follower */
+	/* support multiple SPDIFs; the secondary is set up as a follower,
+	 * unless indep_dig_outs gives the second one its own PCM
+	 */
 	nums = 0;
+	nfollow = 0;
 	for (i = 0; i < spec->autocfg.dig_outs; i++) {
 		pin = spec->autocfg.dig_out_pins[i];
 		dig_nid = look_for_dac(codec, pin, true);
@@ -4035,11 +4041,18 @@
 		if (!nums) {
 			spec->multiout.dig_out_nid = dig_nid;
 			spec->dig_out_type = spec->autocfg.dig_out_type[0];
+		} else if (spec->indep_dig_outs &&
+			   !spec->alt_dig_multiout.dig_out_nid) {
+			spec->alt_dig_multiout.dig_out_nid = dig_nid;
+			spec->alt_dig_out_type = spec->autocfg.dig_out_type[i];
 		} else {
 			spec->multiout.follower_dig_outs = spec->follower_dig_outs;
-			if (nums >= ARRAY_SIZE(spec->follower_dig_outs) - 1)
+			/* same bound as before this hint existed: one
+			 * follower plus the zero terminator
+			 */
+			if (nfollow + 1 >= ARRAY_SIZE(spec->follower_dig_outs) - 1)
 				break;
-			spec->follower_dig_outs[nums - 1] = dig_nid;
+			spec->follower_dig_outs[nfollow++] = dig_nid;
 		}
 		nums++;
 	}
@@ -5245,6 +5258,14 @@
 			spec->multiout.share_spdif = 1;
 		}
 	}
+	if (spec->alt_dig_multiout.dig_out_nid) {
+		err = snd_hda_create_dig_out_ctls(codec,
+						  spec->alt_dig_multiout.dig_out_nid,
+						  spec->alt_dig_multiout.dig_out_nid,
+						  spec->pcm_rec[3]->pcm_type);
+		if (err < 0)
+			return err;
+	}
 	if (spec->dig_in_nid) {
 		err = snd_hda_create_spdif_in_ctls(codec, spec->dig_in_nid);
 		if (err < 0)
@@ -5507,6 +5528,44 @@
 }
 
 /*
+ * Independent second digital out ("indep_dig_outs" hint)
+ */
+static int alt_dig_playback_pcm_open(struct hda_pcm_stream *hinfo,
+				     struct hda_codec *codec,
+				     struct snd_pcm_substream *substream)
+{
+	struct hda_gen_spec *spec = codec->spec;
+	return snd_hda_multi_out_dig_open(codec, &spec->alt_dig_multiout);
+}
+
+static int alt_dig_playback_pcm_prepare(struct hda_pcm_stream *hinfo,
+					struct hda_codec *codec,
+					unsigned int stream_tag,
+					unsigned int format,
+					struct snd_pcm_substream *substream)
+{
+	struct hda_gen_spec *spec = codec->spec;
+	return snd_hda_multi_out_dig_prepare(codec, &spec->alt_dig_multiout,
+					     stream_tag, format, substream);
+}
+
+static int alt_dig_playback_pcm_cleanup(struct hda_pcm_stream *hinfo,
+					struct hda_codec *codec,
+					struct snd_pcm_substream *substream)
+{
+	struct hda_gen_spec *spec = codec->spec;
+	return snd_hda_multi_out_dig_cleanup(codec, &spec->alt_dig_multiout);
+}
+
+static int alt_dig_playback_pcm_close(struct hda_pcm_stream *hinfo,
+				      struct hda_codec *codec,
+				      struct snd_pcm_substream *substream)
+{
+	struct hda_gen_spec *spec = codec->spec;
+	return snd_hda_multi_out_dig_close(codec, &spec->alt_dig_multiout);
+}
+
+/*
  * Analog capture
  */
 #define alt_capture_pcm_open	capture_pcm_open
@@ -5607,6 +5666,19 @@
 	},
 };
 
+static const struct hda_pcm_stream pcm_alt_digital_playback = {
+	.substreams = 1,
+	.channels_min = 2,
+	.channels_max = 2,
+	/* NID is set in build_pcms */
+	.ops = {
+		.open = alt_dig_playback_pcm_open,
+		.close = alt_dig_playback_pcm_close,
+		.prepare = alt_dig_playback_pcm_prepare,
+		.cleanup = alt_dig_playback_pcm_cleanup
+	},
+};
+
 static const struct hda_pcm_stream pcm_digital_capture = {
 	.substreams = 1,
 	.channels_min = 2,
@@ -5794,6 +5866,25 @@
 					 &pcm_digital_capture,
 					 spec->stream_digital_capture,
 					 spec->dig_in_nid);
+	}
+
+	/* independent second digital out, stream index #3 */
+	if (spec->alt_dig_multiout.dig_out_nid) {
+		fill_pcm_stream_name(spec->stream_name_alt_digital,
+				     sizeof(spec->stream_name_alt_digital),
+				     " Alt Digital", codec->core.chip_name);
+		info = snd_hda_codec_pcm_new(codec, "%s",
+					     spec->stream_name_alt_digital);
+		if (!info)
+			return -ENOMEM;
+		spec->pcm_rec[3] = info;
+		info->pcm_type = spec->alt_dig_out_type ?
+			spec->alt_dig_out_type : HDA_PCM_TYPE_SPDIF;
+		setup_pcm_stream(&info->stream[SNDRV_PCM_STREAM_PLAYBACK],
+				 &pcm_alt_digital_playback, NULL,
+				 spec->alt_dig_multiout.dig_out_nid);
+		setup_pcm_stream(&info->stream[SNDRV_PCM_STREAM_CAPTURE],
+				 &pcm_null_stream, NULL, 0);
 	}
 
 	if (spec->no_analog)
