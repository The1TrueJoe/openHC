# THS8200 register state for 720p60 — read off a LIVE HC-800
#
# Captured 2026-09-08 from /proc/driver/ths8200/dump on the vendor OS 3.x image,
# with the component output configured by the vendor's own c4_vid_conf ->
# ths8200_set_720P(). This is not a datasheet reconstruction: it is what working
# hardware actually had in its registers.
#
# WHY THIS FILE EXISTS. The THS8200 (component video DAC, i2c-6 @ 0x21) is the
# ONLY video output on this board that is genuinely driven. The ADV7513 HDMI
# transmitter is present and answers, but nothing configures it on OS 3.x —
# /tmp/intel_hdmi is never created, the c4_adi_7513 device node is never made,
# and libvidcfg.so contains only i.MX8MQ classes. So this register set is the
# proven path to getting a picture out of this box.
#
# The names are from mainline's GPL drivers/media/i2c/ths8200_regs.h, and the
# values cross-check against CEA-861 720p60 exactly:
#
#   DTG1_TOT_PIXELS   0x06,0x72 -> 1650   htotal   (720p60: 1650)
#   DTG1_FRAME_SZ     0x27,0xee ->  750   vtotal   (720p60:  750)
#   DTG1_SPEC_A       0x28      ->   40   hsync    (720p60:   40)
#   DTG1_SPEC_B       0x6e      ->  110   hfront   (720p60:  110)
#   VERSION (0x02)    0x04             the chip answering, not a stale buffer
#
# That agreement is the point: it validates BOTH this capture and the mainline
# register map, which is what makes it safe to replay.
#
# HOW TO USE. Write these registers over /dev/i2c-6 to address 0x21, in address
# order. Skip 0x02 (VERSION, read-only) — read it first instead and check it
# returns 0x04 before writing anything.
#
# Format: <reg-hex> <value-hex>  # NAME

00 00
01 00
02 04   # READ-ONLY, verify == 0x04
03 01   # THS8200_CHIP_CTL
04 00   # THS8200_CSC_R11
05 da   # THS8200_CSC_R12
06 80   # THS8200_CSC_R21
07 78   # THS8200_CSC_R22
08 02   # THS8200_CSC_R31
09 0c   # THS8200_CSC_R32
0A 02   # THS8200_CSC_G11
0B dc   # THS8200_CSC_G12
0C 81   # THS8200_CSC_G21
0D 94   # THS8200_CSC_G22
0E 81   # THS8200_CSC_G31
0F dc   # THS8200_CSC_G32
10 00   # THS8200_CSC_B11
11 4a   # THS8200_CSC_B12
12 02   # THS8200_CSC_B21
13 0c   # THS8200_CSC_B22
14 80   # THS8200_CSC_B31
15 30   # THS8200_CSC_B32
16 00   # THS8200_CSC_OFFS1
17 08   # THS8200_CSC_OFFS12
18 02   # THS8200_CSC_OFFS23
19 01   # THS8200_CSC_OFFS3
1A 00   # THS8200_TST_CNTL1
1B 00   # THS8200_TST_CNTL2
1C 60   # THS8200_DATA_CNTL
1D ff   # THS8200_DTG1_Y_SYNC1_LSB
1E 49   # THS8200_DTG1_Y_SYNC2_LSB
1F b6   # THS8200_DTG1_Y_SYNC3_LSB
20 ff   # THS8200_DTG1_CBCR_SYNC1_LSB
21 ff   # THS8200_DTG1_CBCR_SYNC2_LSB
22 ff   # THS8200_DTG1_CBCR_SYNC3_LSB
23 13   # THS8200_DTG1_Y_SYNC_MSB
24 15   # THS8200_DTG1_CBCR_SYNC_MSB
25 28   # THS8200_DTG1_SPEC_A
26 6e   # THS8200_DTG1_SPEC_B
27 28   # THS8200_DTG1_SPEC_C
