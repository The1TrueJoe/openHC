# openHC — Control4 EA3 board revision 1.
#
# Same board as the ea3-v2 (CE5300, BCM53125 switch, PoE) EXCEPT it still has
# the Wi-Fi radio the v2 dropped. The interesting open question is secure boot:
# the ea3-v2's CEFDK fuse is blown (unsigned kernels are rejected on the normal
# eMMC path, hence the autoscript takeover), while the ea1-v1's is clear. If the
# v1 EA3's fuse is clear it can be flashed the plain way, with no autoscript.
# UNVERIFIED — netboot it first (writes nothing) before touching flash.
BR2_TARGET_GENERIC_HOSTNAME="openhc-ea3-v1"
BR2_TARGET_GENERIC_ISSUE="openHC EA3 v1 (kernel-up)"

BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_OPENHC_PATH)/ea-common/linux/common.fragment $(BR2_EXTERNAL_OPENHC_PATH)/ea-common/linux/wifi.fragment $(BR2_EXTERNAL_OPENHC_PATH)/ea-common/linux/emmc.fragment $(BR2_EXTERNAL_OPENHC_PATH)/ea3-v1/linux/ea3-v1.fragment"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_OPENHC_PATH)/common/rootfs-overlay $(BR2_EXTERNAL_OPENHC_PATH)/ea-common/rootfs-overlay $(BR2_EXTERNAL_OPENHC_PATH)/ea3-v1/rootfs-overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_OPENHC_PATH)/ea-common/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="ea3-v1"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_OPENHC_PATH)/ea-common/patches"
