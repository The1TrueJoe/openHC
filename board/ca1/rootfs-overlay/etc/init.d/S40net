#!/bin/sh
# CA-1 network bring-up: wired FEC on eth0, DHCP. The RTL8723BS Wi-Fi needs
# firmware + wpa_supplicant and is deliberately NOT brought up here — eth0 is
# the reachability path during bring-up. Best-effort: never fail boot.
IFACE=eth0

wait_carrier() {
    i=0
    while [ $i -lt 10 ]; do
        [ "$(cat /sys/class/net/$1/carrier 2>/dev/null)" = 1 ] && return 0
        sleep 1; i=$((i + 1))
    done
    return 1
}

case "$1" in
  start)
    ip link set "$IFACE" up 2>/dev/null || { echo "Net: no $IFACE (fec up?)"; exit 0; }
    printf 'Net: %s: ' "$IFACE"
    wait_carrier "$IFACE" || echo "(no carrier, trying anyway)"
    if udhcpc -i "$IFACE" -t 8 -T 2 -n >/dev/null 2>&1; then
        echo "up ($(ip -4 -o addr show $IFACE | awk '{print $4}'))"
    else
        echo "no lease"
    fi
    ;;
  stop)
    killall udhcpc 2>/dev/null
    ip link set "$IFACE" down 2>/dev/null
    ;;
  *) echo "usage: $0 {start|stop}"; exit 1 ;;
esac
exit 0
