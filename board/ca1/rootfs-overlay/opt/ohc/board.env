# openHomeController board config — Control4 CA-1 (i.MX6SL) kernel-up build.
# Sourced by the init scripts and (later) the ohc services. Shell assignments only.

OHC_MODEL=ca1                   # i.MX6 SoloLite controller, codename "emmet"
OHC_ID_IFACE=eth0               # the MAC that names this box (FEC, single port)
OHC_MDNS_IFACE="eth0 wlan0"     # wired + RTL8723BS SDIO Wi-Fi
OHC_TIMEZONE=America/New_York   # host timezone

# ── Generic capability schema ────────────────────────────────────────────────
# These drive the SHARED, board-agnostic pieces in board/common: the Wi-Fi AP
# fallback (S41wifi-ap) and the web UI / API (ohc-webd). Every board declares
# what it has here; the shared code renders/behaves from these, so ca1 (zwave +
# zigbee + 1 combo serial + wifi) and ea3 (zigbee + 3 serials, no wifi) share
# one implementation and differ only in this file.
OHC_UPLINK_IFACE=eth0           # wired uplink; the AP fallback triggers when this has no carrier
OHC_WIFI_IFACE=wlan0            # wifi iface (AP + station). EMPTY on boards with no radio (ea3)
# Serial ports to expose as web terminals (ttyd) and, optionally, over TCP.
#   "dev:Label:baud"  space-separated.  Radio UARTs are NOT listed here — they
#   are driven by the radio API (OHC_RADIOS) which opens them on demand, so a
#   persistent terminal must not hold them. This is just the user-facing ports
#   (here: the rear RS-232/485 combo port).
OHC_SERIALS="ttymxc2:RS-232/485:115200"
# Home-automation radios. "type:dev" — the UI renders a config/control panel per
# entry. type in {zwave,zigbee}. Empty on boards with no radios.
OHC_RADIOS="zwave:/dev/ttymxc3 zigbee:/dev/ttymxc4"

# --- radios (native i.MX UARTs — there is NO companion IO-MCU on this board) ---
OHC_ZWAVE_TTY=/dev/ttymxc3      # Sigma Designs ZM5304, 500-series, no flow control
OHC_ZIGBEE_TTY=/dev/ttymxc4     # EM35x NCP, RTS/CTS. Silent on the recon unit —
                                # see docs/ca1-recon.md before trusting this.

# --- the rear RS-232/RS-485 combo port ---
# A plain host UART in front of a transceiver configured by seven GPIOs. On the
# EA family the equivalent port hangs off a TM4C MCU with no host tty at all.
OHC_SERIAL_TTY=/dev/ttymxc2

# Transceiver control lines, by DT line-name (gpiofind/gpioget). These are
# gpio-hogs in c4-imx6sl-ca1.dts and are NOT claimable while hogged — the names
# are here so the RS-485 work has one place to look up the map.
OHC_SERIAL_GPIOS="serial_232_485 serial_duplex serial_dx_en serial_rx_en serial_te485 serial_fen serial_loopback"

# --- presence / status inputs ---
OHC_ZWAVE_PRESENT_GPIO=zwave_module    # high = Z-Wave module fitted
OHC_LEDS="ca1:red:status ca1:blue:status ca1:green:status"
