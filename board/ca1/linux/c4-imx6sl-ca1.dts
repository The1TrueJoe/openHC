// SPDX-License-Identifier: GPL-2.0
/*
 * openHC — Control4 CA-1 controller (i.MX6 SoloLite, board codename "emmet").
 *
 * Reconstructed for a MAINLINE kernel from the vendor DTB pulled off a live
 * rev-4 unit (c4-imx6sl-0-4.dtb, kernel 4.1.52-2.180.29). Full derivation and
 * the evidence behind every claim here: docs/ca1-recon.md.
 *
 * Deliberate differences from the vendor tree, all of them deletions or fixes:
 *
 *  - The vendor DT keeps `compatible = "fsl,imx6sl-evk"` and drags along the
 *    whole EVK reference description. The elan-touch digitiser, the mma8450
 *    accelerometer, the max17135 E-ink PMIC and the EPDC are NOT on this board.
 *    They are gone here.
 *  - usdhc1/usdhc2 carried cd-gpios/wp-gpios. There is no card slot and no
 *    write-protect switch; both are soldered parts. Gone, replaced with
 *    non-removable.
 *  - The vendor bus-width properties are backwards relative to the pin groups
 *    (it claims usdhc1 is 8-bit and usdhc2 is 4-bit). The pins win: usdhc1 is
 *    4-bit SDIO Wi-Fi, usdhc2 is 8-bit eMMC.
 *  - The out-of-tree shims are re-expressed in mainline bindings:
 *      "pwm-control"             (32 kHz Wi-Fi clock)  -> pwm-clock
 *      "control4,usb-overcurrent"(USB port power/OC)   -> regulator-fixed
 *
 * STATUS: NOT YET BOOTED. This compiles as a description but no one has run it.
 *
 * The fsl,pins entries below are raw 6-tuples
 * <mux_reg conf_reg input_reg mux_mode input_val pad_ctrl> copied out of the
 * vendor DTB rather than MX6SL_PAD_* macros from imx6sl-pinfunc.h. The values
 * are correct — the macros expand to exactly these first five fields — but
 * converting them to symbolic names is an owed readability cleanup, and until
 * that happens the individual pads are not self-documenting.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
/*
 * Vendor-subdirectory path on purpose. Since Linux 6.5 the ARM DTS tree is
 * split by vendor (arch/arm/boot/dts/nxp/imx/), but Buildroot copies a
 * BR2_LINUX_KERNEL_CUSTOM_DTS_PATH file into arch/arm/boot/dts/ itself. A bare
 * "imx6sl.dtsi" therefore does not resolve from where this file actually sits.
 * Verified by building this against a real 7.1.8 tree.
 */
#include "nxp/imx/imx6sl.dtsi"

/ {
	model = "Control4 CA-1 (i.MX6SL)";
	compatible = "control4,ca1", "fsl,imx6sl";

	chosen {
		stdout-path = &uart1;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x40000000>;	/* 1 GB */
	};

	/*
	 * The vendor tree reserves 320 MB of CMA for the EPDC/PXP display path
	 * this product does not use. A headless openHC image does not need it;
	 * the kernel default is left in place instead.
	 */

	reg_usb_otg1_vbus: regulator-usb-otg1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_otg1_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio4 0 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	reg_usb_otg2_vbus: regulator-usb-otg2-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_otg2_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio4 2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * The RTL8723BS needs a 32.768 kHz slow clock. On this board it is
	 * generated by PWM3 — the vendor node is `wireless-pwm-32K` with
	 * compatible = "pwm-control", an out-of-tree driver. pwm-clock is the
	 * mainline equivalent.
	 */
	clk_wifi_32k: wifi-32k-clock {
		compatible = "pwm-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		pwms = <&pwm3 0 30518 0>;	/* 30518 ns ~= 32.768 kHz */
	};

	/* wifi_enable, GPIO 94 (bank 3 pin 30) in the vendor's numbering. */
	pwrseq_wifi: pwrseq-wifi {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio3 30 GPIO_ACTIVE_LOW>;
		clocks = <&clk_wifi_32k>;
		clock-names = "ext_clock";
		post-power-on-delay-ms = <200>;
	};

	leds {
		compatible = "pwm-leds";

		led-red {
			label = "ca1:red:status";
			pwms = <&pwm1 0 24000000 0>;
			max-brightness = <255>;
		};

		led-blue {
			label = "ca1:blue:status";
			pwms = <&pwm2 0 24000000 0>;
			max-brightness = <255>;
		};

		led-green {
			label = "ca1:green:status";
			pwms = <&pwm4 0 24000000 0>;
			max-brightness = <255>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		/* Front setup/identify button. Vendor emits KEY_F5. */
		key-setup {
			label = "Setup";
			linux,code = <KEY_F5>;
			gpios = <&gpio1 17 GPIO_ACTIVE_LOW>;
		};
	};
};

/*
 * Named lines + boot state, reproducing /etc/init.d/c4gpio on the stock unit —
 * which is the entire board bring-up sequence there (plain sysfs exports
 * symlinked into /dev/gpio).
 *
 * The names come from gpio-line-names so `gpiofind zwave_module` works from the
 * rootfs. The *values* are gpio-hogs rather than something an init script sets,
 * because a userspace `gpioset` releases the line when it exits and the pin
 * reverts to input — the state would not survive the script that applied it.
 * Sysfs would persist, but it is deprecated and gone on a modern kernel.
 *
 * Consequence to be aware of: a hogged line cannot be claimed by userspace
 * later. That is fine today because nothing in the bring-up image drives them,
 * and it keeps the RS-485 transceiver in a defined state instead of floating.
 * When RS-485 direction control lands it will have to convert the four
 * serial_* direction hogs into a real consumer (a uart rs485 binding, or a
 * line-holding daemon) rather than adding a second writer.
 *
 * eth_phy_reset (gpio2 17) and wifi_enable (gpio3 30) are deliberately NOT
 * hogged: they are claimed by &fec and by pwrseq_wifi respectively, and a hog
 * would take the line out from under those drivers.
 */
&gpio1 {
	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"zigbee_reset", "", "", "", "", "", "", "",
		"zwave_reset", "setup_button", "bt_enable", "", "", "", "", "",
		"", "", "", "", "", "", "", "";

	zigbee-reset-hog {
		gpio-hog;
		gpios = <8 GPIO_ACTIVE_HIGH>;
		output-high;		/* reset released */
	};

	zwave-reset-hog {
		gpio-hog;
		gpios = <16 GPIO_ACTIVE_HIGH>;
		output-high;		/* reset released */
	};

	bt-enable-hog {
		gpio-hog;
		gpios = <18 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

&gpio2 {
	gpio-line-names =
		"", "", "", "", "", "", "", "bt_wake_host",
		"serial_duplex", "serial_dx_en", "host_wake_bt", "",
		"serial_rx_en", "serial_te485", "serial_232_485", "",
		"", "eth_phy_reset", "serial_fen", "serial_loopback",
		"", "", "", "", "", "", "", "", "", "", "", "";

	host-wake-bt-hog {
		gpio-hog;
		gpios = <10 GPIO_ACTIVE_HIGH>;
		output-high;
	};

	/* RS-232/RS-485 transceiver, held in the stock boot configuration:
	 * RS-232, full duplex, driver enabled, receiver off, no loopback. */
	serial-duplex-hog {
		gpio-hog;
		gpios = <8 GPIO_ACTIVE_HIGH>;
		output-low;
	};

	serial-dx-en-hog {
		gpio-hog;
		gpios = <9 GPIO_ACTIVE_HIGH>;
		output-high;
	};

	serial-rx-en-hog {
		gpio-hog;
		gpios = <12 GPIO_ACTIVE_HIGH>;
		output-low;
	};

	serial-te485-hog {
		gpio-hog;
		gpios = <13 GPIO_ACTIVE_HIGH>;
		output-low;
	};

	serial-232-485-hog {
		gpio-hog;
		gpios = <14 GPIO_ACTIVE_HIGH>;
		output-low;		/* RS-232 */
	};

	serial-fen-hog {
		gpio-hog;
		gpios = <18 GPIO_ACTIVE_HIGH>;
		output-low;
	};

	serial-loopback-hog {
		gpio-hog;
		gpios = <19 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

&gpio3 {
	/* zwave_module is an input: high means a Z-Wave module is fitted. */
	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "zwave_module", "", "wifi_enable", "";
};

/* ── UART1 → ttymxc0: the console ─────────────────────────────────────── */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

/* ── UART2 → ttymxc1: unused on this board, brought up for completeness ── */
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart2>;
	uart-has-rtscts;
	status = "okay";
};

/*
 * ── UART3 → ttymxc2: the rear RS-232/RS-485 combo port ─────────────────
 * On the EA family this port hangs off a TM4C IO-MCU and there is no host
 * tty for it. Here it is a plain i.MX UART in front of a transceiver that
 * seven GPIOs reconfigure. linux,rs485-enabled-at-boot-time is deliberately
 * NOT set — the port defaults to RS-232, matching the vendor boot state
 * (serial_232_485 = 0).
 */
&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart3>;
	uart-has-rtscts;
	status = "okay";
};

/* ── UART4 → ttymxc3: Z-Wave, Sigma Designs ZM5304 (no flow control) ───── */
&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart4>;
	status = "okay";
};

/*
 * ── UART5 → ttymxc4: Zigbee NCP (EM35x, RTS/CTS) ───────────────────────
 * The part is unconfirmed: on the recon unit this NCP returned nothing to an
 * EZSP/ASH reset at any baud, with or without flow control, before or after
 * pulsing zigbee_reset. See docs/ca1-recon.md.
 */
&uart5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart5>;
	uart-has-rtscts;
	status = "okay";
};

/*
 * ── Ethernet: FEC, RMII, PHY reset on GPIO 49 (bank 2 pin 17) ──────────
 * The reset needs a POST-DELAY. Confirmed on hardware 2026-08-18: with only
 * phy-reset-duration and no post-delay, the FEC deasserts reset and immediately
 * scans MDIO — before the PHY has come out of reset — so every address reads
 * phy_id=0x00000000, the kernel falls back to a "Generic Clause 45 PHY", and
 * eth0 never gets carrier. (It worked once on a warm boot where the PHY was
 * still initialised from the stock boot; it fails on a cold power-on.) The
 * vendor DTB carried NO phy-reset-gpios at all — Control4 reset the PHY from
 * its c4gpio userspace init (drove eth_phy_reset high), so the driver saw an
 * already-settled PHY. We keep the reset in-driver but give the PHY time to
 * wake: phy-reset-post-delay is the ms the FEC waits after deassert before it
 * touches MDIO. Auto-scan (no phy-handle) matches the vendor tree, which found
 * the PHY without naming its address.
 */
&fec {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fec>;
	phy-mode = "rmii";
	phy-reset-gpios = <&gpio2 17 GPIO_ACTIVE_LOW>;
	phy-reset-duration = <20>;
	phy-reset-post-delay = <100>;
	status = "okay";
};

/* ── SPI-NOR: Spansion S25FL128S, 16 MB, holds U-Boot + recovery kernel ── */
&ecspi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi2>;
	/*
	 * The vendor tree declares this ACTIVE_HIGH; the old spi-imx inverted
	 * chip-select internally and ignored the flag. Mainline honours it, and
	 * the line is active low.
	 */
	cs-gpios = <&gpio4 15 GPIO_ACTIVE_LOW>;
	status = "okay";

	flash@0 {
		compatible = "spansion,s25fl128s", "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <20000000>;
		#address-cells = <1>;
		#size-cells = <1>;

		/*
		 * Layout matches U-Boot's own mtdparts. Writing u-boot or
		 * either environment bricks the board if it goes wrong — the
		 * openHC bring-up path does not touch this chip at all, it
		 * boots from the eMMC FAT partition.
		 */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x0f0000>;
			};

			partition@f0000 {
				label = "u-boot-env";
				reg = <0x0f0000 0x010000>;
			};

			partition@100000 {
				label = "recovery-kernel";
				reg = <0x100000 0xc00000>;
			};

			partition@d00000 {
				label = "reserved";
				reg = <0xd00000 0x2f0000>;
			};

			partition@ff0000 {
				label = "u-boot-env-redundant";
				reg = <0xff0000 0x010000>;
			};
		};
	};
};

/* ── usdhc1: SDIO, Realtek RTL8723BS Wi-Fi + Bluetooth (4-bit) ─────────── */
&usdhc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc1>;
	bus-width = <4>;
	non-removable;
	keep-power-in-suspend;
	wakeup-source;
	mmc-pwrseq = <&pwrseq_wifi>;
	status = "okay";
};

/* ── usdhc2: eMMC, Micron M62704, 3.7 GB (8-bit) — the root device ─────── */
&usdhc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc2>;
	bus-width = <8>;
	non-removable;
	keep-power-in-suspend;
	status = "okay";
};

/*
 * The two rear USB host ports. `disable-over-current` is correct but lossy:
 * the vendor's control4,usb-overcurrent driver watched a separate gpio_oc line
 * per port (gpio4 1 and gpio4 3), which is NOT the controller's own OC input,
 * so the chipidea OC detection has to be off or it misreads its pin. The
 * upshot is that over-current is currently UNMONITORED — the ports still power
 * down in hardware, but nothing tells the kernel. Wiring gpio4 1/3 up as
 * interrupts is follow-up work.
 */
&usbotg1 {
	vbus-supply = <&reg_usb_otg1_vbus>;
	dr_mode = "host";
	disable-over-current;
	status = "okay";
};

&usbotg2 {
	vbus-supply = <&reg_usb_otg2_vbus>;
	dr_mode = "host";
	disable-over-current;
	status = "okay";
};

&i2c1 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c1>;
	status = "okay";

	pmic@8 {
		/* The chip is a PFUZE200 (U-Boot: "Found PFUZE200 deviceid=11"), not a
		 * PFUZE100. With the wrong compatible the driver rejects it
		 * ("unrecognized pfuze chip ID") and registers no regulators, which can
		 * stall any driver that waits on a pfuze supply during boot. */
		compatible = "fsl,pfuze200";
		reg = <0x08>;
	};

	rtc@68 {
		compatible = "ti,bq32000";
		reg = <0x68>;
	};
};

&pwm1 { pinctrl-names = "default"; pinctrl-0 = <&pinctrl_pwm1>; status = "okay"; };
&pwm2 { pinctrl-names = "default"; pinctrl-0 = <&pinctrl_pwm2>; status = "okay"; };
&pwm3 { pinctrl-names = "default"; pinctrl-0 = <&pinctrl_pwm3>; status = "okay"; };
&pwm4 { pinctrl-names = "default"; pinctrl-0 = <&pinctrl_pwm4>; status = "okay"; };

&iomuxc {
	pinctrl_uart1: uart1grp {
		fsl,pins = <
			0x298 0x5a0 0x7fc 0x0 0x0 0x1b0b1
			0x29c 0x5a4 0x000 0x0 0x0 0x1b0b1
		>;
	};

	pinctrl_uart2: uart2grp {
		fsl,pins = <
			0x0a0 0x390 0x804 0x1 0x0 0x1b0b1
			0x0a4 0x394 0x000 0x1 0x0 0x1b0b1
			0x0a8 0x398 0x800 0x1 0x0 0x1b0b1
			0x0ac 0x39c 0x000 0x1 0x0 0x1b0b1
		>;
	};

	pinctrl_uart3: uart3grp {
		fsl,pins = <
			0x120 0x410 0x80c 0x2 0x4 0x1b0b1
			0x124 0x414 0x000 0x2 0x0 0x1b0b1
			0x088 0x378 0x808 0x2 0x2 0x1b0b1
			0x08c 0x37c 0x000 0x2 0x0 0x1b0b1
		>;
	};

	pinctrl_uart4: uart4grp {
		fsl,pins = <
			0x1a4 0x4ac 0x000 0x1 0x0 0x1b0b1
			0x184 0x48c 0x814 0x1 0x2 0x1b0b1
		>;
	};

	pinctrl_uart5: uart5grp {
		fsl,pins = <
			0x070 0x360 0x81c 0x2 0x1 0x1b0b1
			0x06c 0x35c 0x000 0x2 0x0 0x1b0b1
			0x068 0x358 0x818 0x2 0x0 0x1b0b1
			0x074 0x364 0x000 0x2 0x0 0x1b0b1
		>;
	};

	/*
	 * Last two entries are mux mode 5 (GPIO) rather than FEC signals —
	 * the vendor group carries the PHY reset and one more control line
	 * inside the fec pinmux group.
	 */
	pinctrl_fec: fecgrp {
		fsl,pins = <
			0x12c 0x41c 0x000 0x0 0x0 0x1b0b0
			0x130 0x420 0x6f4 0x0 0x1 0x1b0b0
			0x128 0x418 0x704 0x0 0x1 0x1b0b0
			0x13c 0x42c 0x6f8 0x0 0x0 0x1b0b0
			0x140 0x430 0x6fc 0x0 0x1 0x1b0b0
			0x148 0x438 0x000 0x0 0x0 0x1b0b0
			0x14c 0x43c 0x000 0x0 0x0 0x1b0b0
			0x150 0x440 0x000 0x0 0x0 0x1b0b0
			0x134 0x424 0x000 0x0 0x0 0x4001b0a8
			0x144 0x434 0x000 0x5 0x0 0x1b0b0
			0x138 0x428 0x000 0x5 0x0 0x1b0b0
		>;
	};

	pinctrl_ecspi2: ecspi2grp {
		fsl,pins = <
			0x078 0x368 0x6a0 0x0 0x0 0x100b1
			0x07c 0x36c 0x6a4 0x0 0x0 0x100b1
			0x080 0x370 0x69c 0x0 0x0 0x100b1
			0x084 0x374 0x000 0x5 0x0 0x80000000
		>;
	};

	pinctrl_i2c1: i2c1grp {
		fsl,pins = <
			0x15c 0x44c 0x71c 0x0 0x2 0x4001b8b1
			0x160 0x450 0x720 0x0 0x2 0x4001b8b1
		>;
	};

	/* 6 pins: CLK, CMD, DAT0-3 — 4-bit, despite the vendor bus-width. */
	pinctrl_usdhc1: usdhc1grp {
		fsl,pins = <
			0x230 0x538 0x000 0x0 0x0 0x17059
			0x22c 0x534 0x000 0x0 0x0 0x10059
			0x234 0x53c 0x000 0x0 0x0 0x17059
			0x238 0x540 0x000 0x0 0x0 0x17059
			0x23c 0x544 0x000 0x0 0x0 0x17059
			0x240 0x548 0x000 0x0 0x0 0x17059
		>;
	};

	/* 10 pins: CLK, CMD, DAT0-7 — 8-bit eMMC. */
	pinctrl_usdhc2: usdhc2grp {
		fsl,pins = <
			0x258 0x560 0x000 0x0 0x0 0x17059
			0x254 0x55c 0x000 0x0 0x0 0x10059
			0x25c 0x564 0x000 0x0 0x0 0x17059
			0x260 0x568 0x000 0x0 0x0 0x17059
			0x264 0x56c 0x000 0x0 0x0 0x17059
			0x268 0x570 0x000 0x0 0x0 0x17059
			0x26c 0x574 0x000 0x0 0x0 0x17059
			0x270 0x578 0x000 0x0 0x0 0x17059
			0x274 0x57c 0x000 0x0 0x0 0x17059
			0x278 0x580 0x000 0x0 0x0 0x17059
		>;
	};

	pinctrl_pwm1: pwm1grp {
		fsl,pins = <0x108 0x3f8 0x000 0x2 0x0 0x110b0>;
	};

	pinctrl_pwm2: pwm2grp {
		fsl,pins = <0x1b4 0x4bc 0x000 0x3 0x0 0x110b0>;
	};

	pinctrl_pwm3: pwm3grp {
		fsl,pins = <0x100 0x3f0 0x000 0x2 0x0 0x110b0>;
	};

	pinctrl_pwm4: pwm4grp {
		fsl,pins = <0x104 0x3f4 0x000 0x2 0x0 0x110b0>;
	};
};
