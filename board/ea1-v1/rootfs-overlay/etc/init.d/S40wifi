#!/bin/sh
# Bring up wlan0 (ath9k) and get a DHCP lease, so the box is reachable over
# Wi-Fi and the serial tether can be dropped. Best-effort: never fail boot.
DEV=wlan0
CONF=/etc/wpa_supplicant/wpa_supplicant-wlan0.conf

case "$1" in
  start)
    printf 'Wi-Fi: '
    # rfkill can start soft-blocked; unblock if the tool is present.
    command -v rfkill >/dev/null 2>&1 && rfkill unblock wifi 2>/dev/null
    ip link set "$DEV" up 2>/dev/null || { echo "no $DEV"; exit 0; }
    wpa_supplicant -B -i "$DEV" -c "$CONF" -Dnl80211 >/dev/null 2>&1
    # give association a moment, then DHCP via busybox udhcpc
    i=0; while [ $i -lt 15 ]; do
      iw "$DEV" link 2>/dev/null | grep -q "Connected to" && break
      sleep 1; i=$((i+1))
    done
    udhcpc -i "$DEV" -t 8 -T 2 -n >/dev/null 2>&1 && echo "up ($(ip -4 -o addr show $DEV | awk '{print $4}'))" || echo "no lease"
    ;;
  stop)
    killall udhcpc wpa_supplicant 2>/dev/null; ip link set "$DEV" down 2>/dev/null ;;
  *) echo "usage: $0 {start|stop}"; exit 1 ;;
esac
exit 0
