# openHomeController board config — EA3 kernel-up build.
# Sourced by /opt/ohc/bin/ohc and the individual services. Shell assignments only.

OHC_MODEL=3                     # EA3 (1/3/5 across the family)
OHC_ID_IFACE=eth0               # the MAC that names this box (always the wired one)
OHC_MDNS_IFACE="eth0"           # no radio on this board — wired only
OHC_TIMEZONE=America/New_York   # host timezone; change with `ohc-tz <Zone>`

# BCM53125 managed-switch port netdevs (DSA). Consumed by the shared
# common/rootfs-overlay/etc/init.d/S40net; empty on a plain single-MAC board.
OHC_DSA_PORTS="lan1 lan2"

# --- the unified IO description every board answers ---------------------------
# OHC_IO_BACKEND says HOW the IO is reached, and it is the only thing ohc-iod
# branches on:
#   mcu   relays/contacts/IR live behind a microcontroller on a serial port,
#         spoken to with the DLE/STX protocol
#   gpio  they are native SoC GPIO lines
#   none  the board has no local IO at all
# Counts are ZERO WHEN ABSENT, and absent means the UI does not draw the panel.
OHC_IO_BACKEND=mcu
OHC_IO_MCU_PART=tm4c1231d5
OHC_IO_MCU_TTY=/dev/ttyS1
OHC_IO_MCU_BAUD=460800
OHC_IR_OUT=6
OHC_IR_BLASTER=1                # 7 outputs total
OHC_IR_IN=1
OHC_RELAYS=1
OHC_CONTACTS=1
OHC_IO_UARTS=3
OHC_SERIALS=""
